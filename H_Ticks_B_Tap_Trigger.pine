// One pending context evaluated against ONE trigger bar. stage = gates passed in order (impulse, stop/risk, clear path,
// admission); fail = code of the first failed gate (7 impulse, 8 stop/risk, 9 coverage unknown, 10 obstacle,
// 11 window instance, 12 session limit, 13 unresolved setup, 14 bias).
type Cand
    int    k
    Zone   trg
    int    stage = 0
    int    fail = -1
    string why = ""
    float  entry = na
    float  stop = na
    float  target = na
    float  legX = na
    int    legT
    int    riskT = 0
    int    bufT = 1
    float  bodyAtr = na
    string srcTxt = ""
    string nearTxt = "none within tracked history"
    bool   ok = false
    int    sub = 0
    int    impFirst = -1
    int    impMask = 0

// A confirmed 3m swing level (strength 2/2) tracked on the chart. consumed = a later candle reached it.
type Lvl
    float  price
    int    dir
    int    pivotT
    int    confT
    bool   consumed = false
    bool   seen = false

f_tk(float x) =>
    math.round(x / syminfo.mintick)

// Closed-interval overlap of a candle range with the ORIGINAL zone boundaries.
f_overlap(float hi, float lo, float zb, float zt) =>
    f_tk(hi) >= f_tk(zb) and f_tk(lo) <= f_tk(zt)

f_tfText(int s) =>
    string r = ""
    if s >= 604800 and s % 604800 == 0
        r := str.tostring(int(s / 604800)) + "W"
    else if s >= 86400 and s % 86400 == 0
        r := str.tostring(int(s / 86400)) + "D"
    else if s >= 3600 and s % 3600 == 0
        r := str.tostring(int(s / 3600)) + "H"
    else if s >= 60 and s % 60 == 0
        r := str.tostring(int(s / 60)) + "m"
    else
        r := str.tostring(s) + "s"
    r

// Engine zone record (8 floats): formTime, code (+-1 live, +-2 inverted-this-bar; sign = direction),
// top, bottom, confTime, tapTime (0 = untapped), formation candle index, formation ATR (-1 = n/a).
f_push(array<float> z, int ft, int dir, float tp, float bt, int conf, int fidx, float atr) =>
    z.push(float(ft))
    z.push(float(dir))
    z.push(tp)
    z.push(bt)
    z.push(float(conf))
    z.push(0.0)
    z.push(float(fidx))
    z.push(na(atr) ? -1.0 : atr)   // frozen formation ATR of this source candle, -1 = unavailable
    true

// ═══════════════════════ SOURCE-CONTEXT LIFECYCLE ENGINE (runs inside request.security) ════════
// Returns the published snapshot (array<float>): header [truncated flag, readyTime (0 = still warming up)], then 8 floats
// per zone, oldest first. The same array object is returned on every bar on which nothing changed; a published array is
// never mutated. While warming up only the header is published (no zones are ever used from a partial history).
// History policy (NO wall-clock cutoff, identical in normal loading and Bar Replay):
//   * every source candle the platform supplies is processed, oldest first; nothing depends on the computer's current time;
//   * a live zone expires once (candle open - formation time) >= `horizonMs` (silent, documented horizon);
//   * READY = the processed history spans a full horizon after the FIRST candle the platform supplied, so no zone inside the
//     horizon can be unknown. The header also reports that first-candle time so a late start can be explained;
//   * capacity: the OLDEST live zone is dropped and truncation stays flagged (coverage UNKNOWN) until that zone would have
//     expired anyway. No relevance shortcut: a dropped gap is never assumed irrelevant.
f_engine(int cap, int minTicks, int horizonMs) =>
    var array<float> Z = array.new_float(0)
    var array<float> pub = array.from(0.0, 0.0, 0.0)
    var float maxPruned = -1.0
    var bool lastTrunc = false
    var bool lastReady = false
    var float lastProc = 0.0
    var int firstProcT = 0
    array<float> out = na
    float atrS = ta.atr(14)      // source-timeframe ATR, evaluated every bar
    float fatr1 = atrS[1]        // ATR on the SAME completed candle [1] as the formation OHLC
    float h1 = high[1]
    float l1 = low[1]
    float c1 = close[1]
    float h2 = high[2]
    float l2 = low[2]
    float h3 = high[3]
    float l3 = low[3]
    int   t1 = time[1]
    int   tc1 = time_close[1]
    int   cidx = bar_index - 1
    bool  valid = not na(h1) and not na(l1) and not na(c1) and not na(t1) and not na(tc1)
    bool  active = valid
    if active
        if t1 > lastProc
            lastProc := t1
            if firstProcT == 0
                firstProcT := t1
            bool dirty = false
            // 1) drop zones flagged inverted on the previous source bar
            int n0 = int(Z.size() / ZS)
            if n0 > 0
                for i = n0 - 1 to 0
                    if math.abs(Z.get(i * ZS + 1)) == 2.0
                        for k = 1 to ZS
                            Z.remove(i * ZS)
                        dirty := true
            // 2) lifecycle of existing zones on the completed candle. Only candles that OPEN at/after the
            //    formation confirmation are eligible (the formation candle never touches/inverts itself).
            int n1 = int(Z.size() / ZS)
            if n1 > 0
                for i = 0 to n1 - 1
                    int b = i * ZS
                    if t1 >= int(Z.get(b + 4))
                        float cd = Z.get(b + 1)
                        float zt = Z.get(b + 2)
                        float zb = Z.get(b + 3)
                        bool inv = cd > 0 ? f_tk(c1) < f_tk(zb) : f_tk(c1) > f_tk(zt)
                        if inv
                            Z.set(b + 1, cd * 2.0)   // source CLOSE strictly beyond the opposite boundary
                            dirty := true
                        else if Z.get(b + 5) == 0.0 and f_overlap(h1, l1, zb, zt)
                            Z.set(b + 5, float(tc1)) // first touch (monotonic)
                            dirty := true
            // 3) formation: candle 3 = [1], candle 1 = [3]; candle 2 only has to exist
            if not na(h2) and not na(l2) and not na(h3) and not na(l3)
                int bullGap = f_tk(l1) - f_tk(h3)
                int bearGap = f_tk(l3) - f_tk(h1)
                if bullGap >= minTicks
                    f_push(Z, t1, 1, l1, h3, tc1, cidx, fatr1)
                    dirty := true
                else if bearGap >= minTicks
                    f_push(Z, t1, -1, l3, h1, tc1, cidx, fatr1)
                    dirty := true
            // 4) horizon expiry (silent, never an inversion). Flagged zones are left so the inversion is published.
            int n2 = int(Z.size() / ZS)
            if n2 > 0
                for i = n2 - 1 to 0
                    if math.abs(Z.get(i * ZS + 1)) == 1.0 and t1 - int(Z.get(i * ZS)) >= horizonMs
                        for k = 1 to ZS
                            Z.remove(i * ZS)
                        dirty := true
            // 5) capacity: drop the OLDEST unflagged live zone (Z is chronological); truncation is flagged, never ignored
            int n3 = int(Z.size() / ZS)
            int nFlag = 0
            if n3 > 0
                for i = 0 to n3 - 1
                    if math.abs(Z.get(i * ZS + 1)) == 2.0
                        nFlag += 1
            int over = n3 - nFlag - cap
            while over > 0
                int pIdx = -1
                int nn = int(Z.size() / ZS)
                for i = 0 to nn - 1
                    if pIdx < 0 and math.abs(Z.get(i * ZS + 1)) == 1.0
                        pIdx := i
                if pIdx >= 0
                    maxPruned := math.max(maxPruned, Z.get(pIdx * ZS))
                    for k = 1 to ZS
                        Z.remove(pIdx * ZS)
                    dirty := true
                over -= 1
            // 6) truncation flag: a capacity-dropped zone could still be live inside the horizon => coverage unknown
            bool truncNow = maxPruned >= 0 and t1 - maxPruned < horizonMs
            if truncNow != lastTrunc
                lastTrunc := truncNow
                dirty := true
            // 7) READY once the processed history spans a full horizon; flip is published
            bool nowReady = t1 - firstProcT >= horizonMs
            if nowReady != lastReady
                lastReady := nowReady
                dirty := true
            // 8) publish a NEW array only if something changed (header only while warming up)
            if dirty
                array<float> tmp = array.from(truncNow ? 1.0 : 0.0, nowReady ? float(tc1) : 0.0, float(firstProcT))
                if nowReady
                    tmp.concat(Z)
                pub := tmp
        out := pub
    out

// 3m swing-level engine (inside request.security on the 3m series). Strict pivots 2 left / 2 right; a pivot becomes
// available only when its second right-side candle completes. A level is consumed by the first LATER completed candle that
// reaches it (high >= level / low <= level); the pivot candle and the confirming candles never consume it (strict pivot).
// Published like the zone engine: header [truncated, readyTime], then 4 floats per level (price, +1 high / -1 low,
// pivot candle open time, confirmation time). Horizon expiry and capacity are time/size bounded; capacity drops the OLDEST
// level and flags coverage UNKNOWN until it would have expired.
f_lvlEngine(int cap, int horizonMs) =>
    var array<float> L = array.new_float(0)
    var array<float> pub = array.from(0.0, 0.0, 0.0)
    var float maxPruned = -1.0
    var bool lastTrunc = false
    var bool lastReady = false
    var float lastProc = 0.0
    var int firstProcT = 0
    array<float> out = na
    float h1 = high[1]
    float l1 = low[1]
    float h2 = high[2]
    float l2 = low[2]
    float h3 = high[3]
    float l3 = low[3]
    float h4 = high[4]
    float l4 = low[4]
    float h5 = high[5]
    float l5 = low[5]
    int   t1 = time[1]
    int   tc1 = time_close[1]
    int   t3 = time[3]
    bool  valid = not na(h1) and not na(l1) and not na(t1) and not na(tc1)
    bool  active = valid
    if active
        if t1 > lastProc
            lastProc := t1
            if firstProcT == 0
                firstProcT := t1
            bool dirty = false
            int n0 = int(L.size() / LS)
            if n0 > 0
                for i = n0 - 1 to 0
                    int b = i * LS
                    bool hit = false
                    if t1 >= int(L.get(b + 3))
                        hit := L.get(b + 1) > 0 ? f_tk(h1) >= f_tk(L.get(b)) : f_tk(l1) <= f_tk(L.get(b))
                    bool old = t1 - int(L.get(b + 2)) >= horizonMs
                    if hit or old
                        for k = 1 to LS
                            L.remove(b)
                        dirty := true
            if not na(h5) and not na(l5) and not na(t3)
                bool ph = f_tk(h3) > f_tk(h4) and f_tk(h3) > f_tk(h5) and f_tk(h3) > f_tk(h2) and f_tk(h3) > f_tk(h1)
                bool pl = f_tk(l3) < f_tk(l4) and f_tk(l3) < f_tk(l5) and f_tk(l3) < f_tk(l2) and f_tk(l3) < f_tk(l1)
                if ph
                    L.push(h3)
                    L.push(1.0)
                    L.push(float(t3))
                    L.push(float(tc1))
                    dirty := true
                if pl
                    L.push(l3)
                    L.push(-1.0)
                    L.push(float(t3))
                    L.push(float(tc1))
                    dirty := true
            int over = int(L.size() / LS) - cap
            while over > 0
                maxPruned := math.max(maxPruned, L.get(2))
                for k = 1 to LS
                    L.remove(0)
                dirty := true
                over -= 1
            bool truncNow = maxPruned >= 0 and t1 - maxPruned < horizonMs
            if truncNow != lastTrunc
                lastTrunc := truncNow
                dirty := true
            bool nowReady = t1 - firstProcT >= horizonMs
            if nowReady != lastReady
                lastReady := nowReady
                dirty := true
            if dirty
                array<float> tmp = array.from(truncNow ? 1.0 : 0.0, nowReady ? float(tc1) : 0.0, float(firstProcT))
                if nowReady
                    tmp.concat(L)
                pub := tmp
        out := pub
    out

// 15m directional bias engine (inside request.security on the 15m series; completed candle [1] only).
// 1) the break test uses only pivots that were confirmed on EARLIER candles (available before the breaking candle began);
// 2) only afterwards is the pivot confirmed by this candle stored (never backdated). A level breaks at most once.
// Returns [bias +1/-1/0, broken level, pivot candle open time, break-confirmation time].
f_bias15() =>
    var float swH = na
    var float swHT = na
    var float swHA = na
    var bool  swHB = true
    var float swL = na
    var float swLT = na
    var float swLA = na
    var bool  swLB = true
    var float bias = 0.0
    var float bLvl = na
    var float bLvlT = na
    var float bAv = na
    var float lastProc = 0.0
    float h1 = high[1]
    float l1 = low[1]
    float c1 = close[1]
    float h2 = high[2]
    float l2 = low[2]
    float h3 = high[3]
    float l3 = low[3]
    float h4 = high[4]
    float l4 = low[4]
    float h5 = high[5]
    float l5 = low[5]
    int   t1 = time[1]
    int   tc1 = time_close[1]
    int   t3 = time[3]
    bool  valid = not na(c1) and not na(t1) and not na(tc1)
    if valid
        if t1 > lastProc
            lastProc := t1
            if not na(swH) and not swHB and swHA <= t1 and f_tk(c1) > f_tk(swH)
                bias := 1.0
                bLvl := swH
                bLvlT := swHT
                bAv := float(tc1)
                swHB := true
            else if not na(swL) and not swLB and swLA <= t1 and f_tk(c1) < f_tk(swL)
                bias := -1.0
                bLvl := swL
                bLvlT := swLT
                bAv := float(tc1)
                swLB := true
            if not na(h5) and not na(l5) and not na(t3)
                if f_tk(h3) > f_tk(h4) and f_tk(h3) > f_tk(h5) and f_tk(h3) > f_tk(h2) and f_tk(h3) > f_tk(h1)
                    swH := h3
                    swHT := float(t3)
                    swHA := float(tc1)
                    swHB := false
                if f_tk(l3) < f_tk(l4) and f_tk(l3) < f_tk(l5) and f_tk(l3) < f_tk(l2) and f_tk(l3) < f_tk(l1)
                    swL := l3
                    swLT := float(t3)
                    swLA := float(tc1)
                    swLB := false
    [bias, bLvl, bLvlT, bAv]

