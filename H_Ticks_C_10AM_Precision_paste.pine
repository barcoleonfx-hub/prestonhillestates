//@version=6
indicator("H Ticks — 10AM Precision Model C", shorttitle = "H Ticks C", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 500)
const string TZ = "America/New_York"
const int NS = 5
const int NF = 15
const string G1 = "1. Times (New York, DST-aware)"
const string G2 = "2. Manipulation and reversal"
const string G3 = "3. Optional liquidity-sweep filter (OFF = baseline)"
const string G4 = "4. Entry model"
const string G5 = "5. Stop, target, risk"
const string G6 = "6. Simulation assumptions"
const string G7 = "7. Display"
const string G8 = "8. Alerts"
const string G0 = "0. Execution variant"
const string G9 = "9. Precision variant (Rejection / Sweep)"
string inVariant = input.string("Standard", "Execution variant (selected: alerts, planned lines)", options = ["Standard", "Precision"], group = G0, tooltip = "Standard = the 10am reversal / retest execution (entry models A, B, C below). Precision = wait for a local rejection / secondary sweep after the same setup, with a local stop.")
bool inShowBoth = input.bool(true, "Display both variants on the chart (when both are simulated)", group = G0)
bool inCmpVar = input.bool(false, "Compare both variants' statistics (simulate Standard AND Precision)", group = G0, tooltip = "OFF = only the selected variant is simulated, so Standard behaves exactly as before. ON = both are simulated independently with separate equity and statistics.")
string inORs = input.session("0930-1000", "Opening range (candle OPEN times, end exclusive)", group = G1, tooltip = "Default 09:30-09:59. Frozen when the 10:00 candle closes. Used only for the optional sweep filter and the liquidity target.")
string inMan = input.session("1000-1010", "10am open candle / initial-manipulation window (candle OPEN times, end exclusive)", group = G1, tooltip = "The START is the candle whose exact open is captured (10:00). The first qualifying manipulation must be on a candle that opens in this window (default 10:00-10:09).")
string inCut = input.session("1045-1100", "Entry cutoff -> time exit (NY)", group = G1, tooltip = "FIRST time = entry cutoff: pending entries are cancelled, no new fills. SECOND time = any remaining position is closed at that candle's open (reported as a time exit).")
string inThr = input.string("ATR", "Manipulation threshold mode", options = ["ATR", "Fixed points"], group = G2, tooltip = "Initial research setting, NOT optimised. ATR mode uses ATR frozen from the last completed candle before the 10:00 open, so the manipulation can never inflate its own threshold.")
float inFixed = input.float(15.0, "Fixed threshold (points)", minval = 0.25, step = 0.25, group = G2)
float inAtrM = input.float(0.5, "ATR multiple", minval = 0.05, step = 0.05, group = G2)
int inAtrLen = input.int(14, "ATR length (1m)", minval = 1, group = G2)
int inRevN = input.int(2, "Consecutive closes through the open to confirm the reversal", minval = 1, maxval = 5, group = G2, tooltip = "Counted only on candles AFTER the manipulation candle; the count resets if a close fails the condition.")
string inAmbInit = input.string("Skip day", "A first candle that crosses both thresholds", options = ["Skip day", "Use larger excursion"], group = G2)
bool inMaxOn = input.bool(false, "Maximum manipulation-size filter (OFF = baseline)", group = G2, tooltip = "Size is ALWAYS recorded in points and ATR multiples. When ON, a candidate larger than the limit is invalidated at reversal confirmation.")
float inMaxPts = input.float(60.0, "Maximum size (points, used in Fixed mode)", minval = 1.0, group = G2)
float inMaxAtr = input.float(4.0, "Maximum size (ATR multiples, used in ATR mode)", minval = 0.1, group = G2)
bool inSweep = input.bool(false, "Require a post-10am liquidity sweep", group = G3, tooltip = "Short: price must exceed an eligible HIGH by the minimum, then close back below it by the reversal confirmation. Long mirrors. Levels must exist BEFORE they are swept; a sweep before 10:00 is context only. Asia/London levels are NOT implemented.")
int inSweepTk = input.int(1, "Minimum sweep distance (ticks)", minval = 1, group = G3)
bool inLvOR = input.bool(true, "Eligible: frozen opening-range high/low", group = G3)
bool inLvPD = input.bool(true, "Eligible: previous completed regular-session high/low (09:30-16:00)", group = G3, tooltip = "Used only when that session had all 390 one-minute candles.")
string inModel = input.string("A: plain retest", "Selected entry model (alerts + planned lines)", options = ["A: plain retest", "B: retest + iFVG", "C: Fib overlap + rejection"], group = G4)
bool inCompare = input.bool(false, "Comparison mode: simulate A, B, C and C-wick independently", group = G4, tooltip = "OFF = only the selected model is simulated. ON = every model keeps its own independent statistics. Only the selected model raises alerts.")
string inCStop = input.string("Manipulation extreme", "Model C stop policy", options = ["Manipulation extreme", "Rejection wick (experimental)"], group = G4, tooltip = "The wick-stop variant is EXPERIMENTAL and always reported as its own column (C-wick).")
bool inStrict = input.bool(false, "Stricter fill: require trade-through (1 tick beyond the limit)", group = G4, tooltip = "OFF = a touch fills (a simulation assumption, not guaranteed execution).")
int inBuf = input.int(2, "Stop buffer (ticks)", minval = 0, group = G5)
int inMaxStop = input.int(80, "Maximum stop distance (ticks); wider setups are REJECTED", minval = 1, group = G5)
string inTgt = input.string("1R", "Target", options = ["1R", "2R", "Opposing liquidity"], group = G5, tooltip = "Opposing liquidity = nearest frozen opening-range / previous-session level beyond the entry on the profit side; no eligible level = the trade is rejected and counted.")
string inSizeMode = input.string("Fixed contracts", "Position sizing", options = ["Fixed contracts", "Fixed cash risk"], group = G6, tooltip = "Fixed cash risk uses the SAME cash risk for every trade (whole contracts only, rounded DOWN; a setup needing less than one contract is rejected). Use it when comparing variants with very different stop sizes.")
int inQty = input.int(1, "Contracts (Fixed contracts mode, whole contracts)", minval = 1, group = G6)
float inCashRisk = input.float(500.0, "Cash risk per trade (USD, Fixed cash risk mode)", minval = 10.0, step = 50.0, group = G6)
float inComm = input.float(0.0, "Commission (USD per contract per side)", minval = 0.0, step = 0.25, group = G6)
int inSlip = input.int(0, "Adverse slippage (ticks) on entry, stop and time exits", minval = 0, group = G6)
string inAmbMode = input.string("Loss (conservative)", "Ambiguous trades", options = ["Loss (conservative)", "Exclude from stats"], group = G6)
bool inFunnel = input.bool(true, "Show funnel table", group = G7)
bool inPerf = input.bool(true, "Show performance table", group = G7)
bool inLedger = input.bool(true, "Show trade ledger", group = G7)
int inLedPage = input.int(1, "Ledger page", minval = 1, group = G7)
string inLedModel = input.string("All", "Ledger model", options = ["All", "A", "B", "C", "C-wick", "Precision"], group = G7)
int inDraw = input.int(5, "Days drawn on the chart", minval = 1, maxval = 20, group = G7)
bool inVisPlan = input.bool(true, "Draw planned entry / stop / target (selected model)", group = G7)
bool inVisFib = input.bool(true, "Draw frozen Fib zone, levels and rejection wick", group = G7)
bool inVisFvg = input.bool(true, "Draw the frozen FVG (model B)", group = G7)
bool inVisPrec = input.bool(true, "Draw the Precision trigger wick and swept local level", group = G7)
bool inVisBand = input.bool(false, "Draw the Precision band around the 10am open", group = G7)
bool inDebug = input.bool(false, "Debug: log each day's result to Pine Logs", group = G7)
string inPTrig = input.string("Rejection", "Precision trigger", options = ["Rejection", "Secondary sweep", "Either"], group = G9, tooltip = "Rejection = a confirmed rejection candle in the precision area. Secondary sweep = a confirmed local pivot (formed after the reversal) is exceeded and the candle closes back, with the same rejection conditions. Either = whichever comes first; both on one candle is labelled Sweep + Rejection.")
float inBand = input.float(4.0, "Precision band half-width (ticks around the 10am open)", minval = 0.0, step = 1.0, group = G9, tooltip = "A test parameter, not an optimised value.")
bool inPFib = input.bool(false, "Require the band to overlap the frozen 61.8-79% Fib zone", group = G9, tooltip = "Uses the same frozen, causal displacement-leg anchors as model C. The trigger candle must then interact with the band-and-zone overlap.")
bool inPIfvg = input.bool(false, "Require a confirmed iFVG inversion first (model B rules)", group = G9, tooltip = "The latest eligible FVG is frozen at the reversal confirmation; a later close through it must happen BEFORE a trigger candle can qualify (the inverting candle itself cannot trigger).")
float inWick = input.float(0.40, "Minimum rejection-wick share of the candle range", minval = 0.05, maxval = 0.95, step = 0.05, group = G9)
int inPvL = input.int(1, "Local pivot: candles to the left", minval = 1, maxval = 5, group = G9)
int inPvR = input.int(1, "Local pivot: candles to the right", minval = 1, maxval = 5, group = G9, tooltip = "A pivot becomes known only when the last right-side candle has CLOSED; it can be swept only by a later candle.")
float inMinR = input.float(5.0, "Minimum planned reward:risk", minval = 0.5, step = 0.5, group = G9, tooltip = "Checked on the ROUNDED entry, stop and target. The nearest eligible target below this is skipped; no farther target is substituted.")
int inPStopCap = input.int(40, "Maximum Precision stop distance (ticks)", minval = 1, group = G9, tooltip = "Over the cap = rejected, never compressed.")
int inPBuf = input.int(2, "Precision stop buffer (ticks)", minval = 0, group = G9)
int inPExp = input.int(3, "Precision order expiry (subsequent chart candles)", minval = 1, group = G9)
string inPTgt = input.string("Opposing liquidity", "Precision target", options = ["Opposing liquidity", "Fixed R"], group = G9, tooltip = "Opposing liquidity = nearest UNSWEPT frozen opening-range / previous-session level beyond the entry on the profit side, known when the order is armed. Fixed R is a separate mode and is labelled as such.")
float inPFixR = input.float(5.0, "Fixed R multiple (Fixed R mode)", minval = 0.5, step = 0.5, group = G9)
bool inAlSetup = input.bool(true, "Alert: setup ready (reversal confirmed)", group = G8)
bool inAlArm = input.bool(true, "Alert: order armed (simulated limit, NOT a fill)", group = G8)
bool inAlFill = input.bool(true, "Alert: simulated fill", group = G8)
bool inAlInv = input.bool(true, "Alert: invalidation / cancellation", group = G8)
f_mins(string s, int off) =>
    int(str.tonumber(str.substring(s, off, off + 2))) * 60 + int(str.tonumber(str.substring(s, off + 2, off + 4)))
int orS = f_mins(inORs, 0)
int orE = f_mins(inORs, 5)
int openT = f_mins(inMan, 0)
int manE = f_mins(inMan, 5)
int cutT = f_mins(inCut, 0)
int exitT = f_mins(inCut, 5)
bool cfgOk = orS < orE and openT < manE and manE <= cutT and cutT < exitT and orE <= openT
bool supported = chart.is_standard and not timeframe.isticks and timeframe.isminutes and timeframe.multiplier == 1
int chartMs = 60000
float tk = syminfo.mintick
int mOpen = hour(time, TZ) * 60 + minute(time, TZ)
int dkey = year(time, TZ) * 10000 + month(time, TZ) * 100 + dayofmonth(time, TZ)
int dowN = dayofweek(time, TZ)
float atrV = ta.atr(inAtrLen)
float h2 = high[2]
float l2 = low[2]
int t2 = time[2]
int stdSel = inModel == "A: plain retest" ? 0 : (inModel == "B: retest + iFVG" ? 1 : (inCStop == "Rejection wick (experimental)" ? 3 : 2))
int selVar = inVariant == "Precision" ? 1 : 0
int selSlot = selVar == 1 ? 4 : stdSel
int altDraw = inShowBoth ? (selVar == 1 ? stdSel : 4) : -1
bool stdOn = selVar == 0 or inCmpVar
bool precOn = selVar == 1 or inCmpVar
var array<bool> slotOn = array.from(stdOn and (inCompare or stdSel == 0), stdOn and (inCompare or stdSel == 1), stdOn and (inCompare or stdSel == 2), stdOn and (inCompare or stdSel == 3), precOn)
var array<string> slotNm = array.from("STD A plain retest", "STD B retest+iFVG", "STD C Fib+rejection", "STD C wick-stop (exp.)", "PRECISION rej/sweep")
type Trade
    int slot
    int dir
    int dayKey
    float lvl
    float entryPx
    float stopPx
    float tgtPx
    float riskPts
    int armT
    int fillT
    int exitT
    float exitPx
    bool isOpen = true
    int outcome = 0
    float grossR = na
    float netR = na
    float netUsd = 0.0
    float costUsd = 0.0
    float maeP = 0.0
    float mfeP = 0.0
    bool excUnc = false
    bool entryAmb = false
    string note = ""
    int qty = 1
    float plannedR = na
    string tgtType = ""
    float riskUsd = 0.0
type Mdl
    int slot
    int st = 0
    string why = ""
    int armBar = -1
    int armT
    float lim = na
    float stp = na
    float tgt = na
    float fT = na
    float fB = na
    int fCT
    bool fInv = false
    Trade tr
    int qty = 1
    float plannedR = na
    string tgtType = ""
    string trigNm = ""
    int tT
    float tHi = na
    float tLo = na
    float tBase = na
    float sLvl = na
    int sT
type Day
    int key
    bool active = true
    int status = 0
    int st = 0
    string why = ""
    float O = na
    int oT
    float atrPre = na
    float thr = na
    float orH = na
    float orL = na
    int orN = 0
    float pdH = na
    float pdL = na
    float rthH = na
    float rthL = na
    int rthN = 0
    int bars10 = 0
    int dir = 0
    float mExt = na
    int mExtT
    float oppX = na
    int qBar = -1
    int qT
    int cnt = 0
    int confBar = -1
    int confT
    float mPts = na
    float mAtr = na
    bool preSweep = false
    float swpLvl = na
    int swpT
    string swpNm = ""
    array<float> lvlP
    array<int> lvlT
    float fbuT = na
    float fbuB = na
    int fbuC
    float fbuMin = na
    float fbeT = na
    float fbeB = na
    int fbeC
    float fbeMax = na
    bool fibOk = false
    float fibLo = na
    float fibHi = na
    bool rejOk = false
    int rejT
    float rejHi = na
    float rejLo = na
    float rejBase = na
    float rejEntry = na
    float parLo = na
    float parHi = na
    float bdLo = na
    float bdHi = na
    float pvP = na
    int pvBar
    int pvKn
    int pvT
    bool pvDead = false
    float poHi = na
    float poLo = na
    array<Mdl> ms
var array<int> fnl = array.new_int(NS * NF, 0)
var array<int> cv = array.new_int(8, 0)
var array<Trade> trades = array.new<Trade>()
var array<Day> days = array.new<Day>()
var array<string> aMsgs = array.new_string(0)
var array<int> evK = array.new_int(4, 0)
var array<line> dLines = array.new<line>()
var array<box> dBoxes = array.new<box>()
var array<label> dLabels = array.new<label>()
var Day cur = na
var Day lastAct = na
var int firstKey = na
var int lastKey = na
var array<float> bufH = array.new_float(0)
var array<float> bufL = array.new_float(0)
var array<int> bufI = array.new_int(0)
var array<int> bufT = array.new_int(0)
var float sHi = na
var float sLo = na
var int pM = na
var float pClose = na
var int pCloseT = na
f_ts(int key, int mins) =>
    timestamp(TZ, int(math.floor(key / 10000.0)), int(math.floor((key % 10000) / 100.0)), key % 100, int(math.floor(mins / 60.0)), mins % 60, 0)
f_hm(int t) =>
    str.format_time(t, "HH:mm", TZ)
f_hms(int t) =>
    str.format_time(t, "HH:mm:ss", TZ)
f_dt(int key) =>
    str.tostring(int(math.floor(key / 10000.0))) + "-" + str.format_time(f_ts(key, 720), "MM-dd", TZ)
f_fn(int slot, int col) =>
    fnl.set(slot * NF + col, fnl.get(slot * NF + col) + 1)
    true
f_fnA(int col) =>
    for k = 0 to NS - 1
        if slotOn.get(k)
            f_fn(k, col)
    true
f_msgK(int kind, int slot, string txt) =>
    if slot == selSlot
        evK.set(kind, evK.get(kind) + 1)
        bool want = (kind == 0 and inAlSetup) or (kind == 1 and inAlArm) or (kind == 2 and inAlFill) or (kind == 3 and inAlInv)
        if want
            aMsgs.push("H Ticks C | " + slotNm.get(slot) + " | " + txt + " | " + syminfo.ticker + " (research model; simulation)")
    true
f_exceeded(Day dy) =>
    dy.dir > 0 ? low < dy.mExt : high > dy.mExt
f_fibLvl(Day dy, float r) =>
    dy.dir < 0 ? dy.oppX + r * (dy.mExt - dy.oppX) : dy.oppX - r * (dy.oppX - dy.mExt)
f_finish(Mdl md, int outcome, float exitPx, int exitTime, string note) =>
    Trade t = md.tr
    float sgn = t.dir > 0 ? 1.0 : -1.0
    float pv = syminfo.pointvalue
    float grossUsd = sgn * (exitPx - t.entryPx) * pv * t.qty
    float slipPer = inSlip * syminfo.mintick * pv * t.qty
    float slipUsd = slipPer * (outcome == 1 ? 1.0 : 2.0)
    float commUsd = inComm * t.qty * 2.0
    float riskUsd = t.riskPts * pv * t.qty
    t.isOpen := false
    t.outcome := outcome
    t.exitPx := exitPx
    t.exitT := exitTime
    t.costUsd := slipUsd + commUsd
    t.netUsd := grossUsd - slipUsd - commUsd
    t.grossR := riskUsd > 0 ? grossUsd / riskUsd : na
    t.netR := riskUsd > 0 ? t.netUsd / riskUsd : na
    t.note := t.note == "" ? note : t.note + " | " + note
    md.st := 4
    md.why := note
    if outcome == 4
        f_fn(md.slot, 10)
    true
f_plan(Day dy, Mdl md, float entryRaw, float wickX) =>
    bool bull = dy.dir > 0
    float entry = math.round_to_mintick(entryRaw)
    float anchor = (md.slot == 3 and not na(wickX)) ? wickX : dy.mExt
    float stop = bull ? math.round_to_mintick(anchor - inBuf * tk) : math.round_to_mintick(anchor + inBuf * tk)
    int riskT = int(math.round((bull ? entry - stop : stop - entry) / tk))
    int qty = inQty
    if inSizeMode == "Fixed cash risk" and riskT >= 1
        qty := int(math.floor(inCashRisk / (riskT * tk * syminfo.pointvalue)))
    bool armed = false
    if riskT < 1
        md.st := 4
        md.why := "rejected: stop is not beyond the entry"
        f_fn(md.slot, 8)
        f_msgK(3, md.slot, "REJECTED - " + md.why)
    else if riskT > inMaxStop
        md.st := 4
        md.why := "stop-cap rejection: " + str.tostring(riskT) + " ticks > " + str.tostring(inMaxStop)
        f_fn(md.slot, 8)
        f_msgK(3, md.slot, "REJECTED - " + md.why)
    else if qty < 1
        md.st := 4
        md.why := "sizing rejection: one contract risks more than the cash budget"
        f_fn(md.slot, 14)
        f_msgK(3, md.slot, "REJECTED - " + md.why)
    else
        float tgt = na
        if inTgt == "1R"
            tgt := bull ? entry + riskT * tk : entry - riskT * tk
        else if inTgt == "2R"
            tgt := bull ? entry + 2 * riskT * tk : entry - 2 * riskT * tk
        else
            if bull
                float c1 = not na(dy.orH) and dy.orH > entry + tk ? dy.orH : na
                float c2 = not na(dy.pdH) and dy.pdH > entry + tk ? dy.pdH : na
                tgt := na(c1) ? c2 : (na(c2) ? c1 : math.min(c1, c2))
            else
                float c1 = not na(dy.orL) and dy.orL < entry - tk ? dy.orL : na
                float c2 = not na(dy.pdL) and dy.pdL < entry - tk ? dy.pdL : na
                tgt := na(c1) ? c2 : (na(c2) ? c1 : math.max(c1, c2))
        if na(tgt)
            md.st := 4
            md.why := "rejected: no eligible opposing-liquidity target"
            f_fn(md.slot, 11)
            f_msgK(3, md.slot, "REJECTED - " + md.why)
        else
            md.lim := entry
            md.stp := stop
            md.tgt := math.round_to_mintick(tgt)
            md.qty := qty
            md.tgtType := inTgt == "Opposing liquidity" ? "liquidity" : inTgt
            md.plannedR := math.abs(md.tgt - entry) / math.abs(entry - stop)
            md.st := 2
            md.armBar := bar_index
            md.armT := time_close
            f_fn(md.slot, 5)
            armed := true
            f_msgK(1, md.slot, "ORDER ARMED (simulated limit, NOT a fill) " + (bull ? "LONG" : "SHORT") + " limit " + str.tostring(md.lim, format.mintick) + " stop " + str.tostring(md.stp, format.mintick) + " target " + str.tostring(md.tgt, format.mintick) + " risk " + str.tostring(riskT) + " ticks")
    armed
f_cond(Day dy, Mdl md, float entryRaw, float wickX) =>
    f_fn(md.slot, 4)
    f_plan(dy, md, entryRaw, wickX)
f_fillTry(Day dy, Mdl md) =>
    bool bull = dy.dir > 0
    float lim = md.lim
    float thrP = inStrict ? tk : 0.0
    bool touch = bull ? low <= lim - thrP : high >= lim + thrP
    if touch
        bool known = bull ? open <= lim - thrP : open >= lim + thrP
        float stp = md.stp
        float tgt = md.tgt
        Trade t = Trade.new(slot = md.slot, dir = dy.dir, dayKey = dy.key, lvl = dy.O, entryPx = lim, stopPx = stp, tgtPx = tgt, riskPts = math.abs(lim - stp), armT = md.armT, fillT = time, qty = md.qty, plannedR = md.plannedR, tgtType = md.tgtType, riskUsd = math.abs(lim - stp) * syminfo.pointvalue * md.qty, note = md.slot == 4 ? md.trigNm + " | plan " + str.tostring(md.plannedR, "#.0") + "R " + md.tgtType : "")
        md.tr := t
        md.st := 3
        trades.push(t)
        f_fn(md.slot, 6)
        f_msgK(2, md.slot, "SIMULATED FILL (limit touch assumed) " + (bull ? "LONG" : "SHORT") + " at " + str.tostring(lim, format.mintick) + " stop " + str.tostring(stp, format.mintick) + " target " + str.tostring(tgt, format.mintick))
        bool stopHit = bull ? low <= stp : high >= stp
        bool tgtTouch = bull ? high >= tgt : low <= tgt
        float adv = bull ? lim - low : high - lim
        float fav = bull ? high - lim : lim - low
        t.maeP := math.max(0.0, adv)
        if known
            t.mfeP := math.max(0.0, fav)
        else
            t.mfeP := 0.0
            t.excUnc := fav > 0
            t.entryAmb := tgtTouch or fav > 0
        if stopHit and tgtTouch
            t.maeP := math.max(t.maeP, t.riskPts)
            t.excUnc := true
            f_finish(md, 4, stp, time, "ambiguous: stop and target both reachable on the fill candle")
        else if stopHit
            t.maeP := math.max(t.maeP, t.riskPts)
            f_finish(md, 2, stp, time, "stop hit on the fill candle")
        else if known and tgtTouch
            t.mfeP := math.max(t.mfeP, math.abs(tgt - lim))
            f_finish(md, 1, tgt, time, "target hit on the fill candle (fill at the open)")
    true
f_fillStep(Day dy, Mdl md) =>
    bool bull = dy.dir > 0
    if (bull ? open < dy.mExt : open > dy.mExt)
        md.st := 4
        md.why := "invalidated: the candle opened beyond the frozen manipulation extreme"
        f_fn(md.slot, 9)
        f_msgK(3, md.slot, "INVALIDATED - " + md.why)
    else
        f_fillTry(dy, md)
    true
f_posStep(Day dy, Mdl md) =>
    Trade t = md.tr
    bool bull = t.dir > 0
    float stp = md.stp
    float tgt = md.tgt
    float ent = t.entryPx
    bool gStop = bull ? open <= stp : open >= stp
    bool gTgt = bull ? open >= tgt : open <= tgt
    bool stopHit = bull ? low <= stp : high >= stp
    bool tgtHit = bull ? high >= tgt : low <= tgt
    float adv = bull ? ent - low : high - ent
    float fav = bull ? high - ent : ent - low
    float pMae = t.maeP
    float pMfe = t.mfeP
    float tgtD = math.abs(tgt - ent)
    if gStop
        t.maeP := math.max(pMae, bull ? ent - open : open - ent)
        f_finish(md, 2, open, time, "gap through the stop: exit at the open")
    else if gTgt
        t.mfeP := math.max(pMfe, tgtD)
        f_finish(md, 1, tgt, time, "gap through the target: filled at the target (no improvement)")
    else if stopHit and tgtHit
        t.maeP := math.max(pMae, t.riskPts)
        t.mfeP := math.max(pMfe, fav)
        t.excUnc := true
        f_finish(md, 4, stp, time, "ambiguous: stop and target both reachable on one candle")
    else if stopHit
        t.maeP := math.max(pMae, t.riskPts)
        t.excUnc := t.excUnc or fav > pMfe
        f_finish(md, 2, stp, time, "stop hit")
    else if tgtHit
        t.mfeP := math.max(pMfe, tgtD)
        t.maeP := math.max(pMae, adv)
        t.excUnc := t.excUnc or adv > pMae
        f_finish(md, 1, tgt, time, "target hit")
    else
        t.maeP := math.max(pMae, adv)
        t.mfeP := math.max(pMfe, fav)
    true
f_invalidate(Mdl md, string why) =>
    md.st := 4
    md.why := why
    f_fn(md.slot, 9)
    f_msgK(3, md.slot, "INVALIDATED - " + why)
    true
f_waitB(Day dy, Mdl md) =>
    bool bull = dy.dir > 0
    if f_exceeded(dy)
        f_invalidate(md, "price exceeded the frozen manipulation extreme before the iFVG confirmation")
    else if (bull ? close > md.fT : close < md.fB)
        md.fInv := true
        f_cond(dy, md, dy.O, na)
    true
f_waitC(Day dy, Mdl md) =>
    if f_exceeded(dy)
        f_invalidate(md, "price exceeded the frozen manipulation extreme before a rejection candle")
    else if dy.rejOk
        f_cond(dy, md, dy.rejEntry, md.slot == 3 ? (dy.dir > 0 ? dy.rejLo : dy.rejHi) : na)
    true
f_cReject(Day dy) =>
    if dy.fibOk and not dy.rejOk and bar_index > dy.confBar and mOpen < cutT and not na(dy.O)
        bool bull = dy.dir > 0
        bool inFrame = bull ? low >= dy.mExt : high <= dy.mExt
        bool zone = low <= dy.fibHi and high >= dy.fibLo
        if bull
            bool wick = low < math.min(open, close)
            if inFrame and zone and wick and low <= dy.O and close > dy.O
                dy.rejOk := true
                dy.rejT := time
                dy.rejHi := high
                dy.rejLo := low
                dy.rejBase := math.min(open, close)
                dy.rejEntry := (low + math.min(open, close)) / 2.0
        else
            bool wick = high > math.max(open, close)
            if inFrame and zone and wick and high >= dy.O and close < dy.O
                dy.rejOk := true
                dy.rejT := time
                dy.rejHi := high
                dy.rejLo := low
                dy.rejBase := math.max(open, close)
                dy.rejEntry := (high + math.max(open, close)) / 2.0
    true
f_pivotUpdate(Day dy) =>
    int n = bufH.size()
    int c = n - 1 - inPvR
    if c - inPvL >= 0
        bool bull = dy.dir > 0
        float pv = bull ? bufL.get(c) : bufH.get(c)
        bool ok = bufI.get(c) > dy.confBar
        if ok
            for j = 1 to inPvL
                ok := ok and (bull ? bufL.get(c - j) > pv : bufH.get(c - j) < pv)
            for j = 1 to inPvR
                ok := ok and (bull ? bufL.get(c + j) > pv : bufH.get(c + j) < pv)
        if ok
            dy.pvP := pv
            dy.pvBar := bufI.get(c)
            dy.pvT := bufT.get(c)
            dy.pvKn := bar_index
            dy.pvDead := false
    true
f_precTrig(Day dy, Mdl md, bool gate) =>
    bool bull = dy.dir > 0
    float rng = high - low
    bool inArea = high >= dy.parLo and low <= dy.parHi
    bool intact = bull ? low >= dy.mExt : high <= dy.mExt
    bool shape = false
    if rng > 0
        float wick = bull ? math.min(open, close) - low : high - math.max(open, close)
        bool dirOk = bull ? (close > dy.O and close > open) : (close < dy.O and close < open)
        bool posOk = bull ? close >= low + 0.5 * rng : close <= low + 0.5 * rng
        shape := dirOk and posOk and wick >= inWick * rng - 0.000000001
    bool rej = inArea and intact and shape
    bool swp = false
    if not na(dy.pvP) and not dy.pvDead and bar_index > dy.pvKn
        bool exc = bull ? low <= dy.pvP - tk : high >= dy.pvP + tk
        swp := exc and inArea and intact and shape and (bull ? close > dy.pvP : close < dy.pvP)
        if exc
            dy.pvDead := true
    bool useR = inPTrig == "Rejection" or inPTrig == "Either"
    bool useS = inPTrig == "Secondary sweep" or inPTrig == "Either"
    bool fire = gate and ((useR and rej) or (useS and swp))
    if fire
        bool both = useR and useS and rej and swp
        md.trigNm := both ? "Sweep + Rejection" : ((useS and swp) ? "Secondary sweep" : "Rejection")
        md.tT := time
        md.tHi := high
        md.tLo := low
        md.tBase := bull ? math.min(open, close) : math.max(open, close)
        md.sLvl := (useS and swp) ? dy.pvP : na
        md.sT := dy.pvT
    fire
f_rejectP(Mdl md, int col, string why) =>
    md.st := 4
    md.why := why
    f_fn(4, col)
    f_msgK(3, 4, "REJECTED - " + why)
    true
f_planP(Day dy, Mdl md) =>
    bool bull = dy.dir > 0
    float entry = math.round_to_mintick(bull ? (md.tLo + md.tBase) / 2.0 : (md.tHi + md.tBase) / 2.0)
    float stop = bull ? math.round_to_mintick(md.tLo - inPBuf * tk) : math.round_to_mintick(md.tHi + inPBuf * tk)
    float dist = bull ? entry - stop : stop - entry
    int riskT = int(math.round(dist / tk))
    int qty = inQty
    if inSizeMode == "Fixed cash risk" and riskT >= 1
        qty := int(math.floor(inCashRisk / (riskT * tk * syminfo.pointvalue)))
    bool armed = false
    if dist <= 0 or riskT < 1
        f_rejectP(md, 8, "stop distance is zero or invalid after rounding")
    else if riskT > inPStopCap
        f_rejectP(md, 8, "stop-cap rejection: " + str.tostring(riskT) + " ticks > " + str.tostring(inPStopCap) + " (stop not compressed)")
    else if qty < 1
        f_rejectP(md, 14, "sizing rejection: one contract risks more than the cash budget")
    else
        float tgt = na
        if inPTgt == "Fixed R"
            tgt := bull ? entry + inPFixR * dist : entry - inPFixR * dist
        else if bull
            float c1 = not na(dy.orH) and dy.orH > entry + tk and not (dy.poHi > dy.orH) ? dy.orH : na
            float c2 = not na(dy.pdH) and dy.pdH > entry + tk and not (sHi > dy.pdH) ? dy.pdH : na
            tgt := na(c1) ? c2 : (na(c2) ? c1 : math.min(c1, c2))
        else
            float c1 = not na(dy.orL) and dy.orL < entry - tk and not (dy.poLo < dy.orL) ? dy.orL : na
            float c2 = not na(dy.pdL) and dy.pdL < entry - tk and not (sLo < dy.pdL) ? dy.pdL : na
            tgt := na(c1) ? c2 : (na(c2) ? c1 : math.max(c1, c2))
        if na(tgt)
            f_rejectP(md, 11, "No eligible liquidity target")
        else
            float tgtR = math.round_to_mintick(tgt)
            float pR = math.abs(tgtR - entry) / dist
            if pR < inMinR - 0.000000001
                f_rejectP(md, 13, "minimum-R rejection: planned " + str.tostring(pR, "#.00") + "R < " + str.tostring(inMinR, "#.0") + "R")
            else
                md.lim := entry
                md.stp := stop
                md.tgt := tgtR
                md.qty := qty
                md.tgtType := inPTgt == "Fixed R" ? "fixed-R" : "liquidity"
                md.plannedR := pR
                md.st := 2
                md.armBar := bar_index
                md.armT := time_close
                f_fn(4, 5)
                armed := true
                f_msgK(1, 4, "PRECISION ORDER ARMED (simulated limit, NOT a fill) " + md.trigNm + " " + (bull ? "LONG" : "SHORT") + " limit " + str.tostring(entry, format.mintick) + " stop " + str.tostring(stop, format.mintick) + " (" + str.tostring(riskT) + " ticks) target " + str.tostring(tgtR, format.mintick) + " (" + md.tgtType + ", planned " + str.tostring(pR, "#.0") + "R)")
    armed
f_waitP(Day dy, Mdl md) =>
    bool bull = dy.dir > 0
    if f_exceeded(dy)
        f_invalidate(md, "price exceeded the frozen manipulation extreme before a precision trigger")
    else
        bool gate = true
        if inPIfvg and not md.fInv
            gate := false
            if bull ? close > md.fT : close < md.fB
                md.fInv := true
        if f_precTrig(dy, md, gate)
            f_fn(4, 4)
            f_planP(dy, md)
        f_pivotUpdate(dy)
    true
f_fillStepP(Day dy, Mdl md) =>
    bool bull = dy.dir > 0
    float thrP = inStrict ? tk : 0.0
    if bar_index > md.armBar + inPExp
        md.st := 4
        md.why := "expired: not filled within " + str.tostring(inPExp) + " subsequent candles"
        f_fn(4, 7)
        f_msgK(3, 4, "CANCELLED - " + md.why)
    else if (bull ? open <= md.stp : open >= md.stp)
        f_invalidate(md, "local stop level breached before the fill (the candle opened beyond the stop)")
    else if (bull ? open < dy.mExt : open > dy.mExt)
        f_invalidate(md, "shared setup invalidated: the candle opened beyond the frozen manipulation extreme")
    else
        bool touchE = bull ? low <= md.lim - thrP : high >= md.lim + thrP
        bool tgtFirst = not touchE and (bull ? high >= md.tgt : low <= md.tgt)
        if tgtFirst
            md.st := 4
            md.why := "cancelled: the target was reached before the entry"
            f_fn(4, 7)
            f_msgK(3, 4, "CANCELLED - " + md.why)
        else
            f_fillTry(dy, md)
    true
f_modelStep(Day dy, Mdl md) =>
    int m = mOpen
    if md.st == 3
        if m >= exitT
            f_finish(md, 3, open, time, "time exit at the " + f_hm(time) + " candle open")
        else
            f_posStep(dy, md)
    else if md.st == 1 or md.st == 2
        if m >= cutT
            if md.st == 2
                f_fn(md.slot, 7)
                md.why := "unfilled: cancelled at the entry cutoff"
                f_msgK(3, md.slot, "CANCELLED - " + md.why)
            else
                f_fn(md.slot, 12)
                md.why := "entry conditions not met by the cutoff"
            md.st := 4
        else if md.st == 2
            if bar_index > md.armBar
                if md.slot == 4
                    f_fillStepP(dy, md)
                else
                    f_fillStep(dy, md)
        else
            if md.slot == 1
                f_waitB(dy, md)
            else if md.slot == 4
                f_waitP(dy, md)
            else
                f_waitC(dy, md)
    true
f_confirm(Day dy) =>
    bool bull = dy.dir > 0
    dy.confT := time_close
    dy.confBar := bar_index
    dy.mPts := math.abs(dy.mExt - dy.O)
    dy.mAtr := na(dy.atrPre) ? na : dy.mPts / dy.atrPre
    bool tooBig = inMaxOn and (inThr == "ATR" ? (not na(dy.mAtr) and dy.mAtr > inMaxAtr) : dy.mPts > inMaxPts)
    bool swOk = true
    if inSweep
        int i0 = bull ? 2 : 0
        int bestI = -1
        float bestP = na
        for i = i0 to i0 + 1
            float lv = dy.lvlP.get(i)
            if not na(lv) and not na(dy.lvlT.get(i)) and (bull ? close > lv : close < lv)
                if bestI < 0 or (bull ? lv < bestP : lv > bestP)
                    bestI := i
                    bestP := lv
        if bestI < 0
            swOk := false
        else
            dy.swpLvl := bestP
            dy.swpT := dy.lvlT.get(bestI)
            dy.swpNm := bestI == 0 ? "opening-range high" : (bestI == 1 ? "previous-session high" : (bestI == 2 ? "opening-range low" : "previous-session low"))
    if tooBig
        dy.st := 8
        dy.why := "manipulation larger than the maximum-size filter (" + str.tostring(dy.mPts, "#.00") + " pts)"
        f_fnA(9)
    else if not swOk
        dy.st := 8
        dy.why := "no qualifying post-10am liquidity sweep with a close back through the level"
        f_fnA(9)
    else
        dy.st := 3
        f_fnA(3)
        if inSweep
            f_fnA(2)
        f_msgK(0, selSlot, "SETUP READY: reversal confirmed " + (bull ? "LONG" : "SHORT") + " - 10am open " + str.tostring(dy.O, format.mintick) + ", frozen manipulation extreme " + str.tostring(dy.mExt, format.mintick))
        if slotOn.get(0)
            f_cond(dy, dy.ms.get(0), dy.O, na)
        if slotOn.get(1)
            Mdl mb = dy.ms.get(1)
            float gT = bull ? dy.fbeT : dy.fbuT
            float gB = bull ? dy.fbeB : dy.fbuB
            if na(gT)
                mb.st := 4
                mb.why := "no eligible FVG formed between the 10am open and the reversal confirmation"
                f_fn(1, 12)
            else
                mb.fT := gT
                mb.fB := gB
                mb.fCT := bull ? dy.fbeC : dy.fbuC
                bool inv = bull ? (not na(dy.fbeMax) and dy.fbeMax > gT) : (not na(dy.fbuMin) and dy.fbuMin < gB)
                mb.fInv := inv
                mb.st := 1
                if inv
                    f_cond(dy, mb, dy.O, na)
        float l618 = f_fibLvl(dy, 0.618)
        float l79 = f_fibLvl(dy, 0.79)
        dy.fibLo := math.min(l618, l79)
        dy.fibHi := math.max(l618, l79)
        if slotOn.get(2) or slotOn.get(3)
            dy.fibOk := dy.O >= dy.fibLo and dy.O <= dy.fibHi
            for k = 2 to 3
                if slotOn.get(k)
                    Mdl mc = dy.ms.get(k)
                    if dy.fibOk
                        mc.st := 1
                    else
                        mc.st := 4
                        mc.why := "skipped: the 10am open is outside the 61.8-79% retracement zone"
                        f_fn(k, 12)
        if slotOn.get(4)
            Mdl mp = dy.ms.get(4)
            dy.bdLo := dy.O - inBand * tk
            dy.bdHi := dy.O + inBand * tk
            float aLo = dy.bdLo
            float aHi = dy.bdHi
            bool pOk = true
            string pWhy = ""
            if inPFib
                aLo := math.max(dy.bdLo, dy.fibLo)
                aHi := math.min(dy.bdHi, dy.fibHi)
                if aLo > aHi
                    pOk := false
                    pWhy := "skipped: the precision band does not overlap the 61.8-79% Fib zone"
            dy.parLo := aLo
            dy.parHi := aHi
            if pOk and inPIfvg
                float gT2 = bull ? dy.fbeT : dy.fbuT
                float gB2 = bull ? dy.fbeB : dy.fbuB
                if na(gT2)
                    pOk := false
                    pWhy := "skipped: no eligible FVG for the iFVG filter"
                else
                    mp.fT := gT2
                    mp.fB := gB2
                    mp.fInv := bull ? (not na(dy.fbeMax) and dy.fbeMax > gT2) : (not na(dy.fbuMin) and dy.fbuMin < gB2)
            if pOk
                mp.st := 1
            else
                mp.st := 4
                mp.why := pWhy
                f_fn(4, 12)
    true
f_dayStep(Day dy) =>
    int m = mOpen
    if m >= 570 and m < 960
        dy.rthH := na(dy.rthH) ? high : math.max(dy.rthH, high)
        dy.rthL := na(dy.rthL) ? low : math.min(dy.rthL, low)
        dy.rthN += 1
    if m >= orS and m < orE
        dy.orH := na(dy.orH) ? high : math.max(dy.orH, high)
        dy.orL := na(dy.orL) ? low : math.min(dy.orL, low)
        dy.orN += 1
    if m < openT
        dy.atrPre := atrV
        if m >= orS
            if not na(dy.pdH) and high >= dy.pdH + inSweepTk * tk
                dy.preSweep := true
            if not na(dy.pdL) and low <= dy.pdL - inSweepTk * tk
                dy.preSweep := true
    if m >= openT and m < exitT
        dy.bars10 += 1
    if dy.st == 0 and m >= openT
        if m != openT
            dy.st := 9
            dy.status := 2
            dy.why := "missing 10am candle (first candle at/after the open is " + f_hm(time) + ")"
        else if inThr == "ATR" and na(dy.atrPre)
            dy.st := 9
            dy.status := 3
            dy.why := "ATR history unavailable before the open"
        else
            dy.O := open
            dy.oT := time
            if dy.orN < orE - orS
                dy.orH := na
                dy.orL := na
            dy.thr := inThr == "ATR" ? inAtrM * dy.atrPre : inFixed
            dy.lvlP.set(0, inLvOR ? dy.orH : na)
            dy.lvlP.set(1, inLvPD ? dy.pdH : na)
            dy.lvlP.set(2, inLvOR ? dy.orL : na)
            dy.lvlP.set(3, inLvPD ? dy.pdL : na)
            bool anyLvl = false
            for i = 0 to 3
                if not na(dy.lvlP.get(i))
                    anyLvl := true
            if inSweep and not anyLvl
                dy.st := 9
                dy.status := 4
                dy.why := "no eligible sweep level was available (opening range / previous session incomplete)"
            else
                dy.st := 1
                f_fnA(0)
    if not na(dy.O) and m >= openT
        dy.poHi := na(dy.poHi) ? high : math.max(dy.poHi, high)
        dy.poLo := na(dy.poLo) ? low : math.min(dy.poLo, low)
    if (dy.st == 1 or dy.st == 2) and m >= openT
        for i = 0 to 3
            float lv = dy.lvlP.get(i)
            if not na(lv) and na(dy.lvlT.get(i))
                if (i < 2 ? high >= lv + inSweepTk * tk : low <= lv - inSweepTk * tk)
                    dy.lvlT.set(i, time_close)
        if not na(dy.fbuB)
            dy.fbuMin := na(dy.fbuMin) ? close : math.min(dy.fbuMin, close)
        if not na(dy.fbeT)
            dy.fbeMax := na(dy.fbeMax) ? close : math.max(dy.fbeMax, close)
        if not na(h2) and not na(l2) and t2 >= dy.oT and time - t2 == 2 * chartMs
            if low > h2
                dy.fbuT := low
                dy.fbuB := h2
                dy.fbuC := time_close
                dy.fbuMin := na
            if high < l2
                dy.fbeT := l2
                dy.fbeB := high
                dy.fbeC := time_close
                dy.fbeMax := na
    if dy.st == 1
        if m >= manE
            dy.st := 7
            dy.why := "no qualifying manipulation before " + f_hm(f_ts(dy.key, manE))
        else
            float up = high - dy.O
            float dn = dy.O - low
            bool qu = up >= dy.thr
            bool qd = dn >= dy.thr
            if qu or qd
                if qu and qd and inAmbInit == "Skip day"
                    dy.st := 7
                    dy.why := "ambiguous first candle: crossed both thresholds, skipped"
                    cv.set(6, cv.get(6) + 1)
                else
                    dy.dir := qu and qd ? (up >= dn ? -1 : 1) : (qu ? -1 : 1)
                    dy.qBar := bar_index
                    dy.qT := time_close
                    dy.mExt := dy.dir < 0 ? high : low
                    dy.mExtT := time
                    dy.oppX := dy.dir < 0 ? low : high
                    dy.cnt := 0
                    dy.st := 2
                    f_fnA(1)
    if dy.st == 2 and bar_index > dy.qBar
        if m >= cutT
            dy.st := 7
            dy.why := "no reversal confirmation before the entry cutoff"
        else
            if dy.dir < 0
                if high >= dy.mExt
                    dy.mExt := high
                    dy.mExtT := time
                    dy.oppX := low
                else
                    dy.oppX := math.min(dy.oppX, low)
                dy.cnt := close < dy.O ? dy.cnt + 1 : 0
            else
                if low <= dy.mExt
                    dy.mExt := low
                    dy.mExtT := time
                    dy.oppX := high
                else
                    dy.oppX := math.max(dy.oppX, high)
                dy.cnt := close > dy.O ? dy.cnt + 1 : 0
            if dy.cnt >= inRevN
                f_confirm(dy)
    if dy.st == 3
        if bar_index > dy.confBar
            f_cReject(dy)
            for k = 0 to NS - 1
                if slotOn.get(k)
                    f_modelStep(dy, dy.ms.get(k))
        bool allDone = true
        for k = 0 to NS - 1
            if slotOn.get(k) and dy.ms.get(k).st != 4
                allDone := false
        if allDone
            dy.st := 6
    true
f_newDay(int key, int dow, Day prev) =>
    Day d = Day.new(key = key, active = dow >= dayofweek.monday and dow <= dayofweek.friday, lvlP = array.new_float(4, na), lvlT = array.new_int(4, na), ms = array.from(Mdl.new(slot = 0), Mdl.new(slot = 1), Mdl.new(slot = 2), Mdl.new(slot = 3), Mdl.new(slot = 4)))
    if not na(prev)
        if prev.rthN >= 390
            d.pdH := prev.rthH
            d.pdL := prev.rthL
    d
f_finalize(Day dy, float lastC, int lastT) =>
    if dy.active
        for k = 0 to NS - 1
            Mdl md = dy.ms.get(k)
            if md.st == 3
                f_finish(md, 3, lastC, lastT, "forced close at the last candle: no candle at/after the time exit (data missing)")
        if dy.st == 0
            dy.status := 2
            dy.why := "no candle at/after the 10am open"
        if dy.status == 0 and dy.bars10 < exitT - openT
            dy.status := 1
        cv.set(0, cv.get(0) + 1)
        cv.set(dy.status + 1, cv.get(dy.status + 1) + 1)
        if inDebug
            log.info("H Ticks C | " + f_dt(dy.key) + " coverage " + str.tostring(dy.status) + " | state " + str.tostring(dy.st) + " | " + dy.why + (na(dy.dir) or dy.dir == 0 ? "" : " | " + (dy.dir > 0 ? "LONG" : "SHORT") + " manip " + str.tostring(dy.mPts, "#.00") + " pts"))
    true
if supported and cfgOk and barstate.isconfirmed
    aMsgs.clear()
    for q = 0 to 3
        evK.set(q, 0)
    bufH.push(high)
    bufL.push(low)
    bufI.push(bar_index)
    bufT.push(time)
    while bufH.size() > 12
        bufH.shift()
        bufL.shift()
        bufI.shift()
        bufT.shift()
    if mOpen >= 960 and (na(pM) or pM < 960)
        sHi := high
        sLo := low
    else
        sHi := na(sHi) ? high : math.max(sHi, high)
        sLo := na(sLo) ? low : math.min(sLo, low)
    pM := mOpen
    if na(cur) or cur.key != dkey
        if not na(cur)
            f_finalize(cur, pClose, pCloseT)
            if cur.active
                lastAct := cur
        cur := f_newDay(dkey, dowN, lastAct)
        days.push(cur)
        while days.size() > 80
            days.shift()
        if cur.active
            if na(firstKey)
                firstKey := dkey
            lastKey := dkey
    if cur.active
        f_dayStep(cur)
    pClose := close
    pCloseT := time_close
    if barstate.isrealtime and aMsgs.size() > 0
        alert(array.join(aMsgs, "\n"), alert.freq_once_per_bar_close)
bool evNow = supported and cfgOk and barstate.isrealtime and barstate.isconfirmed
alertcondition(evNow and evK.get(0) > 0, "Setup ready", "H Ticks C: setup ready (reversal confirmed) on {{ticker}}")
alertcondition(evNow and evK.get(1) > 0, "Order armed", "H Ticks C: order ARMED (simulated limit, not a fill) on {{ticker}}")
alertcondition(evNow and evK.get(2) > 0, "Simulated fill", "H Ticks C: SIMULATED FILL on {{ticker}}")
alertcondition(evNow and evK.get(3) > 0, "Invalidation / cancellation", "H Ticks C: setup invalidated or order cancelled on {{ticker}}")
f_fmt(float v, string f) =>
    na(v) ? "-" : str.tostring(v, f)
f_perf(int slot) =>
    array<float> r = array.new_float(32, 0.0)
    array<float> maeP = array.new_float(0)
    array<float> maeR = array.new_float(0)
    array<float> maeWP = array.new_float(0)
    array<float> maeWR = array.new_float(0)
    int cntT = 0
    int wins = 0
    int losses = 0
    int tex = 0
    int amb = 0
    int pos = 0
    int neg = 0
    int unc = 0
    int openN = 0
    int exAmb = 0
    int nPlan = 0
    float gw = 0.0
    float gl = 0.0
    float sumNet = 0.0
    float sumGross = 0.0
    float sumUsd = 0.0
    float sumStopT = 0.0
    float sumPlan = 0.0
    float sumRisk = 0.0
    float eq = 0.0
    float pk = 0.0
    float dd = 0.0
    float eqU = 0.0
    float pkU = 0.0
    float ddU = 0.0
    int consec = 0
    int maxC = 0
    float sMae = 0.0
    float sMaeR = 0.0
    float sMfe = 0.0
    float sMfeR = 0.0
    int winLow = 0
    int nW = 0
    int n = trades.size()
    if n > 0
        for i = 0 to n - 1
            Trade t = trades.get(i)
            if t.slot == slot
                if t.isOpen
                    openN += 1
                else if t.outcome == 4 and inAmbMode == "Exclude from stats"
                    exAmb += 1
                else
                    cntT += 1
                    float nr = na(t.netR) ? 0.0 : t.netR
                    float gr = na(t.grossR) ? 0.0 : t.grossR
                    float rk = t.riskPts > 0 ? t.riskPts : 1.0
                    if t.outcome == 1
                        wins += 1
                    else if t.outcome == 3
                        tex += 1
                    else
                        losses += 1
                    if t.outcome == 4
                        amb += 1
                    if t.excUnc or t.entryAmb
                        unc += 1
                    sumNet += nr
                    sumGross += gr
                    sumUsd += t.netUsd
                    sumStopT += t.riskPts / tk
                    sumRisk += t.riskUsd
                    if not na(t.plannedR)
                        sumPlan += t.plannedR
                        nPlan += 1
                    if nr > 0
                        pos += 1
                        gw += nr
                        maeWP.push(t.maeP)
                        maeWR.push(t.maeP / rk)
                        nW += 1
                        if t.maeP / rk <= 0.25
                            winLow += 1
                    else if nr < 0
                        gl += -nr
                        neg += 1
                    if nr < 0
                        consec += 1
                        maxC := math.max(maxC, consec)
                    else
                        consec := 0
                    eq += nr
                    pk := math.max(pk, eq)
                    dd := math.max(dd, pk - eq)
                    eqU += t.netUsd
                    pkU := math.max(pkU, eqU)
                    ddU := math.max(ddU, pkU - eqU)
                    sMae += t.maeP
                    sMaeR += t.maeP / rk
                    sMfe += t.mfeP
                    sMfeR += t.mfeP / rk
                    maeP.push(t.maeP)
                    maeR.push(t.maeP / rk)
    r.set(0, cntT)
    r.set(1, wins)
    r.set(2, losses)
    r.set(3, tex)
    r.set(4, amb)
    r.set(5, cntT > 0 ? 100.0 * pos / cntT : na)
    r.set(6, cntT > 0 ? sumNet / cntT : na)
    r.set(7, gl > 0 ? gw / gl : na)
    r.set(8, pos > 0 ? gw / pos : na)
    r.set(9, neg > 0 ? -gl / neg : na)
    r.set(10, maxC)
    r.set(11, dd)
    r.set(12, ddU)
    r.set(13, sumNet)
    r.set(14, cntT > 0 ? sMae / cntT : na)
    r.set(15, cntT > 0 ? sMaeR / cntT : na)
    r.set(16, maeP.size() > 0 ? maeP.median() : na)
    r.set(17, maeR.size() > 0 ? maeR.median() : na)
    r.set(18, maeWP.size() > 0 ? maeWP.median() : na)
    r.set(19, maeWR.size() > 0 ? maeWR.median() : na)
    r.set(20, nW > 0 ? 100.0 * winLow / nW : na)
    r.set(21, cntT > 0 ? sMfe / cntT : na)
    r.set(22, cntT > 0 ? sMfeR / cntT : na)
    r.set(23, unc)
    r.set(24, openN)
    r.set(25, sumUsd)
    r.set(26, exAmb)
    r.set(27, cntT > 0 ? sumGross / cntT : na)
    r.set(28, cntT > 0 ? sumStopT / cntT : na)
    r.set(29, nPlan > 0 ? sumPlan / nPlan : na)
    r.set(30, cntT > 0 ? sumRisk / cntT : na)
    r
f_weekdays(int k1, int k2) =>
    int t0 = f_ts(k1, 720)
    int t1 = f_ts(k2, 720)
    int c = 0
    int t = t0
    while t <= t1
        int dw = dayofweek(t, TZ)
        if dw >= dayofweek.monday and dw <= dayofweek.friday
            c += 1
        t += 86400000
    c
f_clearDraw() =>
    while dLines.size() > 0
        line.delete(dLines.pop())
    while dBoxes.size() > 0
        box.delete(dBoxes.pop())
    while dLabels.size() > 0
        label.delete(dLabels.pop())
    true
f_ln(int x1, float y1, int x2, float y2, color c, string sty, int w) =>
    dLines.push(line.new(x1 = x1, y1 = y1, x2 = x2, y2 = y2, xloc = xloc.bar_time, color = c, style = sty, width = w))
    true
f_bx(int x1, float top, int x2, float bot, color bg, color bc) =>
    dBoxes.push(box.new(left = x1, top = top, right = x2, bottom = bot, xloc = xloc.bar_time, border_color = bc, border_width = 1, bgcolor = bg))
    true
f_lb(int x, float y, string txt, color tc, string sty, string tip) =>
    dLabels.push(label.new(x = x, y = y, text = txt, xloc = xloc.bar_time, style = sty, size = size.tiny, textcolor = tc, color = color.new(color.white, 15), tooltip = tip))
    true
f_drawPlan(Day dy, int slot) =>
    Mdl ms = dy.ms.get(slot)
    if not na(ms.lim)
        string pre = slot == 4 ? "PREC" : "STD"
        bool done = ms.st == 4 and not na(ms.tr)
        bool canc = ms.st == 4 and na(ms.tr)
        bool pend = ms.st == 2
        string stt = pend ? "PENDING" : (ms.st == 3 ? "FILLED" : (done ? "DONE" : "CANCELLED"))
        string sty = pend ? line.style_dashed : (canc ? line.style_dotted : line.style_solid)
        color cE = canc ? color.gray : color.blue
        color cS = canc ? color.gray : color.red
        color cT = canc ? color.gray : color.green
        int xEnd = f_ts(dy.key, exitT)
        int xCut = f_ts(dy.key, cutT)
        int xPre = ms.armT + inPExp * chartMs
        int xe = xCut
        if done
            xe := ms.tr.exitT
        else if ms.st == 3
            xe := xEnd
        else if slot == 4
            xe := xPre
        float distP = math.abs(ms.lim - ms.stp)
        int distT = int(math.round(distP / tk))
        f_ln(ms.armT, ms.lim, xe, ms.lim, cE, sty, 1)
        f_ln(ms.armT, ms.stp, xe, ms.stp, cS, sty, 1)
        f_ln(ms.armT, ms.tgt, xe, ms.tgt, cT, sty, 1)
        f_lb(xe, ms.lim, pre + " ENTRY " + str.tostring(ms.lim, format.mintick) + " [" + stt + "]", cE, label.style_label_left, ms.why == "" ? stt : stt + ": " + ms.why)
        f_lb(xe, ms.stp, pre + " SL " + str.tostring(ms.stp, format.mintick) + " | " + str.tostring(distT) + " ticks / " + str.tostring(distP, "#.00") + " pts", cS, label.style_label_left, "planned stop distance")
        f_lb(xe, ms.tgt, pre + " TP " + str.tostring(ms.tgt, format.mintick) + " | plan " + str.tostring(ms.plannedR, "#.0") + "R " + ms.tgtType, cT, label.style_label_left, "planned reward; target type: " + ms.tgtType)
        if done
            f_lb(ms.tr.exitT, ms.tr.exitPx, pre + " " + (ms.tr.outcome == 1 ? "target" : (ms.tr.outcome == 2 ? "stop" : (ms.tr.outcome == 3 ? "time exit" : "ambiguous"))) + " " + str.tostring(ms.tr.netR, "#.00") + "R", color.black, label.style_label_down, ms.tr.note)
    true
f_drawDay(Day dy) =>
    int xEnd = f_ts(dy.key, exitT)
    int xCut = f_ts(dy.key, cutT)
    if not na(dy.O)
        f_ln(dy.oT, dy.O, xEnd, dy.O, color.blue, line.style_dashed, 2)
        f_lb(dy.oT, dy.O, "10am open " + str.tostring(dy.O, format.mintick), color.blue, label.style_label_right, f_dt(dy.key) + ": exact open of the 10:00 candle, usable once that candle closed")
        if not na(dy.orH)
            f_bx(f_ts(dy.key, orS), dy.orH, dy.oT, dy.orL, color.new(color.gray, 88), color.new(color.gray, 40))
    if dy.st >= 2 and not na(dy.mExt) and dy.st != 7
        f_ln(dy.mExtT, dy.mExt, xCut, dy.mExt, color.orange, line.style_solid, 2)
        f_lb(dy.mExtT, dy.mExt, "manip " + (dy.dir > 0 ? "low " : "high ") + str.tostring(dy.mExt, format.mintick), color.orange, dy.dir > 0 ? label.style_label_up : label.style_label_down, "frozen at reversal confirmation; Standard stops sit beyond it")
    if not na(dy.swpLvl)
        f_ln(f_ts(dy.key, orS), dy.swpLvl, dy.confT, dy.swpLvl, color.purple, line.style_dotted, 2)
        f_lb(dy.swpT, dy.swpLvl, "swept " + dy.swpNm, color.purple, label.style_label_left, "first exceeded " + f_hms(dy.swpT) + " NY")
    if inVisFvg and slotOn.get(1)
        Mdl mb = dy.ms.get(1)
        if not na(mb.fT)
            f_bx(mb.fCT - 3 * chartMs, mb.fT, xCut, mb.fB, color.new(color.teal, 85), color.new(color.teal, 30))
            f_lb(mb.fCT, mb.fT, mb.fInv ? "FVG (inverted)" : "FVG (frozen)", color.teal, label.style_label_down, "model B frozen gap")
    bool fibShow = not na(dy.fibLo) and not na(dy.oppX) and ((dy.fibOk and (slotOn.get(2) or slotOn.get(3))) or (slotOn.get(4) and inPFib))
    if inVisFib and fibShow
        f_bx(dy.mExtT, dy.fibHi, xCut, dy.fibLo, color.new(color.fuchsia, 88), color.new(color.fuchsia, 40))
        array<float> rs = array.from(0.5, 0.618, 0.705, 0.79)
        for i = 0 to 3
            float lv = f_fibLvl(dy, rs.get(i))
            f_ln(dy.mExtT, lv, xCut, lv, color.new(color.fuchsia, 30), line.style_dotted, 1)
            f_lb(xCut, lv, str.tostring(rs.get(i), "#.000"), color.fuchsia, label.style_label_left, "frozen Fib level (our experimental anchoring)")
    if inVisFib and dy.rejOk
        f_bx(dy.rejT, dy.rejHi, dy.rejT + 3 * chartMs, dy.rejBase, color.new(color.red, 80), color.new(color.red, 20))
        f_lb(dy.rejT, dy.rejEntry, "rejection wick, limit " + str.tostring(math.round_to_mintick(dy.rejEntry), format.mintick), color.red, label.style_label_right, "frozen rejection candle (model C); precision entry = wick midpoint")
    if inVisBand and slotOn.get(4) and not na(dy.bdLo) and (selSlot == 4 or altDraw == 4)
        f_bx(dy.oT, dy.bdHi, xCut, dy.bdLo, color.new(color.aqua, 90), color.new(color.aqua, 40))
    if inVisPrec and slotOn.get(4) and (selSlot == 4 or altDraw == 4)
        Mdl mp = dy.ms.get(4)
        if not na(mp.tT)
            float wTop = dy.dir > 0 ? mp.tBase : mp.tHi
            float wBot = dy.dir > 0 ? mp.tLo : mp.tBase
            f_bx(mp.tT, wTop, mp.tT + 2 * chartMs, wBot, color.new(color.red, 75), color.new(color.red, 10))
            f_lb(mp.tT, dy.dir > 0 ? mp.tLo : mp.tHi, "PREC trigger: " + mp.trigNm, color.red, dy.dir > 0 ? label.style_label_up : label.style_label_down, "frozen only after this candle closed; the stop sits beyond its extreme")
            if not na(mp.sLvl)
                f_ln(mp.sT, mp.sLvl, mp.tT + 2 * chartMs, mp.sLvl, color.maroon, line.style_dotted, 2)
                f_lb(mp.sT, mp.sLvl, "swept local " + (dy.dir > 0 ? "low" : "high") + " " + str.tostring(mp.sLvl, format.mintick), color.maroon, label.style_label_right, "pivot known before the sweep candle began")
    if inVisPlan
        if slotOn.get(selSlot)
            f_drawPlan(dy, selSlot)
        if altDraw >= 0 and altDraw != selSlot
            if slotOn.get(altDraw)
                f_drawPlan(dy, altDraw)
    true
var table tbInfo = table.new(position.top_left, 1, 17, bgcolor = color.new(color.white, 8), border_width = 1, border_color = color.gray)
var table tbFun = table.new(position.top_right, 6, 17, bgcolor = color.new(color.white, 8), border_width = 1, border_color = color.gray)
var table tbPerf = table.new(position.bottom_right, 6, 29, bgcolor = color.new(color.white, 8), border_width = 1, border_color = color.gray)
var table tbLed = table.new(position.bottom_left, 13, 13, bgcolor = color.new(color.white, 8), border_width = 1, border_color = color.gray)
f_cell(table t, int c, int r, string txt, color tcol, color bg) =>
    table.cell(t, c, r, txt, text_color = tcol, text_size = size.tiny, text_halign = text.align_left, bgcolor = bg)
    true
f_drawTables() =>
    color blk = color.black
    color bgH = color.new(color.silver, 30)
    color bgN = na
    int maxN = 0
    for k = 0 to NS - 1
        if slotOn.get(k)
            int cnt = 0
            if trades.size() > 0
                for i = 0 to trades.size() - 1
                    if trades.get(i).slot == k
                        cnt += 1
            maxN := math.max(maxN, cnt)
    int wk = not na(firstKey) and not na(lastKey) ? f_weekdays(firstKey, lastKey) : 0
    int evald = cv.get(0)
    string rngTxt = not na(firstKey) ? f_dt(firstKey) + " to " + f_dt(lastKey) : "no weekday evaluated yet"
    f_cell(tbInfo, 0, 0, "H Ticks C - 10AM Precision (RESEARCH MODEL - profitability UNPROVEN)", color.white, color.new(color.maroon, 10))
    f_cell(tbInfo, 0, 1, "Our custom rules, not Powell's official rules. Simulation on completed 1m candles; no tick data.", blk, bgN)
    f_cell(tbInfo, 0, 2, "Coverage (loaded history only): " + rngTxt, blk, bgN)
    f_cell(tbInfo, 0, 3, "Finished weekdays: " + str.tostring(evald) + " | complete " + str.tostring(cv.get(1)) + " | partial " + str.tostring(cv.get(2)) + " | no 10am candle " + str.tostring(cv.get(3)) + " | ATR n/a " + str.tostring(cv.get(4)) + " | levels n/a " + str.tostring(cv.get(5)), blk, bgN)
    f_cell(tbInfo, 0, 4, "Weekdays in range with NO bars at all (holiday / missing data): " + str.tostring(math.max(0, wk - evald)) + "  - missing data is NOT counted as 'no setup'", blk, bgN)
    f_cell(tbInfo, 0, 5, "Ambiguous first candles skipped: " + str.tostring(cv.get(6)), blk, bgN)
    string dstate = ""
    if not na(cur)
        string[] nm = array.from("WAITING", "OPEN_CAPTURED", "MANIPULATION_QUALIFIED", "REVERSAL_CONFIRMED", "", "", "COMPLETE", "EXPIRED", "INVALIDATED", "INELIGIBLE")
        dstate := f_dt(cur.key) + ": " + (cur.active ? nm.get(cur.st) : "weekend") + (cur.why == "" ? "" : " - " + cur.why)
    f_cell(tbInfo, 0, 6, "Latest day: " + dstate, blk, bgN)
    f_cell(tbInfo, 0, 7, "Variant: " + inVariant + (inCmpVar ? " (comparing both)" : "") + " | STANDARD: " + inModel + (inModel == "C: Fib overlap + rejection" ? " / stop: " + inCStop : "") + " | target " + inTgt + " | stop cap " + str.tostring(inMaxStop) + " ticks | buffer " + str.tostring(inBuf), blk, bgN)
    f_cell(tbInfo, 0, 8, "Costs: " + (inComm == 0.0 and inSlip == 0 ? "ZERO (net = gross)" : str.tostring(inComm, "#.00") + " USD/side, " + str.tostring(inSlip) + " tick slippage") + " | contracts " + (inSizeMode == "Fixed cash risk" ? "cash risk " + str.tostring(inCashRisk, "#") + " USD, whole contracts" : str.tostring(inQty) + " fixed") + " | fills: " + (inStrict ? "trade-through required" : "touch assumed"), blk, bgN)
    f_cell(tbInfo, 0, 9, maxN < 100 ? "SAMPLE TOO SMALL: " + str.tostring(maxN) + " trades in the largest column. About 16 days cannot establish an edge." : "Sample: " + str.tostring(maxN) + " trades in the largest column (still not proof).", maxN < 100 ? color.red : blk, bgN)
    f_cell(tbInfo, 0, 10, "Limits: OHLC order within a candle is unknowable (ambiguous trades flagged); a touched limit is an assumption, not guaranteed execution.", blk, bgN)
    f_cell(tbInfo, 0, 11, "Asia/London levels are not implemented. One filled trade per model per day (structural).", blk, bgN)
    f_cell(tbInfo, 0, 12, "Drawdown shown is CLOSED-trade equity only. No guarantee of any outcome.", blk, bgN)
    f_cell(tbInfo, 0, 14, "PRECISION: trigger " + inPTrig + (inPFib ? " + Fib overlap" : "") + (inPIfvg ? " + iFVG" : "") + " | band +/-" + str.tostring(inBand, "#.#") + " ticks | wick >= " + str.tostring(inWick * 100, "#") + "% | stop cap " + str.tostring(inPStopCap) + " ticks | buffer " + str.tostring(inPBuf) + " | min " + str.tostring(inMinR, "#.0") + "R | expiry " + str.tostring(inPExp) + " candles | target " + (inPTgt == "Fixed R" ? "fixed " + str.tostring(inPFixR, "#.0") + "R" : "nearest unswept liquidity"), blk, bgN)
    f_cell(tbInfo, 0, 15, "Precision retries are NOT implemented (one candidate per day). Defaults are research starting points, not optimised.", blk, bgN)
    f_cell(tbInfo, 0, 16, "A small stop with a large planned R is not evidence of an edge or of low drawdown; count every loss, cost and missed fill.", blk, bgN)
    f_cell(tbInfo, 0, 13, syminfo.root == "NQ" or syminfo.root == "MNQ" ? "Instrument: " + syminfo.ticker : "NOTE: tuned for NQ/MNQ; this symbol is " + syminfo.ticker, syminfo.root == "NQ" or syminfo.root == "MNQ" ? blk : color.red, bgN)
    if inFunnel
        string[] rows = array.from("Eligible days", "Qualified manipulations", "Sweep-qualified" + (inSweep ? "" : " (filter off)"), "Confirmed reversals (eligible setups)", "Entry conditions met / precision triggers", "Orders armed", "Filled trades", "Unfilled / expired / cancelled", "Stop-cap rejections", "Invalidated", "Ambiguous trades", "No-target rejections", "Skipped / conditions unmet", "Minimum-R rejections", "Sizing rejections (<1 contract)")
        f_cell(tbFun, 0, 0, "FUNNEL (independent shadow sims)", blk, bgH)
        for k = 0 to NS - 1
            f_cell(tbFun, k + 1, 0, slotNm.get(k), blk, bgH)
        for r = 0 to NF - 1
            f_cell(tbFun, 0, r + 1, rows.get(r), blk, bgN)
            for k = 0 to NS - 1
                f_cell(tbFun, k + 1, r + 1, slotOn.get(k) ? str.tostring(fnl.get(k * NF + r)) : "off", blk, bgN)
    else
        table.clear(tbFun, 0, 0, 5, 16)
    if inPerf
        matrix<float> pf = matrix.new<float>(NS, 32, 0.0)
        for k = 0 to NS - 1
            array<float> pa = f_perf(k)
            for j = 0 to 31
                pf.set(k, j, pa.get(j))
        string[] pr = array.from("Closed trades", "Wins (target)", "Losses (stop + ambiguous)", "Time exits", "Ambiguous", "Net win rate % (filled trades only)", "Expectancy gross R / net R", "Profit factor (net)", "Avg winner (R)", "Avg loser (R)", "Max losing streak", "Max closed DD (R)", "Max closed DD (USD)", "Net R total", "Avg MAE pts / R", "Median MAE pts / R (all)", "Median MAE pts / R (winners)", "Winners with MAE <= 0.25R %", "Avg MFE pts / R", "Uncertain-excursion trades", "Open trades", "Net USD total", "Avg stop (ticks)", "Avg planned R / realised net R", "Avg actual risk USD (whole contracts)")
        f_cell(tbPerf, 0, 0, "PERFORMANCE (closed trades only; MAE/MFE are conservative bounds)", blk, bgH)
        for k = 0 to NS - 1
            f_cell(tbPerf, k + 1, 0, slotNm.get(k), blk, bgH)
        for r = 0 to 24
            f_cell(tbPerf, 0, r + 1, pr.get(r), blk, bgN)
            for k = 0 to NS - 1
                string v = "off"
                if slotOn.get(k)
                    if r == 0
                        v := str.tostring(pf.get(k, 0), "#") + (pf.get(k, 26) > 0 ? " (+" + str.tostring(pf.get(k, 26), "#") + " excl.)" : "")
                    else if r == 5
                        v := f_fmt(pf.get(k, 5), "#.0")
                    else if r == 6
                        v := f_fmt(pf.get(k, 27), "#.00") + " / " + f_fmt(pf.get(k, 6), "#.00")
                    else if r == 7 or r == 8 or r == 9 or r == 11 or r == 13
                        v := f_fmt(pf.get(k, r), "#.00")
                    else if r == 12 or r == 17
                        v := f_fmt(pf.get(k, r == 12 ? 12 : 20), "#")
                    else if r == 14
                        v := f_fmt(pf.get(k, 14), "#.0") + " / " + f_fmt(pf.get(k, 15), "#.00")
                    else if r == 15
                        v := f_fmt(pf.get(k, 16), "#.0") + " / " + f_fmt(pf.get(k, 17), "#.00")
                    else if r == 16
                        v := f_fmt(pf.get(k, 18), "#.0") + " / " + f_fmt(pf.get(k, 19), "#.00")
                    else if r == 18
                        v := f_fmt(pf.get(k, 21), "#.0") + " / " + f_fmt(pf.get(k, 22), "#.00")
                    else if r == 19
                        v := str.tostring(pf.get(k, 23), "#")
                    else if r == 20
                        v := str.tostring(pf.get(k, 24), "#")
                    else if r == 21
                        v := f_fmt(pf.get(k, 25), "#")
                    else if r == 22
                        v := f_fmt(pf.get(k, 28), "#.0")
                    else if r == 23
                        v := f_fmt(pf.get(k, 29), "#.0") + " / " + f_fmt(pf.get(k, 6), "#.00")
                    else if r == 24
                        v := f_fmt(pf.get(k, 30), "#")
                    else
                        v := str.tostring(pf.get(k, r), "#")
                f_cell(tbPerf, k + 1, r + 1, v, blk, bgN)
        f_cell(tbPerf, 0, 26, inComm == 0.0 and inSlip == 0 ? "Costs are ZERO: net = gross. Same cash risk for every trade: use Fixed cash risk sizing." : "Net of the configured costs.", blk, bgN)
        f_cell(tbPerf, 0, 27, "Expired / unfilled orders create no trade and are excluded from every rate. Tiny stops do not mean low drawdown.", blk, bgN)
        f_cell(tbPerf, 0, 28, "Wins/losses by outcome; win rate = filled trades with net R > 0.", blk, bgN)
    else
        table.clear(tbPerf, 0, 0, 5, 28)
    if inLedger
        int perPage = 10
        int sel = inLedModel == "All" ? -1 : (inLedModel == "A" ? 0 : (inLedModel == "B" ? 1 : (inLedModel == "C" ? 2 : (inLedModel == "C-wick" ? 3 : 4))))
        array<int> idx = array.new_int(0)
        if trades.size() > 0
            for i = trades.size() - 1 to 0
                if sel < 0 or trades.get(i).slot == sel
                    idx.push(i)
        int pages = math.max(1, int(math.ceil(idx.size() / 10.0)))
        int pg = math.min(inLedPage, pages)
        string[] hd = array.from("Date", "Dir", "Model", "10am open", "Entry", "Stop", "Target", "Fill", "Exit", "Outcome", "Net R", "Cost $", "Reason")
        for c = 0 to 12
            f_cell(tbLed, c, 0, (c == 0 ? "LEDGER p" + str.tostring(pg) + "/" + str.tostring(pages) + " - " : "") + hd.get(c), blk, bgH)
        for r = 0 to perPage - 1
            int pos = (pg - 1) * perPage + r
            if pos < idx.size()
                Trade t = trades.get(idx.get(pos))
                string oc = t.isOpen ? "OPEN" : (t.outcome == 1 ? "TARGET" : (t.outcome == 2 ? "STOP" : (t.outcome == 3 ? "TIME EXIT" : "AMBIGUOUS")))
                string[] cells = array.from(f_dt(t.dayKey), t.dir > 0 ? "LONG" : "SHORT", slotNm.get(t.slot), str.tostring(t.lvl, format.mintick), str.tostring(t.entryPx, format.mintick), str.tostring(t.stopPx, format.mintick), str.tostring(t.tgtPx, format.mintick), f_hms(t.fillT), t.isOpen ? "-" : f_hms(t.exitT), oc, f_fmt(t.netR, "#.00"), t.isOpen ? "-" : str.tostring(t.costUsd, "#.00"), t.note + (t.entryAmb ? " [entry-candle ambiguity]" : ""))
                for c = 0 to 12
                    f_cell(tbLed, c, r + 1, cells.get(c), blk, bgN)
            else
                for c = 0 to 12
                    f_cell(tbLed, c, r + 1, "", blk, bgN)
        f_cell(tbLed, 0, 11, "Fill/exit times are candle open times (NY). Exits at 11:00 use that candle's open.", blk, bgN)
        f_cell(tbLed, 0, 12, "Net R includes the configured costs; zero costs = gross.", blk, bgN)
    else
        table.clear(tbLed, 0, 0, 12, 12)
    true
bool drawNow = barstate.islastconfirmedhistory or (barstate.isrealtime and barstate.isconfirmed)
if not supported
    if barstate.islast
        table.cell(tbInfo, 0, 0, "H Ticks C needs STANDARD 1-MINUTE candles (not Heikin Ashi, Renko, tick or other types)", text_color = color.white, text_size = size.small, text_halign = text.align_left, bgcolor = color.new(color.red, 10))
else if not cfgOk
    if barstate.islast
        table.cell(tbInfo, 0, 0, "H Ticks C: invalid time settings (check: opening range ends by the open, open < manipulation end <= cutoff < exit)", text_color = color.white, text_size = size.small, text_halign = text.align_left, bgcolor = color.new(color.red, 10))
else if drawNow
    f_clearDraw()
    int nd = days.size()
    int shown = 0
    if nd > 0
        for i = nd - 1 to 0
            Day dd = days.get(i)
            if dd.active and shown < inDraw
                f_drawDay(dd)
                shown += 1
    f_drawTables()
