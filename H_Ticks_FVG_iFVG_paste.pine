//@version=6
indicator("H Ticks — FVG / iFVG", shorttitle = "H Ticks FVG/iFVG", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 500)
const string GRP_GEN = "General"
const string GRP_CH  = "Current-chart layer"
const string GRP_HTF = "Higher-timeframe context layer"
const string GRP_AL  = "Alerts (aggregated alert() calls; mechanical alerts are opt-in)"
bool   inLabels  = input.bool(true,  "Show labels", group = GRP_GEN)
bool   inMid     = input.bool(false, "Show midpoint line (visual only)", group = GRP_GEN)
bool   inMarker  = input.bool(false, "Show inversion marker (chart iFVGs)", group = GRP_GEN)
int    inMinTick = input.int(1, "Minimum DETECTION size (whole ticks)", minval = 1, group = GRP_GEN, tooltip = "Gaps at least this wide are detected and TRACKED. Display filters only decide what is drawn; hidden zones remain tracked and still invert, get tapped or are removed.")
int    inExt     = input.int(0, "Right extension (chart bars, approximate across session gaps)", minval = 0, maxval = 50, group = GRP_GEN)
color  inBull    = input.color(color.rgb(46, 160, 110), "Bullish colour", group = GRP_GEN)
color  inBear    = input.color(color.rgb(201, 82, 77), "Bearish colour", group = GRP_GEN)
int    inBordT   = input.int(70, "Border transparency", minval = 0, maxval = 100, group = GRP_GEN)
string inPrio    = input.string("Nearest to price", "Display priority", options = ["Nearest to price", "Most recently formed"], group = GRP_GEN, tooltip = "Ranks which zones fill the display budgets. Reference = last confirmed chart close; ranking changes only on confirmed bars. Nearest uses nearest-EDGE distance (0 if price is inside), ties by most recent formation.")
bool   inNearest = inPrio == "Nearest to price"
const string GRP_SET = "Qualified iFVG setup (starting parameters, NOT optimised)"
string inMode    = input.string("My Setup Only", "Display mode", options = ["My Setup Only", "All Size-Filtered Gaps"], group = GRP_SET, tooltip = "My Setup Only hides ordinary FVGs and unqualified iFVGs. All Size-Filtered Gaps is diagnostic. Display never changes qualification, lifecycle or alerts.")
bool   inSetupOnly = inMode == "My Setup Only"
bool   inDebug   = input.bool(false, "Debug: show rejection reasons on unqualified iFVGs", group = GRP_SET, tooltip = "Shows the failed gate(s) on unqualified iFVG boxes (also in My Setup Only mode).")
int    inMaxQual = input.int(2, "Max visible qualified iFVGs (newest first)", minval = 1, maxval = 10, group = GRP_SET)
int    inN       = input.int(3, "Impulse and stop lookback (candles incl. inversion)", minval = 2, maxval = 20, group = GRP_SET, tooltip = "Shared by the multi-candle impulse window and the stop lookback.")
float  inBodyAtr = input.float(0.8, "Route A: min body (x ATR(14)[1])", minval = 0.0, step = 0.05, group = GRP_SET)
float  inBodyFrac = input.float(0.65, "Route A: min body / range", minval = 0.0, maxval = 1.0, step = 0.05, group = GRP_SET)
float  inCloseLoc = input.float(0.20, "Route A: close within this fraction of the range extreme", minval = 0.0, maxval = 1.0, step = 0.05, group = GRP_SET)
int    inExtTicks = input.int(1, "Min close extension beyond boundary (ticks)", minval = 1, group = GRP_SET, tooltip = "Extension needed beyond the original boundary (bullish iFVG: original top; bearish: original bottom) is max(this, ATR multiple x ATR(14)[1]). Used by BOTH routes.")
float  inExtAtr  = input.float(0.10, "Min close extension (x ATR(14)[1])", minval = 0.0, step = 0.05, group = GRP_SET)
float  inEff     = input.float(0.70, "Route B: min efficiency |net| / travel", minval = 0.0, maxval = 1.0, step = 0.05, group = GRP_SET)
float  inNetAtr  = input.float(1.0, "Route B: min |net move| (x ATR(14)[1])", minval = 0.0, step = 0.1, group = GRP_SET)
int    inStopBuf = input.int(1, "Stop buffer (ticks)", minval = 0, group = GRP_SET, tooltip = "Stop = lowest low (bullish) / highest high (bearish) over the lookback, beyond by this buffer. Entry = inversion close. Illustrative close-entry model: no fills, commissions or slippage.")
float  inMinR    = input.float(2.0, "Minimum target multiple (R)", minval = 1.0, step = 0.1, group = GRP_SET, tooltip = "Target R = distance to the NEAREST eligible target / risk, from the inversion-close entry and frozen stop. Compared unrounded.")
bool   inPathToTarget = input.bool(false, "Require clear path to selected target (not just the R horizon)", group = GRP_SET)
bool   inReqSweep = input.bool(false, "Require recent liquidity sweep", group = GRP_SET)
bool   inReqContact = input.bool(false, "Require recent relevant HTF-gap contact", group = GRP_SET, tooltip = "Both optional gates must pass when both are enabled (AND).")
int    inRecent  = input.int(5, "Recent window for optional gates (candles incl. inversion)", minval = 1, maxval = 50, group = GRP_SET)
bool   inTgtDay  = input.bool(true, "Target: previous completed day high/low", group = GRP_SET)
bool   inTgtPivot = input.bool(true, "Target: confirmed chart swing highs/lows", group = GRP_SET)
int    inPivL    = input.int(3, "Swing left bars", minval = 1, maxval = 20, group = GRP_SET)
int    inPivR    = input.int(3, "Swing right bars", minval = 1, maxval = 20, group = GRP_SET)
int    inLvlAge  = input.int(1000, "Swing target horizon (chart bars; coverage boundary, not inversion)", minval = 50, maxval = 4000, group = GRP_SET)
bool   inTgtAsia = input.bool(false, "Target: completed Asia session high/low", group = GRP_SET)
string inAsiaSess = input.session("0900-1500", "Asia session (explicit)", group = GRP_SET)
string inAsiaTz  = input.string("Asia/Tokyo", "Asia timezone (IANA)", group = GRP_SET, tooltip = "No timezone is assumed: verify both values for your instrument. Session edges should align with chart bars.")
bool   inTgtLon  = input.bool(false, "Target: completed London session high/low", group = GRP_SET)
string inLonSess = input.session("0800-1600", "London session (explicit)", group = GRP_SET)
string inLonTz   = input.string("Europe/London", "London timezone (IANA)", group = GRP_SET)
bool   inGuides  = input.bool(false, "Show entry / stop / target guides on qualified iFVGs", group = GRP_SET)
const string GRP_WIN = "Entry windows (configured clock windows - NOT an exchange holiday / early-close calendar)"
bool   inWinAsia = input.bool(true, "Window A: Asia open -> London open", group = GRP_WIN, tooltip = "Configured reference times, not a universal definition of the Asian session. Each endpoint uses its own IANA timezone (DST handled automatically). Start inclusive, end exclusive, judged at the inversion candle's CLOSE time.")
int    inAsH  = input.int(9, "Asia open hour", minval = 0, maxval = 23, group = GRP_WIN)
int    inAsM  = input.int(0, "Asia open minute", minval = 0, maxval = 59, group = GRP_WIN)
string inAsTz = input.string("Asia/Tokyo", "Asia open timezone (IANA)", group = GRP_WIN)
int    inLoH  = input.int(8, "London open hour (window end)", minval = 0, maxval = 23, group = GRP_WIN)
int    inLoM  = input.int(0, "London open minute (window end)", minval = 0, maxval = 59, group = GRP_WIN)
string inLoTz = input.string("Europe/London", "London open timezone (IANA)", group = GRP_WIN, tooltip = "The window ends at the first London opening strictly after the Asia start.")
bool   inWinAm = input.bool(true, "Window B: New York morning", group = GRP_WIN)
int    inAmSH = input.int(9, "NY morning start hour", minval = 0, maxval = 23, group = GRP_WIN)
int    inAmSM = input.int(45, "NY morning start minute", minval = 0, maxval = 59, group = GRP_WIN)
int    inAmEH = input.int(11, "NY morning end hour", minval = 0, maxval = 23, group = GRP_WIN)
int    inAmEM = input.int(30, "NY morning end minute", minval = 0, maxval = 59, group = GRP_WIN)
string inAmTz = input.string("America/New_York", "NY morning timezone (IANA)", group = GRP_WIN)
bool   inWinPm = input.bool(true, "Window C: New York afternoon", group = GRP_WIN)
int    inPmSH = input.int(14, "NY afternoon start hour", minval = 0, maxval = 23, group = GRP_WIN)
int    inPmSM = input.int(30, "NY afternoon start minute", minval = 0, maxval = 59, group = GRP_WIN)
int    inPmEH = input.int(15, "NY afternoon end hour", minval = 0, maxval = 23, group = GRP_WIN)
int    inPmEM = input.int(30, "NY afternoon end minute", minval = 0, maxval = 59, group = GRP_WIN)
string inPmTz = input.string("America/New_York", "NY afternoon timezone (IANA)", group = GRP_WIN, tooltip = "An end earlier than the start is treated as overnight (ends the next local date). Identical start/end in one timezone is rejected, not read as 24 hours.")
string inWkd  = input.string("Mon-Fri", "Eligible start days (weekday of the START in its timezone)", options = ["Mon-Fri", "Every day"], group = GRP_WIN)
bool   inStatus = input.bool(false, "Show small entry-window status label", group = GRP_WIN)
bool   inShowFvg  = input.bool(true, "Show current-chart FVGs", group = GRP_CH)
bool   inShowIfvg = input.bool(true, "Show current-chart iFVGs", group = GRP_CH)
int    inMaxFvg   = input.int(3, "Max visible ordinary FVGs", minval = 0, maxval = 20, group = GRP_CH, tooltip = "Separate budget: ordinary FVGs never use an iFVG slot. Display limits do not change inversion logic.")
int    inMaxIfvg  = input.int(2, "Max visible iFVGs", minval = 0, maxval = 20, group = GRP_CH)
float  inFvgAtr   = input.float(0.10, "FVG size filter: ATR multiple (0 = off)", minval = 0.0, step = 0.05, group = GRP_CH, tooltip = "Formation-size filter. Width must be >= max(min ticks x mintick, multiple x formation ATR(14)). ATR is frozen at the gap's confirmed formation candle (chart ATR for chart zones). If ATR is unavailable and the multiple is > 0 the zone is hidden (still tracked).")
int    inFvgMinT  = input.int(4, "FVG size filter: min ticks", minval = 1, group = GRP_CH)
float  inIfvgAtr  = input.float(0.10, "iFVG size filter: ATR multiple (0 = off)", minval = 0.0, step = 0.05, group = GRP_CH, tooltip = "Independent iFVG threshold. Uses the ORIGINAL gap's frozen formation ATR, not ATR at inversion. A hidden ordinary FVG can become a visible iFVG.")
int    inIfvgMinT = input.int(4, "iFVG size filter: min ticks", minval = 1, group = GRP_CH)
bool   inDistOn   = input.bool(true, "Chart-zone distance filter", group = GRP_CH, tooltip = "Distance filtering uses CURRENT confirmed chart ATR(14) and changes as price/ATR change. Zones containing price always pass. Hidden zones remain tracked and may reappear without any alert. Not applied to HTF zones.")
float  inDistAtr  = input.float(3.0, "Max distance (chart ATR)", minval = 0.1, step = 0.5, group = GRP_CH)
int    inChCap    = input.int(200, "Tracking capacity (zones)", minval = 20, maxval = 500, group = GRP_CH)
int    inChWin    = input.int(4500, "Tracking window (chart bars; keep below bars your plan loads)", minval = 100, maxval = 20000, group = GRP_CH)
int    inChT      = input.int(92, "Fill transparency", minval = 0, maxval = 100, group = GRP_CH)
bool   inShowHtf  = input.bool(true, "Show HTF context gaps", group = GRP_HTF)
int    inHtfAbove = input.int(1, "Max zones ABOVE price (per source)", minval = 0, maxval = 10, group = GRP_HTF, tooltip = "Separate budgets per source: above (bottom > price), below (top < price), containing (bottom <= price <= top; boundary contact counts here only). Up to three zones per source.")
int    inHtfBelow = input.int(1, "Max zones BELOW price (per source)", minval = 0, maxval = 10, group = GRP_HTF)
int    inHtfCont  = input.int(1, "Max zones CONTAINING price (per source)", minval = 0, maxval = 10, group = GRP_HTF)
float  inHtfAtr   = input.float(0.10, "HTF size filter: ATR multiple (0 = off)", minval = 0.0, step = 0.05, group = GRP_HTF, tooltip = "Width must be >= max(min ticks x mintick, multiple x the gap's frozen SOURCE-timeframe ATR(14) at its confirmed formation candle). Never chart ATR.")
int    inHtfMinT  = input.int(4, "HTF size filter: min ticks", minval = 1, group = GRP_HTF)
int    inHtfCap   = input.int(100, "Tracking capacity per source", minval = 10, maxval = 200, group = GRP_HTF)
int    inHtfT     = input.int(92, "Untapped fill transparency", minval = 0, maxval = 100, group = GRP_HTF)
int    inHtfTapT  = input.int(95, "Tapped fill transparency", minval = 0, maxval = 100, group = GRP_HTF)
int    inBudget   = input.int(1000, "Source-history budget (source candles per slot; may be clamped for memory)", minval = 100, maxval = 4000, group = GRP_HTF)
bool   en1 = input.bool(true,  "Slot 1", inline = "s1", group = GRP_HTF)
string tf1 = input.timeframe("15",  "", inline = "s1", group = GRP_HTF)
bool   en2 = input.bool(true,  "Slot 2", inline = "s2", group = GRP_HTF)
string tf2 = input.timeframe("60",  "", inline = "s2", group = GRP_HTF)
bool   en3 = input.bool(false, "Slot 3", inline = "s3", group = GRP_HTF)
string tf3 = input.timeframe("240", "", inline = "s3", group = GRP_HTF)
bool   en4 = input.bool(false, "Slot 4", inline = "s4", group = GRP_HTF)
string tf4 = input.timeframe("1D",  "", inline = "s4", group = GRP_HTF)
bool   alQual    = input.bool(true,  "Newly Qualified iFVG (default signal)", group = GRP_AL)
bool   alNewBull = input.bool(false, "New bullish chart FVG", group = GRP_AL)
bool   alNewBear = input.bool(false, "New bearish chart FVG", group = GRP_AL)
bool   alBullIf  = input.bool(false, "Bullish chart iFVG confirmed", group = GRP_AL)
bool   alBearIf  = input.bool(false, "Bearish chart iFVG confirmed", group = GRP_AL)
bool   alHtfNew  = input.bool(false, "New HTF FVG", group = GRP_AL)
bool   alHtfTap  = input.bool(false, "HTF FVG first tapped", group = GRP_AL)
bool   alHtfRem  = input.bool(false, "HTF FVG removed by source inversion", group = GRP_AL)
bool   alIfRem   = input.bool(false, "Chart iFVG removed (overlap / invalidation)", group = GRP_AL)
const int ZS = 8
const int HDR = 2
const int ST_BULL_FVG  = 1
const int ST_BEAR_FVG  = 2
const int ST_BULL_IFVG = 3
const int ST_BEAR_IFVG = 4
const int ST_UNT_BULL  = 11
const int ST_TAP_BULL  = 12
const int ST_UNT_BEAR  = 13
const int ST_TAP_BEAR  = 14
type Zone
    string id
    int    src = -1
    string tfTxt = ""
    int    dir
    int    state
    float  top
    float  bottom
    int    formTime
    int    confTime
    int    availTime
    int    formBar = -1
    int    invBar = -1
    int    invTime
    int    invAvail
    bool   tapped = false
    int    tapTime
    int    tapAvail
    int    lastEvt
    float  width
    float  fatr
    bool   seen = false
    bool   endNow = false
    int    cat = -1
    float  dist = 0.0
    bool   vis = false
    bool   qEval = false
    bool   qual = false
    float  qEntry
    float  qStop
    float  qTarget
    float  qHorizon
    float  qR
    string qTargetName = ""
    string qRoute = ""
    string qSrcs = ""
    string qReasons = ""
    string qNote = ""
    string qWin = ""
    string qWinId = ""
    int    qWinStart
    int    qWinEnd
    box    bx
    line   mid
    label  mk
    line   gE
    line   gS
    line   gT
type Level
    string id
    float  price
    bool   isHigh
    string src
    int    originTime
    int    availTime
    int    originBar = -1
    bool   consumed = false
f_tk(float x) =>
    math.round(x / syminfo.mintick)
f_overlap(float hi, float lo, float zb, float zt) =>
    f_tk(hi) >= f_tk(zb) and f_tk(lo) <= f_tk(zt)
f_tfText(int s) =>
    string r = ""
    if s >= 604800 and s % 604800 == 0
        r := str.tostring(int(s / 604800)) + "W"
    else if s >= 86400 and s % 86400 == 0
        r := str.tostring(int(s / 86400)) + "D"
    else if s >= 3600 and s % 3600 == 0
        r := str.tostring(int(s / 3600)) + "H"
    else if s >= 60 and s % 60 == 0
        r := str.tostring(int(s / 60)) + "m"
    else
        r := str.tostring(s) + "s"
    r
f_push(array<float> z, int ft, int dir, float tp, float bt, int conf, int fidx, float atr) =>
    z.push(float(ft))
    z.push(float(dir))
    z.push(tp)
    z.push(bt)
    z.push(float(conf))
    z.push(0.0)
    z.push(float(fidx))
    z.push(na(atr) ? -1.0 : atr)
    true
f_engine(int cap, int minTicks, int budget) =>
    var array<float> Z = array.new_float(0)
    var array<float> pub = array.from(0.0, 0.0)
    var float maxPruned = -1.0
    var bool lastTrunc = false
    var float lastProc = 0.0
    array<float> out = na
    float atrS = ta.atr(14)
    float fatr1 = atrS[1]
    float h1 = high[1]
    float l1 = low[1]
    float c1 = close[1]
    float h2 = high[2]
    float l2 = low[2]
    float h3 = high[3]
    float l3 = low[3]
    int   t1 = time[1]
    int   tc1 = time_close[1]
    int   cidx = bar_index - 1
    bool  valid = not na(h1) and not na(l1) and not na(c1) and not na(t1) and not na(tc1)
    bool  active = bar_index > last_bar_index - budget
    if valid and active
        if t1 > lastProc
            lastProc := t1
            bool dirty = false
            int n0 = int(Z.size() / ZS)
            if n0 > 0
                for i = n0 - 1 to 0
                    if math.abs(Z.get(i * ZS + 1)) == 2.0
                        for k = 1 to ZS
                            Z.remove(i * ZS)
                        dirty := true
            int n1 = int(Z.size() / ZS)
            if n1 > 0
                for i = 0 to n1 - 1
                    int b = i * ZS
                    if t1 >= int(Z.get(b + 4))
                        float cd = Z.get(b + 1)
                        float zt = Z.get(b + 2)
                        float zb = Z.get(b + 3)
                        bool inv = cd > 0 ? f_tk(c1) < f_tk(zb) : f_tk(c1) > f_tk(zt)
                        if inv
                            Z.set(b + 1, cd * 2.0)
                            dirty := true
                        else if Z.get(b + 5) == 0.0 and f_overlap(h1, l1, zb, zt)
                            Z.set(b + 5, float(tc1))
                            dirty := true
            if not na(h2) and not na(l2) and not na(h3) and not na(l3)
                int bullGap = f_tk(l1) - f_tk(h3)
                int bearGap = f_tk(l3) - f_tk(h1)
                if bullGap >= minTicks
                    f_push(Z, t1, 1, l1, h3, tc1, cidx, fatr1)
                    dirty := true
                else if bearGap >= minTicks
                    f_push(Z, t1, -1, l3, h1, tc1, cidx, fatr1)
                    dirty := true
            int n2 = int(Z.size() / ZS)
            if n2 > 0
                for i = n2 - 1 to 0
                    if math.abs(Z.get(i * ZS + 1)) == 1.0 and cidx - int(Z.get(i * ZS + 6)) >= budget
                        for k = 1 to ZS
                            Z.remove(i * ZS)
                        dirty := true
            int n3 = int(Z.size() / ZS)
            int nFlag = 0
            if n3 > 0
                for i = 0 to n3 - 1
                    if math.abs(Z.get(i * ZS + 1)) == 2.0
                        nFlag += 1
            int over = n3 - nFlag - cap
            int p = 0
            while over > 0 and p < int(Z.size() / ZS)
                if math.abs(Z.get(p * ZS + 1)) == 1.0
                    maxPruned := math.max(maxPruned, Z.get(p * ZS + 6))
                    for k = 1 to ZS
                        Z.remove(p * ZS)
                    over -= 1
                    dirty := true
                else
                    p += 1
            bool truncNow = maxPruned >= 0 and cidx - maxPruned < budget
            if truncNow != lastTrunc
                lastTrunc := truncNow
                dirty := true
            if dirty
                array<float> tmp = array.from(truncNow ? 1.0 : 0.0, 0.0)
                tmp.concat(Z)
                pub := tmp
        out := pub
    out
bool supported = chart.is_standard and not timeframe.isticks
int  chartSecs = supported ? timeframe.in_seconds() : 0
int  chartMs   = chartSecs * 1000
int  sec1 = timeframe.in_seconds(tf1)
int  sec2 = timeframe.in_seconds(tf2)
int  sec3 = timeframe.in_seconds(tf3)
int  sec4 = timeframe.in_seconds(tf4)
bool ok1 = supported and en1 and sec1 > chartSecs
bool ok2 = supported and en2 and sec2 > chartSecs and not (ok1 and sec2 == sec1)
bool ok3 = supported and en3 and sec3 > chartSecs and not (ok1 and sec3 == sec1) and not (ok2 and sec3 == sec2)
bool ok4 = supported and en4 and sec4 > chartSecs and not (ok1 and sec4 == sec1) and not (ok2 and sec4 == sec2) and not (ok3 and sec4 == sec3)
bool al1 = chartSecs > 0 and sec1 % chartSecs == 0
bool al2 = chartSecs > 0 and sec2 % chartSecs == 0
bool al3 = chartSecs > 0 and sec3 % chartSecs == 0
bool al4 = chartSecs > 0 and sec4 % chartSecs == 0
bool act1 = ok1 and al1
bool act2 = ok2 and al2
bool act3 = ok3 and al3
bool act4 = ok4 and al4
int  nSlots = (act1 ? 1 : 0) + (act2 ? 1 : 0) + (act3 ? 1 : 0) + (act4 ? 1 : 0)
int  memBudget = nSlots > 0 ? int(8000000 / (nSlots * ZS * inHtfCap)) : inBudget
int  effBudget = memBudget < inBudget ? memBudget : inBudget
array<float> snap1 = na
array<float> snap2 = na
array<float> snap3 = na
array<float> snap4 = na
int asOf1 = na
int asOf2 = na
int asOf3 = na
int asOf4 = na
if act1
    snap1 := request.security(syminfo.tickerid, tf1, f_engine(inHtfCap, inMinTick, effBudget), lookahead = barmerge.lookahead_on)
    asOf1 := request.security(syminfo.tickerid, tf1, time_close[1], lookahead = barmerge.lookahead_on)
if act2
    snap2 := request.security(syminfo.tickerid, tf2, f_engine(inHtfCap, inMinTick, effBudget), lookahead = barmerge.lookahead_on)
    asOf2 := request.security(syminfo.tickerid, tf2, time_close[1], lookahead = barmerge.lookahead_on)
if act3
    snap3 := request.security(syminfo.tickerid, tf3, f_engine(inHtfCap, inMinTick, effBudget), lookahead = barmerge.lookahead_on)
    asOf3 := request.security(syminfo.tickerid, tf3, time_close[1], lookahead = barmerge.lookahead_on)
if act4
    snap4 := request.security(syminfo.tickerid, tf4, f_engine(inHtfCap, inMinTick, effBudget), lookahead = barmerge.lookahead_on)
    asOf4 := request.security(syminfo.tickerid, tf4, time_close[1], lookahead = barmerge.lookahead_on)
var array<Zone>   chartZ = array.new<Zone>()
var array<Zone>   hz1 = array.new<Zone>()
var array<Zone>   hz2 = array.new<Zone>()
var array<Zone>   hz3 = array.new<Zone>()
var array<Zone>   hz4 = array.new<Zone>()
var array<int>    lastAsOf = array.new_int(4, 0)
var array<int>    wm       = array.new_int(4, 0)
var array<bool>   srcBad   = array.new_bool(4, false)
var array<bool>   srcSeen  = array.new_bool(4, false)
var array<bool>   srcInit  = array.new_bool(4, false)
var array<string> warnArr  = array.new_string(0)
var array<int>    ev   = array.new_int(12, 0)
var array<string> evTf = array.new_string(12, "")
var int firstTime = time
var int lastConfClose = na
var float refPrice = na
float chartAtr = ta.atr(14)
int prevCloseT = time_close[1]
float h2c = high[2]
float l2c = low[2]
float chartAtr1 = chartAtr[1]
bool okWinAs = not (inAsTz == inLoTz and inAsH == inLoH and inAsM == inLoM)
bool okWinAm = not (inAmSH == inAmEH and inAmSM == inAmEM)
bool okWinPm = not (inPmSH == inPmEH and inPmSM == inPmEM)
bool liveNow = barstate.isrealtime and timenow - time <= 2 * chartMs + 60000
int  dispClock = liveNow ? timenow : time_close
varip array<string> expIds = array.new_string(0)
var array<bool>   srcTrunc = array.new_bool(4, false)
var array<Level>  levels = array.new<Level>()
var array<Zone>   pend = array.new<Zone>()
var array<int>    cBars = array.new_int(0)
var array<string> cIds  = array.new_string(0)
var array<int>    cDirs = array.new_int(0)
var array<string> qMsg  = array.new_string(2, "")
var int  lastSweepBull = -1000000
var int  lastSweepBear = -1000000
var int  lastDayEnd = 0
var bool dayReady = false
var array<float> sessHi = array.new_float(2, na)
var array<float> sessLo = array.new_float(2, na)
var array<int>   sessStart = array.new_int(2, 0)
var array<bool>  sessIn = array.new_bool(2, false)
var array<bool>  sessPartial = array.new_bool(2, false)
var array<bool>  sessReady = array.new_bool(2, false)
bool  dayOn = supported and inTgtDay and chartSecs < 86400
float pdH = na
float pdL = na
int   pdEnd = na
if dayOn
    [dH_, dL_, dE_] = request.security(syminfo.tickerid, "D", [high[1], low[1], time_close[1]], lookahead = barmerge.lookahead_on)
    pdH := dH_
    pdL := dL_
    pdEnd := dE_
int tAsia = time(timeframe.period, inAsiaSess, inAsiaTz)
int tLon  = time(timeframe.period, inLonSess, inLonTz)
f_destroy(Zone z) =>
    if not na(z.bx)
        box.delete(z.bx)
        z.bx := na
    if not na(z.mid)
        line.delete(z.mid)
        z.mid := na
    if not na(z.mk)
        label.delete(z.mk)
        z.mk := na
    if not na(z.gE)
        line.delete(z.gE)
        z.gE := na
    if not na(z.gS)
        line.delete(z.gS)
        z.gS := na
    if not na(z.gT)
        line.delete(z.gT)
        z.gT := na
    true
f_clearStore(array<Zone> a) =>
    int n = a.size()
    if n > 0
        for i = n - 1 to 0
            f_destroy(a.get(i))
            a.remove(i)
    true
f_evInc(int i, string tf) =>
    ev.set(i, ev.get(i) + 1)
    if tf != ""
        string cur = evTf.get(i)
        array<string> toks = str.split(cur, ",")
        if not toks.includes(tf)
            evTf.set(i, cur == "" ? tf : cur + "," + tf)
    true
f_resetEv() =>
    for i = 0 to 11
        ev.set(i, 0)
        evTf.set(i, "")
    true
f_stepChart(Zone z, float hi, float lo, float cl, int bi, int t, int tc) =>
    int r = 0
    if bi > z.formBar
        bool bull = z.dir > 0
        if z.state == ST_BULL_FVG or z.state == ST_BEAR_FVG
            bool inv = bull ? f_tk(cl) < f_tk(z.bottom) : f_tk(cl) > f_tk(z.top)
            if inv
                z.state := bull ? ST_BEAR_IFVG : ST_BULL_IFVG
                z.invBar := bi
                z.invTime := t
                z.invAvail := tc
                r := 1
        else if bi > z.invBar
            bool invalid = bull ? f_tk(cl) > f_tk(z.top) : f_tk(cl) < f_tk(z.bottom)
            if invalid
                r := 3
            else if f_overlap(hi, lo, z.bottom, z.top)
                r := 2
    r
f_reconcile(array<Zone> store, int idx, string tfTxt, array<float> snap, int asOf) =>
    bool gen = srcInit.get(idx)
    srcTrunc.set(idx, snap.get(0) == 1.0)
    int cnt = int((snap.size() - HDR) / ZS)
    int m = store.size()
    if m > 0
        for i = 0 to m - 1
            Zone z0 = store.get(i)
            z0.seen := false
            z0.endNow := false
    int j = 0
    if cnt > 0
        for k = 0 to cnt - 1
            int base = HDR + k * ZS
            int ft = int(snap.get(base))
            float cd = snap.get(base + 1)
            int d = cd > 0 ? 1 : -1
            bool flg = math.abs(cd) == 2.0
            float zt = snap.get(base + 2)
            float zb = snap.get(base + 3)
            int conf = int(snap.get(base + 4))
            int tp = int(snap.get(base + 5))
            float fa = snap.get(base + 7)
            bool adv = true
            while adv
                adv := false
                if j < store.size()
                    if store.get(j).formTime < ft
                        j += 1
                        adv := true
            bool isMatch = false
            if j < store.size()
                isMatch := store.get(j).formTime == ft
            if isMatch
                Zone z = store.get(j)
                z.seen := true
                z.lastEvt := asOf
                j += 1
                if flg
                    z.endNow := true
                else if tp > 0 and not z.tapped
                    z.tapped := true
                    z.state := z.dir > 0 ? ST_TAP_BULL : ST_TAP_BEAR
                    z.tapTime := tp
                    z.tapAvail := time_close
                    if gen
                        f_evInc(5, tfTxt)
            else if not flg and ft > wm.get(idx)
                bool tpd = tp > 0
                int st = d > 0 ? (tpd ? ST_TAP_BULL : ST_UNT_BULL) : (tpd ? ST_TAP_BEAR : ST_UNT_BEAR)
                Zone nz = Zone.new(id = syminfo.tickerid + "|" + tfTxt + "|" + str.tostring(ft) + "|" + str.tostring(d), src = idx, tfTxt = tfTxt, dir = d, state = st, top = zt, bottom = zb, formTime = ft, confTime = conf, availTime = time_close, width = zt - zb, fatr = fa < 0 ? na : fa, tapped = tpd, tapTime = tp, tapAvail = time_close, lastEvt = asOf, seen = true)
                store.push(nz)
                wm.set(idx, ft)
                if gen and conf == asOf
                    f_evInc(4, tfTxt)
    int n2 = store.size()
    if n2 > 0
        for i = n2 - 1 to 0
            Zone z = store.get(i)
            if z.endNow
                f_destroy(z)
                store.remove(i)
                if gen
                    f_evInc(6, tfTxt)
            else if not z.seen
                f_destroy(z)
                store.remove(i)
    while store.size() > inHtfCap
        Zone old = store.shift()
        f_destroy(old)
    srcInit.set(idx, true)
    true
f_sync(array<Zone> store, int idx, string tfTxt, array<float> snap, int asOf) =>
    if not na(snap) and not na(asOf)
        srcSeen.set(idx, true)
        if asOf > lastAsOf.get(idx) and not srcBad.get(idx)
            lastAsOf.set(idx, asOf)
            if firstTime <= asOf
                if not na(prevCloseT) and prevCloseT > asOf
                    srcBad.set(idx, true)
                    warnArr.push(tfTxt + " disabled: chart candles do not align with " + tfTxt + " boundaries (session/timeframe alignment)")
                    f_clearStore(store)
                else
                    f_reconcile(store, idx, tfTxt, snap, asOf)
    true
f_tapStore(array<Zone> a) =>
    int n = a.size()
    if n > 0
        for i = 0 to n - 1
            Zone z = a.get(i)
            if time >= z.confTime and f_overlap(high, low, z.bottom, z.top)
                cBars.push(bar_index)
                cIds.push(z.id)
                cDirs.push(z.dir)
                if not z.tapped
                    z.tapped := true
                    z.state := z.dir > 0 ? ST_TAP_BULL : ST_TAP_BEAR
                    z.tapTime := time
                    z.tapAvail := time_close
                    f_evInc(5, z.tfTxt)
    true
f_expired(Zone z) =>
    z.qual and (expIds.includes(z.id) or (not na(dispClock) and not na(z.qWinEnd) and dispClock >= z.qWinEnd))
f_syncDraw(Zone z, bool htf, bool want) =>
    if not want
        f_destroy(z)
    else
        bool bull = z.state == ST_BULL_FVG or z.state == ST_BULL_IFVG or z.state == ST_UNT_BULL or z.state == ST_TAP_BULL
        bool ifvg = z.state == ST_BULL_IFVG or z.state == ST_BEAR_IFVG
        bool tap  = z.state == ST_TAP_BULL or z.state == ST_TAP_BEAR
        color base = bull ? inBull : inBear
        int fillT = htf ? (tap ? inHtfTapT : inHtfT) : inChT
        string txt = ""
        bool qualZ = ifvg and z.qual and not htf and not f_expired(z)
        int bw = qualZ ? 2 : 1
        if inLabels
            if htf
                txt := z.tfTxt + " FVG · " + (tap ? "Tapped" : "Untapped")
            else if qualZ
                txt := "Qualified iFVG · " + str.tostring(math.floor(z.qR * 10) / 10, "#.0") + "R"
            else if ifvg
                txt := inDebug and z.qReasons != "" ? "iFVG ✗ " + (str.length(z.qReasons) > 70 ? str.substring(z.qReasons, 0, 70) + "…" : z.qReasons) : "iFVG"
            else
                txt := "FVG"
        int l = z.formTime > firstTime ? z.formTime : firstTime
        int r = lastConfClose + inExt * chartMs
        if r <= l
            r := l + chartMs
        if na(z.bx)
            z.bx := box.new(left = l, top = z.top, right = r, bottom = z.bottom, xloc = xloc.bar_time, border_color = color.new(base, inBordT), border_width = bw, border_style = ifvg ? line.style_dashed : line.style_solid, bgcolor = color.new(base, fillT), text = txt, text_size = size.small, text_color = color.new(base, 15), text_halign = text.align_right, text_valign = text.align_center)
        else
            box.set_right(z.bx, r)
            box.set_bgcolor(z.bx, color.new(base, fillT))
            box.set_border_color(z.bx, color.new(base, inBordT))
            box.set_border_width(z.bx, bw)
            box.set_border_style(z.bx, ifvg ? line.style_dashed : line.style_solid)
            box.set_text(z.bx, txt)
            box.set_text_color(z.bx, color.new(base, 15))
        if inMid
            float mp = (z.top + z.bottom) / 2
            if na(z.mid)
                z.mid := line.new(x1 = l, y1 = mp, x2 = r, y2 = mp, xloc = xloc.bar_time, color = color.new(base, 45), style = line.style_dotted, width = 1)
            else
                line.set_x2(z.mid, r)
                line.set_color(z.mid, color.new(base, 45))
        else if not na(z.mid)
            line.delete(z.mid)
            z.mid := na
        if inMarker and ifvg and not htf
            if na(z.mk)
                z.mk := label.new(x = z.invTime, y = z.dir > 0 ? z.bottom : z.top, xloc = xloc.bar_time, text = "", style = label.style_xcross, color = color.new(base, 0), size = size.tiny)
            else
                label.set_color(z.mk, color.new(base, 0))
        else if not na(z.mk)
            label.delete(z.mk)
            z.mk := na
        if inGuides and qualZ
            if na(z.gE)
                z.gE := line.new(x1 = z.invTime, y1 = z.qEntry, x2 = r, y2 = z.qEntry, xloc = xloc.bar_time, color = color.new(color.gray, 40), style = line.style_dotted, width = 1)
                z.gS := line.new(x1 = z.invTime, y1 = z.qStop, x2 = r, y2 = z.qStop, xloc = xloc.bar_time, color = color.new(inBear, 40), style = line.style_dotted, width = 1)
                z.gT := line.new(x1 = z.invTime, y1 = z.qTarget, x2 = r, y2 = z.qTarget, xloc = xloc.bar_time, color = color.new(inBull, 40), style = line.style_dotted, width = 1)
            else
                line.set_x2(z.gE, r)
                line.set_x2(z.gS, r)
                line.set_x2(z.gT, r)
        else if not na(z.gE)
            line.delete(z.gE)
            line.delete(z.gS)
            line.delete(z.gT)
            z.gE := na
            z.gS := na
            z.gT := na
    true
f_sizeOk(float width, float fatr, int minT, float mult) =>
    bool ok = true
    if mult > 0 and na(fatr)
        ok := false
    else
        float thrT = float(minT)
        if mult > 0
            float atrT = mult * fatr / syminfo.mintick
            thrT := atrT > thrT ? atrT : thrT
        ok := f_tk(width) >= thrT - 0.000001
    ok
f_dist(Zone z, float ref) =>
    float d = 0.0
    if f_tk(ref) < f_tk(z.bottom)
        d := z.bottom - ref
    else if f_tk(ref) > f_tk(z.top)
        d := ref - z.top
    d
f_classify(array<Zone> a, bool htf) =>
    int n = a.size()
    if n > 0
        for i = 0 to n - 1
            Zone z = a.get(i)
            z.vis := false
            z.cat := -1
            z.dist := f_dist(z, refPrice)
            if htf
                if inShowHtf and f_sizeOk(z.width, z.fatr, inHtfMinT, inHtfAtr)
                    z.cat := f_tk(z.bottom) > f_tk(refPrice) ? 2 : (f_tk(z.top) < f_tk(refPrice) ? 3 : 4)
            else
                bool isI = z.state == ST_BULL_IFVG or z.state == ST_BEAR_IFVG
                if isI and z.qual and not f_expired(z)
                    z.cat := 5
                else
                    bool sizeOk = isI ? f_sizeOk(z.width, z.fatr, inIfvgMinT, inIfvgAtr) : f_sizeOk(z.width, z.fatr, inFvgMinT, inFvgAtr)
                    bool shown = isI ? (inShowIfvg and (not inSetupOnly or inDebug)) : (inShowFvg and not inSetupOnly)
                    bool distOk = true
                    if inDistOn and z.dist > 0 and not na(chartAtr)
                        distOk := z.dist <= inDistAtr * chartAtr
                    if shown and sizeOk and distOk
                        z.cat := isI ? 1 : 0
    true
f_pickCat(array<Zone> a, int cat, int limit) =>
    int n = a.size()
    if n > 0 and limit > 0
        for pick = 1 to limit
            int best = -1
            for i = 0 to n - 1
                Zone z = a.get(i)
                if z.cat == cat and not z.vis
                    if best < 0
                        best := i
                    else
                        Zone bz = a.get(best)
                        bool better = false
                        if cat == 5
                            better := z.invBar >= bz.invBar
                        else if inNearest and z.dist != bz.dist
                            better := z.dist < bz.dist
                        else
                            better := z.formTime >= bz.formTime
                        if better
                            best := i
            if best >= 0
                Zone sel = a.get(best)
                sel.vis := true
    true
f_drawHtf(array<Zone> a) =>
    f_classify(a, true)
    f_pickCat(a, 2, inHtfAbove)
    f_pickCat(a, 3, inHtfBelow)
    f_pickCat(a, 4, inHtfCont)
    int n = a.size()
    if n > 0
        for i = 0 to n - 1
            Zone z = a.get(i)
            f_syncDraw(z, true, z.vis)
    true
f_drawAll() =>
    if not na(lastConfClose) and not na(refPrice)
        f_classify(chartZ, false)
        f_pickCat(chartZ, 0, inMaxFvg)
        f_pickCat(chartZ, 1, inMaxIfvg)
        f_pickCat(chartZ, 5, inMaxQual)
        int n = chartZ.size()
        if n > 0
            for i = 0 to n - 1
                Zone z = chartZ.get(i)
                f_syncDraw(z, false, z.vis)
        f_drawHtf(hz1)
        f_drawHtf(hz2)
        f_drawHtf(hz3)
        f_drawHtf(hz4)
    true
f_ge(float a, float b) =>
    a / syminfo.mintick >= b / syminfo.mintick - 0.000001
f_rnd(float x) =>
    math.round(x / syminfo.mintick) * syminfo.mintick
f_dnT(float x) =>
    math.floor(x / syminfo.mintick + 0.000001) * syminfo.mintick
f_upT(float x) =>
    math.ceil(x / syminfo.mintick - 0.000001) * syminfo.mintick
f_addWhy(string a, string b) =>
    a == "" ? b : a + "; " + b
f_extOk(bool bull, float c, float boundary, float atr1) =>
    float needT = math.max(float(inExtTicks), inExtAtr * atr1 / syminfo.mintick)
    float haveT = bull ? f_tk(c) - f_tk(boundary) : f_tk(boundary) - f_tk(c)
    haveT >= needT - 0.000001
f_routeA(bool bull, float o, float h, float l, float c, float atr1, float boundary) =>
    bool ok = false
    float rng = h - l
    if atr1 > 0 and rng > 0
        float body = c - o
        bool dirOk = bull ? body > 0 : body < 0
        float ab = math.abs(body)
        float loc = bull ? (c - l) / rng : (h - c) / rng
        ok := dirOk and f_ge(ab, inBodyAtr * atr1) and ab / rng >= inBodyFrac - 0.000001 and loc >= 1.0 - inCloseLoc - 0.000001 and f_extOk(bull, c, boundary, atr1)
    ok
f_routeB(bool bull, int n, float o, float c, float atr1, float boundary) =>
    bool ok = false
    if atr1 > 0 and not na(close[n])
        float net = c - close[n]
        float travel = 0.0
        for i = 0 to n - 1
            travel += math.abs(close[i] - close[i + 1])
        bool dirNet = bull ? net > 0 : net < 0
        bool dirBody = bull ? c - o > 0 : c - o < 0
        if travel > 0 and dirNet and dirBody
            ok := math.abs(net) / travel >= inEff - 0.000001 and f_ge(math.abs(net), inNetAtr * atr1) and f_extOk(bull, c, boundary, atr1)
    ok
f_stop(bool bull, int n) =>
    float ext = bull ? low : high
    if n > 1
        for i = 1 to n - 1
            ext := bull ? math.min(ext, low[i]) : math.max(ext, high[i])
    bull ? f_dnT(ext - inStopBuf * syminfo.mintick) : f_upT(ext + inStopBuf * syminfo.mintick)
f_admit(float price, bool isHigh, string src, int originTime, int originBar, bool replace) =>
    if replace
        int n = levels.size()
        if n > 0
            for i = n - 1 to 0
                if levels.get(i).src == src
                    levels.remove(i)
    bool touched = isHigh ? f_tk(high) >= f_tk(price) : f_tk(low) <= f_tk(price)
    if not touched
        levels.push(Level.new(id = src + "|" + str.tostring(price) + "|" + str.tostring(originTime), price = price, isHigh = isHigh, src = src, originTime = originTime, availTime = time_close, originBar = originBar))
    true
f_sess(int idx, bool inS, string nm) =>
    if inS
        if not sessIn.get(idx)
            sessIn.set(idx, true)
            sessHi.set(idx, high)
            sessLo.set(idx, low)
            sessStart.set(idx, time)
            sessPartial.set(idx, bar_index == 0)
        else
            sessHi.set(idx, math.max(sessHi.get(idx), high))
            sessLo.set(idx, math.min(sessLo.get(idx), low))
    else if sessIn.get(idx)
        sessIn.set(idx, false)
        if not sessPartial.get(idx)
            f_admit(sessHi.get(idx), true, nm + " high", sessStart.get(idx), -1, true)
            f_admit(sessLo.get(idx), false, nm + " low", sessStart.get(idx), -1, true)
            sessReady.set(idx, true)
    true
f_pivHigh(int L, int R) =>
    bool ok = not na(high[L + R])
    if ok
        float p = high[R]
        for k = 1 to L
            if not (p > high[R + k])
                ok := false
        for k = 1 to R
            if not (p > high[R - k])
                ok := false
    ok
f_pivLow(int L, int R) =>
    bool ok = not na(low[L + R])
    if ok
        float p = low[R]
        for k = 1 to L
            if not (p < low[R + k])
                ok := false
        for k = 1 to R
            if not (p < low[R - k])
                ok := false
    ok
f_nearestTarget(bool bull, float entry) =>
    float bestP = na
    int bestT = 0
    int eT = f_tk(entry)
    int n = levels.size()
    if n > 0
        for i = 0 to n - 1
            Level lv = levels.get(i)
            if not lv.consumed and lv.isHigh == bull
                int pT = f_tk(lv.price)
                bool elig = bull ? pT > eT : pT < eT
                if elig
                    if na(bestP) or math.abs(pT - eT) < math.abs(bestT - eT)
                        bestP := lv.price
                        bestT := pT
    string nm = ""
    if not na(bestP)
        for i = 0 to n - 1
            Level lv = levels.get(i)
            if not lv.consumed and lv.isHigh == bull
                int pT = f_tk(lv.price)
                bool elig = bull ? pT > eT : pT < eT
                if elig and math.abs(pT - bestT) <= 1
                    array<string> toks = str.split(nm, " + ")
                    if not toks.includes(lv.src)
                        nm := nm == "" ? lv.src : nm + " + " + lv.src
    [bestP, nm]
f_tgtReady() =>
    (not dayOn or dayReady) and (not inTgtAsia or sessReady.get(0)) and (not inTgtLon or sessReady.get(1)) and (not inTgtPivot or bar_index >= inPivL + inPivR)
f_scanObs(array<Zone> a, bool bull, float lo, float hi) =>
    int cnt = 0
    string nm = ""
    int n = a.size()
    if n > 0
        float loT = lo / syminfo.mintick
        float hiT = hi / syminfo.mintick
        for i = 0 to n - 1
            Zone z = a.get(i)
            bool opp = bull ? z.dir < 0 : z.dir > 0
            if opp and f_tk(z.top) >= loT - 0.000001 and f_tk(z.bottom) <= hiT + 0.000001
                cnt += 1
                if nm == ""
                    nm := z.tfTxt + (z.dir < 0 ? " bearish" : " bullish") + " FVG"
    [cnt, nm]
f_scanAll(bool bull, float lo, float hi) =>
    [ca, na_] = f_scanObs(hz1, bull, lo, hi)
    [cb, nb_] = f_scanObs(hz2, bull, lo, hi)
    [cc, nc_] = f_scanObs(hz3, bull, lo, hi)
    [cd, nd_] = f_scanObs(hz4, bull, lo, hi)
    string nm = na_ != "" ? na_ : (nb_ != "" ? nb_ : (nc_ != "" ? nc_ : nd_))
    [ca + cb + cc + cd, nm]
f_slotState(bool en, bool okS, bool actS, int idx) =>
    int st = 0
    if en and okS
        st := actS and srcSeen.get(idx) and srcInit.get(idx) and not srcBad.get(idx) and not srcTrunc.get(idx) ? 1 : 2
    st
f_coverage() =>
    int s1 = f_slotState(en1, ok1, act1, 0)
    int s2 = f_slotState(en2, ok2, act2, 1)
    int s3 = f_slotState(en3, ok3, act3, 2)
    int s4 = f_slotState(en4, ok4, act4, 3)
    int nValid = (s1 == 1 ? 1 : 0) + (s2 == 1 ? 1 : 0) + (s3 == 1 ? 1 : 0) + (s4 == 1 ? 1 : 0)
    int nUnk = (s1 == 2 ? 1 : 0) + (s2 == 2 ? 1 : 0) + (s3 == 2 ? 1 : 0) + (s4 == 2 ? 1 : 0)
    string txt = ""
    if s1 == 1
        txt := f_tfText(sec1)
    if s2 == 1
        txt := txt == "" ? f_tfText(sec2) : txt + "," + f_tfText(sec2)
    if s3 == 1
        txt := txt == "" ? f_tfText(sec3) : txt + "," + f_tfText(sec3)
    if s4 == 1
        txt := txt == "" ? f_tfText(sec4) : txt + "," + f_tfText(sec4)
    [nUnk > 0 ? 1 : (nValid > 0 ? 0 : 2), txt]
f_hasId(array<Zone> a, string id) =>
    bool f = false
    int n = a.size()
    if n > 0
        for i = 0 to n - 1
            if a.get(i).id == id
                f := true
    f
f_contactOk(bool bull) =>
    bool found = false
    int n = cBars.size()
    if n > 0
        for i = 0 to n - 1
            if bar_index - cBars.get(i) <= inRecent - 1 and cDirs.get(i) == (bull ? 1 : -1)
                string id = cIds.get(i)
                if f_hasId(hz1, id) or f_hasId(hz2, id) or f_hasId(hz3, id) or f_hasId(hz4, id)
                    found := true
    found
f_localTs(int ref, string tz, int dayShift, int hh, int mm) =>
    int noon = timestamp(tz, year(ref, tz), month(ref, tz), dayofmonth(ref, tz), 12, 0, 0)
    int shifted = noon + dayShift * 86400000
    timestamp(tz, year(shifted, tz), month(shifted, tz), dayofmonth(shifted, tz), hh, mm, 0)
f_winCand(int T, bool en, bool valid, int sh, int sm, string stz, int eh, int em, string etz) =>
    int bs = na
    int be = na
    if en and valid
        for s = 0 to 1
            int st = f_localTs(T, stz, -s, sh, sm)
            int e0 = f_localTs(st, etz, 0, eh, em)
            int en2 = e0 > st ? e0 : f_localTs(st, etz, 1, eh, em)
            int dw = dayofweek(st, stz)
            bool dayOk = inWkd == "Every day" or (dw >= dayofweek.monday and dw <= dayofweek.friday)
            if dayOk and T >= st and T < en2
                if na(bs) or st > bs
                    bs := st
                    be := en2
    [bs, be]
f_selectWindow(int T) =>
    [sA, eA] = f_winCand(T, inWinAsia, okWinAs, inAsH, inAsM, inAsTz, inLoH, inLoM, inLoTz)
    [sM, eM] = f_winCand(T, inWinAm, okWinAm, inAmSH, inAmSM, inAmTz, inAmEH, inAmEM, inAmTz)
    [sP, eP] = f_winCand(T, inWinPm, okWinPm, inPmSH, inPmSM, inPmTz, inPmEH, inPmEM, inPmTz)
    string bn = ""
    int bs = na
    int be = na
    if not na(sM)
        bn := "New York morning"
        bs := sM
        be := eM
    if not na(sP) and (na(bs) or sP > bs)
        bn := "New York afternoon"
        bs := sP
        be := eP
    if not na(sA) and (na(bs) or sA > bs)
        bn := "Asia -> London"
        bs := sA
        be := eA
    [bn, bs, be]
f_statusText(int T) =>
    string t = "Outside entry windows"
    if not (inWinAsia or inWinAm or inWinPm)
        t := "All entry windows disabled"
    else if not na(T)
        [wn, ws, we] = f_selectWindow(T)
        if not na(ws)
            t := wn
    t
f_evaluate(Zone z) =>
    z.qEval := true
    bool bull = z.state == ST_BULL_IFVG
    string why = ""
    bool ok = true
    if not f_sizeOk(z.width, z.fatr, inIfvgMinT, inIfvgAtr)
        ok := false
        why := f_addWhy(why, inIfvgAtr > 0 and na(z.fatr) ? "Gap ATR unavailable" : "Gap too small")
    bool atrOk = not na(chartAtr1) and chartAtr1 > 0
    float boundary = bull ? z.top : z.bottom
    string route = ""
    if atrOk
        if f_routeA(bull, open, high, low, close, chartAtr1, boundary)
            route := "Single-candle displacement"
        else if f_routeB(bull, inN, open, close, chartAtr1, boundary)
            route := "Multi-candle impulse"
        if route == ""
            ok := false
            why := f_addWhy(why, "Weak impulse")
    else
        ok := false
        why := f_addWhy(why, "Missing volatility data")
    float entry = f_rnd(close)
    float stop = f_stop(bull, inN)
    float risk = bull ? entry - stop : stop - entry
    bool riskOk = not na(stop) and f_tk(risk) >= 1
    if not riskOk
        ok := false
        why := f_addWhy(why, "Invalid risk")
    bool tReady = f_tgtReady()
    [tPrice, tName] = f_nearestTarget(bull, entry)
    float tR = na
    if not tReady
        ok := false
        why := f_addWhy(why, "Target data incomplete")
    else if na(tPrice)
        ok := false
        why := f_addWhy(why, "No eligible target")
    else if riskOk
        tR := (f_tk(tPrice) - f_tk(entry)) / f_tk(risk) * (bull ? 1.0 : -1.0)
        if tR < inMinR - 0.000000001
            ok := false
            why := f_addWhy(why, "Target below " + str.tostring(inMinR, "#.##") + "R (" + str.tostring(math.floor(tR * 100) / 100, "#.00") + "R to " + tName + ")")
    [cov, srcTxt] = f_coverage()
    float horizon = bull ? entry + inMinR * risk : entry - inMinR * risk
    string note = ""
    if cov != 0
        ok := false
        why := f_addWhy(why, cov == 2 ? "No applicable HTF source" : "HTF coverage unknown")
    else if riskOk
        float pathEnd = inPathToTarget and not na(tPrice) ? tPrice : horizon
        float lo = bull ? entry : pathEnd
        float hi = bull ? pathEnd : entry
        [obs, obsName] = f_scanAll(bull, lo, hi)
        if obs > 0
            ok := false
            why := f_addWhy(why, "Blocked by " + obsName)
        else if not inPathToTarget and not na(tPrice)
            float flo = bull ? horizon : tPrice
            float fhi = bull ? tPrice : horizon
            [farObs, farName] = f_scanAll(bull, flo, fhi)
            if farObs > 0
                note := farName + " between " + str.tostring(inMinR, "#.##") + "R and target"
    if inReqSweep
        bool sw = bull ? bar_index - lastSweepBull <= inRecent - 1 : bar_index - lastSweepBear <= inRecent - 1
        if not sw
            ok := false
            why := f_addWhy(why, "Required sweep absent")
    if inReqContact
        if not f_contactOk(bull)
            ok := false
            why := f_addWhy(why, "Required HTF contact absent")
    string winName = ""
    int winStart = na
    int winEnd = na
    int tConf = time_close
    if not (inWinAsia or inWinAm or inWinPm)
        ok := false
        why := f_addWhy(why, "All entry windows disabled")
    else if na(tConf) or tConf <= time
        ok := false
        why := f_addWhy(why, "No reliable close time")
    else
        [wn, ws, we] = f_selectWindow(tConf)
        if na(ws)
            ok := false
            why := f_addWhy(why, "Outside entry windows")
        else
            winName := wn
            winStart := ws
            winEnd := we
    z.qual := ok
    z.qWin := winName
    z.qWinId := winName + "|" + str.tostring(winStart)
    z.qWinStart := winStart
    z.qWinEnd := winEnd
    z.qEntry := entry
    z.qStop := stop
    z.qHorizon := horizon
    z.qTarget := tPrice
    z.qTargetName := tName
    z.qR := tR
    z.qRoute := route
    z.qSrcs := srcTxt
    z.qReasons := why
    z.qNote := note
    if ok
        f_evInc(bull ? 9 : 10, "")
        int di = bull ? 0 : 1
        if qMsg.get(di) == ""
            qMsg.set(di, "Qualified " + (bull ? "bullish" : "bearish") + " iFVG " + syminfo.ticker + " " + timeframe.period + " | Session " + winName + " | Entry " + str.tostring(entry, format.mintick) + " | Stop " + str.tostring(stop, format.mintick) + " | Target " + tName + " @ " + str.tostring(tPrice, format.mintick) + " | " + str.tostring(math.floor(tR * 10) / 10, "#.0") + "R | " + route + " | " + (inPathToTarget ? "path to target clear" : str.tostring(inMinR, "#.##") + "R path clear") + " (horizon " + str.tostring(horizon, format.mintick) + ") | HTF checked: " + srcTxt + (note == "" ? "" : " | note: " + note))
    true
if supported and barstate.isfirst
    if en1 and sec1 > chartSecs and not al1
        warnArr.push(f_tfText(sec1) + " disabled: not an integer multiple of the chart timeframe")
    if en2 and sec2 > chartSecs and not al2
        warnArr.push(f_tfText(sec2) + " disabled: not an integer multiple of the chart timeframe")
    if en3 and sec3 > chartSecs and not al3
        warnArr.push(f_tfText(sec3) + " disabled: not an integer multiple of the chart timeframe")
    if en4 and sec4 > chartSecs and not al4
        warnArr.push(f_tfText(sec4) + " disabled: not an integer multiple of the chart timeframe")
    if nSlots > 0 and effBudget < inBudget
        warnArr.push("Source-history budget clamped to " + str.tostring(effBudget) + " candles (memory bound)")
    if inWinAsia and not okWinAs
        warnArr.push("Entry window A disabled: start equals end")
    if inWinAm and not okWinAm
        warnArr.push("Entry window B disabled: start equals end")
    if inWinPm and not okWinPm
        warnArr.push("Entry window C disabled: start equals end")
bool drawNow = supported and barstate.isconfirmed and (barstate.islast or barstate.islastconfirmedhistory or barstate.isrealtime)
if supported and barstate.isconfirmed
    f_resetEv()
    qMsg.set(0, "")
    qMsg.set(1, "")
    pend.clear()
    lastConfClose := time_close
    refPrice := close
    int nc = chartZ.size()
    if nc > 0
        for i = nc - 1 to 0
            Zone z = chartZ.get(i)
            int r = f_stepChart(z, high, low, close, bar_index, time, time_close)
            if r == 1
                f_evInc(z.dir > 0 ? 3 : 2, "")
                pend.push(z)
            else if r >= 2
                f_destroy(z)
                chartZ.remove(i)
                f_evInc(r == 2 ? 7 : 8, "")
            else if bar_index - z.formBar >= inChWin
                f_destroy(z)
                chartZ.remove(i)
    if bar_index >= 2 and not na(h2c) and not na(l2c)
        int bullGap = f_tk(low) - f_tk(h2c)
        int bearGap = f_tk(l2c) - f_tk(high)
        int dirN = bullGap >= inMinTick ? 1 : (bearGap >= inMinTick ? -1 : 0)
        if dirN != 0
            float zt = dirN > 0 ? low : l2c
            float zb = dirN > 0 ? h2c : high
            Zone nz = Zone.new(id = syminfo.tickerid + "|" + timeframe.period + "|" + str.tostring(time) + "|" + str.tostring(dirN), dir = dirN, state = dirN > 0 ? ST_BULL_FVG : ST_BEAR_FVG, top = zt, bottom = zb, formTime = time, confTime = time_close, availTime = time_close, width = zt - zb, fatr = chartAtr, formBar = bar_index)
            chartZ.push(nz)
            f_evInc(dirN > 0 ? 0 : 1, "")
    while chartZ.size() > inChCap
        Zone old = chartZ.shift()
        f_destroy(old)
    if act1
        f_sync(hz1, 0, f_tfText(sec1), snap1, asOf1)
    if act2
        f_sync(hz2, 1, f_tfText(sec2), snap2, asOf2)
    if act3
        f_sync(hz3, 2, f_tfText(sec3), snap3, asOf3)
    if act4
        f_sync(hz4, 3, f_tfText(sec4), snap4, asOf4)
    f_tapStore(hz1)
    f_tapStore(hz2)
    f_tapStore(hz3)
    f_tapStore(hz4)
    bool pruneC = cBars.size() > 0
    while pruneC
        pruneC := false
        if cBars.size() > 0
            if bar_index - cBars.get(0) > 60 or cBars.size() > 120
                cBars.shift()
                cIds.shift()
                cDirs.shift()
                pruneC := true
    int nl = levels.size()
    if nl > 0
        for i = nl - 1 to 0
            Level lv = levels.get(i)
            if lv.originBar >= 0 and bar_index - lv.originBar > inLvlAge
                levels.remove(i)
            else
                bool touchedL = lv.isHigh ? f_tk(high) >= f_tk(lv.price) : f_tk(low) <= f_tk(lv.price)
                if touchedL
                    if not lv.isHigh and f_tk(low) < f_tk(lv.price) and f_tk(close) > f_tk(lv.price)
                        lastSweepBull := bar_index
                    if lv.isHigh and f_tk(high) > f_tk(lv.price) and f_tk(close) < f_tk(lv.price)
                        lastSweepBear := bar_index
                    lv.consumed := true
                    levels.remove(i)
    if dayOn and not na(pdEnd) and pdEnd != lastDayEnd
        lastDayEnd := pdEnd
        if firstTime <= pdEnd
            f_admit(pdH, true, "PDH", pdEnd, -1, true)
            f_admit(pdL, false, "PDL", pdEnd, -1, true)
            dayReady := true
    if inTgtAsia
        f_sess(0, not na(tAsia), "Asia")
    if inTgtLon
        f_sess(1, not na(tLon), "London")
    if inTgtPivot and bar_index >= inPivL + inPivR
        if f_pivHigh(inPivL, inPivR)
            float ph = high[inPivR]
            bool tchH = false
            for k = 0 to inPivR - 1
                if f_tk(high[k]) >= f_tk(ph)
                    tchH := true
            if not tchH
                f_admit(ph, true, "Swing high", time[inPivR], bar_index - inPivR, false)
        if f_pivLow(inPivL, inPivR)
            float pl = low[inPivR]
            bool tchL = false
            for k = 0 to inPivR - 1
                if f_tk(low[k]) <= f_tk(pl)
                    tchL := true
            if not tchL
                f_admit(pl, false, "Swing low", time[inPivR], bar_index - inPivR, false)
    int np = pend.size()
    if np > 0
        for i = 0 to np - 1
            Zone q = pend.get(i)
            if not q.qEval
                f_evaluate(q)
    if drawNow
        f_drawAll()
if supported and liveNow and not barstate.isconfirmed
    int ncx = chartZ.size()
    if ncx > 0
        for i = 0 to ncx - 1
            Zone zx = chartZ.get(i)
            if zx.qual and not na(zx.qWinEnd) and timenow >= zx.qWinEnd
                if not expIds.includes(zx.id)
                    expIds.push(zx.id)
                f_destroy(zx)
    while expIds.size() > 200
        expIds.shift()
var label statusLbl = na
if supported and barstate.islast
    if inStatus
        string stx = f_statusText(dispClock)
        if na(statusLbl)
            statusLbl := label.new(bar_index, na, stx, yloc = yloc.abovebar, style = label.style_label_down, textcolor = color.gray, color = color.new(color.gray, 85), size = size.tiny)
        else
            label.set_x(statusLbl, bar_index)
            label.set_text(statusLbl, stx)
    else if not na(statusLbl)
        label.delete(statusLbl)
        statusLbl := na
var table warnTbl = table.new(position.top_right, 1, 1, border_width = 0)
f_slotWarn(bool act, int idx, int secs) =>
    string r = ""
    if act and not srcSeen.get(idx)
        r := f_tfText(secs) + ": no source data returned"
    else if act and srcSeen.get(idx) and not srcInit.get(idx) and not srcBad.get(idx)
        r := f_tfText(secs) + ": chart history too short to establish zone state (omitted, not guessed)"
    r
if barstate.islast
    string w = supported ? array.join(warnArr, "\n") : "H Ticks FVG/iFVG: unsupported chart type (needs standard time-based candles; Heikin Ashi/Renko/Range/tick etc. are not valid traded-price OHLC)."
    if supported
        string s1 = f_slotWarn(act1, 0, sec1)
        string s2 = f_slotWarn(act2, 1, sec2)
        string s3 = f_slotWarn(act3, 2, sec3)
        string s4 = f_slotWarn(act4, 3, sec4)
        w += s1 == "" ? "" : (w == "" ? "" : "\n") + s1
        w += s2 == "" ? "" : (w == "" ? "" : "\n") + s2
        w += s3 == "" ? "" : (w == "" ? "" : "\n") + s3
        w += s4 == "" ? "" : (w == "" ? "" : "\n") + s4
    if w == ""
        table.cell(warnTbl, 0, 0, "", bgcolor = na)
    else
        table.cell(warnTbl, 0, 0, w, text_color = color.orange, text_size = size.small, bgcolor = color.new(color.black, 80), text_halign = text.align_left)
bool evNow = supported and barstate.isrealtime and barstate.isconfirmed
f_part(string label, int n, string tfs) =>
    n > 0 ? label + " x" + str.tostring(n) + (tfs == "" ? "" : " [" + tfs + "]") : ""
f_add(string a, string b) =>
    b == "" ? a : (a == "" ? b : a + " | " + b)
if evNow
    if alQual
        if ev.get(9) > 0
            alert(qMsg.get(0) + " | zones: " + str.tostring(ev.get(9)), alert.freq_once_per_bar_close)
        if ev.get(10) > 0
            alert(qMsg.get(1) + " | zones: " + str.tostring(ev.get(10)), alert.freq_once_per_bar_close)
    string msg = ""
    msg := f_add(msg, alNewBull ? f_part("New bullish FVG", ev.get(0), "") : "")
    msg := f_add(msg, alNewBear ? f_part("New bearish FVG", ev.get(1), "") : "")
    msg := f_add(msg, alBullIf ? f_part("Bullish iFVG confirmed", ev.get(2), "") : "")
    msg := f_add(msg, alBearIf ? f_part("Bearish iFVG confirmed", ev.get(3), "") : "")
    msg := f_add(msg, alHtfNew ? f_part("New HTF FVG", ev.get(4), evTf.get(4)) : "")
    msg := f_add(msg, alHtfTap ? f_part("HTF FVG first tapped", ev.get(5), evTf.get(5)) : "")
    msg := f_add(msg, alHtfRem ? f_part("HTF FVG removed by source inversion", ev.get(6), evTf.get(6)) : "")
    msg := f_add(msg, alIfRem ? f_part("iFVG removed (touch)", ev.get(7), "") : "")
    msg := f_add(msg, alIfRem ? f_part("iFVG removed (invalidation)", ev.get(8), "") : "")
    if msg != ""
        alert("H Ticks FVG/iFVG " + syminfo.ticker + " " + timeframe.period + ": " + msg, alert.freq_once_per_bar_close)
alertcondition(evNow and ev.get(9) > 0, "Qualified bullish iFVG", "H Ticks: Qualified bullish iFVG on {{ticker}} {{interval}}")
alertcondition(evNow and ev.get(10) > 0, "Qualified bearish iFVG", "H Ticks: Qualified bearish iFVG on {{ticker}} {{interval}}")
alertcondition(evNow and ev.get(0) > 0, "New bullish chart FVG", "H Ticks: new bullish FVG on {{ticker}} {{interval}}")
alertcondition(evNow and ev.get(1) > 0, "New bearish chart FVG", "H Ticks: new bearish FVG on {{ticker}} {{interval}}")
alertcondition(evNow and ev.get(2) > 0, "Bullish chart iFVG confirmed", "H Ticks: bullish iFVG confirmed on {{ticker}} {{interval}}")
alertcondition(evNow and ev.get(3) > 0, "Bearish chart iFVG confirmed", "H Ticks: bearish iFVG confirmed on {{ticker}} {{interval}}")
alertcondition(evNow and ev.get(4) > 0, "New HTF FVG", "H Ticks: new HTF FVG on {{ticker}} (chart {{interval}})")
alertcondition(evNow and ev.get(5) > 0, "HTF FVG first tapped", "H Ticks: HTF FVG first tapped on {{ticker}} (chart {{interval}})")
alertcondition(evNow and ev.get(6) > 0, "HTF FVG removed by source inversion", "H Ticks: HTF FVG removed by source inversion on {{ticker}} (chart {{interval}})")
alertcondition(evNow and (ev.get(7) > 0 or ev.get(8) > 0), "Chart iFVG removed", "H Ticks: chart iFVG removed on {{ticker}} {{interval}}")
