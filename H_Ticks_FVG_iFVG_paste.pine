//@version=6
indicator("H Ticks — FVG / iFVG", shorttitle = "H Ticks", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 500)
const string GRP_CTX = "Context timeframe"
const string GRP_WIN = "Entry windows (Asia 09:00 Tokyo -> 08:00 London, NY 09:45-11:30, NY 14:30-15:30; DST-aware; Mon-Fri)"
const string GRP_Q   = "Setup quality"
const string GRP_APP = "Chart appearance"
const string GRP_ST  = "Statistics"
const string GRP_DBG = "Debug"
const string GRP_AL  = "Alerts"
string inCtxSel = input.string("Auto (1m, 2m, 3m, 5m)", "Context timeframe", options = ["Auto (1m, 2m, 3m, 5m)", "1m only", "2m only", "3m only", "5m only"], group = GRP_CTX, tooltip = "Auto: each of 1m, 2m, 3m and 5m is tracked independently and ANY ONE can supply a valid setup (no agreement required). If several pass on the same 30s trigger, 5m > 3m > 2m > 1m picks the one entry (tie-break only).")
bool   inWinAsia = input.bool(true, "Window A: Asia open -> London open", group = GRP_WIN)
bool   inWinAm = input.bool(true, "Window B: New York morning 09:45-11:30", group = GRP_WIN, tooltip = "Start inclusive, end exclusive. BOTH the context inversion and the entry must belong to the same window instance (max 3 entries per instance, one unresolved setup at a time).")
bool   inWinPm = input.bool(true, "Window C: New York afternoon 14:30-15:30", group = GRP_WIN)
string inPreset = input.string("Standard", "Impulse preset (decisive 30s inversion candle)", options = ["Standard", "Strong"], group = GRP_Q, tooltip = "Standard: body >= 0.8 x prev ATR, body/range >= 0.65, close in the outer 20% of the range. Strong: 1.0 x, 0.70, outer 15%. Both: body points in the setup direction and the close extends beyond the trigger gap boundary by max(1 tick, 0.10 x prev ATR). Starting parameters, not optimised or proven.")
int    inMinTick = input.int(1, "Minimum gap size (ticks, all gap sources)", minval = 1, group = GRP_Q, tooltip = "Gaps at least this wide are detected and may form contexts, triggers and obstacles.")
bool   inShowPair = input.bool(true, "Show the context gap + 30s trigger gap of every setup", group = GRP_APP)
bool   inShowHtf = input.bool(false, "Show nearby HTF gap boxes (clutter; OFF by default)", group = GRP_APP, tooltip = "Display only. Obstacle checks ALWAYS use all tracked 15m/1H/4H gaps, shown or hidden.")
bool   inShowMarkers = input.bool(false, "Show detail markers (retest, stop anchor, inversion candles)", group = GRP_APP, tooltip = "Small labels that explain how a setup formed. The same facts are always in the label tooltips.")
bool   inShowRR = input.bool(true, "Show risk/reward shading", group = GRP_APP)
string inTheme = input.string("Light", "Theme (labels and tables)", options = ["Light", "Dark"], group = GRP_APP, tooltip = "Light: black entry line. Dark: white entry line (black would be invisible). Tables always use opaque backgrounds.")
bool   inStats = input.bool(true, "Show the small stats box (top-right)", group = GRP_ST)
bool   inDaily = input.bool(false, "Optional: daily breakdown under the stats box", group = GRP_ST)
int    inRepDays = input.int(20, "Days reported (stats box and debug counts)", minval = 1, maxval = 20, group = GRP_ST, tooltip = "How many of the latest Mon-Fri New York dates the stats box and the debug counts cover. If the chart has fewer dates loaded, everything available is used and Coverage reads Partial. TradingView limits how many 30s bars are loaded; the script cannot add more.")
bool   inDebug = input.bool(false, "Debug panel: per-date / per-session funnel, first failed gate, lock intervals, source readiness, rejection records", group = GRP_DBG, tooltip = "Counts cover the reported NY dates (setting: Days reported). Every rejected candidate is counted once at its FIRST failed gate and written to Pine Logs with timestamps, source timeframe and measured value vs threshold.")
string inDbgLbl = input.string("NY windows only", "Debug: rejected-candidate labels (full record in the label tooltip and in Pine Logs)", options = ["Off", "NY windows only", "All sessions"], group = GRP_DBG, tooltip = "Only the latest 30 labels can exist at once. EVERY rejected candidate is also written to the Pine Logs pane while Debug is ON.")
bool   alEntry = input.bool(true, "Alert on each new entry", group = GRP_AL)
bool   alTarget = input.bool(true, "Alert when a setup hits its target", group = GRP_AL)
