f_tk(float x) =>
    math.round(x / syminfo.mintick)
f_overlap(float hi, float lo, float zb, float zt) =>
    f_tk(hi) >= f_tk(zb) and f_tk(lo) <= f_tk(zt)
f_tfText(int s) =>
    string r = ""
    if s >= 604800 and s % 604800 == 0
        r := str.tostring(int(s / 604800)) + "W"
    else if s >= 86400 and s % 86400 == 0
        r := str.tostring(int(s / 86400)) + "D"
    else if s >= 3600 and s % 3600 == 0
        r := str.tostring(int(s / 3600)) + "H"
    else if s >= 60 and s % 60 == 0
        r := str.tostring(int(s / 60)) + "m"
    else
        r := str.tostring(s) + "s"
    r
f_push(array<float> z, int ft, int dir, float tp, float bt, int conf, int fidx, float atr) =>
    z.push(float(ft))
    z.push(float(dir))
    z.push(tp)
    z.push(bt)
    z.push(float(conf))
    z.push(0.0)
    z.push(float(fidx))
    z.push(na(atr) ? -1.0 : atr)
    true
f_engine(int cap, int minTicks, int horizonMs) =>
    var array<float> Z = array.new_float(0)
    var array<float> pub = array.from(0.0, 0.0, 0.0)
    var float maxPruned = -1.0
    var bool lastTrunc = false
    var bool lastReady = false
    var float lastProc = 0.0
    var int firstProcT = 0
    array<float> out = na
    float atrS = ta.atr(14)
    float fatr1 = atrS[1]
    float h1 = high[1]
    float l1 = low[1]
    float c1 = close[1]
    float h2 = high[2]
    float l2 = low[2]
    float h3 = high[3]
    float l3 = low[3]
    int   t1 = time[1]
    int   tc1 = time_close[1]
    int   cidx = bar_index - 1
    bool  valid = not na(h1) and not na(l1) and not na(c1) and not na(t1) and not na(tc1)
    bool  active = valid
    if active
        if t1 > lastProc
            lastProc := t1
            if firstProcT == 0
                firstProcT := t1
            bool dirty = false
            int n0 = int(Z.size() / ZS)
            if n0 > 0
                for i = n0 - 1 to 0
                    if math.abs(Z.get(i * ZS + 1)) == 2.0
                        for k = 1 to ZS
                            Z.remove(i * ZS)
                        dirty := true
            int n1 = int(Z.size() / ZS)
            if n1 > 0
                for i = 0 to n1 - 1
                    int b = i * ZS
                    if t1 >= int(Z.get(b + 4))
                        float cd = Z.get(b + 1)
                        float zt = Z.get(b + 2)
                        float zb = Z.get(b + 3)
                        bool inv = cd > 0 ? f_tk(c1) < f_tk(zb) : f_tk(c1) > f_tk(zt)
                        if inv
                            Z.set(b + 1, cd * 2.0)
                            dirty := true
                        else if Z.get(b + 5) == 0.0 and f_overlap(h1, l1, zb, zt)
                            Z.set(b + 5, float(tc1))
                            dirty := true
            if not na(h2) and not na(l2) and not na(h3) and not na(l3)
                int bullGap = f_tk(l1) - f_tk(h3)
                int bearGap = f_tk(l3) - f_tk(h1)
                if bullGap >= minTicks
                    f_push(Z, t1, 1, l1, h3, tc1, cidx, fatr1)
                    dirty := true
                else if bearGap >= minTicks
                    f_push(Z, t1, -1, l3, h1, tc1, cidx, fatr1)
                    dirty := true
            int n2 = int(Z.size() / ZS)
            if n2 > 0
                for i = n2 - 1 to 0
                    if math.abs(Z.get(i * ZS + 1)) == 1.0 and t1 - int(Z.get(i * ZS)) >= horizonMs
                        for k = 1 to ZS
                            Z.remove(i * ZS)
                        dirty := true
            int n3 = int(Z.size() / ZS)
            int nFlag = 0
            if n3 > 0
                for i = 0 to n3 - 1
                    if math.abs(Z.get(i * ZS + 1)) == 2.0
                        nFlag += 1
            int over = n3 - nFlag - cap
            while over > 0
                int pIdx = -1
                int nn = int(Z.size() / ZS)
                for i = 0 to nn - 1
                    if pIdx < 0 and math.abs(Z.get(i * ZS + 1)) == 1.0
                        pIdx := i
                if pIdx >= 0
                    maxPruned := math.max(maxPruned, Z.get(pIdx * ZS))
                    for k = 1 to ZS
                        Z.remove(pIdx * ZS)
                    dirty := true
                over -= 1
            bool truncNow = maxPruned >= 0 and t1 - maxPruned < horizonMs
            if truncNow != lastTrunc
                lastTrunc := truncNow
                dirty := true
            bool nowReady = t1 - firstProcT >= horizonMs
            if nowReady != lastReady
                lastReady := nowReady
                dirty := true
            if dirty
                array<float> tmp = array.from(truncNow ? 1.0 : 0.0, nowReady ? float(tc1) : 0.0, float(firstProcT))
                if nowReady
                    tmp.concat(Z)
                pub := tmp
        out := pub
    out
f_lvlEngine(int cap, int horizonMs) =>
    var array<float> L = array.new_float(0)
    var array<float> pub = array.from(0.0, 0.0, 0.0)
    var float maxPruned = -1.0
    var bool lastTrunc = false
    var bool lastReady = false
    var float lastProc = 0.0
    var int firstProcT = 0
    array<float> out = na
    float h1 = high[1]
    float l1 = low[1]
    float h2 = high[2]
    float l2 = low[2]
    float h3 = high[3]
    float l3 = low[3]
    float h4 = high[4]
    float l4 = low[4]
    float h5 = high[5]
    float l5 = low[5]
    int   t1 = time[1]
    int   tc1 = time_close[1]
    int   t3 = time[3]
    bool  valid = not na(h1) and not na(l1) and not na(t1) and not na(tc1)
    bool  active = valid
    if active
        if t1 > lastProc
            lastProc := t1
            if firstProcT == 0
                firstProcT := t1
            bool dirty = false
            int n0 = int(L.size() / LS)
            if n0 > 0
                for i = n0 - 1 to 0
                    int b = i * LS
                    bool hit = false
                    if t1 >= int(L.get(b + 3))
                        hit := L.get(b + 1) > 0 ? f_tk(h1) >= f_tk(L.get(b)) : f_tk(l1) <= f_tk(L.get(b))
                    bool old = t1 - int(L.get(b + 2)) >= horizonMs
                    if hit or old
                        for k = 1 to LS
                            L.remove(b)
                        dirty := true
            if not na(h5) and not na(l5) and not na(t3)
                bool ph = f_tk(h3) > f_tk(h4) and f_tk(h3) > f_tk(h5) and f_tk(h3) > f_tk(h2) and f_tk(h3) > f_tk(h1)
                bool pl = f_tk(l3) < f_tk(l4) and f_tk(l3) < f_tk(l5) and f_tk(l3) < f_tk(l2) and f_tk(l3) < f_tk(l1)
                if ph
                    L.push(h3)
                    L.push(1.0)
                    L.push(float(t3))
                    L.push(float(tc1))
                    dirty := true
                if pl
                    L.push(l3)
                    L.push(-1.0)
                    L.push(float(t3))
                    L.push(float(tc1))
                    dirty := true
            int over = int(L.size() / LS) - cap
            while over > 0
                maxPruned := math.max(maxPruned, L.get(2))
                for k = 1 to LS
                    L.remove(0)
                dirty := true
                over -= 1
            bool truncNow = maxPruned >= 0 and t1 - maxPruned < horizonMs
            if truncNow != lastTrunc
                lastTrunc := truncNow
                dirty := true
            bool nowReady = t1 - firstProcT >= horizonMs
            if nowReady != lastReady
                lastReady := nowReady
                dirty := true
            if dirty
                array<float> tmp = array.from(truncNow ? 1.0 : 0.0, nowReady ? float(tc1) : 0.0, float(firstProcT))
                if nowReady
                    tmp.concat(L)
                pub := tmp
        out := pub
    out
f_bias15() =>
    var float swH = na
    var float swHT = na
    var float swHA = na
    var bool  swHB = true
    var float swL = na
    var float swLT = na
    var float swLA = na
    var bool  swLB = true
    var float bias = 0.0
    var float bLvl = na
    var float bLvlT = na
    var float bAv = na
    var float lastProc = 0.0
    float h1 = high[1]
    float l1 = low[1]
    float c1 = close[1]
    float h2 = high[2]
    float l2 = low[2]
    float h3 = high[3]
    float l3 = low[3]
    float h4 = high[4]
    float l4 = low[4]
    float h5 = high[5]
    float l5 = low[5]
    int   t1 = time[1]
    int   tc1 = time_close[1]
    int   t3 = time[3]
    bool  valid = not na(c1) and not na(t1) and not na(tc1)
    if valid
        if t1 > lastProc
            lastProc := t1
            if not na(swH) and not swHB and swHA <= t1 and f_tk(c1) > f_tk(swH)
                bias := 1.0
                bLvl := swH
                bLvlT := swHT
                bAv := float(tc1)
                swHB := true
            else if not na(swL) and not swLB and swLA <= t1 and f_tk(c1) < f_tk(swL)
                bias := -1.0
                bLvl := swL
                bLvlT := swLT
                bAv := float(tc1)
                swLB := true
            if not na(h5) and not na(l5) and not na(t3)
                if f_tk(h3) > f_tk(h4) and f_tk(h3) > f_tk(h5) and f_tk(h3) > f_tk(h2) and f_tk(h3) > f_tk(h1)
                    swH := h3
                    swHT := float(t3)
                    swHA := float(tc1)
                    swHB := false
                if f_tk(l3) < f_tk(l4) and f_tk(l3) < f_tk(l5) and f_tk(l3) < f_tk(l2) and f_tk(l3) < f_tk(l1)
                    swL := l3
                    swLT := float(t3)
                    swLA := float(tc1)
                    swLB := false
    [bias, bLvl, bLvlT, bAv]
bool stdChart  = chart.is_standard and not timeframe.isticks
bool supported = stdChart and timeframe.isseconds and timeframe.multiplier == 30
int  chartSecs = supported ? timeframe.in_seconds() : 0
int  chartMs   = chartSecs * 1000
int  sec1 = timeframe.in_seconds(tf1)
int  sec2 = timeframe.in_seconds(tf2)
int  sec3 = timeframe.in_seconds(tf3)
int  sec4 = timeframe.in_seconds(tf4)
bool ok1 = supported and en1 and sec1 > chartSecs
bool ok2 = supported and en2 and sec2 > chartSecs and not (ok1 and sec2 == sec1)
bool ok3 = supported and en3 and sec3 > chartSecs and not (ok1 and sec3 == sec1) and not (ok2 and sec3 == sec2)
bool ok4 = supported and en4 and sec4 > chartSecs and not (ok1 and sec4 == sec1) and not (ok2 and sec4 == sec2) and not (ok3 and sec4 == sec3)
bool al1 = chartSecs > 0 and sec1 % chartSecs == 0
bool al2 = chartSecs > 0 and sec2 % chartSecs == 0
bool al3 = chartSecs > 0 and sec3 % chartSecs == 0
bool al4 = chartSecs > 0 and sec4 % chartSecs == 0
bool act1 = ok1 and al1
bool act2 = ok2 and al2
bool act3 = ok3 and al3
bool act4 = ok4 and al4
int  secL = 180
bool actL = supported and chartSecs > 0 and secL % chartSecs == 0
bool sel1 = inCtxSel == "Auto (1m, 2m, 3m, 5m)" or inCtxSel == "1m only"
bool sel2 = inCtxSel == "Auto (1m, 2m, 3m, 5m)" or inCtxSel == "2m only"
bool sel3 = inCtxSel == "Auto (1m, 2m, 3m, 5m)" or inCtxSel == "3m only"
bool sel5 = inCtxSel == "Auto (1m, 2m, 3m, 5m)" or inCtxSel == "5m only"
bool actC0 = supported and sel1 and chartSecs > 0 and 60 % chartSecs == 0
bool actC1 = supported and sel2 and chartSecs > 0 and 120 % chartSecs == 0
bool actC2 = supported and sel3 and chartSecs > 0 and 180 % chartSecs == 0
bool actC3 = supported and sel5 and chartSecs > 0 and 300 % chartSecs == 0
array<bool> actCtxA = array.from(actC0, actC1, actC2, actC3)
int  hrzC0 = inCtxHorizon * 60 * 1000
int  hrzC1 = inCtxHorizon * 120 * 1000
int  hrzC2 = inCtxHorizon * 180 * 1000
int  hrzC3 = inCtxHorizon * 300 * 1000
int  hrzL = inCtxHorizon * secL * 1000
int  hrz1 = inHorizon * sec1 * 1000
int  hrz2 = inHorizon * sec2 * 1000
int  hrz3 = inHorizon * sec3 * 1000
int  hrz4 = inHorizon * sec4 * 1000
array<float> snapC0 = na
array<float> snapC1 = na
array<float> snapC2 = na
array<float> snapC3 = na
array<float> snap1 = na
array<float> snap2 = na
array<float> snap3 = na
array<float> snap4 = na
array<float> snapL = na
float bzR = na
float blR = na
float btR = na
