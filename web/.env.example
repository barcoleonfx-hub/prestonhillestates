# Database: a local file in development, a hosted libSQL/Turso URL in production
DATABASE_URL=file:./data/prestonhill.db
DATABASE_AUTH_TOKEN=

# Long random string used to sign admin sessions (generate with: openssl rand -base64 48)
AUTH_SECRET=

# Media storage: "local" stores uploads in ./uploads; "s3" uses any S3-compatible bucket (AWS S3, Cloudflare R2)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL the bucket's files are served from, e.g. https://media.prestonhillestates.com
MEDIA_PUBLIC_BASE_URL=

# Staff portal address, used for links in reminder emails
PORTAL_URL=https://www.prestonhillestates.com

# Outgoing email for appointment alerts. Leave SMTP_HOST empty in development: emails are saved to data/outbox instead.
# Office 365: SMTP_HOST=smtp.office365.com SMTP_PORT=587 with the mailbox address and password (or an app password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Preston Hill Estates <info@prestonhillestates.com>

# Secret for /api/cron/reminders, which sends reminders even when nobody has the portal open.
# Call it every 5 minutes with the header "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Where uploads and saved emails live when STORAGE_DRIVER=local (point these at a persistent disk in production)
UPLOADS_DIR=uploads
OUTBOX_DIR=data/outbox

# First admin, created automatically on a fresh database (handy on hosts without shell access)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Personal details are deleted after this many months with no contact (agreed: 24)
RETENTION_MONTHS=24
