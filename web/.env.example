# Database: a local file in development, a hosted libSQL/Turso URL in production
DATABASE_URL=file:./data/prestonhill.db
DATABASE_AUTH_TOKEN=

# Long random string used to sign admin sessions (generate with: openssl rand -base64 48)
AUTH_SECRET=

# Media storage: "local" stores uploads in ./uploads; "s3" uses any S3-compatible bucket (AWS S3, Cloudflare R2)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL the bucket's files are served from, e.g. https://media.prestonhillestates.com
MEDIA_PUBLIC_BASE_URL=
