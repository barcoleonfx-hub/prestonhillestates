//@version=6
// ─────────────────────────────────────────────────────────────────────────────────────────────
// H Ticks — FVG / iFVG
//
// ARCHITECTURE (short)
//   * CURRENT-CHART LAYER : FVGs of the open chart timeframe -> may become iFVG -> removed on first
//                           later touch / strict invalidation. Computed bar-by-bar on the chart series.
//   * HTF CONTEXT LAYER   : up to 4 source-timeframe slots. A lifecycle engine runs INSIDE
//                           request.security() on the source series (formation, source-close inversion,
//                           source-range touches) and hands the chart a snapshot of its live zones.
//                           The chart adds finer-grained taps from chart candles and removes zones the
//                           engine reports as inverted. HTF zones are never shown as iFVG.
//   * Both layers keep separate state arrays, inputs, visibility and lifecycle code.
//
// NON-REPAINTING HTF DATA
//   The engine only reads series offsets >= 1 (high[1], close[1], time[1] ...) i.e. the last COMPLETED
//   source candle, and the companion request is the documented time_close[1] + lookahead_on pattern.
//   No unfinished source OHLC is ever read and no second offset is stacked on top.
//
// TIMING (alerts and drawings share it)
//   Every lifecycle change AND every drawing mutation happens only on a CONFIRMED chart bar. Unconfirmed
//   realtime ticks change nothing (no provisional colours, nothing for rollback to duplicate). A wick
//   touch is committed at the chart candle's close. HTF events are available at the open of the first
//   chart bar of the next source period and shown/alerted at that bar's close. formTime/confTime/tapTime
//   are SOURCE times; availTime/tapAvail/invAvail are the CHART times at which they were processed.
//
// COVERAGE POLICY (one rule for live and reload)
//   A zone is tracked only while its formation candle is within the last N candles of its own series
//   (N = source-history budget for HTF slots, chart-window input for the chart layer). Older zones EXPIRE
//   silently: expiry is not an inversion, is never alerted, and never recolours anything. The engine only
//   reconstructs candles inside the same window, so an uninterrupted session and a fresh reload hold the
//   same zones at the same bar. Capacity pruning (oldest unflagged first) is likewise silent and is
//   never price-based. The chart-window must not exceed the number of bars the chart loads.
//
// SESSION BASIS
//   All requests use syminfo.tickerid, so the chart's symbol, session (RTH/ETH) and adjustment settings
//   are shared by every source timeframe. Standard time-based candles only.
//
// MEMORY
//   A snapshot is 8 floats per live zone. The engine publishes a NEW array only when its state changed
//   and otherwise returns the same, never-mutated reference. Worst case (every bar changes, every slot
//   full) = slots x budget x 8 x capacity x 8 bytes; the effective budget is clamped so that bound
//   stays <= 8,000,000 floats (64 MB). Default (2 slots, 1000, 100): <= ~13 MB bound, typically far less.
// ─────────────────────────────────────────────────────────────────────────────────────────────
indicator("H Ticks — FVG / iFVG", shorttitle = "H Ticks FVG/iFVG", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ═════════════════════════════════════════ INPUTS ═════════════════════════════════════════════
const string GRP_GEN = "General"
const string GRP_CH  = "Current-chart layer"
const string GRP_HTF = "Higher-timeframe context layer"
const string GRP_AL  = "Alerts (aggregated alert() calls)"

bool   inLabels  = input.bool(true,  "Show labels", group = GRP_GEN)
bool   inMid     = input.bool(false, "Show midpoint line (visual only)", group = GRP_GEN)
bool   inMarker  = input.bool(false, "Show inversion marker (chart iFVGs)", group = GRP_GEN)
int    inMinTick = input.int(1, "Minimum DETECTION size (whole ticks)", minval = 1, group = GRP_GEN, tooltip = "Gaps at least this wide are detected and TRACKED. Display filters only decide what is drawn; hidden zones remain tracked and still invert, get tapped or are removed.")
int    inExt     = input.int(0, "Right extension (chart bars, approximate across session gaps)", minval = 0, maxval = 50, group = GRP_GEN)
color  inBull    = input.color(color.rgb(46, 160, 110), "Bullish colour", group = GRP_GEN)
color  inBear    = input.color(color.rgb(201, 82, 77), "Bearish colour", group = GRP_GEN)
int    inBordT   = input.int(70, "Border transparency", minval = 0, maxval = 100, group = GRP_GEN)
string inPrio    = input.string("Nearest to price", "Display priority", options = ["Nearest to price", "Most recently formed"], group = GRP_GEN, tooltip = "Ranks which zones fill the display budgets. Reference = last confirmed chart close; ranking changes only on confirmed bars. Nearest uses nearest-EDGE distance (0 if price is inside), ties by most recent formation.")
bool   inNearest = inPrio == "Nearest to price"

bool   inShowFvg  = input.bool(true, "Show current-chart FVGs", group = GRP_CH)
bool   inShowIfvg = input.bool(true, "Show current-chart iFVGs", group = GRP_CH)
int    inMaxFvg   = input.int(3, "Max visible ordinary FVGs", minval = 0, maxval = 20, group = GRP_CH, tooltip = "Separate budget: ordinary FVGs never use an iFVG slot. Display limits do not change inversion logic.")
int    inMaxIfvg  = input.int(2, "Max visible iFVGs", minval = 0, maxval = 20, group = GRP_CH)
float  inFvgAtr   = input.float(0.10, "FVG size filter: ATR multiple (0 = off)", minval = 0.0, step = 0.05, group = GRP_CH, tooltip = "Formation-size filter. Width must be >= max(min ticks x mintick, multiple x formation ATR(14)). ATR is frozen at the gap's confirmed formation candle (chart ATR for chart zones). If ATR is unavailable and the multiple is > 0 the zone is hidden (still tracked).")
int    inFvgMinT  = input.int(4, "FVG size filter: min ticks", minval = 1, group = GRP_CH)
float  inIfvgAtr  = input.float(0.10, "iFVG size filter: ATR multiple (0 = off)", minval = 0.0, step = 0.05, group = GRP_CH, tooltip = "Independent iFVG threshold. Uses the ORIGINAL gap's frozen formation ATR, not ATR at inversion. A hidden ordinary FVG can become a visible iFVG.")
int    inIfvgMinT = input.int(4, "iFVG size filter: min ticks", minval = 1, group = GRP_CH)
bool   inDistOn   = input.bool(true, "Chart-zone distance filter", group = GRP_CH, tooltip = "Distance filtering uses CURRENT confirmed chart ATR(14) and changes as price/ATR change. Zones containing price always pass. Hidden zones remain tracked and may reappear without any alert. Not applied to HTF zones.")
float  inDistAtr  = input.float(3.0, "Max distance (chart ATR)", minval = 0.1, step = 0.5, group = GRP_CH)
int    inChCap    = input.int(200, "Tracking capacity (zones)", minval = 20, maxval = 500, group = GRP_CH)
int    inChWin    = input.int(4500, "Tracking window (chart bars; keep below bars your plan loads)", minval = 100, maxval = 20000, group = GRP_CH)
int    inChT      = input.int(92, "Fill transparency", minval = 0, maxval = 100, group = GRP_CH)

bool   inShowHtf  = input.bool(true, "Show HTF context gaps", group = GRP_HTF)
int    inHtfAbove = input.int(1, "Max zones ABOVE price (per source)", minval = 0, maxval = 10, group = GRP_HTF, tooltip = "Separate budgets per source: above (bottom > price), below (top < price), containing (bottom <= price <= top; boundary contact counts here only). Up to three zones per source.")
int    inHtfBelow = input.int(1, "Max zones BELOW price (per source)", minval = 0, maxval = 10, group = GRP_HTF)
int    inHtfCont  = input.int(1, "Max zones CONTAINING price (per source)", minval = 0, maxval = 10, group = GRP_HTF)
float  inHtfAtr   = input.float(0.10, "HTF size filter: ATR multiple (0 = off)", minval = 0.0, step = 0.05, group = GRP_HTF, tooltip = "Width must be >= max(min ticks x mintick, multiple x the gap's frozen SOURCE-timeframe ATR(14) at its confirmed formation candle). Never chart ATR.")
int    inHtfMinT  = input.int(4, "HTF size filter: min ticks", minval = 1, group = GRP_HTF)
int    inHtfCap   = input.int(100, "Tracking capacity per source", minval = 10, maxval = 200, group = GRP_HTF)
int    inHtfT     = input.int(92, "Untapped fill transparency", minval = 0, maxval = 100, group = GRP_HTF)
int    inHtfTapT  = input.int(95, "Tapped fill transparency", minval = 0, maxval = 100, group = GRP_HTF)
int    inBudget   = input.int(1000, "Source-history budget (source candles per slot; may be clamped for memory)", minval = 100, maxval = 4000, group = GRP_HTF)
bool   en1 = input.bool(true,  "Slot 1", inline = "s1", group = GRP_HTF)
string tf1 = input.timeframe("15",  "", inline = "s1", group = GRP_HTF)
bool   en2 = input.bool(true,  "Slot 2", inline = "s2", group = GRP_HTF)
string tf2 = input.timeframe("60",  "", inline = "s2", group = GRP_HTF)
bool   en3 = input.bool(false, "Slot 3", inline = "s3", group = GRP_HTF)
string tf3 = input.timeframe("240", "", inline = "s3", group = GRP_HTF)
bool   en4 = input.bool(false, "Slot 4", inline = "s4", group = GRP_HTF)
string tf4 = input.timeframe("1D",  "", inline = "s4", group = GRP_HTF)

bool   alNewBull = input.bool(true,  "New bullish chart FVG", group = GRP_AL)
bool   alNewBear = input.bool(true,  "New bearish chart FVG", group = GRP_AL)
bool   alBullIf  = input.bool(true,  "Bullish chart iFVG confirmed", group = GRP_AL)
bool   alBearIf  = input.bool(true,  "Bearish chart iFVG confirmed", group = GRP_AL)
bool   alHtfNew  = input.bool(true,  "New HTF FVG", group = GRP_AL)
bool   alHtfTap  = input.bool(true,  "HTF FVG first tapped", group = GRP_AL)
bool   alHtfRem  = input.bool(true,  "HTF FVG removed by source inversion", group = GRP_AL)
bool   alIfRem   = input.bool(false, "Chart iFVG removed (overlap / invalidation)", group = GRP_AL)

// ═════════════════════════════════════════ TYPES ══════════════════════════════════════════════
const int ZS = 8   // engine record size (floats per zone)
const int ST_BULL_FVG  = 1
const int ST_BEAR_FVG  = 2
const int ST_BULL_IFVG = 3   // arises from a BEARISH FVG (green)
const int ST_BEAR_IFVG = 4   // arises from a BULLISH FVG (red)
const int ST_UNT_BULL  = 11
const int ST_TAP_BULL  = 12
const int ST_UNT_BEAR  = 13
const int ST_TAP_BEAR  = 14
// REMOVED is terminal: removed/expired zones are destroyed immediately and never re-created
// (chart layer: creation only at the current bar; HTF layer: per-source import watermark).

type Zone
    string id
    int    src = -1          // HTF slot index, -1 = chart layer
    string tfTxt = ""
    int    dir               // ORIGINAL direction: +1 bullish, -1 bearish
    int    state
    float  top               // immutable original boundaries
    float  bottom
    int    formTime          // open time of candle 3 (source time)
    int    confTime          // close time of candle 3 = moment the gap became confirmed (source time)
    int    availTime         // chart time at which the script processed/imported it
    int    formBar = -1      // chart layer only
    int    invBar = -1       // chart layer only
    int    invTime           // chart inversion candle open time
    int    invAvail          // chart time of inversion commit
    bool   tapped = false
    int    tapTime           // event time (source candle close, or chart candle open)
    int    tapAvail          // chart time of commit
    int    lastEvt           // last source snapshot (source bar close time) applied
    float  width             // frozen original width (top - bottom)
    float  fatr              // frozen formation ATR(14) of the zone's own timeframe (na = unavailable)
    bool   seen = false
    bool   endNow = false
    int    cat = -1          // transient display classification (never lifecycle state)
    float  dist = 0.0
    bool   vis = false
    box    bx                // persistent drawing handles (mutated only on confirmed bars)
    line   mid
    label  mk

// ═════════════════════════════════════════ PURE HELPERS ═══════════════════════════════════════
// Tick-aware integer comparison: prices are snapped to whole ticks; no buffer is added.
f_tk(float x) =>
    math.round(x / syminfo.mintick)

// Closed-interval overlap of a candle range with the ORIGINAL zone boundaries.
f_overlap(float hi, float lo, float zb, float zt) =>
    f_tk(hi) >= f_tk(zb) and f_tk(lo) <= f_tk(zt)

f_tfText(int s) =>
    string r = ""
    if s >= 604800 and s % 604800 == 0
        r := str.tostring(int(s / 604800)) + "W"
    else if s >= 86400 and s % 86400 == 0
        r := str.tostring(int(s / 86400)) + "D"
    else if s >= 3600 and s % 3600 == 0
        r := str.tostring(int(s / 3600)) + "H"
    else if s >= 60 and s % 60 == 0
        r := str.tostring(int(s / 60)) + "m"
    else
        r := str.tostring(s) + "s"
    r

// Engine zone record (8 floats): formTime, code (+-1 live, +-2 inverted-this-bar; sign = direction),
// top, bottom, confTime, tapTime (0 = untapped), formation candle index, formation ATR (-1 = n/a).
f_push(array<float> z, int ft, int dir, float tp, float bt, int conf, int fidx, float atr) =>
    z.push(float(ft))
    z.push(float(dir))
    z.push(tp)
    z.push(bt)
    z.push(float(conf))
    z.push(0.0)
    z.push(float(fidx))
    z.push(na(atr) ? -1.0 : atr)   // frozen formation ATR of this source candle, -1 = unavailable
    true

// ═══════════════════════ SOURCE-CONTEXT LIFECYCLE ENGINE (runs inside request.security) ════════
// Returns the published snapshot (array<float>, 8 floats per zone, oldest first). The same array object
// is returned on every bar on which nothing changed; a published array is never mutated.
// Window policy: candle c is processed only if c > lastCandle - budget, and a zone expires once
// (c - formationCandle) >= budget, so live == fresh reconstruction.
f_engine(int cap, int minTicks, int budget) =>
    var array<float> Z = array.new_float(0)
    var array<float> pub = array.new_float(0)
    var float lastProc = 0.0
    array<float> out = na
    float atrS = ta.atr(14)      // source-timeframe ATR, evaluated every bar
    float fatr1 = atrS[1]        // ATR on the SAME completed candle [1] as the formation OHLC
    float h1 = high[1]
    float l1 = low[1]
    float c1 = close[1]
    float h2 = high[2]
    float l2 = low[2]
    float h3 = high[3]
    float l3 = low[3]
    int   t1 = time[1]
    int   tc1 = time_close[1]
    int   cidx = bar_index - 1
    bool  valid = not na(h1) and not na(l1) and not na(c1) and not na(t1) and not na(tc1)
    bool  active = bar_index > last_bar_index - budget
    if valid and active
        if t1 > lastProc
            lastProc := t1
            bool dirty = false
            // 1) drop zones flagged inverted on the previous source bar
            int n0 = int(Z.size() / ZS)
            if n0 > 0
                for i = n0 - 1 to 0
                    if math.abs(Z.get(i * ZS + 1)) == 2.0
                        for k = 1 to ZS
                            Z.remove(i * ZS)
                        dirty := true
            // 2) lifecycle of existing zones on the completed candle. Only candles that OPEN at/after the
            //    formation confirmation are eligible (the formation candle never touches/inverts itself).
            int n1 = int(Z.size() / ZS)
            if n1 > 0
                for i = 0 to n1 - 1
                    int b = i * ZS
                    if t1 >= int(Z.get(b + 4))
                        float cd = Z.get(b + 1)
                        float zt = Z.get(b + 2)
                        float zb = Z.get(b + 3)
                        bool inv = cd > 0 ? f_tk(c1) < f_tk(zb) : f_tk(c1) > f_tk(zt)
                        if inv
                            Z.set(b + 1, cd * 2.0)   // source CLOSE strictly beyond the opposite boundary
                            dirty := true
                        else if Z.get(b + 5) == 0.0 and f_overlap(h1, l1, zb, zt)
                            Z.set(b + 5, float(tc1)) // first touch (monotonic)
                            dirty := true
            // 3) formation: candle 3 = [1], candle 1 = [3]; candle 2 only has to exist
            if not na(h2) and not na(l2) and not na(h3) and not na(l3)
                int bullGap = f_tk(l1) - f_tk(h3)
                int bearGap = f_tk(l3) - f_tk(h1)
                if bullGap >= minTicks
                    f_push(Z, t1, 1, l1, h3, tc1, cidx, fatr1)
                    dirty := true
                else if bearGap >= minTicks
                    f_push(Z, t1, -1, l3, h1, tc1, cidx, fatr1)
                    dirty := true
            // 4) age expiry (silent, never an inversion). Flagged zones are left so the inversion is published.
            int n2 = int(Z.size() / ZS)
            if n2 > 0
                for i = n2 - 1 to 0
                    if math.abs(Z.get(i * ZS + 1)) == 1.0 and cidx - int(Z.get(i * ZS + 6)) >= budget
                        for k = 1 to ZS
                            Z.remove(i * ZS)
                        dirty := true
            // 5) capacity: oldest UNFLAGGED zone first, so a just-inverted zone's event is never pruned away
            int n3 = int(Z.size() / ZS)
            int nFlag = 0
            if n3 > 0
                for i = 0 to n3 - 1
                    if math.abs(Z.get(i * ZS + 1)) == 2.0
                        nFlag += 1
            int over = n3 - nFlag - cap
            int p = 0
            while over > 0 and p < int(Z.size() / ZS)
                if math.abs(Z.get(p * ZS + 1)) == 1.0
                    for k = 1 to ZS
                        Z.remove(p * ZS)
                    over -= 1
                    dirty := true
                else
                    p += 1
            // 6) publish a NEW array only if something changed
            if dirty
                pub := Z.copy()
        out := pub
    out

// ═════════════════════════════ CHART-SIDE SETUP (supported charts, slots) ═════════════════════
bool supported = chart.is_standard and not timeframe.isticks
// unsupported charts never reach any timeframe conversion
int  chartSecs = supported ? timeframe.in_seconds() : 0
int  chartMs   = chartSecs * 1000

int  sec1 = timeframe.in_seconds(tf1)
int  sec2 = timeframe.in_seconds(tf2)
int  sec3 = timeframe.in_seconds(tf3)
int  sec4 = timeframe.in_seconds(tf4)
// higher than chart only; equal -> chart layer; lower -> omitted; equivalent selections deduplicated
bool ok1 = supported and en1 and sec1 > chartSecs
bool ok2 = supported and en2 and sec2 > chartSecs and not (ok1 and sec2 == sec1)
bool ok3 = supported and en3 and sec3 > chartSecs and not (ok1 and sec3 == sec1) and not (ok2 and sec3 == sec2)
bool ok4 = supported and en4 and sec4 > chartSecs and not (ok1 and sec4 == sec1) and not (ok2 and sec4 == sec2) and not (ok3 and sec4 == sec3)
bool al1 = chartSecs > 0 and sec1 % chartSecs == 0
bool al2 = chartSecs > 0 and sec2 % chartSecs == 0
bool al3 = chartSecs > 0 and sec3 % chartSecs == 0
bool al4 = chartSecs > 0 and sec4 % chartSecs == 0
bool act1 = ok1 and al1
bool act2 = ok2 and al2
bool act3 = ok3 and al3
bool act4 = ok4 and al4

// Effective source budget: bound worst-case snapshot memory (see header).
int  nSlots = (act1 ? 1 : 0) + (act2 ? 1 : 0) + (act3 ? 1 : 0) + (act4 ? 1 : 0)
int  memBudget = nSlots > 0 ? int(8000000 / (nSlots * ZS * inHtfCap)) : inBudget
int  effBudget = memBudget < inBudget ? memBudget : inBudget

array<float> snap1 = na
array<float> snap2 = na
array<float> snap3 = na
array<float> snap4 = na
int asOf1 = na
int asOf2 = na
int asOf3 = na
int asOf4 = na
if act1
    snap1 := request.security(syminfo.tickerid, tf1, f_engine(inHtfCap, inMinTick, effBudget), lookahead = barmerge.lookahead_on)
    asOf1 := request.security(syminfo.tickerid, tf1, time_close[1], lookahead = barmerge.lookahead_on)
if act2
    snap2 := request.security(syminfo.tickerid, tf2, f_engine(inHtfCap, inMinTick, effBudget), lookahead = barmerge.lookahead_on)
    asOf2 := request.security(syminfo.tickerid, tf2, time_close[1], lookahead = barmerge.lookahead_on)
if act3
    snap3 := request.security(syminfo.tickerid, tf3, f_engine(inHtfCap, inMinTick, effBudget), lookahead = barmerge.lookahead_on)
    asOf3 := request.security(syminfo.tickerid, tf3, time_close[1], lookahead = barmerge.lookahead_on)
if act4
    snap4 := request.security(syminfo.tickerid, tf4, f_engine(inHtfCap, inMinTick, effBudget), lookahead = barmerge.lookahead_on)
    asOf4 := request.security(syminfo.tickerid, tf4, time_close[1], lookahead = barmerge.lookahead_on)

// ═════════════════════════════════════════ STATE ══════════════════════════════════════════════
var array<Zone>   chartZ = array.new<Zone>()
var array<Zone>   hz1 = array.new<Zone>()
var array<Zone>   hz2 = array.new<Zone>()
var array<Zone>   hz3 = array.new<Zone>()
var array<Zone>   hz4 = array.new<Zone>()
var array<int>    lastAsOf = array.new_int(4, 0)      // per-slot: last snapshot already reconciled
var array<int>    wm       = array.new_int(4, 0)      // per-slot import watermark (formTime) for NEW zones only
var array<bool>   srcBad   = array.new_bool(4, false)
var array<bool>   srcSeen  = array.new_bool(4, false)
var array<bool>   srcInit  = array.new_bool(4, false) // false until the bootstrap import has happened
var array<string> warnArr  = array.new_string(0)
// per-bar event counters: 0 newBull,1 newBear,2 bullIfvg,3 bearIfvg,4 htfNew,5 htfTap,6 htfRem,7 ifRemTouch,8 ifRemInval
var array<int>    ev   = array.new_int(10, 0)
var array<string> evTf = array.new_string(10, "")
var int firstTime = time
var int lastConfClose = na
var float refPrice = na          // last confirmed chart close: display reference only
float chartAtr = ta.atr(14)
int prevCloseT = time_close[1]
float h2c = high[2]
float l2c = low[2]

// ═════════════════════════════════════════ ACTIONS ════════════════════════════════════════════
f_destroy(Zone z) =>
    if not na(z.bx)
        box.delete(z.bx)
        z.bx := na
    if not na(z.mid)
        line.delete(z.mid)
        z.mid := na
    if not na(z.mk)
        label.delete(z.mk)
        z.mk := na
    true

f_clearStore(array<Zone> a) =>
    int n = a.size()
    if n > 0
        for i = n - 1 to 0
            f_destroy(a.get(i))
            a.remove(i)
    true

// Exact-token de-duplication of timeframe labels (5m must never match 15m).
f_evInc(int i, string tf) =>
    ev.set(i, ev.get(i) + 1)
    if tf != ""
        string cur = evTf.get(i)
        array<string> toks = str.split(cur, ",")
        if not toks.includes(tf)
            evTf.set(i, cur == "" ? tf : cur + "," + tf)
    true

f_resetEv() =>
    for i = 0 to 9
        ev.set(i, 0)
        evTf.set(i, "")
    true

// One chart-layer lifecycle step. Returns 0 none, 1 inverted, 2 removed (touch), 3 removed (invalidation).
f_stepChart(Zone z, float hi, float lo, float cl, int bi, int t, int tc) =>
    int r = 0
    if bi > z.formBar
        bool bull = z.dir > 0
        if z.state == ST_BULL_FVG or z.state == ST_BEAR_FVG
            // inversion: confirmed close strictly through the opposite OUTER boundary
            bool inv = bull ? f_tk(cl) < f_tk(z.bottom) : f_tk(cl) > f_tk(z.top)
            if inv
                z.state := bull ? ST_BEAR_IFVG : ST_BULL_IFVG
                z.invBar := bi
                z.invTime := t
                z.invAvail := tc
                r := 1
        else if bi > z.invBar
            // the inversion candle (bi == invBar) can never remove the new iFVG
            bool invalid = bull ? f_tk(cl) > f_tk(z.top) : f_tk(cl) < f_tk(z.bottom)
            if invalid
                r := 3
            else if f_overlap(hi, lo, z.bottom, z.top)
                r := 2
    r

// Reconcile one source slot against the engine snapshot (HTF layer). Chronological two-pointer merge.
// `gen` = false during the slot's first (bootstrap) reconciliation: nothing is announced then.
// The watermark only gates creation of zones that have no store match; matched zones always update.
f_reconcile(array<Zone> store, int idx, string tfTxt, array<float> snap, int asOf) =>
    bool gen = srcInit.get(idx)
    int cnt = int(snap.size() / ZS)
    int m = store.size()
    if m > 0
        for i = 0 to m - 1
            Zone z0 = store.get(i)
            z0.seen := false
            z0.endNow := false
    int j = 0
    if cnt > 0
        for k = 0 to cnt - 1
            int base = k * ZS
            int ft = int(snap.get(base))
            float cd = snap.get(base + 1)
            int d = cd > 0 ? 1 : -1
            bool flg = math.abs(cd) == 2.0
            float zt = snap.get(base + 2)
            float zb = snap.get(base + 3)
            int conf = int(snap.get(base + 4))
            int tp = int(snap.get(base + 5))
            float fa = snap.get(base + 7)
            bool adv = true
            while adv
                adv := false
                if j < store.size()
                    if store.get(j).formTime < ft
                        j += 1
                        adv := true
            bool isMatch = false
            if j < store.size()
                isMatch := store.get(j).formTime == ft
            if isMatch
                Zone z = store.get(j)
                z.seen := true
                z.lastEvt := asOf
                j += 1
                if flg
                    z.endNow := true
                else if tp > 0 and not z.tapped
                    z.tapped := true          // monotonic: never reverted by a snapshot
                    z.state := z.dir > 0 ? ST_TAP_BULL : ST_TAP_BEAR
                    z.tapTime := tp
                    z.tapAvail := time_close
                    if gen
                        f_evInc(5, tfTxt)
            else if not flg and ft > wm.get(idx)
                bool tpd = tp > 0
                int st = d > 0 ? (tpd ? ST_TAP_BULL : ST_UNT_BULL) : (tpd ? ST_TAP_BEAR : ST_UNT_BEAR)
                Zone nz = Zone.new(id = syminfo.tickerid + "|" + tfTxt + "|" + str.tostring(ft) + "|" + str.tostring(d), src = idx, tfTxt = tfTxt, dir = d, state = st, top = zt, bottom = zb, formTime = ft, confTime = conf, availTime = time_close, width = zt - zb, fatr = fa < 0 ? na : fa, tapped = tpd, tapTime = tp, tapAvail = time_close, lastEvt = asOf, seen = true)
                store.push(nz)
                wm.set(idx, ft)
                // genuine formation = confirmed by the source candle that just completed, after bootstrap
                if gen and conf == asOf
                    f_evInc(4, tfTxt)
    // zones missing from the snapshot are gone (expired, capacity-pruned, or already removed): silent.
    // zones the engine flagged inverted: removal dominates any tap in the same step.
    int n2 = store.size()
    if n2 > 0
        for i = n2 - 1 to 0
            Zone z = store.get(i)
            if z.endNow
                f_destroy(z)
                store.remove(i)
                if gen
                    f_evInc(6, tfTxt)
            else if not z.seen
                f_destroy(z)
                store.remove(i)
    // deterministic capacity pruning, oldest first (never a price event)
    while store.size() > inHtfCap
        Zone old = store.shift()
        f_destroy(old)
    srcInit.set(idx, true)
    true

f_sync(array<Zone> store, int idx, string tfTxt, array<float> snap, int asOf) =>
    if not na(snap) and not na(asOf)
        srcSeen.set(idx, true)
        if asOf > lastAsOf.get(idx) and not srcBad.get(idx)
            lastAsOf.set(idx, asOf)
            // The chart must cover the WHOLE current source period (it starts at asOf), otherwise touches
            // earlier in that period are unknowable: skip; the next snapshot already includes that period.
            if firstTime <= asOf
                // A chart candle straddling the source boundary would make event order ambiguous.
                if not na(prevCloseT) and prevCloseT > asOf
                    srcBad.set(idx, true)
                    warnArr.push(tfTxt + " disabled: chart candles do not align with " + tfTxt + " boundaries (session/timeframe alignment)")
                    f_clearStore(store)
                else
                    f_reconcile(store, idx, tfTxt, snap, asOf)
    true

// Chart-candle taps on HTF zones. Candle must OPEN at/after formation confirmation; monotonic.
f_tapStore(array<Zone> a) =>
    int n = a.size()
    if n > 0
        for i = 0 to n - 1
            Zone z = a.get(i)
            if not z.tapped and time >= z.confTime and f_overlap(high, low, z.bottom, z.top)
                z.tapped := true
                z.state := z.dir > 0 ? ST_TAP_BULL : ST_TAP_BEAR
                z.tapTime := time
                z.tapAvail := time_close
                f_evInc(5, z.tfTxt)
    true

// ═════════════════════════════════════════ DRAWING ════════════════════════════════════════════
// Persistent handles. Called only on confirmed bars (never on provisional ticks), so nothing here can be
// rolled back, duplicated or shown in a provisional colour. Creates when wanted and missing, otherwise
// updates through setters; deletes when hidden (state is untouched, tracking continues).
f_syncDraw(Zone z, bool htf, bool want) =>
    if not want
        f_destroy(z)
    else
        bool bull = z.state == ST_BULL_FVG or z.state == ST_BULL_IFVG or z.state == ST_UNT_BULL or z.state == ST_TAP_BULL
        bool ifvg = z.state == ST_BULL_IFVG or z.state == ST_BEAR_IFVG
        bool tap  = z.state == ST_TAP_BULL or z.state == ST_TAP_BEAR
        color base = bull ? inBull : inBear
        int fillT = htf ? (tap ? inHtfTapT : inHtfT) : inChT
        string txt = ""
        if inLabels
            txt := htf ? z.tfTxt + " FVG · " + (tap ? "Tapped" : "Untapped") : (ifvg ? "iFVG" : "FVG")
        int l = z.formTime > firstTime ? z.formTime : firstTime   // clamp to first available chart bar
        int r = lastConfClose + inExt * chartMs
        if r <= l
            r := l + chartMs
        if na(z.bx)
            z.bx := box.new(left = l, top = z.top, right = r, bottom = z.bottom, xloc = xloc.bar_time, border_color = color.new(base, inBordT), border_width = 1, border_style = ifvg ? line.style_dashed : line.style_solid, bgcolor = color.new(base, fillT), text = txt, text_size = size.small, text_color = color.new(base, 15), text_halign = text.align_right, text_valign = text.align_center)
        else
            box.set_right(z.bx, r)
            box.set_bgcolor(z.bx, color.new(base, fillT))
            box.set_border_color(z.bx, color.new(base, inBordT))
            box.set_border_style(z.bx, ifvg ? line.style_dashed : line.style_solid)
            box.set_text(z.bx, txt)
            box.set_text_color(z.bx, color.new(base, 15))
        if inMid
            float mp = (z.top + z.bottom) / 2
            if na(z.mid)
                z.mid := line.new(x1 = l, y1 = mp, x2 = r, y2 = mp, xloc = xloc.bar_time, color = color.new(base, 45), style = line.style_dotted, width = 1)
            else
                line.set_x2(z.mid, r)
                line.set_color(z.mid, color.new(base, 45))
        else if not na(z.mid)
            line.delete(z.mid)
            z.mid := na
        if inMarker and ifvg and not htf
            if na(z.mk)
                z.mk := label.new(x = z.invTime, y = z.dir > 0 ? z.bottom : z.top, xloc = xloc.bar_time, text = "", style = label.style_xcross, color = color.new(base, 0), size = size.tiny)
            else
                label.set_color(z.mk, color.new(base, 0))
        else if not na(z.mk)
            label.delete(z.mk)
            z.mk := na
    true

// ───────────── display selection (never touches lifecycle state or array order) ─────────────
// Size filter on FROZEN width and FROZEN formation ATR. Tick-aware, so a width exactly at the threshold qualifies.
f_sizeOk(float width, float fatr, int minT, float mult) =>
    bool ok = true
    if mult > 0 and na(fatr)
        ok := false              // ATR qualification unknown: hide (still tracked)
    else
        float thrT = float(minT)
        if mult > 0
            float atrT = mult * fatr / syminfo.mintick
            thrT := atrT > thrT ? atrT : thrT
        ok := f_tk(width) >= thrT - 0.000001
    ok

// Nearest-EDGE distance (0 when price is inside or on a boundary).
f_dist(Zone z, float ref) =>
    float d = 0.0
    if f_tk(ref) < f_tk(z.bottom)
        d := z.bottom - ref
    else if f_tk(ref) > f_tk(z.top)
        d := ref - z.top
    d

// Categories: 0 chart FVG, 1 chart iFVG, 2 HTF above, 3 HTF below, 4 HTF containing price (exclusive).
f_classify(array<Zone> a, bool htf) =>
    int n = a.size()
    if n > 0
        for i = 0 to n - 1
            Zone z = a.get(i)
            z.vis := false
            z.cat := -1
            z.dist := f_dist(z, refPrice)
            if htf
                if inShowHtf and f_sizeOk(z.width, z.fatr, inHtfMinT, inHtfAtr)
                    z.cat := f_tk(z.bottom) > f_tk(refPrice) ? 2 : (f_tk(z.top) < f_tk(refPrice) ? 3 : 4)
            else
                bool isI = z.state == ST_BULL_IFVG or z.state == ST_BEAR_IFVG
                bool sizeOk = isI ? f_sizeOk(z.width, z.fatr, inIfvgMinT, inIfvgAtr) : f_sizeOk(z.width, z.fatr, inFvgMinT, inFvgAtr)
                bool shown = isI ? inShowIfvg : inShowFvg
                bool distOk = true
                if inDistOn and z.dist > 0 and not na(chartAtr)
                    distOk := z.dist <= inDistAtr * chartAtr
                if shown and sizeOk and distOk
                    z.cat := isI ? 1 : 0
    true

// Mark the best `limit` zones of one category. Nearest: smallest edge distance (inside = 0 = first), then most
// recent formation; on a full tie the later array position wins (formTime is unique per array, so this is stable).
f_pickCat(array<Zone> a, int cat, int limit) =>
    int n = a.size()
    if n > 0 and limit > 0
        for pick = 1 to limit
            int best = -1
            for i = 0 to n - 1
                Zone z = a.get(i)
                if z.cat == cat and not z.vis
                    if best < 0
                        best := i
                    else
                        Zone bz = a.get(best)
                        bool better = false
                        if inNearest and z.dist != bz.dist
                            better := z.dist < bz.dist
                        else
                            better := z.formTime >= bz.formTime
                        if better
                            best := i
            if best >= 0
                Zone sel = a.get(best)
                sel.vis := true
    true

f_drawHtf(array<Zone> a) =>
    f_classify(a, true)
    f_pickCat(a, 2, inHtfAbove)
    f_pickCat(a, 3, inHtfBelow)
    f_pickCat(a, 4, inHtfCont)
    int n = a.size()
    if n > 0
        for i = 0 to n - 1
            Zone z = a.get(i)
            f_syncDraw(z, true, z.vis)
    true

f_drawAll() =>
    if not na(lastConfClose) and not na(refPrice)
        f_classify(chartZ, false)
        f_pickCat(chartZ, 0, inMaxFvg)
        f_pickCat(chartZ, 1, inMaxIfvg)
        int n = chartZ.size()
        if n > 0
            for i = 0 to n - 1
                Zone z = chartZ.get(i)
                f_syncDraw(z, false, z.vis)
        f_drawHtf(hz1)
        f_drawHtf(hz2)
        f_drawHtf(hz3)
        f_drawHtf(hz4)
    true

// ═════════════════════════════ MAIN: confirmed-bar processing ═════════════════════════════════
if supported and barstate.isfirst
    if en1 and sec1 > chartSecs and not al1
        warnArr.push(f_tfText(sec1) + " disabled: not an integer multiple of the chart timeframe")
    if en2 and sec2 > chartSecs and not al2
        warnArr.push(f_tfText(sec2) + " disabled: not an integer multiple of the chart timeframe")
    if en3 and sec3 > chartSecs and not al3
        warnArr.push(f_tfText(sec3) + " disabled: not an integer multiple of the chart timeframe")
    if en4 and sec4 > chartSecs and not al4
        warnArr.push(f_tfText(sec4) + " disabled: not an integer multiple of the chart timeframe")
    if nSlots > 0 and effBudget < inBudget
        warnArr.push("Source-history budget clamped to " + str.tostring(effBudget) + " candles (memory bound)")

// Drawings are mutated only on confirmed bars at/after the last confirmed historical bar.
bool drawNow = supported and barstate.isconfirmed and (barstate.islast or barstate.islastconfirmedhistory or barstate.isrealtime)

if supported and barstate.isconfirmed
    f_resetEv()
    lastConfClose := time_close
    refPrice := close

    // 1) current-chart layer: step existing zones (only bars AFTER the formation bar are eligible)
    int nc = chartZ.size()
    if nc > 0
        for i = nc - 1 to 0
            Zone z = chartZ.get(i)
            int r = f_stepChart(z, high, low, close, bar_index, time, time_close)
            if r == 1
                f_evInc(z.dir > 0 ? 3 : 2, "")
            else if r >= 2
                f_destroy(z)
                chartZ.remove(i)
                f_evInc(r == 2 ? 7 : 8, "")
            else if bar_index - z.formBar >= inChWin
                f_destroy(z)          // window expiry: silent, not an inversion
                chartZ.remove(i)

    // 2) current-chart layer: new gap confirmed by THIS closed bar (candle 3)
    if bar_index >= 2 and not na(h2c) and not na(l2c)
        int bullGap = f_tk(low) - f_tk(h2c)
        int bearGap = f_tk(l2c) - f_tk(high)
        int dirN = bullGap >= inMinTick ? 1 : (bearGap >= inMinTick ? -1 : 0)
        if dirN != 0
            float zt = dirN > 0 ? low : l2c
            float zb = dirN > 0 ? h2c : high
            Zone nz = Zone.new(id = syminfo.tickerid + "|" + timeframe.period + "|" + str.tostring(time) + "|" + str.tostring(dirN), dir = dirN, state = dirN > 0 ? ST_BULL_FVG : ST_BEAR_FVG, top = zt, bottom = zb, formTime = time, confTime = time_close, availTime = time_close, width = zt - zb, fatr = chartAtr, formBar = bar_index)
            chartZ.push(nz)
            f_evInc(dirN > 0 ? 0 : 1, "")
    while chartZ.size() > inChCap
        Zone old = chartZ.shift()
        f_destroy(old)          // capacity pruning: silent, not a price event

    // 3) HTF layer: source snapshots first (removal dominates), then chart-candle taps
    if act1
        f_sync(hz1, 0, f_tfText(sec1), snap1, asOf1)
    if act2
        f_sync(hz2, 1, f_tfText(sec2), snap2, asOf2)
    if act3
        f_sync(hz3, 2, f_tfText(sec3), snap3, asOf3)
    if act4
        f_sync(hz4, 3, f_tfText(sec4), snap4, asOf4)
    f_tapStore(hz1)
    f_tapStore(hz2)
    f_tapStore(hz3)
    f_tapStore(hz4)

    // 4) drawings follow the committed state on the same bar the alerts do
    if drawNow
        f_drawAll()

// ═════════════════════════════════════ WARNINGS (concise) ═════════════════════════════════════
var table warnTbl = table.new(position.top_right, 1, 1, border_width = 0)
f_slotWarn(bool act, int idx, int secs) =>
    string r = ""
    if act and not srcSeen.get(idx)
        r := f_tfText(secs) + ": no source data returned"
    else if act and srcSeen.get(idx) and not srcInit.get(idx) and not srcBad.get(idx)
        r := f_tfText(secs) + ": chart history too short to establish zone state (omitted, not guessed)"
    r

if barstate.islast
    string w = supported ? array.join(warnArr, "\n") : "H Ticks FVG/iFVG: unsupported chart type (needs standard time-based candles; Heikin Ashi/Renko/Range/tick etc. are not valid traded-price OHLC)."
    if supported
        string s1 = f_slotWarn(act1, 0, sec1)
        string s2 = f_slotWarn(act2, 1, sec2)
        string s3 = f_slotWarn(act3, 2, sec3)
        string s4 = f_slotWarn(act4, 3, sec4)
        w += s1 == "" ? "" : (w == "" ? "" : "\n") + s1
        w += s2 == "" ? "" : (w == "" ? "" : "\n") + s2
        w += s3 == "" ? "" : (w == "" ? "" : "\n") + s3
        w += s4 == "" ? "" : (w == "" ? "" : "\n") + s4
    if w == ""
        table.cell(warnTbl, 0, 0, "", bgcolor = na)
    else
        table.cell(warnTbl, 0, 0, w, text_color = color.orange, text_size = size.small, bgcolor = color.new(color.black, 80), text_halign = text.align_left)

// ═════════════════════════════════════════ ALERTS ═════════════════════════════════════════════
// Only genuine lifecycle events on a confirmed REALTIME bar, i.e. the same bar on which drawings change.
// Bootstrap imports, window expiry and capacity pruning never alert.
bool evNow = supported and barstate.isrealtime and barstate.isconfirmed

f_part(string label, int n, string tfs) =>
    n > 0 ? label + " x" + str.tostring(n) + (tfs == "" ? "" : " [" + tfs + "]") : ""

f_add(string a, string b) =>
    b == "" ? a : (a == "" ? b : a + " | " + b)

if evNow
    string msg = ""
    msg := f_add(msg, alNewBull ? f_part("New bullish FVG", ev.get(0), "") : "")
    msg := f_add(msg, alNewBear ? f_part("New bearish FVG", ev.get(1), "") : "")
    msg := f_add(msg, alBullIf ? f_part("Bullish iFVG confirmed", ev.get(2), "") : "")
    msg := f_add(msg, alBearIf ? f_part("Bearish iFVG confirmed", ev.get(3), "") : "")
    msg := f_add(msg, alHtfNew ? f_part("New HTF FVG", ev.get(4), evTf.get(4)) : "")
    msg := f_add(msg, alHtfTap ? f_part("HTF FVG first tapped", ev.get(5), evTf.get(5)) : "")
    msg := f_add(msg, alHtfRem ? f_part("HTF FVG removed by source inversion", ev.get(6), evTf.get(6)) : "")
    msg := f_add(msg, alIfRem ? f_part("iFVG removed (touch)", ev.get(7), "") : "")
    msg := f_add(msg, alIfRem ? f_part("iFVG removed (invalidation)", ev.get(8), "") : "")
    if msg != ""
        alert("H Ticks FVG/iFVG " + syminfo.ticker + " " + timeframe.period + ": " + msg, alert.freq_once_per_bar_close)

// Selectable per-event alertConditions (use these OR the aggregated alert() call, not both).
alertcondition(evNow and ev.get(0) > 0, "New bullish chart FVG", "H Ticks: new bullish FVG on {{ticker}} {{interval}}")
alertcondition(evNow and ev.get(1) > 0, "New bearish chart FVG", "H Ticks: new bearish FVG on {{ticker}} {{interval}}")
alertcondition(evNow and ev.get(2) > 0, "Bullish chart iFVG confirmed", "H Ticks: bullish iFVG confirmed on {{ticker}} {{interval}}")
alertcondition(evNow and ev.get(3) > 0, "Bearish chart iFVG confirmed", "H Ticks: bearish iFVG confirmed on {{ticker}} {{interval}}")
alertcondition(evNow and ev.get(4) > 0, "New HTF FVG", "H Ticks: new HTF FVG on {{ticker}} (chart {{interval}})")
alertcondition(evNow and ev.get(5) > 0, "HTF FVG first tapped", "H Ticks: HTF FVG first tapped on {{ticker}} (chart {{interval}})")
alertcondition(evNow and ev.get(6) > 0, "HTF FVG removed by source inversion", "H Ticks: HTF FVG removed by source inversion on {{ticker}} (chart {{interval}})")
alertcondition(evNow and (ev.get(7) > 0 or ev.get(8) > 0), "Chart iFVG removed", "H Ticks: chart iFVG removed on {{ticker}} {{interval}}")
