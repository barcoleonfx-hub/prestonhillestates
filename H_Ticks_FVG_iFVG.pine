    line   lS
    line   lT
    line   lR
    box    rbx
    box    gbx
    box    ctxBx
    box    trgBx
    label  lbE
    label  lbS
    label  lbT
    label  lbRt
    label  lbAn

// A confirmed 3m swing level (strength 2/2) tracked on the chart. consumed = a later candle reached it.
type Lvl
    float  price
    int    dir
    int    pivotT
    int    confT
    bool   consumed = false
    bool   seen = false

f_tk(float x) =>
    math.round(x / syminfo.mintick)

// Closed-interval overlap of a candle range with the ORIGINAL zone boundaries.
f_overlap(float hi, float lo, float zb, float zt) =>
    f_tk(hi) >= f_tk(zb) and f_tk(lo) <= f_tk(zt)

f_tfText(int s) =>
    string r = ""
    if s >= 604800 and s % 604800 == 0
        r := str.tostring(int(s / 604800)) + "W"
    else if s >= 86400 and s % 86400 == 0
        r := str.tostring(int(s / 86400)) + "D"
    else if s >= 3600 and s % 3600 == 0
        r := str.tostring(int(s / 3600)) + "H"
    else if s >= 60 and s % 60 == 0
        r := str.tostring(int(s / 60)) + "m"
    else
        r := str.tostring(s) + "s"
    r

// Engine zone record (8 floats): formTime, code (+-1 live, +-2 inverted-this-bar; sign = direction),
// top, bottom, confTime, tapTime (0 = untapped), formation candle index, formation ATR (-1 = n/a).
f_push(array<float> z, int ft, int dir, float tp, float bt, int conf, int fidx, float atr) =>
    z.push(float(ft))
    z.push(float(dir))
    z.push(tp)
    z.push(bt)
    z.push(float(conf))
    z.push(0.0)
    z.push(float(fidx))
    z.push(na(atr) ? -1.0 : atr)   // frozen formation ATR of this source candle, -1 = unavailable
    true

// ═══════════════════════ SOURCE-CONTEXT LIFECYCLE ENGINE (runs inside request.security) ════════
// Returns the published snapshot (array<float>): header [truncated flag, readyTime (0 = still warming up)], then 8 floats
// per zone, oldest first. The same array object is returned on every bar on which nothing changed; a published array is
// never mutated. While warming up only the header is published (no zones are ever used from a partial history).
// Time-based policy (identical live and on reload once ready):
//   * a source candle is processed only if it closed within `histMs` of the current time (horizon + reporting span);
//   * a live zone expires once (candle open - formation time) >= `horizonMs` (silent, documented horizon);
//   * READY = the processed history spans a full horizon, so no zone inside the horizon can be unknown;
//   * capacity: the OLDEST live zone is dropped and truncation stays flagged (coverage UNKNOWN) until that zone would have
//     expired anyway. No relevance shortcut: a dropped gap is never assumed irrelevant.
f_engine(int cap, int minTicks, int horizonMs, int histMs) =>
    var array<float> Z = array.new_float(0)
    var array<float> pub = array.from(0.0, 0.0)
    var float maxPruned = -1.0
    var bool lastTrunc = false
    var bool lastReady = false
    var float lastProc = 0.0
    var int firstProcT = 0
    array<float> out = na
    float atrS = ta.atr(14)      // source-timeframe ATR, evaluated every bar
    float fatr1 = atrS[1]        // ATR on the SAME completed candle [1] as the formation OHLC
    float h1 = high[1]
    float l1 = low[1]
    float c1 = close[1]
    float h2 = high[2]
    float l2 = low[2]
    float h3 = high[3]
    float l3 = low[3]
    int   t1 = time[1]
    int   tc1 = time_close[1]
    int   cidx = bar_index - 1
    bool  valid = not na(h1) and not na(l1) and not na(c1) and not na(t1) and not na(tc1)
    bool  active = valid and t1 >= timenow - histMs
    if active
        if t1 > lastProc
            lastProc := t1
            if firstProcT == 0
                firstProcT := t1
            bool dirty = false
            // 1) drop zones flagged inverted on the previous source bar
            int n0 = int(Z.size() / ZS)
            if n0 > 0
                for i = n0 - 1 to 0
                    if math.abs(Z.get(i * ZS + 1)) == 2.0
                        for k = 1 to ZS
                            Z.remove(i * ZS)
                        dirty := true
            // 2) lifecycle of existing zones on the completed candle. Only candles that OPEN at/after the
            //    formation confirmation are eligible (the formation candle never touches/inverts itself).
            int n1 = int(Z.size() / ZS)
            if n1 > 0
                for i = 0 to n1 - 1
                    int b = i * ZS
                    if t1 >= int(Z.get(b + 4))
                        float cd = Z.get(b + 1)
                        float zt = Z.get(b + 2)
                        float zb = Z.get(b + 3)
                        bool inv = cd > 0 ? f_tk(c1) < f_tk(zb) : f_tk(c1) > f_tk(zt)
                        if inv
                            Z.set(b + 1, cd * 2.0)   // source CLOSE strictly beyond the opposite boundary
                            dirty := true
                        else if Z.get(b + 5) == 0.0 and f_overlap(h1, l1, zb, zt)
                            Z.set(b + 5, float(tc1)) // first touch (monotonic)
                            dirty := true
            // 3) formation: candle 3 = [1], candle 1 = [3]; candle 2 only has to exist
            if not na(h2) and not na(l2) and not na(h3) and not na(l3)
                int bullGap = f_tk(l1) - f_tk(h3)
                int bearGap = f_tk(l3) - f_tk(h1)
                if bullGap >= minTicks
                    f_push(Z, t1, 1, l1, h3, tc1, cidx, fatr1)
                    dirty := true
                else if bearGap >= minTicks
                    f_push(Z, t1, -1, l3, h1, tc1, cidx, fatr1)
                    dirty := true
            // 4) horizon expiry (silent, never an inversion). Flagged zones are left so the inversion is published.
            int n2 = int(Z.size() / ZS)
            if n2 > 0
                for i = n2 - 1 to 0
                    if math.abs(Z.get(i * ZS + 1)) == 1.0 and t1 - int(Z.get(i * ZS)) >= horizonMs
                        for k = 1 to ZS
                            Z.remove(i * ZS)
                        dirty := true
            // 5) capacity: drop the OLDEST unflagged live zone (Z is chronological); truncation is flagged, never ignored
            int n3 = int(Z.size() / ZS)
            int nFlag = 0
            if n3 > 0
                for i = 0 to n3 - 1
                    if math.abs(Z.get(i * ZS + 1)) == 2.0
                        nFlag += 1
            int over = n3 - nFlag - cap
            while over > 0
                int pIdx = -1
                int nn = int(Z.size() / ZS)
                for i = 0 to nn - 1
                    if pIdx < 0 and math.abs(Z.get(i * ZS + 1)) == 1.0
                        pIdx := i
                if pIdx >= 0
                    maxPruned := math.max(maxPruned, Z.get(pIdx * ZS))
                    for k = 1 to ZS
                        Z.remove(pIdx * ZS)
                    dirty := true
                over -= 1
            // 6) truncation flag: a capacity-dropped zone could still be live inside the horizon => coverage unknown
            bool truncNow = maxPruned >= 0 and t1 - maxPruned < horizonMs
            if truncNow != lastTrunc
                lastTrunc := truncNow
                dirty := true
            // 7) READY once the processed history spans a full horizon; flip is published
            bool nowReady = t1 - firstProcT >= horizonMs
            if nowReady != lastReady
                lastReady := nowReady
                dirty := true
            // 8) publish a NEW array only if something changed (header only while warming up)
            if dirty
                array<float> tmp = array.from(truncNow ? 1.0 : 0.0, nowReady ? float(tc1) : 0.0)
                if nowReady
                    tmp.concat(Z)
                pub := tmp
        out := pub
    out

// 3m swing-level engine (inside request.security on the 3m series). Strict pivots 2 left / 2 right; a pivot becomes
// available only when its second right-side candle completes. A level is consumed by the first LATER completed candle that
// reaches it (high >= level / low <= level); the pivot candle and the confirming candles never consume it (strict pivot).
// Published like the zone engine: header [truncated, readyTime], then 4 floats per level (price, +1 high / -1 low,
// pivot candle open time, confirmation time). Horizon expiry and capacity are time/size bounded; capacity drops the OLDEST
// level and flags coverage UNKNOWN until it would have expired.
f_lvlEngine(int cap, int horizonMs, int histMs) =>
    var array<float> L = array.new_float(0)
    var array<float> pub = array.from(0.0, 0.0)
    var float maxPruned = -1.0
    var bool lastTrunc = false
    var bool lastReady = false
    var float lastProc = 0.0
    var int firstProcT = 0
    array<float> out = na
    float h1 = high[1]
    float l1 = low[1]
    float h2 = high[2]
    float l2 = low[2]
    float h3 = high[3]
    float l3 = low[3]
    float h4 = high[4]
    float l4 = low[4]
    float h5 = high[5]
    float l5 = low[5]
    int   t1 = time[1]
    int   tc1 = time_close[1]
    int   t3 = time[3]
    bool  valid = not na(h1) and not na(l1) and not na(t1) and not na(tc1)
    bool  active = valid and t1 >= timenow - histMs
    if active
        if t1 > lastProc
            lastProc := t1
            if firstProcT == 0
                firstProcT := t1
            bool dirty = false
            int n0 = int(L.size() / LS)
            if n0 > 0
                for i = n0 - 1 to 0
                    int b = i * LS
                    bool hit = false
                    if t1 >= int(L.get(b + 3))
                        hit := L.get(b + 1) > 0 ? f_tk(h1) >= f_tk(L.get(b)) : f_tk(l1) <= f_tk(L.get(b))
                    bool old = t1 - int(L.get(b + 2)) >= horizonMs
                    if hit or old
                        for k = 1 to LS
                            L.remove(b)
                        dirty := true
            if not na(h5) and not na(l5) and not na(t3)
                bool ph = f_tk(h3) > f_tk(h4) and f_tk(h3) > f_tk(h5) and f_tk(h3) > f_tk(h2) and f_tk(h3) > f_tk(h1)
                bool pl = f_tk(l3) < f_tk(l4) and f_tk(l3) < f_tk(l5) and f_tk(l3) < f_tk(l2) and f_tk(l3) < f_tk(l1)
                if ph
                    L.push(h3)
                    L.push(1.0)
                    L.push(float(t3))
                    L.push(float(tc1))
                    dirty := true
                if pl
                    L.push(l3)
                    L.push(-1.0)
                    L.push(float(t3))
                    L.push(float(tc1))
                    dirty := true
            int over = int(L.size() / LS) - cap
            while over > 0
                maxPruned := math.max(maxPruned, L.get(2))
                for k = 1 to LS
                    L.remove(0)
                dirty := true
                over -= 1
            bool truncNow = maxPruned >= 0 and t1 - maxPruned < horizonMs
            if truncNow != lastTrunc
                lastTrunc := truncNow
                dirty := true
            bool nowReady = t1 - firstProcT >= horizonMs
            if nowReady != lastReady
                lastReady := nowReady
                dirty := true
            if dirty
                array<float> tmp = array.from(truncNow ? 1.0 : 0.0, nowReady ? float(tc1) : 0.0)
                if nowReady
                    tmp.concat(L)
                pub := tmp
        out := pub
    out

// 15m directional bias engine (inside request.security on the 15m series; completed candle [1] only).
// 1) the break test uses only pivots that were confirmed on EARLIER candles (available before the breaking candle began);
// 2) only afterwards is the pivot confirmed by this candle stored (never backdated). A level breaks at most once.
// Returns [bias +1/-1/0, broken level, pivot candle open time, break-confirmation time].
f_bias15(int histMs) =>
    var float swH = na
    var float swHT = na
    var float swHA = na
    var bool  swHB = true
    var float swL = na
    var float swLT = na
    var float swLA = na
    var bool  swLB = true
    var float bias = 0.0
    var float bLvl = na
    var float bLvlT = na
    var float bAv = na
    var float lastProc = 0.0
    float h1 = high[1]
    float l1 = low[1]
    float c1 = close[1]
    float h2 = high[2]
    float l2 = low[2]
    float h3 = high[3]
    float l3 = low[3]
    float h4 = high[4]
    float l4 = low[4]
    float h5 = high[5]
    float l5 = low[5]
    int   t1 = time[1]
    int   tc1 = time_close[1]
    int   t3 = time[3]
    bool  valid = not na(c1) and not na(t1) and not na(tc1) and t1 >= timenow - histMs
    if valid
        if t1 > lastProc
            lastProc := t1
            if not na(swH) and not swHB and swHA <= t1 and f_tk(c1) > f_tk(swH)
                bias := 1.0
                bLvl := swH
                bLvlT := swHT
                bAv := float(tc1)
                swHB := true
            else if not na(swL) and not swLB and swLA <= t1 and f_tk(c1) < f_tk(swL)
                bias := -1.0
                bLvl := swL
                bLvlT := swLT
                bAv := float(tc1)
                swLB := true
            if not na(h5) and not na(l5) and not na(t3)
                if f_tk(h3) > f_tk(h4) and f_tk(h3) > f_tk(h5) and f_tk(h3) > f_tk(h2) and f_tk(h3) > f_tk(h1)
                    swH := h3
                    swHT := float(t3)
                    swHA := float(tc1)
                    swHB := false
                if f_tk(l3) < f_tk(l4) and f_tk(l3) < f_tk(l5) and f_tk(l3) < f_tk(l2) and f_tk(l3) < f_tk(l1)
                    swL := l3
                    swLT := float(t3)
                    swLA := float(tc1)
                    swLB := false
    [bias, bLvl, bLvlT, bAv]

// ═════════════════════════════ CHART SUPPORT, SOURCES, REQUESTS ═════════════════════════════
bool stdChart  = chart.is_standard and not timeframe.isticks
bool supported = stdChart and timeframe.isseconds and timeframe.multiplier == 30
int  chartSecs = supported ? timeframe.in_seconds() : 0
int  chartMs   = chartSecs * 1000

int  sec1 = timeframe.in_seconds(tf1)
int  sec2 = timeframe.in_seconds(tf2)
int  sec3 = timeframe.in_seconds(tf3)
int  sec4 = timeframe.in_seconds(tf4)
int  secCtx = timeframe.in_seconds(TF_CTX)
bool ok1 = supported and en1 and sec1 > chartSecs
bool ok2 = supported and en2 and sec2 > chartSecs and not (ok1 and sec2 == sec1)
bool ok3 = supported and en3 and sec3 > chartSecs and not (ok1 and sec3 == sec1) and not (ok2 and sec3 == sec2)
bool ok4 = supported and en4 and sec4 > chartSecs and not (ok1 and sec4 == sec1) and not (ok2 and sec4 == sec2) and not (ok3 and sec4 == sec3)
bool al1 = chartSecs > 0 and sec1 % chartSecs == 0
bool al2 = chartSecs > 0 and sec2 % chartSecs == 0
bool al3 = chartSecs > 0 and sec3 % chartSecs == 0
bool al4 = chartSecs > 0 and sec4 % chartSecs == 0
bool act1 = ok1 and al1
bool act2 = ok2 and al2
bool act3 = ok3 and al3
bool act4 = ok4 and al4
bool act0 = supported and chartSecs > 0 and secCtx % chartSecs == 0

int  hrz0 = inCtxHorizon * secCtx * 1000
int  hrz1 = inHorizon * sec1 * 1000
int  hrz2 = inHorizon * sec2 * 1000
int  hrz3 = inHorizon * sec3 * 1000
int  hrz4 = inHorizon * sec4 * 1000

array<float> snap0 = na
array<float> snap1 = na
array<float> snap2 = na
array<float> snap3 = na
array<float> snap4 = na
array<float> snap5 = na
float bzR = na
float blR = na
float btR = na
float baR = na
int   asOf0 = na
float cls0 = na
int asOf1 = na
int asOf2 = na
int asOf3 = na
int asOf4 = na
if act0
    snap0 := request.security(syminfo.tickerid, TF_CTX, f_engine(inCtxCap, inMinTick, hrz0, hrz0 + SPAN_MS), lookahead = barmerge.lookahead_on)
    [a0_, c0_] = request.security(syminfo.tickerid, TF_CTX, [time_close[1], close[1]], lookahead = barmerge.lookahead_on)
    asOf0 := a0_
    cls0 := c0_
    snap5 := request.security(syminfo.tickerid, TF_CTX, f_lvlEngine(LVL_CAP, hrz0, hrz0 + SPAN_MS), lookahead = barmerge.lookahead_on)
if supported
    [bz_, bl_, bt_, ba_] = request.security(syminfo.tickerid, "15", f_bias15(2 * SPAN_MS), lookahead = barmerge.lookahead_on)
    bzR := bz_
    blR := bl_
    btR := bt_
    baR := ba_
if act1
    snap1 := request.security(syminfo.tickerid, tf1, f_engine(inHtfCap, inMinTick, hrz1, hrz1 + SPAN_MS), lookahead = barmerge.lookahead_on)
    asOf1 := request.security(syminfo.tickerid, tf1, time_close[1], lookahead = barmerge.lookahead_on)
if act2
    snap2 := request.security(syminfo.tickerid, tf2, f_engine(inHtfCap, inMinTick, hrz2, hrz2 + SPAN_MS), lookahead = barmerge.lookahead_on)
    asOf2 := request.security(syminfo.tickerid, tf2, time_close[1], lookahead = barmerge.lookahead_on)
if act3
    snap3 := request.security(syminfo.tickerid, tf3, f_engine(inHtfCap, inMinTick, hrz3, hrz3 + SPAN_MS), lookahead = barmerge.lookahead_on)
    asOf3 := request.security(syminfo.tickerid, tf3, time_close[1], lookahead = barmerge.lookahead_on)
if act4
    snap4 := request.security(syminfo.tickerid, tf4, f_engine(inHtfCap, inMinTick, hrz4, hrz4 + SPAN_MS), lookahead = barmerge.lookahead_on)
    asOf4 := request.security(syminfo.tickerid, tf4, time_close[1], lookahead = barmerge.lookahead_on)

// ═════════════════════════════════════════ STATE ══════════════════════════════════════════════
var array<Zone>   chartZ = array.new<Zone>()
var array<Zone>   hz1 = array.new<Zone>()
var array<Zone>   hz2 = array.new<Zone>()
var array<Zone>   hz3 = array.new<Zone>()
var array<Zone>   hz4 = array.new<Zone>()
var array<int>    lastAsOf = array.new_int(7, 0)
var array<int>    wm       = array.new_int(7, 0)
var array<bool>   srcBad   = array.new_bool(7, false)
var array<bool>   srcSeen  = array.new_bool(7, false)
var array<bool>   srcInit  = array.new_bool(7, false)
var array<bool>   srcTrunc = array.new_bool(7, false)
var array<bool>   srcReady = array.new_bool(7, false)
var array<string> warnArr  = array.new_string(0)
var array<int>    ev   = array.new_int(12, 0)         // 7 target hit, 8 stop hit, 9 long entry, 10 short entry, 11 ambiguous
var array<string> evTf = array.new_string(12, "")
var array<string> aMsgs = array.new_string(0)         // alert lines of the current confirmed bar (sent as ONE alert())
var int   firstTime = time
var int   lastConfClose = na
var float refPrice = na
float chartAtr = ta.atr(14)
int   prevCloseT = time_close[1]
float h2c = high[2]
float l2c = low[2]
var Ctx cx = Ctx.new()
var array<Zone>   pend = array.new<Zone>()            // 30s gaps that inverted on THIS bar (trigger candidates)
var array<Setup>  setups = array.new<Setup>()
var array<string> wKeys = array.new_string(0)         // entries per window instance
var array<int>    wCnt  = array.new_int(0)
var int  lastResolveAt = 0
var array<label>  dbgLbls = array.new<label>()
var array<int>    dKey    = array.new_int(0)          // NY calendar dates with chart data (yyyymmdd), oldest first
var array<int>    dDow    = array.new_int(0)
var array<int>    dWinN   = array.new_int(0)          // confirmed bars inside an enabled entry window
var array<int>    dWinBad = array.new_int(0)          // ... of which qualification coverage was incomplete
var array<int>    dSetN   = array.new_int(0)          // setups entered on that date
var int  firstDateKey = na
var int  covStart = na
var bool needPrune = false
var array<Lvl> lvStore = array.new<Lvl>()
int   biasDir = na(bzR) ? 0 : int(bzR)
bool okWinAs = not (inAsTz == inLoTz and inAsH == inLoH and inAsM == inLoM)
bool okWinAm = not (inAmSH == inAmEH and inAmSM == inAmEM)
bool okWinPm = not (inPmSH == inPmEH and inPmSM == inPmEM)

// ───────────── entry windows (calendar-aware; named IANA timezones; never the chart display timezone) ─────────────
// Local timestamp for the calendar date `dayShift` days from ref's local date in tz. Stepping is anchored at local
// NOON so a DST day (23h/25h) can never skip or repeat a date; hh:mm is then built with timestamp(tz, ...).
f_localTs(int ref, string tz, int dayShift, int hh, int mm) =>
    int noon = timestamp(tz, year(ref, tz), month(ref, tz), dayofmonth(ref, tz), 12, 0, 0)
    int shifted = noon + dayShift * 86400000
    timestamp(tz, year(shifted, tz), month(shifted, tz), dayofmonth(shifted, tz), hh, mm, 0)

// One window candidate containing T (start inclusive, end exclusive). Instances starting on T's local start-date
// and the previous start-date are checked, so overnight windows are found. Returns [start, end] or [na, na].
f_winCand(int T, bool en, bool valid, int sh, int sm, string stz, int eh, int em, string etz) =>
    int bs = na
    int be = na
    if en and valid
        for s = 0 to 1
            int st = f_localTs(T, stz, -s, sh, sm)
            int e0 = f_localTs(st, etz, 0, eh, em)
            int eEnd = e0 > st ? e0 : f_localTs(st, etz, 1, eh, em)   // first end strictly after the start
            int dw = dayofweek(st, stz)
            bool dayOk = inWkd == "Every day" or (dw >= dayofweek.monday and dw <= dayofweek.friday)
            if dayOk and T >= st and T < eEnd
                if na(bs) or st > bs
                    bs := st
                    be := eEnd
    [bs, be]

// Deterministic assignment: latest start wins; equal starts: NY morning, then NY afternoon, then Asia -> London.
f_selectWindow(int T) =>
    [sA, eA] = f_winCand(T, inWinAsia, okWinAs, inAsH, inAsM, inAsTz, inLoH, inLoM, inLoTz)
    [sM, eM] = f_winCand(T, inWinAm, okWinAm, inAmSH, inAmSM, inAmTz, inAmEH, inAmEM, inAmTz)
    [sP, eP] = f_winCand(T, inWinPm, okWinPm, inPmSH, inPmSM, inPmTz, inPmEH, inPmEM, inPmTz)
    string bn = ""
    int bs = na
    int be = na
    if not na(sM)
        bn := "New York morning"
        bs := sM
        be := eM
    if not na(sP) and (na(bs) or sP > bs)
        bn := "New York afternoon"
        bs := sP
        be := eP
    if not na(sA) and (na(bs) or sA > bs)
        bn := "Asia -> London"
        bs := sA
        be := eA
    [bn, bs, be]

// ═════════════════════════════════════════ ACTIONS ════════════════════════════════════════════
f_destroy(Zone z) =>
    if not na(z.bx)
        box.delete(z.bx)
        z.bx := na
    true

f_clearStore(array<Zone> a) =>
    int n = a.size()
    if n > 0
        for i = n - 1 to 0
            f_destroy(a.get(i))
            a.remove(i)
    true

f_evInc(int i, string tf) =>
    ev.set(i, ev.get(i) + 1)
    if tf != ""
        string cur = evTf.get(i)
        array<string> toks = str.split(cur, ",")
        if not toks.includes(tf)
            evTf.set(i, cur == "" ? tf : cur + "," + tf)
    true

f_resetEv() =>
    for i = 0 to 11
        ev.set(i, 0)
        evTf.set(i, "")
    true

f_addWhy(string a, string b) =>
    b == "" ? a : (a == "" ? b : a + "; " + b)




f_log(string txt) =>
    if inLog
        log.info("H Ticks | " + txt)
    true

// One chart-layer lifecycle step. Returns 0 none, 1 inverted, 2 removed (touch), 3 removed (invalidation).
f_stepChart(Zone z, float hi, float lo, float cl, int bi, int t, int tc) =>
    int r = 0
    if bi > z.formBar
        bool bull = z.dir > 0
        if z.state == ST_BULL_FVG or z.state == ST_BEAR_FVG
            // inversion: confirmed close strictly through the opposite OUTER boundary
            bool inv = bull ? f_tk(cl) < f_tk(z.bottom) : f_tk(cl) > f_tk(z.top)
            if inv
                z.state := bull ? ST_BEAR_IFVG : ST_BULL_IFVG
                z.invBar := bi
                z.invTime := t
                z.invAvail := tc
                r := 1
        else if bi > z.invBar
            // the inversion candle (bi == invBar) can never remove the new iFVG
            bool invalid = bull ? f_tk(cl) > f_tk(z.top) : f_tk(cl) < f_tk(z.bottom)
            if invalid
                r := 3
            else if f_overlap(hi, lo, z.bottom, z.top)
                r := 2
    r

// Reconcile one source slot against the engine snapshot (HTF layer). Chronological two-pointer merge.
// `gen` = false during the slot's first (bootstrap) reconciliation: nothing is announced then.
// The watermark only gates creation of zones that have no store match; matched zones always update.
f_reconcile(array<Zone> store, int idx, string tfTxt, array<float> snap, int asOf) =>
    bool gen = srcInit.get(idx)
    srcTrunc.set(idx, snap.get(0) == 1.0)
    srcReady.set(idx, snap.get(1) > 0.0)
    int cnt = int((snap.size() - HDR) / ZS)
    int m = store.size()
    if m > 0
        for i = 0 to m - 1
            Zone z0 = store.get(i)
            z0.seen := false
            z0.endNow := false
    int j = 0
    if cnt > 0
        for k = 0 to cnt - 1
            int base = HDR + k * ZS
            int ft = int(snap.get(base))
            float cd = snap.get(base + 1)
            int d = cd > 0 ? 1 : -1
            bool flg = math.abs(cd) == 2.0
            float zt = snap.get(base + 2)
            float zb = snap.get(base + 3)
            int conf = int(snap.get(base + 4))
            int tp = int(snap.get(base + 5))
            float fa = snap.get(base + 7)
            bool adv = true
            while adv
                adv := false
                if j < store.size()
                    if store.get(j).formTime < ft
                        j += 1
                        adv := true
            bool isMatch = false
            if j < store.size()
                isMatch := store.get(j).formTime == ft
            if isMatch
                Zone z = store.get(j)
                z.seen := true
                z.lastEvt := asOf
                j += 1
                if flg
                    z.endNow := true
                else if tp > 0 and not z.tapped
                    z.tapped := true          // monotonic: never reverted by a snapshot
                    z.state := z.dir > 0 ? ST_TAP_BULL : ST_TAP_BEAR
                    z.tapTime := tp
                    z.tapAvail := time_close
                    if gen
                        f_evInc(5, tfTxt)
            else if not flg and ft > wm.get(idx)
                bool tpd = tp > 0
                int st = d > 0 ? (tpd ? ST_TAP_BULL : ST_UNT_BULL) : (tpd ? ST_TAP_BEAR : ST_UNT_BEAR)
                Zone nz = Zone.new(id = syminfo.tickerid + "|" + tfTxt + "|" + str.tostring(ft) + "|" + str.tostring(d), src = idx, tfTxt = tfTxt, dir = d, state = st, top = zt, bottom = zb, formTime = ft, confTime = conf, availTime = time_close, width = zt - zb, fatr = fa < 0 ? na : fa, tapped = tpd, tapTime = tp, tapAvail = time_close, lastEvt = asOf, seen = true)
                store.push(nz)
                wm.set(idx, ft)
                // genuine formation = confirmed by the source candle that just completed, after bootstrap
                if gen and conf == asOf
                    f_evInc(4, tfTxt)
    // zones missing from the snapshot are gone (expired, capacity-pruned, or already removed): silent.
    // zones the engine flagged inverted: removal dominates any tap in the same step.
    int n2 = store.size()
    if n2 > 0
        for i = n2 - 1 to 0
            Zone z = store.get(i)
            if z.endNow
                f_destroy(z)
                store.remove(i)
                if gen
                    f_evInc(6, tfTxt)
            else if not z.seen
                f_destroy(z)
                store.remove(i)
    srcInit.set(idx, true)
    true

f_sync(array<Zone> store, int idx, string tfTxt, array<float> snap, int asOf) =>
    if not na(snap) and not na(asOf)
        srcSeen.set(idx, true)
        if asOf > lastAsOf.get(idx) and not srcBad.get(idx)
            lastAsOf.set(idx, asOf)
            // The chart must cover the WHOLE current source period (it starts at asOf), otherwise touches
            // earlier in that period are unknowable: skip; the next snapshot already includes that period.
            if firstTime <= asOf
                // A chart candle straddling the source boundary would make event order ambiguous.
                if not na(prevCloseT) and prevCloseT > asOf
                    srcBad.set(idx, true)
                    warnArr.push(tfTxt + " disabled: chart candles do not align with " + tfTxt + " boundaries (session/timeframe alignment)")
                    f_clearStore(store)
                else
                    f_reconcile(store, idx, tfTxt, snap, asOf)
    true

// Chart-candle taps on HTF zones (monotonic). Candle must OPEN at/after formation confirmation.
f_tapStore(array<Zone> a) =>
    int n = a.size()
    if n > 0
        for i = 0 to n - 1
            Zone z = a.get(i)
            if not z.tapped and time >= z.confTime and f_overlap(high, low, z.bottom, z.top)
                z.tapped := true
                z.state := z.dir > 0 ? ST_TAP_BULL : ST_TAP_BEAR
                z.tapTime := time
                z.tapAvail := time_close
                f_evInc(5, z.tfTxt)
    true

// ───────────── HTF obstacle / coverage ─────────────
// Opposing active tracked HTF FVGs whose ORIGINAL boundaries intersect the closed interval [lo, hi].
// Deliberately ignores every display filter (size, budgets, nearest sets, visibility).
f_scanObs(array<Zone> a, bool bull, float lo, float hi) =>
    int cnt = 0
    string nm = ""
    int n = a.size()
    if n > 0
        float loT = lo / syminfo.mintick
        float hiT = hi / syminfo.mintick
        for i = 0 to n - 1
            Zone z = a.get(i)
            bool opp = bull ? z.dir < 0 : z.dir > 0
            if opp and f_tk(z.top) >= loT - 0.000001 and f_tk(z.bottom) <= hiT + 0.000001
                cnt += 1
                if nm == ""
                    nm := z.tfTxt + (z.dir < 0 ? " bearish" : " bullish") + " FVG, " + str.tostring(z.bottom, format.mintick) + "–" + str.tostring(z.top, format.mintick)
    [cnt, nm]

f_scanAll(bool bull, float lo, float hi) =>
    [ca, na_] = f_scanObs(hz1, bull, lo, hi)
    [cb, nb_] = f_scanObs(hz2, bull, lo, hi)
    [cc, nc_] = f_scanObs(hz3, bull, lo, hi)
    [cd, nd_] = f_scanObs(hz4, bull, lo, hi)
    string nm = na_ != "" ? na_ : (nb_ != "" ? nb_ : (nc_ != "" ? nc_ : nd_))
    [ca + cb + cc + cd, nm]

// 0 = not applicable (disabled / equal / lower / duplicate), 1 = valid, 2 = UNKNOWN (never "clear")
f_slotState(bool en, bool okS, bool actS, int idx) =>
    int st = 0
    if en and okS
        st := actS and srcSeen.get(idx) and srcInit.get(idx) and srcReady.get(idx) and not srcBad.get(idx) and not srcTrunc.get(idx) ? 1 : 2
    st

// Why a source is not valid (empty when valid / not applicable). Names the source and the limitation.
f_slotWhy(bool en, bool okS, bool actS, int idx, string nm) =>
    string r = ""
    if en and okS
        if not actS
            r := nm + ": inactive (not an integer multiple of the chart timeframe)"
        else if not srcSeen.get(idx)
            r := nm + ": no source data returned"
        else if srcBad.get(idx)
            r := nm + ": chart candles do not align with source boundaries"
        else if not srcInit.get(idx)
            r := nm + ": chart history does not yet cover the source period"
        else if srcTrunc.get(idx)
            r := nm + ": tracking capacity exceeded (an omitted gap may still be live)"
        else if not srcReady.get(idx)
            r := nm + ": history warming up (obstacle horizon not yet covered)"
    r

// cov: 0 complete, 1 unknown (some applicable source not valid), 2 no applicable source
f_coverage() =>
    int s1 = f_slotState(en1, ok1, act1, 0)
    int s2 = f_slotState(en2, ok2, act2, 1)
    int s3 = f_slotState(en3, ok3, act3, 2)
    int s4 = f_slotState(en4, ok4, act4, 3)
    int nValid = (s1 == 1 ? 1 : 0) + (s2 == 1 ? 1 : 0) + (s3 == 1 ? 1 : 0) + (s4 == 1 ? 1 : 0)
    int nUnk = (s1 == 2 ? 1 : 0) + (s2 == 2 ? 1 : 0) + (s3 == 2 ? 1 : 0) + (s4 == 2 ? 1 : 0)
    string txt = ""
    if s1 == 1
        txt := f_tfText(sec1)
    if s2 == 1
        txt := txt == "" ? f_tfText(sec2) : txt + "," + f_tfText(sec2)
    if s3 == 1
        txt := txt == "" ? f_tfText(sec3) : txt + "," + f_tfText(sec3)
    if s4 == 1
        txt := txt == "" ? f_tfText(sec4) : txt + "," + f_tfText(sec4)
    string why = ""
    if nUnk > 0
        why := f_addWhy(why, f_slotWhy(en1, ok1, act1, 0, f_tfText(sec1)))
        why := f_addWhy(why, f_slotWhy(en2, ok2, act2, 1, f_tfText(sec2)))
        why := f_addWhy(why, f_slotWhy(en3, ok3, act3, 2, f_tfText(sec3)))
        why := f_addWhy(why, f_slotWhy(en4, ok4, act4, 3, f_tfText(sec4)))
    [nUnk > 0 ? 1 : (nValid > 0 ? 0 : 2), txt, why]

// 3m context source: usable only when data is present, aligned, initialised and warmed up. Capacity truncation can only
// MISS contexts (never create one), so it is reported but does not make the source unusable.
f_ctxReady() =>
    act0 and srcSeen.get(4) and srcInit.get(4) and srcReady.get(4) and not srcBad.get(4)

f_lvlReady() =>
    act0 and srcSeen.get(5) and srcInit.get(5) and srcReady.get(5) and not srcBad.get(5) and not srcTrunc.get(5)

f_lvlWhy() =>
    string r = ""
    if supported and act0
        if not srcSeen.get(5)
            r := "3m structure: no source data returned"
        else if srcBad.get(5)
            r := "3m structure: chart candles do not align with 3m boundaries"
        else if not srcInit.get(5)
            r := "3m structure: chart history does not yet cover the source period"
        else if srcTrunc.get(5)
            r := "3m structure: level capacity exceeded (an omitted level may still be live)"
        else if not srcReady.get(5)
            r := "3m structure: history warming up (level horizon not yet covered)"
    r

f_ctxWhy() =>
    string r = ""
    if not supported
        r := ""
    else if not act0
        r := "3m context: unavailable (3m is not an integer multiple of the chart timeframe)"
    else if not srcSeen.get(4)
        r := "3m context: no source data returned"
    else if srcBad.get(4)
        r := "3m context: chart candles do not align with 3m boundaries"
    else if not srcInit.get(4)
        r := "3m context: chart history does not yet cover the source period"
    else if not srcReady.get(4)
        r := "3m context: history warming up (gap-age horizon not yet covered)"
    else if srcTrunc.get(4)
        r := "3m context: gap capacity exceeded (older 3m gaps omitted; contexts may be missed)"
    r

// ───────────── display selection (never touches lifecycle state or array order) ─────────────
// Size filter on FROZEN width and FROZEN formation ATR. Tick-aware, so a width exactly at the threshold qualifies.
f_sizeOk(float width, float fatr, int minT, float mult) =>
    bool ok = true
    if mult > 0 and na(fatr)
        ok := false              // ATR qualification unknown: hide (still tracked)
    else
        float thrT = float(minT)
        if mult > 0
            float atrT = mult * fatr / syminfo.mintick
            thrT := atrT > thrT ? atrT : thrT
        ok := f_tk(width) >= thrT - 0.000001
    ok

// Nearest-EDGE distance (0 when price is inside or on a boundary).
f_dist(Zone z, float ref) =>
    float d = 0.0
    if f_tk(ref) < f_tk(z.bottom)
        d := z.bottom - ref
    else if f_tk(ref) > f_tk(z.top)
        d := ref - z.top
    d

// ═════════════════════════════════════════ DRAWING ════════════════════════════════════════════
// Persistent handles, mutated only on confirmed bars (drawNow). Hidden/removed items are deleted; state is untouched.
f_syncDraw(Zone z, bool htf, bool want) =>
    if not want
        f_destroy(z)
    else
        bool bull = z.state == ST_BULL_FVG or z.state == ST_BULL_IFVG or z.state == ST_UNT_BULL or z.state == ST_TAP_BULL
        bool ifvg = z.state == ST_BULL_IFVG or z.state == ST_BEAR_IFVG
        bool tap  = z.state == ST_TAP_BULL or z.state == ST_TAP_BEAR
        color base = bull ? inBull : inBear
        int fillT = htf ? (tap ? inHtfTapT : inHtfT) : inChT
        string txt = ""
        if inLabels
            txt := htf ? z.tfTxt + " FVG · " + (tap ? "Tapped" : "Untapped") : (ifvg ? "iFVG" : "FVG")
        int l = z.formTime > firstTime ? z.formTime : firstTime
        int r = lastConfClose + inExt * chartMs
        if r <= l
            r := l + chartMs
        if na(z.bx)
            z.bx := box.new(left = l, top = z.top, right = r, bottom = z.bottom, xloc = xloc.bar_time, border_color = color.new(base, inBordT), border_width = 1, border_style = ifvg ? line.style_dashed : line.style_solid, bgcolor = color.new(base, fillT), text = txt, text_size = size.small, text_color = color.new(base, 15), text_halign = text.align_right, text_valign = text.align_center)
        else
            box.set_left(z.bx, l)
            box.set_top(z.bx, z.top)
            box.set_right(z.bx, r)
            box.set_bottom(z.bx, z.bottom)
            box.set_bgcolor(z.bx, color.new(base, fillT))
            box.set_border_color(z.bx, color.new(base, inBordT))
            box.set_border_style(z.bx, ifvg ? line.style_dashed : line.style_solid)
            box.set_text(z.bx, txt)
            box.set_text_color(z.bx, color.new(base, 15))
    true

f_classify(array<Zone> a, bool htf) =>
    int n = a.size()
    if n > 0
        for i = 0 to n - 1
            Zone z = a.get(i)
            z.vis := false
            z.cat := -1
            z.dist := f_dist(z, refPrice)
            if htf
                if inShowHtf and f_sizeOk(z.width, z.fatr, inHtfMinT, inHtfAtr)
                    z.cat := f_tk(z.bottom) > f_tk(refPrice) ? 2 : (f_tk(z.top) < f_tk(refPrice) ? 3 : 4)
            else
                bool isI = z.state == ST_BULL_IFVG or z.state == ST_BEAR_IFVG
                if inShow30 and f_sizeOk(z.width, z.fatr, inFvgMinT, inFvgAtr)
                    z.cat := isI ? 1 : 0
    true

f_pickCat(array<Zone> a, int cat, int limit) =>
    int n = a.size()
    if n > 0 and limit > 0
        for pick = 1 to limit
            int best = -1
            for i = 0 to n - 1
                Zone z = a.get(i)
                if z.cat == cat and not z.vis
                    if best < 0
                        best := i
                    else
                        Zone bz = a.get(best)
                        bool better = false
                        if inNearest and z.dist != bz.dist
                            better := z.dist < bz.dist
                        else
                            better := z.formTime >= bz.formTime
                        if better
                            best := i
            if best >= 0
                Zone sel = a.get(best)
                sel.vis := true
    true

f_drawHtf(array<Zone> a) =>
    f_classify(a, true)
    f_pickCat(a, 2, inHtfAbove)
    f_pickCat(a, 3, inHtfBelow)
    f_pickCat(a, 4, inHtfCont)
    int n = a.size()
    if n > 0
        for i = 0 to n - 1
            Zone z = a.get(i)
            f_syncDraw(z, true, z.vis)
    true

f_drawCtx() =>
    if cx.state != 0 and inShowCtx
        color base = cx.dir > 0 ? inBull : inBear
        int l = cx.formTime > firstTime ? cx.formTime : firstTime
        int r = lastConfClose + inExt * chartMs
        if r <= l
            r := l + chartMs
        string txt = ""
        if inLabels
            txt := "3m ctx " + (cx.dir > 0 ? "long" : "short") + (cx.state == 1 ? " · awaiting retest" : " · awaiting 30s trigger")
        if na(cx.bx)
            cx.bx := box.new(left = l, top = cx.top, right = r, bottom = cx.bottom, xloc = xloc.bar_time, border_color = color.new(base, 40), border_width = 2, border_style = line.style_dashed, bgcolor = color.new(base, 90), text = txt, text_size = size.small, text_color = color.new(base, 10), text_halign = text.align_right, text_valign = text.align_center)
        else
            box.set_left(cx.bx, l)
            box.set_top(cx.bx, cx.top)
            box.set_right(cx.bx, r)
            box.set_bottom(cx.bx, cx.bottom)
            box.set_bgcolor(cx.bx, color.new(base, 90))
            box.set_border_color(cx.bx, color.new(base, 40))
            box.set_text(cx.bx, txt)
            box.set_text_color(cx.bx, color.new(base, 10))
    else if not na(cx.bx)
        box.delete(cx.bx)
        cx.bx := na
    true

f_delSetupDraw(Setup s) =>
    if not na(s.lE)
        line.delete(s.lE)
        s.lE := na
    if not na(s.lS)
        line.delete(s.lS)
        s.lS := na
    if not na(s.lT)
        line.delete(s.lT)
        s.lT := na
    if not na(s.lR)
        line.delete(s.lR)
        s.lR := na
    if not na(s.rbx)
        box.delete(s.rbx)
        s.rbx := na
    if not na(s.gbx)
        box.delete(s.gbx)
        s.gbx := na
    if not na(s.ctxBx)
        box.delete(s.ctxBx)
        s.ctxBx := na
    if not na(s.trgBx)
        box.delete(s.trgBx)
        s.trgBx := na
    if not na(s.lbE)
        label.delete(s.lbE)
        s.lbE := na
    if not na(s.lbS)
        label.delete(s.lbS)
        s.lbS := na
    if not na(s.lbT)
        label.delete(s.lbT)
        s.lbT := na
    if not na(s.lbRt)
        label.delete(s.lbRt)
        s.lbRt := na
    if not na(s.lbAn)
        label.delete(s.lbAn)
        s.lbAn := na
    true

// Create-or-update helpers: every property is (re)applied so a handle can never keep stale values.
f_boxUp(box b, int l, float tp, int r, float bt, color bg, color bc, string txt, color tc, string sty) =>
    box h = b
    if na(h)
        h := box.new(left = l, top = tp, right = r, bottom = bt, xloc = xloc.bar_time, border_color = bc, border_width = 1, border_style = sty, bgcolor = bg, text = txt, text_size = size.tiny, text_color = tc, text_halign = text.align_right, text_valign = text.align_top)
    else
        box.set_left(h, l)
        box.set_top(h, tp)
        box.set_right(h, r)
        box.set_bottom(h, bt)
        box.set_bgcolor(h, bg)
        box.set_border_color(h, bc)
        box.set_border_style(h, sty)
        box.set_text(h, txt)
        box.set_text_color(h, tc)
    h

f_lineUp(line ln, int x1, float y1, int x2, float y2, color c, string sty) =>
    line h = ln
    if na(h)
        h := line.new(x1 = x1, y1 = y1, x2 = x2, y2 = y2, xloc = xloc.bar_time, color = c, style = sty, width = 2)
    else
        line.set_xy1(h, x1, y1)
        line.set_xy2(h, x2, y2)
        line.set_color(h, c)
    h

f_lblUp(label lb, int x, float y, string txt, color tc, string sty, string tip) =>
    label h = lb
    if na(h)
        h := label.new(x = x, y = y, text = txt, xloc = xloc.bar_time, style = sty, size = size.tiny, textcolor = tc, color = cLblBg, tooltip = tip)
    else
        label.set_xy(h, x, y)
        label.set_text(h, txt)
        label.set_textcolor(h, tc)
        label.set_color(h, cLblBg)
        label.set_tooltip(h, tip)
    h

// Risk/reward position look-alike (NOT TradingView's native drawing tool). Starts at the entry confirmation; while OPEN it
// extends to the latest confirmed close; when resolved the shading stops at the actual resolution time. A minimum visual width
// (display only) keeps a fast result readable; the actual resolution time is marked by a separate dotted line and the label.
f_syncSetupDraw(Setup s, bool want) =>
    if not want
        f_delSetupDraw(s)
    else
        bool bull = s.dir > 0
        int actualR = s.state != 0 ? s.resolveTime : lastConfClose
        int rv = math.max(actualR + inExt * chartMs, s.entryTime + 20 * chartMs)
        string outTxt = s.state == 1 ? "Target hit" : (s.state == 2 ? "Stop hit" : (s.state == 3 ? "Ambiguous" : "Open"))
        string resTxt = s.state != 0 ? " · " + outTxt + " " + str.format_time(s.resolveTime, "HH:mm:ss", TZ_NY) + " NY" : ""
        string tipTxt = s.tip + (rv > actualR + inExt * chartMs ? "\n(Shaded width is display-only; the outcome time is the dotted marker.)" : "")
        string tE = "Entry " + str.tostring(s.entry, format.mintick) + " · 1:1 · risk " + str.tostring(s.riskT) + "t" + resTxt
        string tT = "Target " + str.tostring(s.target, format.mintick) + (s.state == 1 ? " · Target hit" : "")
        string tS = "Stop " + str.tostring(s.stop, format.mintick) + (s.state == 2 ? " · Stop hit" : "")
        if inShowRR
            float rTop = bull ? s.entry : s.stop
            float rBot = bull ? s.stop : s.entry
            float gTop = bull ? s.target : s.entry
            float gBot = bull ? s.entry : s.target
            s.rbx := f_boxUp(s.rbx, s.entryTime, rTop, rv, rBot, color.new(color.red, 85), color.new(color.red, 100), "", color.red, line.style_solid)
            s.gbx := f_boxUp(s.gbx, s.entryTime, gTop, rv, gBot, color.new(color.green, 85), color.new(color.green, 100), "", color.green, line.style_solid)
        else
            if not na(s.rbx)
                box.delete(s.rbx)
                s.rbx := na
            if not na(s.gbx)
                box.delete(s.gbx)
                s.gbx := na
        s.lE := f_lineUp(s.lE, s.entryTime, s.entry, rv, s.entry, inEntryCol, line.style_solid)
        s.lS := f_lineUp(s.lS, s.entryTime, s.stop, rv, s.stop, inStopCol, line.style_solid)
        s.lT := f_lineUp(s.lT, s.entryTime, s.target, rv, s.target, inTgtCol, line.style_solid)
        if s.state != 0
            float yLo = math.min(s.stop, s.target)
            float yHi = math.max(s.stop, s.target)
            s.lR := f_lineUp(s.lR, s.resolveTime, yLo, s.resolveTime, yHi, color.gray, line.style_dotted)
        else if not na(s.lR)
            line.delete(s.lR)
            s.lR := na
        s.lbE := f_lblUp(s.lbE, rv, s.entry, tE, inEntryCol, label.style_label_left, tipTxt)
        s.lbS := f_lblUp(s.lbS, rv, s.stop, tS, inStopCol, label.style_label_left, tipTxt)
        s.lbT := f_lblUp(s.lbT, rv, s.target, tT, inTgtCol, label.style_label_left, tipTxt)
        s.lbRt := f_lblUp(s.lbRt, s.retestT, s.retestPx, "retest", cLblTx, bull ? label.style_label_up : label.style_label_down, tipTxt)
        s.lbAn := f_lblUp(s.lbAn, s.stopAnchorT, s.legExt, "stop anchor", inStopCol, bull ? label.style_label_up : label.style_label_down, tipTxt)
        if inShowPair
            color pc = bull ? inBull : inBear
            s.ctxBx := f_boxUp(s.ctxBx, s.ctxFormT, s.ctxTop, s.entryTime, s.ctxBot, color.new(pc, 88), color.new(pc, 40), "3m CONTEXT · " + s.id, color.new(pc, 10), line.style_dashed)
            s.trgBx := f_boxUp(s.trgBx, s.trgFormT, s.trgTop, s.entryTime, s.trgBot, color.new(pc, 80), color.new(pc, 30), "30s TRIGGER · " + s.id, color.new(pc, 10), line.style_solid)
        else
            if not na(s.ctxBx)
                box.delete(s.ctxBx)
                s.ctxBx := na
            if not na(s.trgBx)
                box.delete(s.trgBx)
                s.trgBx := na
    true

// Drawing subset when object limits bind: unresolved setups first, then the newest resolved ones, up to DRAW_MAX.
// Statistics never depend on what is drawn.
f_drawSetups() =>
    int n = setups.size()
    int drawn = 0
    if n > 0
        for pass = 0 to 1
            for ii = 0 to n - 1
                int i = pass == 0 ? ii : n - 1 - ii
                Setup s = setups.get(i)
                if (pass == 0) == (s.state == 0)
                    bool want = drawn < DRAW_MAX
                    if want
                        drawn += 1
                    f_syncSetupDraw(s, want)
    true

f_drawAll() =>
    if not na(lastConfClose) and not na(refPrice)
        f_classify(chartZ, false)
        f_pickCat(chartZ, 0, inMax30Fvg)
        f_pickCat(chartZ, 1, inMax30Ifvg)
        int n = chartZ.size()
        if n > 0
            for i = 0 to n - 1
                Zone z = chartZ.get(i)
                f_syncDraw(z, false, z.vis)
        f_drawHtf(hz1)
        f_drawHtf(hz2)
        f_drawHtf(hz3)
        f_drawHtf(hz4)
        f_drawCtx()
        f_drawSetups()
    true

// ───────────── 3m context, entry, outcome ─────────────
// ───────────── 3m structural levels on the chart ─────────────
f_lvlReconcile(array<float> snap) =>
    int cnt = int((snap.size() - HDR) / LS)
    int m = lvStore.size()
    if m > 0
        for i = 0 to m - 1
            Lvl q0 = lvStore.get(i)
            q0.seen := false
    if cnt > 0
        for k = 0 to cnt - 1
            int b = HDR + k * LS
            float pr = snap.get(b)
            int dr = snap.get(b + 1) > 0 ? 1 : -1
            int pt = int(snap.get(b + 2))
            int ct = int(snap.get(b + 3))
            bool found = false
            int n = lvStore.size()
            if n > 0
                for i = 0 to n - 1
                    Lvl q = lvStore.get(i)
                    if q.pivotT == pt and q.dir == dr
                        q.seen := true
                        found := true
            if not found
                lvStore.push(Lvl.new(price = pr, dir = dr, pivotT = pt, confT = ct, seen = true))
    int n2 = lvStore.size()
    if n2 > 0
        for i = n2 - 1 to 0
            if not lvStore.get(i).seen
                lvStore.remove(i)
    true

f_lvlSync(array<float> snap, int asOf) =>
    if not na(snap) and not na(asOf)
        srcSeen.set(5, true)
        if asOf > lastAsOf.get(5)
            lastAsOf.set(5, asOf)
            if srcBad.get(4)
                srcBad.set(5, true)
            else if firstTime <= asOf
                srcInit.set(5, true)
                srcTrunc.set(5, snap.get(0) == 1.0)
                srcReady.set(5, snap.get(1) > 0.0)
                f_lvlReconcile(snap)
    true

// Consumption by THIS confirmed 30s candle (monotonic). Levels confirmed after this candle opened cannot be consumed by it.
f_lvlConsume() =>
    int n = lvStore.size()
    if n > 0
        for i = 0 to n - 1
            Lvl q = lvStore.get(i)
            if not q.consumed and time >= q.confT
                bool hit = q.dir > 0 ? f_tk(high) >= f_tk(q.price) : f_tk(low) <= f_tk(q.price)
                if hit
                    q.consumed := true
    true

// Nearest remaining (unconsumed, available before this candle began) level in the target direction.
// Blocks unless the target ends at least one tick before it. Returns [blocked, nearest level or na].
f_structCheck(bool bull, int tT) =>
    float near = na
    int n = lvStore.size()
    if n > 0
        for i = 0 to n - 1
            Lvl q = lvStore.get(i)
            if not q.consumed and q.confT <= time and q.dir == (bull ? 1 : -1)
                if na(near)
                    near := q.price
                else
                    near := bull ? math.min(near, q.price) : math.max(near, q.price)
    bool blocked = false
    if not na(near)
        blocked := bull ? tT > f_tk(near) - 1 : tT < f_tk(near) + 1
    [blocked, near]

f_nyT(int t) =>
    str.format_time(t, "MM-dd HH:mm:ss", TZ_NY)

f_ctxClear() =>
    if not na(cx.bx)
        box.delete(cx.bx)
        cx.bx := na
    cx.state := 0
    cx.retestBar := -1
    true

f_openSetup() =>
    bool o = false
    int n = setups.size()
    if n > 0
        for i = 0 to n - 1
            if setups.get(i).state == 0
                o := true
    o

f_winCount(string id) =>
    int c = 0
    int n = wKeys.size()
    if n > 0
        for i = 0 to n - 1
            if wKeys.get(i) == id
                c := wCnt.get(i)
    c

f_winInc(string id) =>
    bool found = false
    int n = wKeys.size()
    if n > 0
        for i = 0 to n - 1
            if wKeys.get(i) == id
                wCnt.set(i, wCnt.get(i) + 1)
                found := true
    if not found
        wKeys.push(id)
        wCnt.push(1)
    while wKeys.size() > 60
        wKeys.shift()
        wCnt.shift()
    true

// ───────────── reporting calendar: New York entry dates ─────────────
f_dateKey(int t) =>
    year(t, TZ_NY) * 10000 + month(t, TZ_NY) * 100 + dayofmonth(t, TZ_NY)

f_dateIdx(int k) =>
    int r = -1
    int n = dKey.size()
    if n > 0
        for i = n - 1 to 0
            if r < 0 and dKey.get(i) == k
                r := i
    r

// The reported dates: the latest REP_DATES Mon-Fri NY dates that have chart data (plus any weekend date that holds setups,
// so no setup is ever silently left out). Oldest first.
f_reportDates() =>
    array<int> r = array.new_int(0)
    int n = dKey.size()
    if n > 0
        for i = n - 1 to 0
            if r.size() < REP_DATES
                bool wk = dDow.get(i) >= dayofweek.monday and dDow.get(i) <= dayofweek.friday
                if wk or dSetN.get(i) > 0
                    r.unshift(dKey.get(i))
    r

// Retention: an UNRESOLVED setup is never pruned. A RESOLVED setup is pruned only when its entry date is older than the
// oldest reported date. Statistics are computed from these records and never from drawings.
f_pruneSetups() =>
    array<int> rd = f_reportDates()
    int cut = rd.size() > 0 ? rd.first() : 0
    int n = setups.size()
    if n > 0
        for i = n - 1 to 0
            Setup s = setups.get(i)
            if s.state != 0 and s.dateKey < cut
                f_delSetupDraw(s)
                setups.remove(i)
    true

f_dateCount(int k, int st) =>
    int c = 0
    int n = setups.size()
    if n > 0
        for i = 0 to n - 1
            Setup s = setups.get(i)
            if s.dateKey == k and (st < 0 or s.state == st)
                c += 1
    c

// 0 fully evaluated, 1 partial, 2 unavailable (qualification coverage never complete on that date)
f_dateStatus(int idx) =>
    int st = 0
    int wn = dWinN.get(idx)
    int bad = dWinBad.get(idx)
    if wn > 0 and bad == wn
        st := 2
    else if bad > 0 or dKey.get(idx) == firstDateKey
        st := 1
    st

f_dateTxt(int k) =>
    string t = str.tostring(k)
    str.substring(t, 4, 6) + "-" + str.substring(t, 6, 8)

// Mandatory expiry at the originating window's end (end exclusive); optional maximum age. Never transferred.
f_ctxExpire() =>
    if cx.state != 0
        bool endedWin = time_close >= cx.winEnd
        bool aged = inUseMaxAge and time_close - cx.confAsOf >= inMaxAgeMin * 60000
        if endedWin or aged
            cx.lastReason := endedWin ? "context expired at window end" : "context expired (max age)"
            f_ctxClear()
    true

// One new confirmed 3m update: (1) later 3m close beyond the zone cancels the pending context,
// (2) 3m gaps inverted by THIS candle may create/replace the context (narrowest, newest, stable order).
f_ctxUpdate(array<float> snap, int asOf, float cCl) =>
    if cx.state != 0 and asOf > cx.confAsOf
        bool inval = cx.dir > 0 ? f_tk(cCl) < f_tk(cx.bottom) : f_tk(cCl) > f_tk(cx.top)
        if inval
            cx.lastReason := "3m context cancelled by a confirmed 3m close through the zone"
            f_ctxClear()
    int cnt = int((snap.size() - HDR) / ZS)
    int bestK = -1
    float bestW = 0.0
    int bestFt = 0
    if cnt > 0
        for k = 0 to cnt - 1
            int base = HDR + k * ZS
            bool dirOk = (snap.get(base + 1) > 0 ? -1 : 1) == biasDir
            if dirOk and math.abs(snap.get(base + 1)) == 2.0 and f_tk(snap.get(base + 2)) - f_tk(snap.get(base + 3)) >= inCtxMinTicks
                float w = snap.get(base + 2) - snap.get(base + 3)
                int ft = int(snap.get(base))
                if bestK < 0 or w < bestW or (w == bestW and ft >= bestFt)
                    bestK := k
                    bestW := w
                    bestFt := ft
    if bestK >= 0
        bool blocked = inOneActive and (f_openSetup() or asOf < lastResolveAt)
        if not blocked
            [wn, ws, we] = f_selectWindow(asOf)
            if not na(ws)
                int b2 = HDR + bestK * ZS
                float cd = snap.get(b2 + 1)
                f_ctxClear()
                cx.state := 1
                cx.dir := cd > 0 ? -1 : 1
                cx.top := snap.get(b2 + 2)
                cx.bottom := snap.get(b2 + 3)
                cx.formTime := int(snap.get(b2))
                cx.confAsOf := asOf
                cx.procTime := time_close
                cx.zid := TF_CTX + "|" + str.tostring(cx.formTime) + "|" + str.tostring(cd > 0 ? 1 : -1)
                cx.winId := wn + "|" + str.tostring(ws)
                cx.winName := wn
                cx.winStart := ws
                cx.winEnd := we
                cx.retestBar := -1
                cx.away := 0
                cx.legExt := na
                cx.retestPx := na
                cx.cbDir := biasDir
                cx.cbLvl := blR
                cx.cbLvlT := int(btR)
                cx.lastReason := ""
                if alCtx
                    aMsgs.push("H Ticks 3m context " + (cx.dir > 0 ? "LONG" : "SHORT") + " " + syminfo.ticker + " | zone " + str.tostring(cx.bottom, format.mintick) + "-" + str.tostring(cx.top, format.mintick) + " | Session " + wn)
                f_log("ctx created " + (cx.dir > 0 ? "long" : "short") + " " + cx.winId)
    true

f_ctxSync(array<float> snap, int asOf, float cCl) =>
    if not na(snap) and not na(asOf) and not na(cCl)
        srcSeen.set(4, true)
        if asOf > lastAsOf.get(4) and not srcBad.get(4)
            lastAsOf.set(4, asOf)
            if firstTime <= asOf
                if not na(prevCloseT) and prevCloseT > asOf
                    srcBad.set(4, true)
                    warnArr.push("3m context source disabled: chart candles do not align with 3m boundaries")
                    f_ctxClear()
                else
                    srcInit.set(4, true)
                    srcTrunc.set(4, snap.get(0) == 1.0)
                    srcReady.set(4, snap.get(1) > 0.0)
                    if srcReady.get(4)
                        f_ctxUpdate(snap, asOf, cCl)
    true

// Trigger candidates = 30s gaps that inverted on this bar in the context's direction and were confirmed at/after the
// 3m confirmation. Narrowest first, then newest; ties resolve to the later array position (stable order).
// Trigger candidates = 30s gaps inverted on THIS bar in the context direction whose formation candle opened at/after the
// 3m confirmation and that intersect the 3m context interval. Newest formation first; then larger width; then later
// array order (ids are timestamp-derived and unique per bar, so the final tie-break cannot occur).
f_pickTrigger() =>
    Zone best = na
    int n = pend.size()
    if n > 0
        int need = cx.dir > 0 ? ST_BULL_IFVG : ST_BEAR_IFVG
        for i = 0 to n - 1
            Zone z = pend.get(i)
            if z.state == need and z.formTime >= cx.confAsOf and f_overlap(z.top, z.bottom, cx.bottom, cx.top)
                bool take = false
                if na(best)
                    take := true
                else
                    take := z.formTime > best.formTime or (z.formTime == best.formTime and z.width >= best.width)
                if take
                    best := z
    best

// Decisive-candle test on the ACTUAL 30s inversion candle (current bar). Returns [ok, reason, body/ATR].
f_decisive(Zone t, bool bull, float atrP) =>
    bool ok = true
    string why = ""
    float bodyAtr = na
    bool strong = inPreset == "Strong"
    float mB = strong ? 1.0 : 0.8
    float mR = strong ? 0.70 : 0.65
    float fr = strong ? 0.15 : 0.20
    float rng = high - low
    float body = close - open
    if na(atrP) or atrP <= 0
        ok := false
        why := "Decisive candle: previous ATR unavailable"
    else if rng <= 0
        ok := false
        why := "Decisive candle: zero-range candle"
    else
        float ab = math.abs(body)
        bodyAtr := ab / atrP
        bool dirOk = bull ? body > 0 : body < 0
        if not dirOk
            ok := false
            why := f_addWhy(why, "Weak/wrong inversion: body points against the setup")
        if ab < mB * atrP - 0.000000001
            ok := false
            why := f_addWhy(why, "Weak inversion: body " + str.tostring(bodyAtr, "#.00") + " x ATR < " + str.tostring(mB, "#.0"))
        if ab / rng < mR - 0.000000001
            ok := false
            why := f_addWhy(why, "Weak inversion: body/range " + str.tostring(ab / rng, "#.00") + " < " + str.tostring(mR, "#.00"))
        bool posOk = bull ? close >= high - fr * rng - 0.000000001 : close <= low + fr * rng + 0.000000001
        if not posOk
            ok := false
            why := f_addWhy(why, "Weak inversion: close not in the outer " + str.tostring(fr * 100, "#") + "% of the range")
        float ext = math.max(syminfo.mintick, 0.10 * atrP)
        float got = bull ? close - t.top : t.bottom - close
        if got < ext - 0.000000001
            ok := false
            why := f_addWhy(why, "Weak inversion: close extends only " + str.tostring(got / syminfo.mintick, "#.0") + " ticks beyond the trigger gap")
    [ok, why, bodyAtr]

f_dbg(string txt) =>
    if inDebug
        dbgLbls.push(label.new(bar_index, high, "x " + txt, style = label.style_label_down, size = size.tiny, textcolor = color.gray, color = color.new(color.gray, 90)))
        while dbgLbls.size() > 30
            label.delete(dbgLbls.shift())
    true

// Entry decision, taken ONCE for this trigger. Rejection keeps the context pending and is never revisited.
f_tryEntry(Zone t) =>
    bool bull = cx.dir > 0
    bool ok = true
    string why = ""
    [wn, ws, we] = f_selectWindow(time_close)
    if na(ws) or wn + "|" + str.tostring(ws) != cx.winId
        ok := false
        why := f_addWhy(why, "Entry outside the originating window instance")
    if f_winCount(cx.winId) >= inMaxEntries
        ok := false
        why := f_addWhy(why, "Window entry limit reached")
    if inOneActive and f_openSetup()
        ok := false
        why := f_addWhy(why, "Another setup is unresolved")
    if biasDir != cx.dir
        ok := false
        why := f_addWhy(why, "15m bias does not agree")
    float atrP = chartAtr[1]
    [decOk, decWhy, bodyAtr] = f_decisive(t, bull, atrP)
    if not decOk
        ok := false
        why := f_addWhy(why, decWhy)
    // structural stop: observed retest-leg extreme (updated through THIS candle) +/- max(1 tick, 0.10 x prev ATR), outward
    float legX = cx.legExt
    int bufT = na(atrP) ? 1 : math.max(1, int(math.ceil(0.10 * atrP / syminfo.mintick - 0.000001)))
    int eT = f_tk(close)
    int sT = 0
    int rT = 0
    float entry = eT * syminfo.mintick
    float stop = na
    float target = na
    if na(legX)
        ok := false
        why := f_addWhy(why, "No retest-leg extreme recorded")
    else
        sT := bull ? int(math.floor(legX / syminfo.mintick + 0.000001)) - bufT : int(math.ceil(legX / syminfo.mintick - 0.000001)) + bufT
        rT := bull ? eT - sT : sT - eT
        stop := sT * syminfo.mintick
        if rT >= 1
            int tT = bull ? eT + rT : eT - rT
            target := tT * syminfo.mintick
        else
            ok := false
            why := f_addWhy(why, "Invalid risk (stop not beyond entry)")
    [cov, srcTxt, covWhy] = f_coverage()
    if cov != 0
        ok := false
        why := f_addWhy(why, cov == 2 ? "No applicable HTF source" : "HTF coverage unknown (" + covWhy + ")")
    string nearTxt = "none within tracked history"
    if rT >= 1
        if cov == 0
            float lo = bull ? entry : target
            float hi = bull ? target : entry
            [obs, obsName] = f_scanAll(bull, lo, hi)
            if obs > 0
                ok := false
                why := f_addWhy(why, "Blocked: " + obsName + ".")
        if not f_lvlReady()
            ok := false
            why := f_addWhy(why, "3m structure coverage unknown (" + f_lvlWhy() + ")")
        else
            int tTk = f_tk(target)
            [stBlk, stNear] = f_structCheck(bull, tTk)
            if not na(stNear)
                nearTxt := str.tostring(stNear, format.mintick) + (bull ? " (3m swing high)" : " (3m swing low)")
            if stBlk
                ok := false
                why := f_addWhy(why, "Blocked: 3m swing " + (bull ? "high " : "low ") + str.tostring(stNear, format.mintick) + " leaves less than one tick beyond the 1R target.")
    if ok
        string sid = str.format_time(time_close, "yyyyMMdd-HHmmss", TZ_NY) + (bull ? "-L" : "-S")
        int dk = f_dateKey(time_close)
        string dirW = bull ? "LONG" : "SHORT"
        string tip = "Setup " + sid + " " + dirW + " · " + cx.winName + "\n" + "15m bias: " + (bull ? "bullish (close above swing high " : "bearish (close below swing low ") + str.tostring(blR, format.mintick) + ", pivot " + f_nyT(int(btR)) + " NY, break confirmed " + f_nyT(int(baR)) + " NY)\n" + "3m inversion confirmed: " + f_nyT(cx.confAsOf) + " NY\n" + "Source processed (chart): " + f_nyT(cx.procTime) + " NY\n" + "Retest candle: " + f_nyT(cx.retestTime) + " NY\n" + "30s trigger confirmed: " + f_nyT(time_close) + " NY\n" + "Impulse " + inPreset + ": body " + str.tostring(bodyAtr, "#.00") + " x prev ATR\n" + "Stop anchor: " + str.tostring(legX, format.mintick) + " @ " + f_nyT(cx.legExtT) + " NY (+" + str.tostring(bufT) + " tick buffer)\n" + "Risk: " + str.tostring(rT) + " ticks (1:1)\n" + "HTF sources checked: " + srcTxt + "\n" + "Nearest 3m structural obstacle: " + nearTxt
        Setup s = Setup.new(id = sid, dateKey = dk, dir = bull ? 1 : -1, entry = entry, stop = stop, target = target, riskT = rT, entryTime = time_close, entryBar = bar_index, winId = cx.winId, winName = cx.winName, ctxZid = cx.zid, srcs = srcTxt, ctxTop = cx.top, ctxBot = cx.bottom, ctxFormT = cx.formTime - 2 * secCtx * 1000, trgTop = t.top, trgBot = t.bottom, trgFormT = t.formTime - 2 * chartMs, legExt = legX, stopAnchorT = cx.legExtT, retestT = cx.retestTime, retestPx = cx.retestPx, tip = tip)
        setups.push(s)
        f_winInc(cx.winId)
        int dxi = f_dateIdx(dk)
        if dxi >= 0
            dSetN.set(dxi, dSetN.get(dxi) + 1)
        f_evInc(bull ? 9 : 10, "")
        string human = "H Ticks ENTRY " + dirW + " " + syminfo.ticker + " " + timeframe.period + " | ID " + sid + " | Entry " + str.tostring(entry, format.mintick) + " | Stop " + str.tostring(stop, format.mintick) + " | Target 1R " + str.tostring(target, format.mintick) + " | Risk " + str.tostring(rT) + " ticks | Session " + cx.winName + " | HTF obstacles checked: " + srcTxt
        if alEntry
            aMsgs.push(human)
        f_log("ENTRY " + dirW + " E=" + str.tostring(entry) + " S=" + str.tostring(stop) + " T=" + str.tostring(target) + " rT=" + str.tostring(rT))
        f_ctxClear()
    else
        cx.lastReason := why
        f_dbg(why)
        f_log("trigger rejected: " + why)
    ok

f_trackSetups() =>
    int rt = 0
    int n = setups.size()
    if n > 0
        int oTk = f_tk(open)
        int hTk = f_tk(high)
        int lTk = f_tk(low)
        for i = 0 to n - 1
            Setup s = setups.get(i)
            if s.state == 0 and bar_index > s.entryBar
                int sTk = f_tk(s.stop)
                int tTk = f_tk(s.target)
                int res = 0
                if s.dir > 0
                    if oTk >= tTk
                        res := 1
                    else if oTk <= sTk
                        res := 2
                    else
                        bool th = hTk >= tTk
                        bool sh = lTk <= sTk
                        res := th and sh ? 3 : (th ? 1 : (sh ? 2 : 0))
                else
                    if oTk <= tTk
                        res := 1
                    else if oTk >= sTk
                        res := 2
                    else
                        bool th = lTk <= tTk
                        bool sh = hTk >= sTk
                        res := th and sh ? 3 : (th ? 1 : (sh ? 2 : 0))
                if res != 0
                    s.state := res
                    s.resolveTime := time_close
                    rt := time_close
                    f_evInc(res == 1 ? 7 : (res == 2 ? 8 : 11), "")
                    bool want = res == 1 ? alTarget : (res == 2 ? alStop : alAmb)
                    if want
                        string what = res == 1 ? "TARGET HIT" : (res == 2 ? "STOP HIT" : "AMBIGUOUS (target and stop both reachable within one candle)")
                        aMsgs.push("H Ticks " + what + " | ID " + s.id + " | " + (s.dir > 0 ? "LONG" : "SHORT") + " " + syminfo.ticker + " | Session " + s.winName + " | Entry " + str.tostring(s.entry, format.mintick) + " Stop " + str.tostring(s.stop, format.mintick) + " Target " + str.tostring(s.target, format.mintick))
                    f_log("resolved " + s.id + " state=" + str.tostring(res))
    rt

// ═════════════════════════════ MAIN: confirmed-bar processing ═════════════════════════════════
if supported and barstate.isfirst
    if en1 and sec1 > chartSecs and not al1
        warnArr.push(f_tfText(sec1) + " obstacle source disabled: not an integer multiple of the chart timeframe")
    if en2 and sec2 > chartSecs and not al2
        warnArr.push(f_tfText(sec2) + " obstacle source disabled: not an integer multiple of the chart timeframe")
    if en3 and sec3 > chartSecs and not al3
        warnArr.push(f_tfText(sec3) + " obstacle source disabled: not an integer multiple of the chart timeframe")
    if en4 and sec4 > chartSecs and not al4
        warnArr.push(f_tfText(sec4) + " obstacle source disabled: not an integer multiple of the chart timeframe")
    if inWinAsia and not okWinAs
        warnArr.push("Entry window A disabled: start equals end")
    if inWinAm and not okWinAm
        warnArr.push("Entry window B disabled: start equals end")
    if inWinPm and not okWinPm
        warnArr.push("Entry window C disabled: start equals end")

bool drawNow = supported and barstate.isconfirmed and (barstate.islast or barstate.islastconfirmedhistory or barstate.isrealtime)

if supported and barstate.isconfirmed
    f_resetEv()
    aMsgs.clear()
    pend.clear()
    lastConfClose := time_close
    refPrice := close
    needPrune := false
    // reporting calendar: NY date of this confirmed bar's close (entry dates use the same basis)
    int dkNow = f_dateKey(time_close)
    if dKey.size() == 0 or dKey.last() != dkNow
        dKey.push(dkNow)
        dDow.push(dayofweek(time_close, TZ_NY))
        dWinN.push(0)
        dWinBad.push(0)
        dSetN.push(0)
        if na(firstDateKey)
            firstDateKey := dkNow
        while dKey.size() > 14
            dKey.shift()
            dDow.shift()
            dWinN.shift()
            dWinBad.shift()
            dSetN.shift()
        needPrune := true

    // 1) mechanical 30s gap lifecycle (unchanged rules). Inversions this bar become trigger candidates.
    int nc = chartZ.size()
    if nc > 0
        for i = nc - 1 to 0
            Zone z = chartZ.get(i)
            int r = f_stepChart(z, high, low, close, bar_index, time, time_close)
            if r == 1
                pend.push(z)
            else if r >= 2
                f_destroy(z)
                chartZ.remove(i)
            else if bar_index - z.formBar >= inChWin
                f_destroy(z)
                chartZ.remove(i)

    // 2) new 30s gap confirmed by THIS closed bar (candle 3)
    if bar_index >= 2 and not na(h2c) and not na(l2c)
        int bullGap = f_tk(low) - f_tk(h2c)
        int bearGap = f_tk(l2c) - f_tk(high)
        int dirN = bullGap >= inMinTick ? 1 : (bearGap >= inMinTick ? -1 : 0)
        if dirN != 0
            float zt = dirN > 0 ? low : l2c
            float zb = dirN > 0 ? h2c : high
            Zone nz = Zone.new(id = syminfo.tickerid + "|" + timeframe.period + "|" + str.tostring(time) + "|" + str.tostring(dirN), dir = dirN, state = dirN > 0 ? ST_BULL_FVG : ST_BEAR_FVG, top = zt, bottom = zb, formTime = time, confTime = time_close, availTime = time_close, width = zt - zb, fatr = chartAtr, formBar = bar_index)
            chartZ.push(nz)
    while chartZ.size() > inChCap
        Zone old = chartZ.shift()
        f_destroy(old)

    // 3) obstacle sources: confirmed source inversions / taps are applied BEFORE any entry decision
    if act1
        f_sync(hz1, 0, f_tfText(sec1), snap1, asOf1)
    if act2
        f_sync(hz2, 1, f_tfText(sec2), snap2, asOf2)
    if act3
        f_sync(hz3, 2, f_tfText(sec3), snap3, asOf3)
    if act4
        f_sync(hz4, 3, f_tfText(sec4), snap4, asOf4)
    f_tapStore(hz1)
    f_tapStore(hz2)
    f_tapStore(hz3)
    f_tapStore(hz4)

    // 4) outcome tracking of entered setups (resolution must precede context ingestion)
    int rt = f_trackSetups()
    if rt > 0
        lastResolveAt := rt
        needPrune := true

    // 5) 3m context: expiry, then newly available confirmed 3m data (cancel / create), then trigger, then retest
    f_ctxExpire()
    // a confirmed 15m bias reversal against the pending context cancels it (nothing after entry is touched)
    if cx.state != 0 and biasDir != 0 and biasDir != cx.dir
        cx.lastReason := "15m bias reversed against the pending context"
        f_ctxClear()
    if act0
        f_ctxSync(snap0, asOf0, cls0)
        f_lvlSync(snap5, asOf0)
    f_lvlConsume()
    // qualification coverage of THIS bar: 3m context source ready AND every applicable obstacle source complete.
    // Counted per NY date, only for bars inside an enabled entry window (outside windows no setup can exist).
    [cvQ, txQ, whQ] = f_coverage()
    bool qualOk = f_ctxReady() and f_lvlReady() and cvQ == 0
    if qualOk and na(covStart)
        covStart := time_close
    [wnQ, wsQ, weQ] = f_selectWindow(time_close)
    if not na(wsQ)
        int dq = dKey.size() - 1
        dWinN.set(dq, dWinN.get(dq) + 1)
        if not qualOk
            dWinBad.set(dq, dWinBad.get(dq) + 1)
    if cx.state == 2 and cx.retestBar < bar_index
        // retest-leg extreme runs from the first retest candle THROUGH the trigger candle (updated before any stop is built)
        if cx.dir > 0 and low < cx.legExt
            cx.legExt := low
            cx.legExtT := time
        if cx.dir < 0 and high > cx.legExt
            cx.legExt := high
            cx.legExtT := time
        Zone trg = f_pickTrigger()
        if not na(trg)
            if f_tryEntry(trg)
                needPrune := true
    // retest is evaluated AFTER the trigger step so a candle that both first retests and inverts a gap can never trigger
    if cx.state == 1 and time >= cx.confAsOf
        bool touch = f_overlap(high, low, cx.bottom, cx.top)
        if touch and cx.away >= inDeparture
            cx.state := 2
            cx.retestBar := bar_index
            cx.retestTime := time
            cx.legExt := cx.dir > 0 ? low : high
            cx.legExtT := time
            cx.retestPx := cx.legExt
            if alCtx
                aMsgs.push("H Ticks retest done: waiting for 30s trigger (" + (cx.dir > 0 ? "LONG" : "SHORT") + ") " + syminfo.ticker)
            f_log("retest bar " + str.tostring(bar_index))
        else
            int aw = cx.dir > 0 ? f_tk(high) - f_tk(cx.top) : f_tk(cx.bottom) - f_tk(low)
            if aw > cx.away
                cx.away := aw

    if needPrune
        f_pruneSetups()

    // 6) drawings follow the committed state
    if drawNow
        f_drawAll()

var table warnTbl = table.new(position.top_right, 1, 1, border_width = 0)
var table stTbl = table.new(position.bottom_right, 6, 9, bgcolor = color.new(color.black, 85), border_width = 0)
var table staTbl = table.new(position.top_left, 1, 4, bgcolor = color.new(color.black, 85), border_width = 0)
f_cell(table t, int c, int r, string txt, color tc, string al) =>
    table.cell(t, c, r, txt, text_color = tc, text_size = size.small, text_halign = al == "l" ? text.align_left : text.align_center)
    true

if barstate.islast
    string w = supported ? array.join(warnArr, "\n") : "Switch to a standard 30-second chart"
    if supported
        string wx = ""
        wx := f_addWhy(wx, f_ctxWhy())
        wx := f_addWhy(wx, f_lvlWhy())
        wx := f_addWhy(wx, f_slotWhy(en1, ok1, act1, 0, f_tfText(sec1)))
        wx := f_addWhy(wx, f_slotWhy(en2, ok2, act2, 1, f_tfText(sec2)))
        wx := f_addWhy(wx, f_slotWhy(en3, ok3, act3, 2, f_tfText(sec3)))
        wx := f_addWhy(wx, f_slotWhy(en4, ok4, act4, 3, f_tfText(sec4)))
        if setups.size() > DRAW_MAX
            wx := f_addWhy(wx, "Drawings limited to " + str.tostring(DRAW_MAX) + " setups (unresolved first, then newest); statistics are unaffected")
        w += wx == "" ? "" : (w == "" ? "" : "\n") + str.replace_all(wx, "; ", "\n")
    if w == ""
        table.cell(warnTbl, 0, 0, "", bgcolor = na)
    else
        table.cell(warnTbl, 0, 0, w, text_color = color.orange, text_size = size.small, bgcolor = color.new(color.black, 80), text_halign = text.align_left)
    if supported and inStatus
        string a1 = cx.state == 0 ? "Context: none" : "Context: " + (cx.dir > 0 ? "LONG" : "SHORT") + (cx.state == 1 ? " - awaiting retest" : " - awaiting 30s trigger") + " | " + cx.winName
        string a2 = (cx.state == 0 ? "" : "Entries this window: " + str.tostring(f_winCount(cx.winId)) + "/" + str.tostring(inMaxEntries) + " | ") + (f_openSetup() ? "Setup OPEN" : "No open setup") + (cx.lastReason == "" ? "" : " | last: " + cx.lastReason)
        [cvS, txS, whS] = f_coverage()
        bool qS = f_ctxReady() and f_lvlReady() and cvS == 0
        string a3 = qS ? "Qualification coverage: complete (" + txS + ")" + (na(covStart) ? "" : " since " + str.format_time(covStart, "MM-dd HH:mm", TZ_NY) + " NY") : "Qualification coverage: INCOMPLETE - entries blocked" + (na(covStart) ? " (not yet established)" : " (complete earlier since " + str.format_time(covStart, "MM-dd HH:mm", TZ_NY) + " NY)")
        f_cell(staTbl, 0, 0, a1, color.white, "l")
        f_cell(staTbl, 0, 1, a2, color.silver, "l")
        f_cell(staTbl, 0, 2, a3, qS ? color.silver : color.orange, "l")
        string a4 = biasDir == 0 ? "15m bias: UNKNOWN (no qualifying break yet) - no contexts" : "15m bias: " + (biasDir > 0 ? "BULLISH" : "BEARISH") + " - " + (biasDir > 0 ? "close above swing high " : "close below swing low ") + str.tostring(blR, format.mintick) + " (pivot " + f_nyT(int(btR)) + " NY)"
        f_cell(staTbl, 0, 3, a4, biasDir == 0 ? color.orange : color.silver, "l")
    if supported and inStats
        array<int> rd = f_reportDates()
        int nr = rd.size()
        string[] hd = array.from("Date (NY)", "Setups", "Winners", "Losers", "Open", "Ambiguous")
        for c = 0 to 5
            f_cell(stTbl, c, 0, hd.get(c), color.white, c == 0 ? "l" : "c")
        int tW = 0
        int tL = 0
        int tO = 0
        int tA = 0
        bool anyP = false
        bool anyU = false
        for r = 0 to REP_DATES - 1
            if r < nr
                int k = rd.get(r)
                int di = f_dateIdx(k)
                int stx = di >= 0 ? f_dateStatus(di) : 1
                int cW = f_dateCount(k, 1)
                int cL = f_dateCount(k, 2)
                int cO = f_dateCount(k, 0)
                int cA = f_dateCount(k, 3)
                if stx == 1
                    anyP := true
                if stx == 2
                    anyU := true
                tW += cW
                tL += cL
                tO += cO
                tA += cA
                string dt = f_dateTxt(k) + (stx == 1 ? " †" : (stx == 2 ? " ‡" : ""))
                f_cell(stTbl, 0, r + 1, dt, color.silver, "l")
                f_cell(stTbl, 1, r + 1, stx == 2 ? "n/a" : str.tostring(cW + cL + cO + cA), color.silver, "c")
                f_cell(stTbl, 2, r + 1, stx == 2 ? "n/a" : str.tostring(cW), color.silver, "c")
                f_cell(stTbl, 3, r + 1, stx == 2 ? "n/a" : str.tostring(cL), color.silver, "c")
                f_cell(stTbl, 4, r + 1, stx == 2 ? "n/a" : str.tostring(cO), color.silver, "c")
                f_cell(stTbl, 5, r + 1, stx == 2 ? "n/a" : str.tostring(cA), color.silver, "c")
            else
                for c = 0 to 5
                    f_cell(stTbl, c, r + 1, "", color.silver, "c")
        f_cell(stTbl, 0, 6, "Total", color.white, "l")
        f_cell(stTbl, 1, 6, str.tostring(tW + tL + tO + tA), color.white, "c")
        f_cell(stTbl, 2, 6, str.tostring(tW), color.white, "c")
        f_cell(stTbl, 3, 6, str.tostring(tL), color.white, "c")
        f_cell(stTbl, 4, 6, str.tostring(tO), color.white, "c")
        f_cell(stTbl, 5, 6, str.tostring(tA), color.white, "c")
        int oldOpen = 0
        if nr > 0 and setups.size() > 0
            for i = 0 to setups.size() - 1
                Setup so = setups.get(i)
                if so.state == 0 and so.dateKey < rd.first()
                    oldOpen += 1
        string wr = (tW + tL) > 0 ? "Win rate (Winners / (Winners + Losers); Open and Ambiguous excluded): " + str.tostring(100.0 * tW / (tW + tL), "#") + "% (" + str.tostring(tW) + "/" + str.tostring(tW + tL) + ")" : "Win rate: —"
        string notes = ""
        if anyP
            notes += "† partial history: some qualification bars lacked coverage or the chart history begins that date\n"
        if anyU
            notes += "‡ unavailable: no qualification coverage on that date (history/source limits)\n"
        if oldOpen > 0
            notes += str.tostring(oldOpen) + " older unresolved setup(s) retained, not in table\n"
        table.cell(stTbl, 0, 7, wr, text_color = color.silver, text_size = size.small, text_halign = text.align_left)
        table.merge_cells(stTbl, 0, 7, 5, 7)
        table.cell(stTbl, 0, 8, notes == "" ? "Entry date = New York calendar date of the entry candle close. Outcomes follow the entry date." : notes, text_color = color.gray, text_size = size.tiny, text_halign = text.align_left)
        table.merge_cells(stTbl, 0, 8, 5, 8)

// ═════════════════════════════════════════ ALERTS ═════════════════════════════════════════════
// Only genuine events on a confirmed REALTIME bar; never from history / bootstrap. Every event of the bar is collected in
// aMsgs while the state machine runs (each event is created once, at its single state transition) and sent as ONE alert().
// Drawing happens independently and can never produce an alert.
bool evNow = supported and barstate.isrealtime and barstate.isconfirmed
if evNow and aMsgs.size() > 0
    alert(array.join(aMsgs, "\n"), alert.freq_once_per_bar_close)
alertcondition(evNow and ev.get(9) > 0, "Long entry (3m ctx -> 30s trigger, 1R)", "H Ticks: LONG entry on {{ticker}} {{interval}}")
alertcondition(evNow and ev.get(10) > 0, "Short entry (3m ctx -> 30s trigger, 1R)", "H Ticks: SHORT entry on {{ticker}} {{interval}}")
alertcondition(evNow and ev.get(7) > 0, "Target hit", "H Ticks: setup TARGET HIT on {{ticker}} {{interval}}")
alertcondition(evNow and ev.get(8) > 0, "Stop hit", "H Ticks: setup STOP HIT on {{ticker}} {{interval}}")
alertcondition(evNow and ev.get(11) > 0, "Ambiguous outcome", "H Ticks: setup AMBIGUOUS on {{ticker}} {{interval}}")
