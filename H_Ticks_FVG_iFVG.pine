//@version=6
// ─────────────────────────────────────────────────────────────────────────────────────────────
// H Ticks — FVG / iFVG : 3m inversion -> retest -> fresh 30s inversion -> entry at close -> fixed 1R
//
// REQUIRES A STANDARD 30-SECOND CHART. Anything else shows "Switch to a standard 30-second chart" and generates nothing.
//   * Execution = chart (30s) candles. Setup context = confirmed 3-minute candles (request.security, [1] + lookahead_on,
//     engine reads only completed candles). Obstacles = confirmed 15m / 1H (optional 4H / 1D) tracked gaps.
//   * State machine (at most ONE pending context):
//       3m FVG inverts (confirmed 3m close, inside an enabled entry window)  -> PENDING_RETEST
//       later 30s candle (open >= 3m confirmation) touches the original 3m zone -> WAITING_FOR_30S_TRIGGER (zone kept)
//       fresh 30s FVG (confirmed at/after the 3m confirmation) inverts on a candle strictly after the retest candle
//       -> entry = that candle's confirmed close; stop = trigger-candle BODY +/- buffer; target = exactly 1R.
//   * Gates at entry (all mandatory, nothing else): same originating window instance, entry count < limit, no other
//     unresolved setup (default), valid risk, clear path to 1R against ALL tracked opposing HTF gaps, complete coverage.
//   * A rejected trigger does not consume a slot, keeps the context pending, and is never re-approved later.
//   * No ATR-size, momentum, liquidity-target or 2R requirement exists any more.
// Timing: all state changes and drawings happen on confirmed 30s bars. Alerts only on confirmed realtime bars.
// Session basis: syminfo.tickerid for every request. Verification: see H_Ticks_FVG_iFVG_NOTES.md (code review + Python
// model only; NOT compiled in TradingView, NOT Bar-Replay tested).
// ─────────────────────────────────────────────────────────────────────────────────────────────
// INDICATOR (not a strategy). Outcomes/statistics come from the built-in outcome model below (touch-based, with ASSUMED
// slippage/costs inputs); they are an estimate, not Strategy Tester results.
indicator("H Ticks — FVG / iFVG", shorttitle = "H Ticks FVG/iFVG", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 500)

const string GRP_GEN = "General"
const string GRP_SET = "Setup: 3m context -> retest -> 30s trigger -> fixed 1R"
const string GRP_WIN = "Entry windows (configured clock windows - NOT an exchange holiday / early-close calendar)"
const string GRP_CH  = "Optional 30-second gap boxes (hidden by default)"
const string GRP_HTF = "Higher-timeframe obstacles and context"
const string GRP_AL  = "Alerts"

bool   inLabels  = input.bool(true, "Show labels", group = GRP_GEN)
int    inExt     = input.int(0, "Right extension (chart bars, approximate across session gaps)", minval = 0, maxval = 50, group = GRP_GEN)
color  inBull    = input.color(color.rgb(46, 160, 110), "Bullish colour", group = GRP_GEN)
color  inBear    = input.color(color.rgb(201, 82, 77), "Bearish colour", group = GRP_GEN)
int    inBordT   = input.int(70, "Border transparency", minval = 0, maxval = 100, group = GRP_GEN)
int    inMinTick = input.int(1, "Minimum DETECTION size (whole ticks, all gap sources)", minval = 1, group = GRP_GEN, tooltip = "Gaps at least this wide are detected and tracked. Display filters never decide setup eligibility.")

int    inStopBuf = input.int(1, "Stop buffer (ticks)", minval = 0, group = GRP_SET, tooltip = "Stop = trigger-candle BODY (min(open,close) for longs, max for shorts) beyond by this buffer. Entry = the trigger candle's confirmed close. Target = exactly 1R. Illustrative close-entry model: no fills, commissions or slippage.")
int    inMaxEntries = input.int(3, "Max signalled entries per window instance", minval = 1, maxval = 20, group = GRP_SET, tooltip = "Counts only actual entries (every condition passed and a setup record created). Pending contexts, retests, rejected triggers and hidden drawings never count.")
bool   inOneActive = input.bool(true, "Allow only ONE unresolved entered setup at a time (all windows)", group = GRP_SET, tooltip = "While a setup is unresolved no new entry is issued, and contexts confirmed before its resolution are discarded (never queued). A new setup needs a new 3m context confirmed at/after the resolution close.")
bool   inUseMaxAge = input.bool(false, "Optional: expire a pending context after a maximum age", group = GRP_SET)
int    inMaxAgeMin = input.int(30, "Maximum context age (minutes)", minval = 1, group = GRP_SET)
bool   inShowCtx = input.bool(true, "Show the pending 3-minute context box", group = GRP_SET)
bool   inDebug   = input.bool(false, "Debug: label rejected triggers with the failed gate", group = GRP_SET)
bool   inLog = input.bool(false, "Log state changes to Pine Logs (for validation)", group = GRP_SET)
int    inCtxMinTicks = input.int(1, "OPTIONAL: minimum 3m context gap width (ticks)", minval = 1, group = GRP_SET, tooltip = "1 = spec default (any detected gap). Raising it excludes tiny 3m gaps from creating a context.")
int    inDeparture = input.int(0, "OPTIONAL: required departure before a retest counts (ticks)", minval = 0, group = GRP_SET, tooltip = "0 = spec default. Otherwise price must first move this many ticks beyond the context boundary (in the trade direction) on an EARLIER candle before a touch counts as the retest.")
int    inMinRiskT = input.int(1, "Minimum risk (ticks)", minval = 1, group = GRP_SET, tooltip = "1 = spec default. A larger value rejects triggers whose body-stop risk is too small for spread/slippage/commission.")
int    inMaxRiskT = input.int(0, "OPTIONAL: maximum risk (ticks, 0 = off)", minval = 0, group = GRP_SET)
int    inTimeStopMin = input.int(0, "OPTIONAL: outcome model closes an open setup after N minutes (0 = off)", minval = 0, group = GRP_SET, tooltip = "Failsafe so a stranded setup cannot block later setups forever. The outcome model exits at that bar's close.")
int    inSlipTicks = input.int(1, "Outcome model: assumed slippage (ticks, on entry and on stop exits)", minval = 0, group = GRP_SET, tooltip = "ASSUMPTION used only for the results table / outcome labels. Entry fills this many ticks worse than the signal close; stops fill this many ticks worse than the stop (or at the open if the candle gaps through it).")
int    inCostTicks = input.int(0, "Outcome model: assumed round-turn cost (ticks)", minval = 0, group = GRP_SET, tooltip = "ASSUMPTION: commission/fees expressed in ticks of price, deducted from every outcome.")
bool   inStats = input.bool(true, "Show per-window results table (outcome model, after assumed costs)", group = GRP_SET)
bool   inStatus = input.bool(true, "Show state table (context / window / entries)", group = GRP_SET)

const string TF_CTX = "3"

int    inAsH  = input.int(9, "Asia open hour", minval = 0, maxval = 23, group = GRP_WIN)
bool   inWinAsia = input.bool(true, "Window A: Asia open -> London open", group = GRP_WIN, tooltip = "Configured reference times, not a universal definition of the Asian session. Each endpoint uses its own IANA timezone (DST handled automatically). Start inclusive, end exclusive. BOTH the 3m context confirmation and the 30s entry confirmation must belong to the same window instance.")
int    inAsM  = input.int(0, "Asia open minute", minval = 0, maxval = 59, group = GRP_WIN)
string inAsTz = input.string("Asia/Tokyo", "Asia open timezone (IANA)", options = ["Asia/Tokyo", "Asia/Hong_Kong", "Asia/Singapore", "Australia/Sydney", "Europe/London", "Europe/Berlin", "America/New_York", "America/Chicago", "UTC"], group = GRP_WIN)
int    inLoH  = input.int(8, "London open hour (window end)", minval = 0, maxval = 23, group = GRP_WIN)
int    inLoM  = input.int(0, "London open minute (window end)", minval = 0, maxval = 59, group = GRP_WIN)
string inLoTz = input.string("Europe/London", "London open timezone (IANA)", options = ["Asia/Tokyo", "Asia/Hong_Kong", "Asia/Singapore", "Australia/Sydney", "Europe/London", "Europe/Berlin", "America/New_York", "America/Chicago", "UTC"], group = GRP_WIN, tooltip = "The window ends at the first London opening strictly after the Asia start.")
bool   inWinAm = input.bool(true, "Window B: New York morning", group = GRP_WIN)
int    inAmSH = input.int(9, "NY morning start hour", minval = 0, maxval = 23, group = GRP_WIN)
int    inAmSM = input.int(45, "NY morning start minute", minval = 0, maxval = 59, group = GRP_WIN)
int    inAmEH = input.int(11, "NY morning end hour", minval = 0, maxval = 23, group = GRP_WIN)
int    inAmEM = input.int(30, "NY morning end minute", minval = 0, maxval = 59, group = GRP_WIN)
string inAmTz = input.string("America/New_York", "NY morning timezone (IANA)", options = ["Asia/Tokyo", "Asia/Hong_Kong", "Asia/Singapore", "Australia/Sydney", "Europe/London", "Europe/Berlin", "America/New_York", "America/Chicago", "UTC"], group = GRP_WIN)
bool   inWinPm = input.bool(true, "Window C: New York afternoon", group = GRP_WIN)
int    inPmSH = input.int(14, "NY afternoon start hour", minval = 0, maxval = 23, group = GRP_WIN)
int    inPmSM = input.int(30, "NY afternoon start minute", minval = 0, maxval = 59, group = GRP_WIN)
int    inPmEH = input.int(15, "NY afternoon end hour", minval = 0, maxval = 23, group = GRP_WIN)
int    inPmEM = input.int(30, "NY afternoon end minute", minval = 0, maxval = 59, group = GRP_WIN)
string inPmTz = input.string("America/New_York", "NY afternoon timezone (IANA)", options = ["Asia/Tokyo", "Asia/Hong_Kong", "Asia/Singapore", "Australia/Sydney", "Europe/London", "Europe/Berlin", "America/New_York", "America/Chicago", "UTC"], group = GRP_WIN, tooltip = "An end earlier than the start is treated as overnight (ends the next local date). Identical start/end in one timezone is rejected. Overlapping windows: the latest start owns a timestamp; equal starts: NY morning, NY afternoon, Asia -> London.")
string inWkd  = input.string("Mon-Fri", "Eligible start days (weekday of the START in its timezone)", options = ["Mon-Fri", "Every day"], group = GRP_WIN)

bool   inShow30  = input.bool(false, "Show routine 30-second FVG / iFVG boxes", group = GRP_CH)
int    inMax30Fvg = input.int(3, "Max visible 30s FVGs", minval = 0, maxval = 20, group = GRP_CH)
int    inMax30Ifvg = input.int(2, "Max visible 30s iFVGs", minval = 0, maxval = 20, group = GRP_CH)
float  inFvgAtr  = input.float(0.10, "Display size filter: ATR multiple (0 = off)", minval = 0.0, step = 0.05, group = GRP_CH, tooltip = "DISPLAY ONLY (never an entry condition): width must be >= max(min ticks x mintick, multiple x the gap's frozen formation ATR).")
int    inFvgMinT = input.int(4, "Display size filter: min ticks", minval = 1, group = GRP_CH)
int    inChCap   = input.int(200, "30s tracking capacity (zones)", minval = 20, maxval = 500, group = GRP_CH)
int    inChWin   = input.int(4500, "30s tracking window (chart bars; keep below bars your plan loads)", minval = 100, maxval = 20000, group = GRP_CH)
int    inChT     = input.int(92, "Fill transparency", minval = 0, maxval = 100, group = GRP_CH)

bool   inShowHtf  = input.bool(true, "Show nearest HTF context boxes", group = GRP_HTF)
string inPrio     = input.string("Nearest to price", "HTF display priority", options = ["Nearest to price", "Most recently formed"], group = GRP_HTF)
bool   inNearest  = inPrio == "Nearest to price"
int    inHtfAbove = input.int(1, "Max zones ABOVE price (per source)", minval = 0, maxval = 10, group = GRP_HTF, tooltip = "Display only. Obstacle checks always use ALL tracked HTF gaps, hidden or not.")
int    inHtfBelow = input.int(1, "Max zones BELOW price (per source)", minval = 0, maxval = 10, group = GRP_HTF)
int    inHtfCont  = input.int(1, "Max zones CONTAINING price (per source)", minval = 0, maxval = 10, group = GRP_HTF)
float  inHtfAtr   = input.float(0.10, "HTF display size filter: ATR multiple (0 = off)", minval = 0.0, step = 0.05, group = GRP_HTF)
int    inHtfMinT  = input.int(4, "HTF display size filter: min ticks", minval = 1, group = GRP_HTF)
int    inHtfCap   = input.int(200, "Tracking capacity per source", minval = 10, maxval = 300, group = GRP_HTF)
int    inHtfT     = input.int(92, "Untapped fill transparency", minval = 0, maxval = 100, group = GRP_HTF)
int    inHtfTapT  = input.int(95, "Tapped fill transparency", minval = 0, maxval = 100, group = GRP_HTF)
int    inBudget   = input.int(500, "Source-history budget (source candles per source; may be clamped for memory)", minval = 100, maxval = 4000, group = GRP_HTF)
float  inRelAtr   = input.float(5.0, "Obstacle relevance radius (x source ATR)", minval = 1.0, step = 0.5, group = GRP_HTF, tooltip = "When a source tracks more live gaps than its capacity, the gap FARTHEST from price is dropped first. Coverage is only flagged UNKNOWN if a dropped gap lay within this many source ATRs of price (so strong trends do not block every entry). Gaps pruned beyond the radius are outside coverage by definition.")
bool   en1 = input.bool(true,  "Obstacle source 1", inline = "s1", group = GRP_HTF)
string tf1 = input.timeframe("15",  "", inline = "s1", group = GRP_HTF)
bool   en2 = input.bool(true,  "Obstacle source 2", inline = "s2", group = GRP_HTF)
string tf2 = input.timeframe("60",  "", inline = "s2", group = GRP_HTF)
bool   en3 = input.bool(false, "Obstacle source 3", inline = "s3", group = GRP_HTF)
string tf3 = input.timeframe("240", "", inline = "s3", group = GRP_HTF)
bool   en4 = input.bool(false, "Obstacle source 4", inline = "s4", group = GRP_HTF)
string tf4 = input.timeframe("1D",  "", inline = "s4", group = GRP_HTF)

bool   alEntry = input.bool(true, "Alert on each new entry", group = GRP_AL)
bool   alCtx = input.bool(false, "Alert when a 3m context is created / retested", group = GRP_AL)
bool   alOutcome = input.bool(false, "Alert when a setup resolves (outcome model)", group = GRP_AL)
bool   alJson = input.bool(false, "Entry alert text as JSON (webhook-friendly)", group = GRP_AL)

const int ZS = 8
const int HDR = 2
const int ST_BULL_FVG  = 1
const int ST_BEAR_FVG  = 2
const int ST_BULL_IFVG = 3
const int ST_BEAR_IFVG = 4
const int ST_UNT_BULL  = 11
const int ST_TAP_BULL  = 12
const int ST_UNT_BEAR  = 13
const int ST_TAP_BEAR  = 14

type Zone
    string id
    int    src = -1
    string tfTxt = ""
    int    dir
    int    state
    float  top
    float  bottom
    int    formTime
    int    confTime
    int    availTime
    int    formBar = -1
    int    invBar = -1
    int    invTime
    int    invAvail
    bool   tapped = false
    int    tapTime
    int    tapAvail
    int    lastEvt
    float  width
    float  fatr
    bool   seen = false
    bool   endNow = false
    int    cat = -1
    float  dist = 0.0
    bool   vis = false
    box    bx

// The single pending 3-minute context. state: 0 NONE, 1 PENDING_RETEST, 2 WAITING_FOR_30S_TRIGGER.
type Ctx
    int    state = 0
    int    dir
    float  top
    float  bottom
    int    formTime
    int    confAsOf
    int    procTime
    string zid = ""
    string winId = ""
    string winName = ""
    int    winStart
    int    winEnd
    int    retestBar = -1
    int    retestTime
    int    away = 0
    string lastReason = ""
    box    bx

// An actual signalled entry. state: 0 UNRESOLVED, 1 TARGET, 2 STOP, 3 STOP (same-candle ambiguity, resolved stop-first).
type Setup
    string id
    int    dir
    float  entry
    float  stop
    float  target
    int    riskT
    float  rMult = 0.0
    int    entryTime
    int    entryBar
    string winId
    string winName
    string ctxZid
    string srcs = ""
    int    state = 0
    int    resolveTime
    line   lE
    line   lS
    line   lT
    label  lb

// Tick-aware integer comparison: prices are snapped to whole ticks; no buffer is added.
f_tk(float x) =>
    math.round(x / syminfo.mintick)

// Closed-interval overlap of a candle range with the ORIGINAL zone boundaries.
f_overlap(float hi, float lo, float zb, float zt) =>
    f_tk(hi) >= f_tk(zb) and f_tk(lo) <= f_tk(zt)

f_tfText(int s) =>
    string r = ""
    if s >= 604800 and s % 604800 == 0
        r := str.tostring(int(s / 604800)) + "W"
    else if s >= 86400 and s % 86400 == 0
        r := str.tostring(int(s / 86400)) + "D"
    else if s >= 3600 and s % 3600 == 0
        r := str.tostring(int(s / 3600)) + "H"
    else if s >= 60 and s % 60 == 0
        r := str.tostring(int(s / 60)) + "m"
    else
        r := str.tostring(s) + "s"
    r

// Engine zone record (8 floats): formTime, code (+-1 live, +-2 inverted-this-bar; sign = direction),
// top, bottom, confTime, tapTime (0 = untapped), formation candle index, formation ATR (-1 = n/a).
f_push(array<float> z, int ft, int dir, float tp, float bt, int conf, int fidx, float atr) =>
    z.push(float(ft))
    z.push(float(dir))
    z.push(tp)
    z.push(bt)
    z.push(float(conf))
    z.push(0.0)
    z.push(float(fidx))
    z.push(na(atr) ? -1.0 : atr)   // frozen formation ATR of this source candle, -1 = unavailable
    true

// ═══════════════════════ SOURCE-CONTEXT LIFECYCLE ENGINE (runs inside request.security) ════════
// Returns the published snapshot (array<float>, 8 floats per zone, oldest first). The same array object
// is returned on every bar on which nothing changed; a published array is never mutated.
// Window policy: candle c is processed only if c > lastCandle - budget, and a zone expires once
// (c - formationCandle) >= budget, so live == fresh reconstruction.
f_engine(int cap, int minTicks, int budget, float relAtr) =>
    var array<float> Z = array.new_float(0)
    var array<float> pub = array.from(0.0, 0.0)
    var float maxPruned = -1.0
    var bool lastTrunc = false
    var float lastProc = 0.0
    array<float> out = na
    float atrS = ta.atr(14)      // source-timeframe ATR, evaluated every bar
    float fatr1 = atrS[1]        // ATR on the SAME completed candle [1] as the formation OHLC
    float h1 = high[1]
    float l1 = low[1]
    float c1 = close[1]
    float h2 = high[2]
    float l2 = low[2]
    float h3 = high[3]
    float l3 = low[3]
    int   t1 = time[1]
    int   tc1 = time_close[1]
    int   cidx = bar_index - 1
    bool  valid = not na(h1) and not na(l1) and not na(c1) and not na(t1) and not na(tc1)
    bool  active = bar_index > last_bar_index - budget
    if valid and active
        if t1 > lastProc
            lastProc := t1
            bool dirty = false
            // 1) drop zones flagged inverted on the previous source bar
            int n0 = int(Z.size() / ZS)
            if n0 > 0
                for i = n0 - 1 to 0
                    if math.abs(Z.get(i * ZS + 1)) == 2.0
                        for k = 1 to ZS
                            Z.remove(i * ZS)
                        dirty := true
            // 2) lifecycle of existing zones on the completed candle. Only candles that OPEN at/after the
            //    formation confirmation are eligible (the formation candle never touches/inverts itself).
            int n1 = int(Z.size() / ZS)
            if n1 > 0
                for i = 0 to n1 - 1
                    int b = i * ZS
                    if t1 >= int(Z.get(b + 4))
                        float cd = Z.get(b + 1)
                        float zt = Z.get(b + 2)
                        float zb = Z.get(b + 3)
                        bool inv = cd > 0 ? f_tk(c1) < f_tk(zb) : f_tk(c1) > f_tk(zt)
                        if inv
                            Z.set(b + 1, cd * 2.0)   // source CLOSE strictly beyond the opposite boundary
                            dirty := true
                        else if Z.get(b + 5) == 0.0 and f_overlap(h1, l1, zb, zt)
                            Z.set(b + 5, float(tc1)) // first touch (monotonic)
                            dirty := true
            // 3) formation: candle 3 = [1], candle 1 = [3]; candle 2 only has to exist
            if not na(h2) and not na(l2) and not na(h3) and not na(l3)
                int bullGap = f_tk(l1) - f_tk(h3)
                int bearGap = f_tk(l3) - f_tk(h1)
                if bullGap >= minTicks
                    f_push(Z, t1, 1, l1, h3, tc1, cidx, fatr1)
                    dirty := true
                else if bearGap >= minTicks
                    f_push(Z, t1, -1, l3, h1, tc1, cidx, fatr1)
                    dirty := true
            // 4) age expiry (silent, never an inversion). Flagged zones are left so the inversion is published.
            int n2 = int(Z.size() / ZS)
            if n2 > 0
                for i = n2 - 1 to 0
                    if math.abs(Z.get(i * ZS + 1)) == 1.0 and cidx - int(Z.get(i * ZS + 6)) >= budget
                        for k = 1 to ZS
                            Z.remove(i * ZS)
                        dirty := true
            // 5) capacity: oldest UNFLAGGED zone first, so a just-inverted zone's event is never pruned away
            int n3 = int(Z.size() / ZS)
            int nFlag = 0
            if n3 > 0
                for i = 0 to n3 - 1
                    if math.abs(Z.get(i * ZS + 1)) == 2.0
                        nFlag += 1
            int over = n3 - nFlag - cap
            while over > 0
                // drop the live gap FARTHEST from the source close (ties: oldest); coverage is only flagged unknown when the
                // dropped gap lay within the relevance radius of price
                int pIdx = -1
                float pd = -1.0
                int nn = int(Z.size() / ZS)
                for i = 0 to nn - 1
                    if math.abs(Z.get(i * ZS + 1)) == 1.0
                        float pzt = Z.get(i * ZS + 2)
                        float pzb = Z.get(i * ZS + 3)
                        float dd = c1 < pzb ? pzb - c1 : (c1 > pzt ? c1 - pzt : 0.0)
                        if dd > pd
                            pd := dd
                            pIdx := i
                if pIdx >= 0
                    bool relevant = na(fatr1) or fatr1 <= 0 or pd <= relAtr * fatr1
                    if relevant
                        maxPruned := math.max(maxPruned, Z.get(pIdx * ZS + 6))
                    for k = 1 to ZS
                        Z.remove(pIdx * ZS)
                    dirty := true
                over -= 1
            // 6) truncation flag: a capacity-pruned zone would still be inside the age horizon => coverage unknown
            bool truncNow = maxPruned >= 0 and cidx - maxPruned < budget
            if truncNow != lastTrunc
                lastTrunc := truncNow
                dirty := true
            // 7) publish a NEW array only if something changed
            if dirty
                array<float> tmp = array.from(truncNow ? 1.0 : 0.0, 0.0)
                tmp.concat(Z)
                pub := tmp
        out := pub
    out

// ═════════════════════════════ CHART SUPPORT, SOURCES, REQUESTS ═════════════════════════════
bool stdChart  = chart.is_standard and not timeframe.isticks
bool supported = stdChart and timeframe.isseconds and timeframe.multiplier == 30
int  chartSecs = supported ? timeframe.in_seconds() : 0
int  chartMs   = chartSecs * 1000

int  sec1 = timeframe.in_seconds(tf1)
int  sec2 = timeframe.in_seconds(tf2)
int  sec3 = timeframe.in_seconds(tf3)
int  sec4 = timeframe.in_seconds(tf4)
int  secCtx = timeframe.in_seconds(TF_CTX)
bool ok1 = supported and en1 and sec1 > chartSecs
bool ok2 = supported and en2 and sec2 > chartSecs and not (ok1 and sec2 == sec1)
bool ok3 = supported and en3 and sec3 > chartSecs and not (ok1 and sec3 == sec1) and not (ok2 and sec3 == sec2)
bool ok4 = supported and en4 and sec4 > chartSecs and not (ok1 and sec4 == sec1) and not (ok2 and sec4 == sec2) and not (ok3 and sec4 == sec3)
bool al1 = chartSecs > 0 and sec1 % chartSecs == 0
bool al2 = chartSecs > 0 and sec2 % chartSecs == 0
bool al3 = chartSecs > 0 and sec3 % chartSecs == 0
bool al4 = chartSecs > 0 and sec4 % chartSecs == 0
bool act1 = ok1 and al1
bool act2 = ok2 and al2
bool act3 = ok3 and al3
bool act4 = ok4 and al4
bool act0 = supported and chartSecs > 0 and secCtx % chartSecs == 0

int  nSlots = (act0 ? 1 : 0) + (act1 ? 1 : 0) + (act2 ? 1 : 0) + (act3 ? 1 : 0) + (act4 ? 1 : 0)
int  memBudget = nSlots > 0 ? int(8000000 / (nSlots * ZS * inHtfCap)) : inBudget
int  effBudget = memBudget < inBudget ? memBudget : inBudget

array<float> snap0 = na
array<float> snap1 = na
array<float> snap2 = na
array<float> snap3 = na
array<float> snap4 = na
int   asOf0 = na
float cls0 = na
int asOf1 = na
int asOf2 = na
int asOf3 = na
int asOf4 = na
if act0
    snap0 := request.security(syminfo.tickerid, TF_CTX, f_engine(inHtfCap, inMinTick, effBudget, inRelAtr), lookahead = barmerge.lookahead_on)
    [a0_, c0_] = request.security(syminfo.tickerid, TF_CTX, [time_close[1], close[1]], lookahead = barmerge.lookahead_on)
    asOf0 := a0_
    cls0 := c0_
if act1
    snap1 := request.security(syminfo.tickerid, tf1, f_engine(inHtfCap, inMinTick, effBudget, inRelAtr), lookahead = barmerge.lookahead_on)
    asOf1 := request.security(syminfo.tickerid, tf1, time_close[1], lookahead = barmerge.lookahead_on)
if act2
    snap2 := request.security(syminfo.tickerid, tf2, f_engine(inHtfCap, inMinTick, effBudget, inRelAtr), lookahead = barmerge.lookahead_on)
    asOf2 := request.security(syminfo.tickerid, tf2, time_close[1], lookahead = barmerge.lookahead_on)
if act3
    snap3 := request.security(syminfo.tickerid, tf3, f_engine(inHtfCap, inMinTick, effBudget, inRelAtr), lookahead = barmerge.lookahead_on)
    asOf3 := request.security(syminfo.tickerid, tf3, time_close[1], lookahead = barmerge.lookahead_on)
if act4
    snap4 := request.security(syminfo.tickerid, tf4, f_engine(inHtfCap, inMinTick, effBudget, inRelAtr), lookahead = barmerge.lookahead_on)
    asOf4 := request.security(syminfo.tickerid, tf4, time_close[1], lookahead = barmerge.lookahead_on)

// ═════════════════════════════════════════ STATE ══════════════════════════════════════════════
var array<Zone>   chartZ = array.new<Zone>()
var array<Zone>   hz1 = array.new<Zone>()
var array<Zone>   hz2 = array.new<Zone>()
var array<Zone>   hz3 = array.new<Zone>()
var array<Zone>   hz4 = array.new<Zone>()
var array<int>    lastAsOf = array.new_int(5, 0)      // index 4 = 3m context source
var array<int>    wm       = array.new_int(5, 0)
var array<bool>   srcBad   = array.new_bool(5, false)
var array<bool>   srcSeen  = array.new_bool(5, false)
var array<bool>   srcInit  = array.new_bool(5, false)
var array<bool>   srcTrunc = array.new_bool(5, false)
var array<string> warnArr  = array.new_string(0)
var array<int>    ev   = array.new_int(12, 0)         // 9 long entry, 10 short entry
var array<string> evTf = array.new_string(12, "")
var array<string> qMsg = array.new_string(2, "")
var int   firstTime = time
var int   lastConfClose = na
var float refPrice = na
float chartAtr = ta.atr(14)
int   prevCloseT = time_close[1]
float h2c = high[2]
float l2c = low[2]
var Ctx cx = Ctx.new()
var array<Zone>   pend = array.new<Zone>()            // 30s gaps that inverted on THIS bar (trigger candidates)
var array<Setup>  setups = array.new<Setup>()
var array<string> wKeys = array.new_string(0)         // entries per window instance
var array<int>    wCnt  = array.new_int(0)
var int  lastResolveAt = 0
var array<label>  dbgLbls = array.new<label>()
var array<string> sMsg = array.new_string(3, "")       // 0 context created, 1 retest, 2 setup resolved
var array<int>    stN = array.new_int(4, 0)            // per-window outcome-model results: 0 Asia, 1 NY am, 2 NY pm, 3 total
var array<int>    stW = array.new_int(4, 0)
var array<float>  stR = array.new_float(4, 0.0)
bool okWinAs = not (inAsTz == inLoTz and inAsH == inLoH and inAsM == inLoM)
bool okWinAm = not (inAmSH == inAmEH and inAmSM == inAmEM)
bool okWinPm = not (inPmSH == inPmEH and inPmSM == inPmEM)

// ───────────── entry windows (calendar-aware; named IANA timezones; never the chart display timezone) ─────────────
// Local timestamp for the calendar date `dayShift` days from ref's local date in tz. Stepping is anchored at local
// NOON so a DST day (23h/25h) can never skip or repeat a date; hh:mm is then built with timestamp(tz, ...).
f_localTs(int ref, string tz, int dayShift, int hh, int mm) =>
    int noon = timestamp(tz, year(ref, tz), month(ref, tz), dayofmonth(ref, tz), 12, 0, 0)
    int shifted = noon + dayShift * 86400000
    timestamp(tz, year(shifted, tz), month(shifted, tz), dayofmonth(shifted, tz), hh, mm, 0)

// One window candidate containing T (start inclusive, end exclusive). Instances starting on T's local start-date
// and the previous start-date are checked, so overnight windows are found. Returns [start, end] or [na, na].
f_winCand(int T, bool en, bool valid, int sh, int sm, string stz, int eh, int em, string etz) =>
    int bs = na
    int be = na
    if en and valid
        for s = 0 to 1
            int st = f_localTs(T, stz, -s, sh, sm)
            int e0 = f_localTs(st, etz, 0, eh, em)
            int en2 = e0 > st ? e0 : f_localTs(st, etz, 1, eh, em)   // first end strictly after the start
            int dw = dayofweek(st, stz)
            bool dayOk = inWkd == "Every day" or (dw >= dayofweek.monday and dw <= dayofweek.friday)
            if dayOk and T >= st and T < en2
                if na(bs) or st > bs
                    bs := st
                    be := en2
    [bs, be]

// Deterministic assignment: latest start wins; equal starts: NY morning, then NY afternoon, then Asia -> London.
f_selectWindow(int T) =>
    [sA, eA] = f_winCand(T, inWinAsia, okWinAs, inAsH, inAsM, inAsTz, inLoH, inLoM, inLoTz)
    [sM, eM] = f_winCand(T, inWinAm, okWinAm, inAmSH, inAmSM, inAmTz, inAmEH, inAmEM, inAmTz)
    [sP, eP] = f_winCand(T, inWinPm, okWinPm, inPmSH, inPmSM, inPmTz, inPmEH, inPmEM, inPmTz)
    string bn = ""
    int bs = na
    int be = na
    if not na(sM)
        bn := "New York morning"
        bs := sM
        be := eM
    if not na(sP) and (na(bs) or sP > bs)
        bn := "New York afternoon"
        bs := sP
        be := eP
    if not na(sA) and (na(bs) or sA > bs)
        bn := "Asia -> London"
        bs := sA
        be := eA
    [bn, bs, be]

// ═════════════════════════════════════════ ACTIONS ════════════════════════════════════════════
f_destroy(Zone z) =>
    if not na(z.bx)
        box.delete(z.bx)
        z.bx := na
    true

f_clearStore(array<Zone> a) =>
    int n = a.size()
    if n > 0
        for i = n - 1 to 0
            f_destroy(a.get(i))
            a.remove(i)
    true

f_evInc(int i, string tf) =>
    ev.set(i, ev.get(i) + 1)
    if tf != ""
        string cur = evTf.get(i)
        array<string> toks = str.split(cur, ",")
        if not toks.includes(tf)
            evTf.set(i, cur == "" ? tf : cur + "," + tf)
    true

f_resetEv() =>
    for i = 0 to 11
        ev.set(i, 0)
        evTf.set(i, "")
    true

f_addWhy(string a, string b) =>
    a == "" ? b : a + "; " + b

f_dnT(float x) =>
    math.floor(x / syminfo.mintick + 0.000001) * syminfo.mintick

f_upT(float x) =>
    math.ceil(x / syminfo.mintick - 0.000001) * syminfo.mintick

f_rnd(float x) =>
    math.round(x / syminfo.mintick) * syminfo.mintick

f_log(string txt) =>
    if inLog
        log.info("H Ticks | " + txt)
    true

f_winIdx(string nm) =>
    nm == "Asia -> London" ? 0 : (nm == "New York morning" ? 1 : 2)

// One chart-layer lifecycle step. Returns 0 none, 1 inverted, 2 removed (touch), 3 removed (invalidation).
f_stepChart(Zone z, float hi, float lo, float cl, int bi, int t, int tc) =>
    int r = 0
    if bi > z.formBar
        bool bull = z.dir > 0
        if z.state == ST_BULL_FVG or z.state == ST_BEAR_FVG
            // inversion: confirmed close strictly through the opposite OUTER boundary
            bool inv = bull ? f_tk(cl) < f_tk(z.bottom) : f_tk(cl) > f_tk(z.top)
            if inv
                z.state := bull ? ST_BEAR_IFVG : ST_BULL_IFVG
                z.invBar := bi
                z.invTime := t
                z.invAvail := tc
                r := 1
        else if bi > z.invBar
            // the inversion candle (bi == invBar) can never remove the new iFVG
            bool invalid = bull ? f_tk(cl) > f_tk(z.top) : f_tk(cl) < f_tk(z.bottom)
            if invalid
                r := 3
            else if f_overlap(hi, lo, z.bottom, z.top)
                r := 2
    r

// Reconcile one source slot against the engine snapshot (HTF layer). Chronological two-pointer merge.
// `gen` = false during the slot's first (bootstrap) reconciliation: nothing is announced then.
// The watermark only gates creation of zones that have no store match; matched zones always update.
f_reconcile(array<Zone> store, int idx, string tfTxt, array<float> snap, int asOf) =>
    bool gen = srcInit.get(idx)
    srcTrunc.set(idx, snap.get(0) == 1.0)
    int cnt = int((snap.size() - HDR) / ZS)
    int m = store.size()
    if m > 0
        for i = 0 to m - 1
            Zone z0 = store.get(i)
            z0.seen := false
            z0.endNow := false
    int j = 0
    if cnt > 0
        for k = 0 to cnt - 1
            int base = HDR + k * ZS
            int ft = int(snap.get(base))
            float cd = snap.get(base + 1)
            int d = cd > 0 ? 1 : -1
            bool flg = math.abs(cd) == 2.0
            float zt = snap.get(base + 2)
            float zb = snap.get(base + 3)
            int conf = int(snap.get(base + 4))
            int tp = int(snap.get(base + 5))
            float fa = snap.get(base + 7)
            bool adv = true
            while adv
                adv := false
                if j < store.size()
                    if store.get(j).formTime < ft
                        j += 1
                        adv := true
            bool isMatch = false
            if j < store.size()
                isMatch := store.get(j).formTime == ft
            if isMatch
                Zone z = store.get(j)
                z.seen := true
                z.lastEvt := asOf
                j += 1
                if flg
                    z.endNow := true
                else if tp > 0 and not z.tapped
                    z.tapped := true          // monotonic: never reverted by a snapshot
                    z.state := z.dir > 0 ? ST_TAP_BULL : ST_TAP_BEAR
                    z.tapTime := tp
                    z.tapAvail := time_close
                    if gen
                        f_evInc(5, tfTxt)
            else if not flg and ft > wm.get(idx)
                bool tpd = tp > 0
                int st = d > 0 ? (tpd ? ST_TAP_BULL : ST_UNT_BULL) : (tpd ? ST_TAP_BEAR : ST_UNT_BEAR)
                Zone nz = Zone.new(id = syminfo.tickerid + "|" + tfTxt + "|" + str.tostring(ft) + "|" + str.tostring(d), src = idx, tfTxt = tfTxt, dir = d, state = st, top = zt, bottom = zb, formTime = ft, confTime = conf, availTime = time_close, width = zt - zb, fatr = fa < 0 ? na : fa, tapped = tpd, tapTime = tp, tapAvail = time_close, lastEvt = asOf, seen = true)
                store.push(nz)
                wm.set(idx, ft)
                // genuine formation = confirmed by the source candle that just completed, after bootstrap
                if gen and conf == asOf
                    f_evInc(4, tfTxt)
    // zones missing from the snapshot are gone (expired, capacity-pruned, or already removed): silent.
    // zones the engine flagged inverted: removal dominates any tap in the same step.
    int n2 = store.size()
    if n2 > 0
        for i = n2 - 1 to 0
            Zone z = store.get(i)
            if z.endNow
                f_destroy(z)
                store.remove(i)
                if gen
                    f_evInc(6, tfTxt)
            else if not z.seen
                f_destroy(z)
                store.remove(i)
    // deterministic capacity pruning, oldest first (never a price event)
    while store.size() > inHtfCap
        Zone old = store.shift()
        f_destroy(old)
    srcInit.set(idx, true)
    true

f_sync(array<Zone> store, int idx, string tfTxt, array<float> snap, int asOf) =>
    if not na(snap) and not na(asOf)
        srcSeen.set(idx, true)
        if asOf > lastAsOf.get(idx) and not srcBad.get(idx)
            lastAsOf.set(idx, asOf)
            // The chart must cover the WHOLE current source period (it starts at asOf), otherwise touches
            // earlier in that period are unknowable: skip; the next snapshot already includes that period.
            if firstTime <= asOf
                // A chart candle straddling the source boundary would make event order ambiguous.
                if not na(prevCloseT) and prevCloseT > asOf
                    srcBad.set(idx, true)
                    warnArr.push(tfTxt + " disabled: chart candles do not align with " + tfTxt + " boundaries (session/timeframe alignment)")
                    f_clearStore(store)
                else
                    f_reconcile(store, idx, tfTxt, snap, asOf)
    true

// Chart-candle taps on HTF zones (monotonic). Candle must OPEN at/after formation confirmation.
f_tapStore(array<Zone> a) =>
    int n = a.size()
    if n > 0
        for i = 0 to n - 1
            Zone z = a.get(i)
            if not z.tapped and time >= z.confTime and f_overlap(high, low, z.bottom, z.top)
                z.tapped := true
                z.state := z.dir > 0 ? ST_TAP_BULL : ST_TAP_BEAR
                z.tapTime := time
                z.tapAvail := time_close
                f_evInc(5, z.tfTxt)
    true

// ───────────── HTF obstacle / coverage ─────────────
// Opposing active tracked HTF FVGs whose ORIGINAL boundaries intersect the closed interval [lo, hi].
// Deliberately ignores every display filter (size, budgets, nearest sets, visibility).
f_scanObs(array<Zone> a, bool bull, float lo, float hi) =>
    int cnt = 0
    string nm = ""
    int n = a.size()
    if n > 0
        float loT = lo / syminfo.mintick
        float hiT = hi / syminfo.mintick
        for i = 0 to n - 1
            Zone z = a.get(i)
            bool opp = bull ? z.dir < 0 : z.dir > 0
            if opp and f_tk(z.top) >= loT - 0.000001 and f_tk(z.bottom) <= hiT + 0.000001
                cnt += 1
                if nm == ""
                    nm := z.tfTxt + (z.dir < 0 ? " bearish" : " bullish") + " FVG"
    [cnt, nm]

f_scanAll(bool bull, float lo, float hi) =>
    [ca, na_] = f_scanObs(hz1, bull, lo, hi)
    [cb, nb_] = f_scanObs(hz2, bull, lo, hi)
    [cc, nc_] = f_scanObs(hz3, bull, lo, hi)
    [cd, nd_] = f_scanObs(hz4, bull, lo, hi)
    string nm = na_ != "" ? na_ : (nb_ != "" ? nb_ : (nc_ != "" ? nc_ : nd_))
    [ca + cb + cc + cd, nm]

// 0 = not applicable (disabled / equal / lower / duplicate), 1 = valid, 2 = UNKNOWN (never "clear")
f_slotState(bool en, bool okS, bool actS, int idx) =>
    int st = 0
    if en and okS
        st := actS and srcSeen.get(idx) and srcInit.get(idx) and not srcBad.get(idx) and not srcTrunc.get(idx) ? 1 : 2
    st

// cov: 0 complete, 1 unknown (some applicable source not valid), 2 no applicable source
f_coverage() =>
    int s1 = f_slotState(en1, ok1, act1, 0)
    int s2 = f_slotState(en2, ok2, act2, 1)
    int s3 = f_slotState(en3, ok3, act3, 2)
    int s4 = f_slotState(en4, ok4, act4, 3)
    int nValid = (s1 == 1 ? 1 : 0) + (s2 == 1 ? 1 : 0) + (s3 == 1 ? 1 : 0) + (s4 == 1 ? 1 : 0)
    int nUnk = (s1 == 2 ? 1 : 0) + (s2 == 2 ? 1 : 0) + (s3 == 2 ? 1 : 0) + (s4 == 2 ? 1 : 0)
    string txt = ""
    if s1 == 1
        txt := f_tfText(sec1)
    if s2 == 1
        txt := txt == "" ? f_tfText(sec2) : txt + "," + f_tfText(sec2)
    if s3 == 1
        txt := txt == "" ? f_tfText(sec3) : txt + "," + f_tfText(sec3)
    if s4 == 1
        txt := txt == "" ? f_tfText(sec4) : txt + "," + f_tfText(sec4)
    [nUnk > 0 ? 1 : (nValid > 0 ? 0 : 2), txt]

// ───────────── display selection (never touches lifecycle state or array order) ─────────────
// Size filter on FROZEN width and FROZEN formation ATR. Tick-aware, so a width exactly at the threshold qualifies.
f_sizeOk(float width, float fatr, int minT, float mult) =>
    bool ok = true
    if mult > 0 and na(fatr)
        ok := false              // ATR qualification unknown: hide (still tracked)
    else
        float thrT = float(minT)
        if mult > 0
            float atrT = mult * fatr / syminfo.mintick
            thrT := atrT > thrT ? atrT : thrT
        ok := f_tk(width) >= thrT - 0.000001
    ok

// Nearest-EDGE distance (0 when price is inside or on a boundary).
f_dist(Zone z, float ref) =>
    float d = 0.0
    if f_tk(ref) < f_tk(z.bottom)
        d := z.bottom - ref
    else if f_tk(ref) > f_tk(z.top)
        d := ref - z.top
    d

// ═════════════════════════════════════════ DRAWING ════════════════════════════════════════════
// Persistent handles, mutated only on confirmed bars (drawNow). Hidden/removed items are deleted; state is untouched.
f_syncDraw(Zone z, bool htf, bool want) =>
    if not want
        f_destroy(z)
    else
        bool bull = z.state == ST_BULL_FVG or z.state == ST_BULL_IFVG or z.state == ST_UNT_BULL or z.state == ST_TAP_BULL
        bool ifvg = z.state == ST_BULL_IFVG or z.state == ST_BEAR_IFVG
        bool tap  = z.state == ST_TAP_BULL or z.state == ST_TAP_BEAR
        color base = bull ? inBull : inBear
        int fillT = htf ? (tap ? inHtfTapT : inHtfT) : inChT
        string txt = ""
        if inLabels
            txt := htf ? z.tfTxt + " FVG · " + (tap ? "Tapped" : "Untapped") : (ifvg ? "iFVG" : "FVG")
        int l = z.formTime > firstTime ? z.formTime : firstTime
        int r = lastConfClose + inExt * chartMs
        if r <= l
            r := l + chartMs
        if na(z.bx)
            z.bx := box.new(left = l, top = z.top, right = r, bottom = z.bottom, xloc = xloc.bar_time, border_color = color.new(base, inBordT), border_width = 1, border_style = ifvg ? line.style_dashed : line.style_solid, bgcolor = color.new(base, fillT), text = txt, text_size = size.small, text_color = color.new(base, 15), text_halign = text.align_right, text_valign = text.align_center)
        else
            box.set_right(z.bx, r)
            box.set_bgcolor(z.bx, color.new(base, fillT))
            box.set_border_style(z.bx, ifvg ? line.style_dashed : line.style_solid)
            box.set_text(z.bx, txt)
    true

f_classify(array<Zone> a, bool htf) =>
    int n = a.size()
    if n > 0
        for i = 0 to n - 1
            Zone z = a.get(i)
            z.vis := false
            z.cat := -1
            z.dist := f_dist(z, refPrice)
            if htf
                if inShowHtf and f_sizeOk(z.width, z.fatr, inHtfMinT, inHtfAtr)
                    z.cat := f_tk(z.bottom) > f_tk(refPrice) ? 2 : (f_tk(z.top) < f_tk(refPrice) ? 3 : 4)
            else
                bool isI = z.state == ST_BULL_IFVG or z.state == ST_BEAR_IFVG
                if inShow30 and f_sizeOk(z.width, z.fatr, inFvgMinT, inFvgAtr)
                    z.cat := isI ? 1 : 0
    true

f_pickCat(array<Zone> a, int cat, int limit) =>
    int n = a.size()
    if n > 0 and limit > 0
        for pick = 1 to limit
            int best = -1
            for i = 0 to n - 1
                Zone z = a.get(i)
                if z.cat == cat and not z.vis
                    if best < 0
                        best := i
                    else
                        Zone bz = a.get(best)
                        bool better = false
                        if inNearest and z.dist != bz.dist
                            better := z.dist < bz.dist
                        else
                            better := z.formTime >= bz.formTime
                        if better
                            best := i
            if best >= 0
                Zone sel = a.get(best)
                sel.vis := true
    true

f_drawHtf(array<Zone> a) =>
    f_classify(a, true)
    f_pickCat(a, 2, inHtfAbove)
    f_pickCat(a, 3, inHtfBelow)
    f_pickCat(a, 4, inHtfCont)
    int n = a.size()
    if n > 0
        for i = 0 to n - 1
            Zone z = a.get(i)
            f_syncDraw(z, true, z.vis)
    true

f_drawCtx() =>
    if cx.state != 0 and inShowCtx
        color base = cx.dir > 0 ? inBull : inBear
        int l = cx.formTime > firstTime ? cx.formTime : firstTime
        int r = lastConfClose + inExt * chartMs
        if r <= l
            r := l + chartMs
        string txt = ""
        if inLabels
            txt := "3m ctx " + (cx.dir > 0 ? "long" : "short") + (cx.state == 1 ? " · awaiting retest" : " · awaiting 30s trigger")
        if na(cx.bx)
            cx.bx := box.new(left = l, top = cx.top, right = r, bottom = cx.bottom, xloc = xloc.bar_time, border_color = color.new(base, 40), border_width = 2, border_style = line.style_dashed, bgcolor = color.new(base, 90), text = txt, text_size = size.small, text_color = color.new(base, 10), text_halign = text.align_right, text_valign = text.align_center)
        else
            box.set_right(cx.bx, r)
            box.set_text(cx.bx, txt)
    else if not na(cx.bx)
        box.delete(cx.bx)
        cx.bx := na
    true

f_drawSetups() =>
    int n = setups.size()
    if n > 0
        for i = 0 to n - 1
            Setup s = setups.get(i)
            int r = s.state != 0 ? s.resolveTime : lastConfClose + inExt * chartMs
            if r <= s.entryTime
                r := s.entryTime + chartMs
            string txt = ""
            if inLabels
                txt := (s.dir > 0 ? "Long 1R" : "Short 1R") + (s.state == 1 ? " ✓ " + str.tostring(s.rMult, "#.0") + "R" : (s.state == 2 or s.state == 3 ? " ✗ " + str.tostring(s.rMult, "#.0") + "R" : (s.state == 4 ? " exit " + str.tostring(s.rMult, "#.0") + "R" : "")))
            if na(s.lE)
                s.lE := line.new(x1 = s.entryTime, y1 = s.entry, x2 = r, y2 = s.entry, xloc = xloc.bar_time, color = color.new(color.gray, 20), style = line.style_solid, width = 1)
                s.lS := line.new(x1 = s.entryTime, y1 = s.stop, x2 = r, y2 = s.stop, xloc = xloc.bar_time, color = color.new(inBear, 20), style = line.style_dashed, width = 1)
                s.lT := line.new(x1 = s.entryTime, y1 = s.target, x2 = r, y2 = s.target, xloc = xloc.bar_time, color = color.new(inBull, 20), style = line.style_dashed, width = 1)
                s.lb := label.new(x = s.entryTime, y = s.entry, xloc = xloc.bar_time, text = txt, style = label.style_label_left, size = size.tiny, textcolor = color.gray, color = color.new(color.gray, 85))
            else
                line.set_x2(s.lE, r)
                line.set_x2(s.lS, r)
                line.set_x2(s.lT, r)
                label.set_text(s.lb, txt)
    true

f_drawAll() =>
    if not na(lastConfClose) and not na(refPrice)
        f_classify(chartZ, false)
        f_pickCat(chartZ, 0, inMax30Fvg)
        f_pickCat(chartZ, 1, inMax30Ifvg)
        int n = chartZ.size()
        if n > 0
            for i = 0 to n - 1
                Zone z = chartZ.get(i)
                f_syncDraw(z, false, z.vis)
        f_drawHtf(hz1)
        f_drawHtf(hz2)
        f_drawHtf(hz3)
        f_drawHtf(hz4)
        f_drawCtx()
        f_drawSetups()
    true

// ───────────── 3m context, entry, outcome ─────────────
f_ctxClear() =>
    if not na(cx.bx)
        box.delete(cx.bx)
        cx.bx := na
    cx.state := 0
    cx.retestBar := -1
    true

f_openSetup() =>
    bool o = false
    int n = setups.size()
    if n > 0
        for i = 0 to n - 1
            if setups.get(i).state == 0
                o := true
    o

f_winCount(string id) =>
    int c = 0
    int n = wKeys.size()
    if n > 0
        for i = 0 to n - 1
            if wKeys.get(i) == id
                c := wCnt.get(i)
    c

f_winInc(string id) =>
    bool found = false
    int n = wKeys.size()
    if n > 0
        for i = 0 to n - 1
            if wKeys.get(i) == id
                wCnt.set(i, wCnt.get(i) + 1)
                found := true
    if not found
        wKeys.push(id)
        wCnt.push(1)
    while wKeys.size() > 60
        wKeys.shift()
        wCnt.shift()
    true

// Mandatory expiry at the originating window's end (end exclusive); optional maximum age. Never transferred.
f_ctxExpire() =>
    if cx.state != 0
        bool endedWin = time_close >= cx.winEnd
        bool aged = inUseMaxAge and time_close - cx.confAsOf >= inMaxAgeMin * 60000
        if endedWin or aged
            cx.lastReason := endedWin ? "context expired at window end" : "context expired (max age)"
            f_ctxClear()
    true

// One new confirmed 3m update: (1) later 3m close beyond the zone cancels the pending context,
// (2) 3m gaps inverted by THIS candle may create/replace the context (narrowest, newest, stable order).
f_ctxUpdate(array<float> snap, int asOf, float cCl) =>
    if cx.state != 0 and asOf > cx.confAsOf
        bool inval = cx.dir > 0 ? f_tk(cCl) < f_tk(cx.bottom) : f_tk(cCl) > f_tk(cx.top)
        if inval
            cx.lastReason := "3m context cancelled by a confirmed 3m close through the zone"
            f_ctxClear()
    int cnt = int((snap.size() - HDR) / ZS)
    int bestK = -1
    float bestW = 0.0
    int bestFt = 0
    if cnt > 0
        for k = 0 to cnt - 1
            int base = HDR + k * ZS
            if math.abs(snap.get(base + 1)) == 2.0 and f_tk(snap.get(base + 2)) - f_tk(snap.get(base + 3)) >= inCtxMinTicks
                float w = snap.get(base + 2) - snap.get(base + 3)
                int ft = int(snap.get(base))
                if bestK < 0 or w < bestW or (w == bestW and ft >= bestFt)
                    bestK := k
                    bestW := w
                    bestFt := ft
    if bestK >= 0
        bool blocked = inOneActive and (f_openSetup() or asOf < lastResolveAt)
        if not blocked
            [wn, ws, we] = f_selectWindow(asOf)
            if not na(ws)
                int b2 = HDR + bestK * ZS
                float cd = snap.get(b2 + 1)
                f_ctxClear()
                cx.state := 1
                cx.dir := cd > 0 ? -1 : 1
                cx.top := snap.get(b2 + 2)
                cx.bottom := snap.get(b2 + 3)
                cx.formTime := int(snap.get(b2))
                cx.confAsOf := asOf
                cx.procTime := time_close
                cx.zid := TF_CTX + "|" + str.tostring(cx.formTime) + "|" + str.tostring(cd > 0 ? 1 : -1)
                cx.winId := wn + "|" + str.tostring(ws)
                cx.winName := wn
                cx.winStart := ws
                cx.winEnd := we
                cx.retestBar := -1
                cx.away := 0
                cx.lastReason := ""
                sMsg.set(0, "H Ticks 3m context " + (cx.dir > 0 ? "LONG" : "SHORT") + " " + syminfo.ticker + " | zone " + str.tostring(cx.bottom, format.mintick) + "-" + str.tostring(cx.top, format.mintick) + " | " + wn)
                f_log("ctx created " + (cx.dir > 0 ? "long" : "short") + " " + cx.winId)
    true

f_ctxSync(array<float> snap, int asOf, float cCl) =>
    if not na(snap) and not na(asOf) and not na(cCl)
        srcSeen.set(4, true)
        if asOf > lastAsOf.get(4) and not srcBad.get(4)
            lastAsOf.set(4, asOf)
            if firstTime <= asOf
                if not na(prevCloseT) and prevCloseT > asOf
                    srcBad.set(4, true)
                    warnArr.push("3m context source disabled: chart candles do not align with 3m boundaries")
                    f_ctxClear()
                else
                    srcInit.set(4, true)
                    f_ctxUpdate(snap, asOf, cCl)
    true

// Trigger candidates = 30s gaps that inverted on this bar in the context's direction and were confirmed at/after the
// 3m confirmation. Narrowest first, then newest; ties resolve to the later array position (stable order).
f_pickTrigger() =>
    Zone best = na
    int n = pend.size()
    if n > 0
        int need = cx.dir > 0 ? ST_BULL_IFVG : ST_BEAR_IFVG
        for i = 0 to n - 1
            Zone z = pend.get(i)
            if z.state == need and z.confTime >= cx.confAsOf
                bool take = false
                if na(best)
                    take := true
                else
                    take := z.width < best.width or (z.width == best.width and z.formTime >= best.formTime)
                if take
                    best := z
    best

f_dbg(string txt) =>
    if inDebug
        dbgLbls.push(label.new(bar_index, high, "x " + txt, style = label.style_label_down, size = size.tiny, textcolor = color.gray, color = color.new(color.gray, 90)))
        while dbgLbls.size() > 30
            label.delete(dbgLbls.shift())
    true

// Entry decision, taken ONCE for this trigger. Rejection keeps the context pending and is never revisited.
f_tryEntry(Zone t) =>
    bool bull = cx.dir > 0
    bool ok = true
    string why = ""
    [wn, ws, we] = f_selectWindow(time_close)
    if na(ws) or wn + "|" + str.tostring(ws) != cx.winId
        ok := false
        why := f_addWhy(why, "Entry outside the originating window instance")
    if f_winCount(cx.winId) >= inMaxEntries
        ok := false
        why := f_addWhy(why, "Window entry limit reached")
    if inOneActive and f_openSetup()
        ok := false
        why := f_addWhy(why, "Another setup is unresolved")
    float entry = f_rnd(close)
    float body = bull ? math.min(open, close) : math.max(open, close)
    float stop = bull ? f_dnT(body - inStopBuf * syminfo.mintick) : f_upT(body + inStopBuf * syminfo.mintick)
    int eT = f_tk(entry)
    int sT = f_tk(stop)
    int rT = bull ? eT - sT : sT - eT
    float target = na
    if rT >= 1
        int tT = bull ? eT + rT : eT - rT
        target := tT * syminfo.mintick
        if rT < inMinRiskT
            ok := false
            why := f_addWhy(why, "Risk below minimum (" + str.tostring(rT) + " ticks)")
        if inMaxRiskT > 0 and rT > inMaxRiskT
            ok := false
            why := f_addWhy(why, "Risk above maximum (" + str.tostring(rT) + " ticks)")
    else
        ok := false
        why := f_addWhy(why, "Invalid risk")
    [cov, srcTxt] = f_coverage()
    if cov != 0
        ok := false
        why := f_addWhy(why, cov == 2 ? "No applicable HTF source" : "HTF coverage unknown")
    else if rT >= 1
        float lo = bull ? entry : target
        float hi = bull ? target : entry
        [obs, obsName] = f_scanAll(bull, lo, hi)
        if obs > 0
            ok := false
            why := f_addWhy(why, "Blocked by " + obsName)
    if ok
        float riskPx = rT * syminfo.mintick
        Setup s = Setup.new(id = cx.winId + "|" + str.tostring(time_close), dir = bull ? 1 : -1, entry = entry, stop = stop, target = target, riskT = rT, entryTime = time_close, entryBar = bar_index, winId = cx.winId, winName = cx.winName, ctxZid = cx.zid, srcs = srcTxt)
        setups.push(s)
        f_winInc(cx.winId)
        f_evInc(bull ? 9 : 10, "")
        string riskTxt = str.tostring(rT) + " ticks / " + str.tostring(riskPx * syminfo.pointvalue, "#.##") + " " + syminfo.currency + " per contract"
        string human = "H Ticks " + (bull ? "LONG" : "SHORT") + " " + syminfo.ticker + " " + timeframe.period + " | Entry " + str.tostring(entry, format.mintick) + " | Stop " + str.tostring(stop, format.mintick) + " | Target 1R " + str.tostring(target, format.mintick) + " | Risk " + riskTxt + " | Session " + cx.winName + " | 3m context " + str.tostring(cx.bottom, format.mintick) + "-" + str.tostring(cx.top, format.mintick) + " | HTF obstacles checked: " + srcTxt
        string json = "{\"indicator\":\"H Ticks 3m30s\",\"side\":\"" + (bull ? "long" : "short") + "\",\"ticker\":\"" + syminfo.ticker + "\",\"entry\":" + str.tostring(entry, format.mintick) + ",\"stop\":" + str.tostring(stop, format.mintick) + ",\"target\":" + str.tostring(target, format.mintick) + ",\"risk_ticks\":" + str.tostring(rT) + ",\"session\":\"" + cx.winName + "\"}"
        qMsg.set(bull ? 0 : 1, alJson ? json : human)
        f_log("ENTRY " + (bull ? "long" : "short") + " E=" + str.tostring(entry) + " S=" + str.tostring(stop) + " T=" + str.tostring(target) + " rT=" + str.tostring(rT))
        f_ctxClear()
        while setups.size() > 30
            Setup old = setups.shift()
            if not na(old.lE)
                line.delete(old.lE)
                line.delete(old.lS)
                line.delete(old.lT)
                label.delete(old.lb)
    else
        cx.lastReason := why
        f_dbg(why)
        f_log("trigger rejected: " + why)
    ok

// Outcome model (ESTIMATE, not broker fills). Later 30s candles only. Stop is checked first when one candle touches both
// (conservative). A stop that gaps through fills at the open. Assumed slippage applies to the entry fill and to stop fills;
// assumed cost (ticks) is deducted. R is measured against the signal's own risk distance. Optional time exit at the close.
// state: 1 target, 2 stop, 3 stop (both touched in one candle), 4 time exit. Returns the resolution close time or 0.
f_trackSetups() =>
    int rt = 0
    int n = setups.size()
    if n > 0
        for i = 0 to n - 1
            Setup s = setups.get(i)
            if s.state == 0 and bar_index > s.entryBar
                bool stopHit = s.dir > 0 ? f_tk(low) <= f_tk(s.stop) : f_tk(high) >= f_tk(s.stop)
                bool tgtHit = s.dir > 0 ? f_tk(high) >= f_tk(s.target) : f_tk(low) <= f_tk(s.target)
                bool timeOut = inTimeStopMin > 0 and time_close - s.entryTime >= inTimeStopMin * 60000
                if stopHit or tgtHit or timeOut
                    float riskPx = math.abs(s.entry - s.stop)
                    float slip = inSlipTicks * syminfo.mintick
                    float fillE = s.entry + s.dir * slip
                    float exitP = s.target
                    int st = 1
                    if stopHit
                        float base = s.dir > 0 ? math.min(s.stop, open) : math.max(s.stop, open)
                        exitP := base - s.dir * slip
                        st := tgtHit ? 3 : 2
                    else if not tgtHit
                        exitP := close
                        st := 4
                    float rm = riskPx > 0 ? (s.dir * (exitP - fillE) - inCostTicks * syminfo.mintick) / riskPx : 0.0
                    s.state := st
                    s.rMult := rm
                    s.resolveTime := time_close
                    rt := time_close
                    int wi = f_winIdx(s.winName)
                    stN.set(wi, stN.get(wi) + 1)
                    stN.set(3, stN.get(3) + 1)
                    if rm > 0
                        stW.set(wi, stW.get(wi) + 1)
                        stW.set(3, stW.get(3) + 1)
                    stR.set(wi, stR.get(wi) + rm)
                    stR.set(3, stR.get(3) + rm)
                    sMsg.set(2, "H Ticks setup resolved " + (s.dir > 0 ? "LONG" : "SHORT") + " " + syminfo.ticker + " | " + str.tostring(rm, "#.00") + "R (model, after assumed costs) | " + (st == 1 ? "target" : (st == 4 ? "time exit" : "stop")))
                    f_log("resolved " + s.id + " state=" + str.tostring(st) + " R=" + str.tostring(rm))
    rt

// ═════════════════════════════ MAIN: confirmed-bar processing ═════════════════════════════════
if supported and barstate.isfirst
    if en1 and sec1 > chartSecs and not al1
        warnArr.push(f_tfText(sec1) + " obstacle source disabled: not an integer multiple of the chart timeframe")
    if en2 and sec2 > chartSecs and not al2
        warnArr.push(f_tfText(sec2) + " obstacle source disabled: not an integer multiple of the chart timeframe")
    if en3 and sec3 > chartSecs and not al3
        warnArr.push(f_tfText(sec3) + " obstacle source disabled: not an integer multiple of the chart timeframe")
    if en4 and sec4 > chartSecs and not al4
        warnArr.push(f_tfText(sec4) + " obstacle source disabled: not an integer multiple of the chart timeframe")
    if nSlots > 0 and effBudget < inBudget
        warnArr.push("Source-history budget clamped to " + str.tostring(effBudget) + " candles (memory bound)")
    if inWinAsia and not okWinAs
        warnArr.push("Entry window A disabled: start equals end")
    if inWinAm and not okWinAm
        warnArr.push("Entry window B disabled: start equals end")
    if inWinPm and not okWinPm
        warnArr.push("Entry window C disabled: start equals end")

bool drawNow = supported and barstate.isconfirmed and (barstate.islast or barstate.islastconfirmedhistory or barstate.isrealtime)

if supported and barstate.isconfirmed
    f_resetEv()
    qMsg.set(0, "")
    qMsg.set(1, "")
    sMsg.set(0, "")
    sMsg.set(1, "")
    sMsg.set(2, "")
    pend.clear()
    lastConfClose := time_close
    refPrice := close

    // 1) mechanical 30s gap lifecycle (unchanged rules). Inversions this bar become trigger candidates.
    int nc = chartZ.size()
    if nc > 0
        for i = nc - 1 to 0
            Zone z = chartZ.get(i)
            int r = f_stepChart(z, high, low, close, bar_index, time, time_close)
            if r == 1
                pend.push(z)
            else if r >= 2
                f_destroy(z)
                chartZ.remove(i)
            else if bar_index - z.formBar >= inChWin
                f_destroy(z)
                chartZ.remove(i)

    // 2) new 30s gap confirmed by THIS closed bar (candle 3)
    if bar_index >= 2 and not na(h2c) and not na(l2c)
        int bullGap = f_tk(low) - f_tk(h2c)
        int bearGap = f_tk(l2c) - f_tk(high)
        int dirN = bullGap >= inMinTick ? 1 : (bearGap >= inMinTick ? -1 : 0)
        if dirN != 0
            float zt = dirN > 0 ? low : l2c
            float zb = dirN > 0 ? h2c : high
            Zone nz = Zone.new(id = syminfo.tickerid + "|" + timeframe.period + "|" + str.tostring(time) + "|" + str.tostring(dirN), dir = dirN, state = dirN > 0 ? ST_BULL_FVG : ST_BEAR_FVG, top = zt, bottom = zb, formTime = time, confTime = time_close, availTime = time_close, width = zt - zb, fatr = chartAtr, formBar = bar_index)
            chartZ.push(nz)
    while chartZ.size() > inChCap
        Zone old = chartZ.shift()
        f_destroy(old)

    // 3) obstacle sources: confirmed source inversions / taps are applied BEFORE any entry decision
    if act1
        f_sync(hz1, 0, f_tfText(sec1), snap1, asOf1)
    if act2
        f_sync(hz2, 1, f_tfText(sec2), snap2, asOf2)
    if act3
        f_sync(hz3, 2, f_tfText(sec3), snap3, asOf3)
    if act4
        f_sync(hz4, 3, f_tfText(sec4), snap4, asOf4)
    f_tapStore(hz1)
    f_tapStore(hz2)
    f_tapStore(hz3)
    f_tapStore(hz4)

    // 4) outcome tracking of entered setups (resolution must precede context ingestion)
    int rt = f_trackSetups()
    if rt > 0
        lastResolveAt := rt

    // 5) 3m context: expiry, then newly available confirmed 3m data (cancel / create), then trigger, then retest
    f_ctxExpire()
    if act0
        f_ctxSync(snap0, asOf0, cls0)
    if cx.state == 2 and cx.retestBar < bar_index
        Zone trg = f_pickTrigger()
        if not na(trg)
            f_tryEntry(trg)
    // retest is evaluated AFTER the trigger step so a candle that both first retests and inverts a gap can never trigger
    if cx.state == 1 and time >= cx.confAsOf
        bool touch = f_overlap(high, low, cx.bottom, cx.top)
        if touch and cx.away >= inDeparture
            cx.state := 2
            cx.retestBar := bar_index
            cx.retestTime := time
            sMsg.set(1, "H Ticks retest done: waiting for 30s trigger (" + (cx.dir > 0 ? "LONG" : "SHORT") + ") " + syminfo.ticker)
            f_log("retest bar " + str.tostring(bar_index))
        else
            int aw = cx.dir > 0 ? f_tk(high) - f_tk(cx.top) : f_tk(cx.bottom) - f_tk(low)
            if aw > cx.away
                cx.away := aw

    // 6) drawings follow the committed state
    if drawNow
        f_drawAll()

var table warnTbl = table.new(position.top_right, 1, 1, border_width = 0)
var table stTbl = table.new(position.bottom_right, 5, 5, bgcolor = color.new(color.black, 85), border_width = 0)
var table staTbl = table.new(position.top_left, 1, 2, bgcolor = color.new(color.black, 85), border_width = 0)
f_slotWarn(bool act, int idx, string nm) =>
    string r = ""
    if act and not srcSeen.get(idx)
        r := nm + ": no source data returned"
    else if act and srcSeen.get(idx) and not srcInit.get(idx) and not srcBad.get(idx)
        r := nm + ": chart history too short to establish state (omitted, not guessed)"
    r

f_pct(int w, int n) =>
    n > 0 ? str.tostring(100.0 * w / n, "#") + "%" : "-"

if barstate.islast
    string w = supported ? array.join(warnArr, "\n") : "Switch to a standard 30-second chart"
    if supported
        string s0 = f_slotWarn(act0, 4, "3m")
        string s1 = f_slotWarn(act1, 0, f_tfText(sec1))
        string s2 = f_slotWarn(act2, 1, f_tfText(sec2))
        string s3 = f_slotWarn(act3, 2, f_tfText(sec3))
        string s4 = f_slotWarn(act4, 3, f_tfText(sec4))
        w += s0 == "" ? "" : (w == "" ? "" : "\n") + s0
        w += s1 == "" ? "" : (w == "" ? "" : "\n") + s1
        w += s2 == "" ? "" : (w == "" ? "" : "\n") + s2
        w += s3 == "" ? "" : (w == "" ? "" : "\n") + s3
        w += s4 == "" ? "" : (w == "" ? "" : "\n") + s4
    if w == ""
        table.cell(warnTbl, 0, 0, "", bgcolor = na)
    else
        table.cell(warnTbl, 0, 0, w, text_color = color.orange, text_size = size.small, bgcolor = color.new(color.black, 80), text_halign = text.align_left)
    if supported and inStatus
        string a1 = cx.state == 0 ? "Context: none" : "Context: " + (cx.dir > 0 ? "LONG" : "SHORT") + (cx.state == 1 ? " - awaiting retest" : " - awaiting 30s trigger") + " | " + cx.winName
        string a2 = (cx.state == 0 ? "" : "Entries this window: " + str.tostring(f_winCount(cx.winId)) + "/" + str.tostring(inMaxEntries) + " | ") + (f_openSetup() ? "Setup OPEN" : "No open setup") + (cx.lastReason == "" ? "" : " | last: " + cx.lastReason)
        table.cell(staTbl, 0, 0, a1, text_color = color.white, text_size = size.small, text_halign = text.align_left)
        table.cell(staTbl, 0, 1, a2, text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    if supported and inStats
        table.cell(stTbl, 0, 0, "Window (model)", text_color = color.white, text_size = size.small)
        table.cell(stTbl, 1, 0, "N", text_color = color.white, text_size = size.small)
        table.cell(stTbl, 2, 0, "Win%", text_color = color.white, text_size = size.small)
        table.cell(stTbl, 3, 0, "Avg R", text_color = color.white, text_size = size.small)
        table.cell(stTbl, 4, 0, "Net R", text_color = color.white, text_size = size.small)
        for r = 0 to 3
            string nm = r == 0 ? "Asia->London" : (r == 1 ? "NY morning" : (r == 2 ? "NY afternoon" : "Total"))
            int n = stN.get(r)
            table.cell(stTbl, 0, r + 1, nm, text_color = color.silver, text_size = size.small, text_halign = text.align_left)
            table.cell(stTbl, 1, r + 1, str.tostring(n), text_color = color.silver, text_size = size.small)
            table.cell(stTbl, 2, r + 1, f_pct(stW.get(r), n), text_color = color.silver, text_size = size.small)
            table.cell(stTbl, 3, r + 1, n > 0 ? str.tostring(stR.get(r) / n, "#.00") : "-", text_color = color.silver, text_size = size.small)
            table.cell(stTbl, 4, r + 1, str.tostring(stR.get(r), "#.0"), text_color = color.silver, text_size = size.small)

// ═════════════════════════════════════════ ALERTS ═════════════════════════════════════════════
// Only genuine events on a confirmed REALTIME bar. Never from history / bootstrap.
bool evNow = supported and barstate.isrealtime and barstate.isconfirmed
if evNow
    if alEntry
        if ev.get(9) > 0
            alert(qMsg.get(0), alert.freq_once_per_bar_close)
        if ev.get(10) > 0
            alert(qMsg.get(1), alert.freq_once_per_bar_close)
    if alCtx
        if sMsg.get(0) != ""
            alert(sMsg.get(0), alert.freq_once_per_bar_close)
        if sMsg.get(1) != ""
            alert(sMsg.get(1), alert.freq_once_per_bar_close)
    if alOutcome and sMsg.get(2) != ""
        alert(sMsg.get(2), alert.freq_once_per_bar_close)
alertcondition(evNow and ev.get(9) > 0, "Long entry (3m ctx -> 30s trigger, 1R)", "H Ticks: LONG entry on {{ticker}} {{interval}}")
alertcondition(evNow and ev.get(10) > 0, "Short entry (3m ctx -> 30s trigger, 1R)", "H Ticks: SHORT entry on {{ticker}} {{interval}}")
