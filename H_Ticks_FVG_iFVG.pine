var array<Zone>   chartZ = array.new<Zone>()
var array<Zone>   hz1 = array.new<Zone>()
var array<Zone>   hz2 = array.new<Zone>()
var array<Zone>   hz3 = array.new<Zone>()
var array<Zone>   hz4 = array.new<Zone>()
var array<int>    lastAsOf = array.new_int(10, 0)
var array<int>    wm       = array.new_int(10, 0)
var array<bool>   srcBad   = array.new_bool(10, false)
var array<bool>   srcSeen  = array.new_bool(10, false)
var array<bool>   srcInit  = array.new_bool(10, false)
var array<bool>   srcTrunc = array.new_bool(10, false)
var array<bool>   srcReady = array.new_bool(10, false)
var array<string> warnArr  = array.new_string(0)
var array<int>    ev   = array.new_int(12, 0)         // 7 target hit, 8 stop hit, 9 long entry, 10 short entry, 11 ambiguous
var array<string> evTf = array.new_string(12, "")
var array<string> aMsgs = array.new_string(0)         // alert lines of the current confirmed bar (sent as ONE alert())
var int   firstTime = time
var int   lastConfClose = na
var float refPrice = na
float chartAtr = ta.atr(14)
int   prevCloseT = time_close[1]
float h2c = high[2]
float l2c = low[2]
var array<Ctx>    cxs = array.from(Ctx.new(k = 0, tfTxt = "1m", tfSecs = 60), Ctx.new(k = 1, tfTxt = "2m", tfSecs = 120), Ctx.new(k = 2, tfTxt = "3m", tfSecs = 180), Ctx.new(k = 3, tfTxt = "5m", tfSecs = 300))
var array<int>    fnl = array.new_int(NCTX * FN, 0)    // per-timeframe funnel: inversions, admitted, retests, eligible 30s inversions, impulse, stop/risk, clear path, entries
var array<int>    fnb = array.new_int(NCTX * FB, 0)    // per-timeframe first-failed-gate / block counters (each candidate counted once)
var array<Zone>   pend = array.new<Zone>()            // 30s gaps that inverted on THIS bar (trigger candidates)
var array<Setup>  setups = array.new<Setup>()
var array<string> wKeys = array.new_string(0)         // entries per window instance
var array<int>    wCnt  = array.new_int(0)
var int  lastResolveAt = 0
var array<label>  dbgLbls = array.new<label>()
var array<int>    dKey    = array.new_int(0)          // NY calendar dates with chart data (yyyymmdd), oldest first
var array<int>    dDow    = array.new_int(0)
var array<int>    dWinN   = array.new_int(0)          // confirmed bars inside an enabled entry window
var array<int>    dWinBad = array.new_int(0)          // ... of which qualification coverage was incomplete
var array<int>    dSetN   = array.new_int(0)          // setups entered on that date
var int  firstDateKey = na
var int  covStart = na
var bool needPrune = false
var array<Lvl> lvStore = array.new<Lvl>()
int   biasDir = na(bzR) ? 0 : int(bzR)
bool okWinAs = not (inAsTz == inLoTz and inAsH == inLoH and inAsM == inLoM)
bool okWinAm = not (inAmSH == inAmEH and inAmSM == inAmEM)
bool okWinPm = not (inPmSH == inPmEH and inPmSM == inPmEM)

// ───────────── entry windows (calendar-aware; named IANA timezones; never the chart display timezone) ─────────────
// Local timestamp for the calendar date `dayShift` days from ref's local date in tz. Stepping is anchored at local
// NOON so a DST day (23h/25h) can never skip or repeat a date; hh:mm is then built with timestamp(tz, ...).
f_localTs(int ref, string tz, int dayShift, int hh, int mm) =>
    int noon = timestamp(tz, year(ref, tz), month(ref, tz), dayofmonth(ref, tz), 12, 0, 0)
    int shifted = noon + dayShift * 86400000
    timestamp(tz, year(shifted, tz), month(shifted, tz), dayofmonth(shifted, tz), hh, mm, 0)

// One window candidate containing T (start inclusive, end exclusive). Instances starting on T's local start-date
// and the previous start-date are checked, so overnight windows are found. Returns [start, end] or [na, na].
f_winCand(int T, bool en, bool valid, int sh, int sm, string stz, int eh, int em, string etz) =>
    int bs = na
    int be = na
    if en and valid
        for s = 0 to 1
            int st = f_localTs(T, stz, -s, sh, sm)
            int e0 = f_localTs(st, etz, 0, eh, em)
            int eEnd = e0 > st ? e0 : f_localTs(st, etz, 1, eh, em)   // first end strictly after the start
            int dw = dayofweek(st, stz)
            bool dayOk = inWkd == "Every day" or (dw >= dayofweek.monday and dw <= dayofweek.friday)
            if dayOk and T >= st and T < eEnd
                if na(bs) or st > bs
                    bs := st
                    be := eEnd
    [bs, be]

// Deterministic assignment: latest start wins; equal starts: NY morning, then NY afternoon, then Asia -> London.
f_selectWindow(int T) =>
    [sA, eA] = f_winCand(T, inWinAsia, okWinAs, inAsH, inAsM, inAsTz, inLoH, inLoM, inLoTz)
    [sM, eM] = f_winCand(T, inWinAm, okWinAm, inAmSH, inAmSM, inAmTz, inAmEH, inAmEM, inAmTz)
    [sP, eP] = f_winCand(T, inWinPm, okWinPm, inPmSH, inPmSM, inPmTz, inPmEH, inPmEM, inPmTz)
    string bn = ""
    int bs = na
    int be = na
    if not na(sM)
        bn := "New York morning"
        bs := sM
        be := eM
    if not na(sP) and (na(bs) or sP > bs)
        bn := "New York afternoon"
        bs := sP
        be := eP
    if not na(sA) and (na(bs) or sA > bs)
        bn := "Asia -> London"
        bs := sA
        be := eA
    [bn, bs, be]

// ═════════════════════════════════════════ ACTIONS ════════════════════════════════════════════
f_destroy(Zone z) =>
    if not na(z.bx)
        box.delete(z.bx)
        z.bx := na
    true

f_clearStore(array<Zone> a) =>
    int n = a.size()
    if n > 0
        for i = n - 1 to 0
            f_destroy(a.get(i))
            a.remove(i)
    true

f_evInc(int i, string tf) =>
    ev.set(i, ev.get(i) + 1)
    if tf != ""
        string cur = evTf.get(i)
        array<string> toks = str.split(cur, ",")
        if not toks.includes(tf)
            evTf.set(i, cur == "" ? tf : cur + "," + tf)
    true

f_resetEv() =>
    for i = 0 to 11
        ev.set(i, 0)
        evTf.set(i, "")
    true

f_addWhy(string a, string b) =>
    b == "" ? a : (a == "" ? b : a + "; " + b)




f_log(string txt) =>
    if inLog
        log.info("H Ticks | " + txt)
    true

// One chart-layer lifecycle step. Returns 0 none, 1 inverted, 2 removed (touch), 3 removed (invalidation).
f_stepChart(Zone z, float hi, float lo, float cl, int bi, int t, int tc) =>
    int r = 0
    if bi > z.formBar
        bool bull = z.dir > 0
        if z.state == ST_BULL_FVG or z.state == ST_BEAR_FVG
            // inversion: confirmed close strictly through the opposite OUTER boundary
            bool inv = bull ? f_tk(cl) < f_tk(z.bottom) : f_tk(cl) > f_tk(z.top)
            if inv
                z.state := bull ? ST_BEAR_IFVG : ST_BULL_IFVG
                z.invBar := bi
                z.invTime := t
                z.invAvail := tc
                r := 1
        else if bi > z.invBar
            // the inversion candle (bi == invBar) can never remove the new iFVG
            bool invalid = bull ? f_tk(cl) > f_tk(z.top) : f_tk(cl) < f_tk(z.bottom)
            if invalid
                r := 3
            else if f_overlap(hi, lo, z.bottom, z.top)
                r := 2
    r

// Reconcile one source slot against the engine snapshot (HTF layer). Chronological two-pointer merge.
// `gen` = false during the slot's first (bootstrap) reconciliation: nothing is announced then.
// The watermark only gates creation of zones that have no store match; matched zones always update.
f_reconcile(array<Zone> store, int idx, string tfTxt, array<float> snap, int asOf) =>
    bool gen = srcInit.get(idx)
    srcTrunc.set(idx, snap.get(0) == 1.0)
    srcReady.set(idx, snap.get(1) > 0.0)
    int cnt = int((snap.size() - HDR) / ZS)
    int m = store.size()
    if m > 0
        for i = 0 to m - 1
            Zone z0 = store.get(i)
            z0.seen := false
            z0.endNow := false
    int j = 0
    if cnt > 0
        for k = 0 to cnt - 1
            int base = HDR + k * ZS
            int ft = int(snap.get(base))
            float cd = snap.get(base + 1)
            int d = cd > 0 ? 1 : -1
            bool flg = math.abs(cd) == 2.0
            float zt = snap.get(base + 2)
            float zb = snap.get(base + 3)
            int conf = int(snap.get(base + 4))
            int tp = int(snap.get(base + 5))
            float fa = snap.get(base + 7)
            bool adv = true
            while adv
                adv := false
                if j < store.size()
                    if store.get(j).formTime < ft
                        j += 1
                        adv := true
            bool isMatch = false
            if j < store.size()
                isMatch := store.get(j).formTime == ft
            if isMatch
                Zone z = store.get(j)
                z.seen := true
                z.lastEvt := asOf
                j += 1
                if flg
                    z.endNow := true
                else if tp > 0 and not z.tapped
                    z.tapped := true          // monotonic: never reverted by a snapshot
                    z.state := z.dir > 0 ? ST_TAP_BULL : ST_TAP_BEAR
                    z.tapTime := tp
                    z.tapAvail := time_close
                    if gen
                        f_evInc(5, tfTxt)
            else if not flg and ft > wm.get(idx)
                bool tpd = tp > 0
                int st = d > 0 ? (tpd ? ST_TAP_BULL : ST_UNT_BULL) : (tpd ? ST_TAP_BEAR : ST_UNT_BEAR)
                Zone nz = Zone.new(id = syminfo.tickerid + "|" + tfTxt + "|" + str.tostring(ft) + "|" + str.tostring(d), src = idx, tfTxt = tfTxt, dir = d, state = st, top = zt, bottom = zb, formTime = ft, confTime = conf, availTime = time_close, width = zt - zb, fatr = fa < 0 ? na : fa, tapped = tpd, tapTime = tp, tapAvail = time_close, lastEvt = asOf, seen = true)
                store.push(nz)
                wm.set(idx, ft)
                // genuine formation = confirmed by the source candle that just completed, after bootstrap
                if gen and conf == asOf
                    f_evInc(4, tfTxt)
    // zones missing from the snapshot are gone (expired, capacity-pruned, or already removed): silent.
    // zones the engine flagged inverted: removal dominates any tap in the same step.
    int n2 = store.size()
    if n2 > 0
        for i = n2 - 1 to 0
            Zone z = store.get(i)
            if z.endNow
                f_destroy(z)
                store.remove(i)
                if gen
                    f_evInc(6, tfTxt)
            else if not z.seen
                f_destroy(z)
                store.remove(i)
    srcInit.set(idx, true)
    true

f_sync(array<Zone> store, int idx, string tfTxt, array<float> snap, int asOf) =>
    if not na(snap) and not na(asOf)
        srcSeen.set(idx, true)
        if asOf > lastAsOf.get(idx) and not srcBad.get(idx)
            lastAsOf.set(idx, asOf)
            // The chart must cover the WHOLE current source period (it starts at asOf), otherwise touches
            // earlier in that period are unknowable: skip; the next snapshot already includes that period.
            if firstTime <= asOf
                // A chart candle straddling the source boundary would make event order ambiguous.
                if not na(prevCloseT) and prevCloseT > asOf
                    srcBad.set(idx, true)
                    warnArr.push(tfTxt + " disabled: chart candles do not align with " + tfTxt + " boundaries (session/timeframe alignment)")
                    f_clearStore(store)
                else
                    f_reconcile(store, idx, tfTxt, snap, asOf)
    true

// Chart-candle taps on HTF zones (monotonic). Candle must OPEN at/after formation confirmation.
f_tapStore(array<Zone> a) =>
    int n = a.size()
    if n > 0
        for i = 0 to n - 1
            Zone z = a.get(i)
            if not z.tapped and time >= z.confTime and f_overlap(high, low, z.bottom, z.top)
                z.tapped := true
                z.state := z.dir > 0 ? ST_TAP_BULL : ST_TAP_BEAR
                z.tapTime := time
                z.tapAvail := time_close
                f_evInc(5, z.tfTxt)
    true

// ───────────── HTF obstacle / coverage ─────────────
// Opposing active tracked HTF FVGs whose ORIGINAL boundaries intersect the closed interval [lo, hi].
// Deliberately ignores every display filter (size, budgets, nearest sets, visibility).
f_scanObs(array<Zone> a, bool bull, float lo, float hi) =>
    int cnt = 0
    string nm = ""
    int n = a.size()
    if n > 0
        float loT = lo / syminfo.mintick
        float hiT = hi / syminfo.mintick
        for i = 0 to n - 1
            Zone z = a.get(i)
            bool opp = bull ? z.dir < 0 : z.dir > 0
            if opp and f_tk(z.top) >= loT - 0.000001 and f_tk(z.bottom) <= hiT + 0.000001
                cnt += 1
                if nm == ""
                    nm := z.tfTxt + (z.dir < 0 ? " bearish" : " bullish") + " FVG, " + str.tostring(z.bottom, format.mintick) + "–" + str.tostring(z.top, format.mintick)
    [cnt, nm]

f_scanAll(bool bull, float lo, float hi) =>
    [ca, na_] = f_scanObs(hz1, bull, lo, hi)
    [cb, nb_] = f_scanObs(hz2, bull, lo, hi)
    [cc, nc_] = f_scanObs(hz3, bull, lo, hi)
    [cd, nd_] = f_scanObs(hz4, bull, lo, hi)
    string nm = na_ != "" ? na_ : (nb_ != "" ? nb_ : (nc_ != "" ? nc_ : nd_))
    [ca + cb + cc + cd, nm]

// 0 = not applicable (disabled / equal / lower / duplicate), 1 = valid, 2 = UNKNOWN (never "clear")
f_slotState(bool en, bool okS, bool actS, int idx) =>
    int st = 0
    if en and okS
        st := actS and srcSeen.get(idx) and srcInit.get(idx) and srcReady.get(idx) and not srcBad.get(idx) and not srcTrunc.get(idx) ? 1 : 2
    st

// Why a source is not valid (empty when valid / not applicable). Names the source and the limitation.
f_slotWhy(bool en, bool okS, bool actS, int idx, string nm) =>
    string r = ""
    if en and okS
        if not actS
            r := nm + ": inactive (not an integer multiple of the chart timeframe)"
        else if not srcSeen.get(idx)
            r := nm + ": no source data returned"
        else if srcBad.get(idx)
            r := nm + ": chart candles do not align with source boundaries"
        else if not srcInit.get(idx)
            r := nm + ": chart history does not yet cover the source period"
        else if srcTrunc.get(idx)
            r := nm + ": tracking capacity exceeded (an omitted gap may still be live)"
        else if not srcReady.get(idx)
            r := nm + ": history warming up (obstacle horizon not yet covered)"
    r

// cov: 0 complete, 1 unknown (some applicable source not valid), 2 no applicable source
f_coverage() =>
    int s1 = f_slotState(en1, ok1, act1, 0)
    int s2 = f_slotState(en2, ok2, act2, 1)
    int s3 = f_slotState(en3, ok3, act3, 2)
    int s4 = f_slotState(en4, ok4, act4, 3)
    int nValid = (s1 == 1 ? 1 : 0) + (s2 == 1 ? 1 : 0) + (s3 == 1 ? 1 : 0) + (s4 == 1 ? 1 : 0)
    int nUnk = (s1 == 2 ? 1 : 0) + (s2 == 2 ? 1 : 0) + (s3 == 2 ? 1 : 0) + (s4 == 2 ? 1 : 0)
    string txt = ""
    if s1 == 1
        txt := f_tfText(sec1)
    if s2 == 1
        txt := txt == "" ? f_tfText(sec2) : txt + "," + f_tfText(sec2)
    if s3 == 1
        txt := txt == "" ? f_tfText(sec3) : txt + "," + f_tfText(sec3)
    if s4 == 1
        txt := txt == "" ? f_tfText(sec4) : txt + "," + f_tfText(sec4)
    string why = ""
    if nUnk > 0
        why := f_addWhy(why, f_slotWhy(en1, ok1, act1, 0, f_tfText(sec1)))
        why := f_addWhy(why, f_slotWhy(en2, ok2, act2, 1, f_tfText(sec2)))
        why := f_addWhy(why, f_slotWhy(en3, ok3, act3, 2, f_tfText(sec3)))
        why := f_addWhy(why, f_slotWhy(en4, ok4, act4, 3, f_tfText(sec4)))
    [nUnk > 0 ? 1 : (nValid > 0 ? 0 : 2), txt, why]

// 3m context source: usable only when data is present, aligned, initialised and warmed up. Capacity truncation can only
// MISS contexts (never create one), so it is reported but does not make the source unusable.
f_ctxReadyK(int k) =>
    bool r = false
    if actCtxA.get(k)
        int ix = IX_CTX + k
        r := srcSeen.get(ix) and srcInit.get(ix) and srcReady.get(ix) and not srcBad.get(ix)
    r

// every ACTIVE context timeframe is usable (used only to label date coverage; each context works as soon as ITS source is ready)
f_ctxReadyAll() =>
    bool r = true
    for k = 0 to NCTX - 1
        if actCtxA.get(k) and not f_ctxReadyK(k)
            r := false
    r

f_lvlReady() =>
    actL and srcSeen.get(IX_LVL) and srcInit.get(IX_LVL) and srcReady.get(IX_LVL) and not srcBad.get(IX_LVL) and not srcTrunc.get(IX_LVL)

f_lvlWhy() =>
    string r = ""
    if supported and actL
        if not srcSeen.get(IX_LVL)
            r := "3m structure: no source data returned"
        else if srcBad.get(IX_LVL)
            r := "3m structure: chart candles do not align with 3m boundaries"
        else if not srcInit.get(IX_LVL)
            r := "3m structure: chart history does not yet cover the source period"
        else if srcTrunc.get(IX_LVL)
            r := "3m structure: level capacity exceeded (an omitted level may still be live)"
        else if not srcReady.get(IX_LVL)
            r := "3m structure: history warming up (level horizon not yet covered)"
    r

f_ctxWhyK(int k) =>
    string nm = cxs.get(k).tfTxt + " context"
    int ix = IX_CTX + k
    string r = ""
    if supported and actCtxA.get(k)
        if not srcSeen.get(ix)
            r := nm + ": no source data returned"
        else if srcBad.get(ix)
            r := nm + ": chart candles do not align with source boundaries"
        else if not srcInit.get(ix)
            r := nm + ": chart history does not yet cover the source period"
        else if not srcReady.get(ix)
            r := nm + ": history warming up (gap-age horizon not yet covered)"
        else if srcTrunc.get(ix)
            r := nm + ": gap capacity exceeded (older gaps omitted; contexts may be missed)"
    r

f_ctxWhy() =>
    string r = ""
    for k = 0 to NCTX - 1
        r := f_addWhy(r, f_ctxWhyK(k))
    r

// ───────────── display selection (never touches lifecycle state or array order) ─────────────
// Size filter on FROZEN width and FROZEN formation ATR. Tick-aware, so a width exactly at the threshold qualifies.
f_sizeOk(float width, float fatr, int minT, float mult) =>
    bool ok = true
    if mult > 0 and na(fatr)
        ok := false              // ATR qualification unknown: hide (still tracked)
    else
        float thrT = float(minT)
        if mult > 0
            float atrT = mult * fatr / syminfo.mintick
            thrT := atrT > thrT ? atrT : thrT
        ok := f_tk(width) >= thrT - 0.000001
    ok

// Nearest-EDGE distance (0 when price is inside or on a boundary).
f_dist(Zone z, float ref) =>
    float d = 0.0
    if f_tk(ref) < f_tk(z.bottom)
        d := z.bottom - ref
    else if f_tk(ref) > f_tk(z.top)
        d := ref - z.top
    d

// ═════════════════════════════════════════ DRAWING ════════════════════════════════════════════
// Persistent handles, mutated only on confirmed bars (drawNow). Hidden/removed items are deleted; state is untouched.
f_syncDraw(Zone z, bool htf, bool want) =>
    if not want
        f_destroy(z)
    else
        bool bull = z.state == ST_BULL_FVG or z.state == ST_BULL_IFVG or z.state == ST_UNT_BULL or z.state == ST_TAP_BULL
        bool ifvg = z.state == ST_BULL_IFVG or z.state == ST_BEAR_IFVG
        bool tap  = z.state == ST_TAP_BULL or z.state == ST_TAP_BEAR
        color base = bull ? inBull : inBear
        int fillT = htf ? (tap ? inHtfTapT : inHtfT) : inChT
        string txt = ""
        if inLabels
            txt := htf ? z.tfTxt + " FVG · " + (tap ? "Tapped" : "Untapped") : (ifvg ? "iFVG" : "FVG")
        int l = z.formTime > firstTime ? z.formTime : firstTime
        int r = lastConfClose + inExt * chartMs
        if r <= l
            r := l + chartMs
        if na(z.bx)
            z.bx := box.new(left = l, top = z.top, right = r, bottom = z.bottom, xloc = xloc.bar_time, border_color = color.new(base, inBordT), border_width = 1, border_style = ifvg ? line.style_dashed : line.style_solid, bgcolor = color.new(base, fillT), text = txt, text_size = size.small, text_color = color.new(base, 15), text_halign = text.align_right, text_valign = text.align_center)
        else
            box.set_left(z.bx, l)
            box.set_top(z.bx, z.top)
            box.set_right(z.bx, r)
            box.set_bottom(z.bx, z.bottom)
            box.set_bgcolor(z.bx, color.new(base, fillT))
            box.set_border_color(z.bx, color.new(base, inBordT))
            box.set_border_style(z.bx, ifvg ? line.style_dashed : line.style_solid)
            box.set_text(z.bx, txt)
            box.set_text_color(z.bx, color.new(base, 15))
    true

f_classify(array<Zone> a, bool htf) =>
    int n = a.size()
    if n > 0
        for i = 0 to n - 1
            Zone z = a.get(i)
            z.vis := false
            z.cat := -1
            z.dist := f_dist(z, refPrice)
            if htf
                if inShowHtf and f_sizeOk(z.width, z.fatr, inHtfMinT, inHtfAtr)
                    z.cat := f_tk(z.bottom) > f_tk(refPrice) ? 2 : (f_tk(z.top) < f_tk(refPrice) ? 3 : 4)
            else
                bool isI = z.state == ST_BULL_IFVG or z.state == ST_BEAR_IFVG
                if inShow30 and f_sizeOk(z.width, z.fatr, inFvgMinT, inFvgAtr)
                    z.cat := isI ? 1 : 0
    true

f_pickCat(array<Zone> a, int cat, int limit) =>
    int n = a.size()
    if n > 0 and limit > 0
        for pick = 1 to limit
            int best = -1
            for i = 0 to n - 1
                Zone z = a.get(i)
                if z.cat == cat and not z.vis
                    if best < 0
                        best := i
                    else
                        Zone bz = a.get(best)
                        bool better = false
                        if inNearest and z.dist != bz.dist
                            better := z.dist < bz.dist
                        else
                            better := z.formTime >= bz.formTime
                        if better
                            best := i
            if best >= 0
                Zone sel = a.get(best)
                sel.vis := true
    true

f_drawHtf(array<Zone> a) =>
    f_classify(a, true)
    f_pickCat(a, 2, inHtfAbove)
    f_pickCat(a, 3, inHtfBelow)
    f_pickCat(a, 4, inHtfCont)
    int n = a.size()
    if n > 0
        for i = 0 to n - 1
            Zone z = a.get(i)
            f_syncDraw(z, true, z.vis)
    true

f_drawCtx() =>
    for k = 0 to NCTX - 1
        Ctx c = cxs.get(k)
        if c.state != 0 and inShowCtx
            color base = c.dir > 0 ? inBull : inBear
            int l = c.formTime > firstTime ? c.formTime : firstTime
            int r = lastConfClose + inExt * chartMs
            if r <= l
                r := l + chartMs
            string txt = c.tfTxt + " ctx " + (c.dir > 0 ? "long" : "short") + (c.state == 1 ? " · awaiting retest" : " · awaiting 30s trigger")
            if na(c.bx)
                c.bx := box.new(left = l, top = c.top, right = r, bottom = c.bottom, xloc = xloc.bar_time, border_color = color.new(base, 40), border_width = 2, border_style = line.style_dashed, bgcolor = color.new(base, 90), text = txt, text_size = size.small, text_color = color.new(base, 10), text_halign = text.align_right, text_valign = text.align_center)
            else
                box.set_left(c.bx, l)
                box.set_top(c.bx, c.top)
                box.set_right(c.bx, r)
                box.set_bottom(c.bx, c.bottom)
                box.set_bgcolor(c.bx, color.new(base, 90))
                box.set_border_color(c.bx, color.new(base, 40))
                box.set_text(c.bx, txt)
                box.set_text_color(c.bx, color.new(base, 10))
        else if not na(c.bx)
            box.delete(c.bx)
            c.bx := na
    true

f_nyT(int t) =>
    str.format_time(t, "MM-dd HH:mm:ss", TZ_NY)

f_delSetupDraw(Setup s) =>
    if not na(s.lE)
        line.delete(s.lE)
        s.lE := na
    if not na(s.lS)
        line.delete(s.lS)
        s.lS := na
    if not na(s.lT)
        line.delete(s.lT)
        s.lT := na
    if not na(s.lR)
        line.delete(s.lR)
        s.lR := na
    if not na(s.rbx)
        box.delete(s.rbx)
        s.rbx := na
    if not na(s.gbx)
        box.delete(s.gbx)
        s.gbx := na
    if not na(s.ctxBx)
        box.delete(s.ctxBx)
        s.ctxBx := na
    if not na(s.trgBx)
        box.delete(s.trgBx)
        s.trgBx := na
    if not na(s.lbE)
        label.delete(s.lbE)
        s.lbE := na
    if not na(s.lbS)
        label.delete(s.lbS)
        s.lbS := na
    if not na(s.lbT)
        label.delete(s.lbT)
        s.lbT := na
    if not na(s.lbRt)
        label.delete(s.lbRt)
        s.lbRt := na
    if not na(s.lbAn)
        label.delete(s.lbAn)
        s.lbAn := na
    if not na(s.lbX)
        label.delete(s.lbX)
        s.lbX := na
    if not na(s.lbCx)
        label.delete(s.lbCx)
        s.lbCx := na
    if not na(s.lbTg)
        label.delete(s.lbTg)
        s.lbTg := na
    if not na(s.lbCm)
        label.delete(s.lbCm)
        s.lbCm := na
    if not na(s.lbTm)
        label.delete(s.lbTm)
        s.lbTm := na
    true

// Create-or-update helpers: every property is (re)applied so a handle can never keep stale values.
f_boxUp(box b, int l, float tp, int r, float bt, color bg, color bc, string txt, color tc, string sty, int bw) =>
    box h = b
    if na(h)
        h := box.new(left = l, top = tp, right = r, bottom = bt, xloc = xloc.bar_time, border_color = bc, border_width = bw, border_style = sty, bgcolor = bg, text = txt, text_size = size.tiny, text_color = tc, text_halign = text.align_right, text_valign = text.align_top)
    else
        box.set_left(h, l)
        box.set_top(h, tp)
        box.set_right(h, r)
        box.set_bottom(h, bt)
        box.set_bgcolor(h, bg)
        box.set_border_color(h, bc)
        box.set_border_width(h, bw)
        box.set_border_style(h, sty)
        box.set_text(h, txt)
        box.set_text_color(h, tc)
    h

f_lineUp(line ln, int x1, float y1, int x2, float y2, color c, string sty) =>
    line h = ln
    if na(h)
        h := line.new(x1 = x1, y1 = y1, x2 = x2, y2 = y2, xloc = xloc.bar_time, color = c, style = sty, width = 2)
    else
        line.set_xy1(h, x1, y1)
        line.set_xy2(h, x2, y2)
        line.set_color(h, c)
    h

f_lblUp(label lb, int x, float y, string txt, color tc, string sty, string tip) =>
    label h = lb
    if na(h)
        h := label.new(x = x, y = y, text = txt, xloc = xloc.bar_time, style = sty, size = size.tiny, textcolor = tc, color = cLblBg, tooltip = tip)
    else
        label.set_xy(h, x, y)
        label.set_text(h, txt)
        label.set_textcolor(h, tc)
        label.set_color(h, cLblBg)
        label.set_tooltip(h, tip)
    h

// Every setup owns its OWN frozen handles and its OWN copy of both gaps (context gap + 30s trigger gap), so clearing a pending
// context or removing a live iFVG never touches setup evidence. Z-order = creation order: R/R shading first, then the two gap
// boxes (they end where the shading begins, so they are never covered), then lines and labels.
// The position look-alike (NOT TradingView's native tool) starts at the entry confirmation; while OPEN it extends to the latest
// confirmed close; once resolved the shading ends at the actual resolution time, widened to a display-only minimum width
// when needed. The TRUE exit time has its own dotted marker + label and is what the statistics use.
f_syncSetupDraw(Setup s, bool want) =>
    if not want
        f_delSetupDraw(s)
    else
        bool bull = s.dir > 0
        string dirW = bull ? "LONG" : "SHORT"
        int actualR = s.state != 0 ? s.resolveTime : lastConfClose
        int rv = math.max(actualR + inExt * chartMs, s.entryTime + 20 * chartMs)
        string outTxt = s.state == 1 ? "Target hit" : (s.state == 2 ? "Stop hit" : (s.state == 3 ? "Ambiguous" : "Open"))
        string tipTxt = s.tip + (rv > actualR + inExt * chartMs ? "\n(Shaded width is display-only; the true exit time is the dotted marker.)" : "")
        string tipCtx = s.ctxTf + " CONTEXT gap " + str.tostring(s.ctxBot, format.mintick) + " - " + str.tostring(s.ctxTop, format.mintick) + " · " + s.ctxId + "\nformation (candle 1 open): " + f_nyT(s.ctxFormT) + " NY\ninversion confirmed: " + f_nyT(s.ctxConfT) + " NY\nsetup " + s.id
        string tipTrg = "30s TRIGGER gap " + str.tostring(s.trgBot, format.mintick) + " - " + str.tostring(s.trgTop, format.mintick) + " · " + s.trgId + "\nformation (candle 1 open): " + f_nyT(s.trgFormT) + " NY\ninversion confirmed: " + f_nyT(s.entryTime) + " NY\nsetup " + s.id
        if inShowRR
            float rTop = bull ? s.entry : s.stop
            float rBot = bull ? s.stop : s.entry
            float gTop = bull ? s.target : s.entry
            float gBot = bull ? s.entry : s.target
            s.rbx := f_boxUp(s.rbx, s.entryTime, rTop, rv, rBot, color.new(color.red, 85), color.new(color.red, 100), "", color.red, line.style_solid, 1)
            s.gbx := f_boxUp(s.gbx, s.entryTime, gTop, rv, gBot, color.new(color.green, 85), color.new(color.green, 100), "", color.green, line.style_solid, 1)
        else
            if not na(s.rbx)
                box.delete(s.rbx)
                s.rbx := na
            if not na(s.gbx)
                box.delete(s.gbx)
                s.gbx := na
        if inShowPair
            s.ctxBx := f_boxUp(s.ctxBx, s.ctxFormT, s.ctxTop, s.entryTime, s.ctxBot, cCtxFill, cCtxLine, "", cCtxLine, line.style_solid, 2)
            s.trgBx := f_boxUp(s.trgBx, s.trgFormT, s.trgTop, s.entryTime, s.trgBot, cTrgFill, cTrgLine, "", cTrgLine, line.style_dashed, 3)
        else
            if not na(s.ctxBx)
                box.delete(s.ctxBx)
                s.ctxBx := na
            if not na(s.trgBx)
                box.delete(s.trgBx)
                s.trgBx := na
        s.lE := f_lineUp(s.lE, s.entryTime, s.entry, rv, s.entry, inEntryCol, line.style_solid)
        s.lS := f_lineUp(s.lS, s.entryTime, s.stop, rv, s.stop, inStopCol, line.style_solid)
        s.lT := f_lineUp(s.lT, s.entryTime, s.target, rv, s.target, inTgtCol, line.style_solid)
        if s.state != 0
            float yLo = math.min(s.stop, s.target)
            float yHi = math.max(s.stop, s.target)
            s.lR := f_lineUp(s.lR, s.resolveTime, yLo, s.resolveTime, yHi, color.gray, line.style_dotted)
            float yX = s.state == 1 ? s.target : (s.state == 2 ? s.stop : s.entry)
            s.lbX := f_lblUp(s.lbX, s.resolveTime, yX, outTxt + " " + str.format_time(s.resolveTime, "HH:mm:ss", TZ_NY) + " NY", cLblTx, label.style_label_down, tipTxt)
        else
            if not na(s.lR)
                line.delete(s.lR)
                s.lR := na
            if not na(s.lbX)
                label.delete(s.lbX)
                s.lbX := na
        s.lbE := f_lblUp(s.lbE, rv, s.entry, "Entry " + str.tostring(s.entry, format.mintick), inEntryCol, label.style_label_left, tipTxt)
        s.lbS := f_lblUp(s.lbS, rv, s.stop, "Stop " + str.tostring(s.stop, format.mintick), inStopCol, label.style_label_left, tipTxt)
        s.lbT := f_lblUp(s.lbT, rv, s.target, "Target 1R " + str.tostring(s.target, format.mintick), inTgtCol, label.style_label_left, tipTxt)
        s.lbRt := f_lblUp(s.lbRt, s.retestT, s.retestPx, "retest", cLblTx, bull ? label.style_label_up : label.style_label_down, tipTxt)
        s.lbAn := f_lblUp(s.lbAn, s.stopAnchorT, s.legExt, "stop anchor", inStopCol, bull ? label.style_label_up : label.style_label_down, tipTxt)
        if inShowPair
            s.lbCx := f_lblUp(s.lbCx, s.ctxFormT, s.ctxTop, s.ctxTf + " CONTEXT · " + dirW + " · " + s.id, cCtxLine, label.style_label_right, tipCtx)
            s.lbTg := f_lblUp(s.lbTg, s.trgFormT, s.trgBot, "30s TRIGGER · " + dirW + " · " + s.id, cTrgLine, label.style_label_right, tipTrg)
            s.lbCm := f_lblUp(s.lbCm, s.ctxInvT, s.ctxInvPx, s.ctxTf + " inv", cCtxLine, bull ? label.style_label_up : label.style_label_down, tipCtx)
            s.lbTm := f_lblUp(s.lbTm, s.trgInvT, s.trgInvPx, "30s inv", cTrgLine, bull ? label.style_label_up : label.style_label_down, tipTrg)
        else
            if not na(s.lbCx)
                label.delete(s.lbCx)
                s.lbCx := na
            if not na(s.lbTg)
                label.delete(s.lbTg)
                s.lbTg := na
            if not na(s.lbCm)
                label.delete(s.lbCm)
                s.lbCm := na
            if not na(s.lbTm)
                label.delete(s.lbTm)
                s.lbTm := na
    true

f_drawSetups() =>
    int n = setups.size()
    int drawn = 0
    if n > 0
        for pass = 0 to 1
            for ii = 0 to n - 1
                int i = pass == 0 ? ii : n - 1 - ii
                Setup s = setups.get(i)
                if (pass == 0) == (s.state == 0)
                    bool want = drawn < DRAW_MAX
                    if want
                        drawn += 1
                    f_syncSetupDraw(s, want)
    true

f_drawAll() =>
    if not na(lastConfClose) and not na(refPrice)
        f_classify(chartZ, false)
        f_pickCat(chartZ, 0, inMax30Fvg)
        f_pickCat(chartZ, 1, inMax30Ifvg)
        int n = chartZ.size()
        if n > 0
            for i = 0 to n - 1
                Zone z = chartZ.get(i)
                f_syncDraw(z, false, z.vis)
        f_drawHtf(hz1)
        f_drawHtf(hz2)
        f_drawHtf(hz3)
        f_drawHtf(hz4)
        f_drawCtx()
        f_drawSetups()
    true

// ───────────── 3m context, entry, outcome ─────────────
// ───────────── 3m structural levels on the chart ─────────────
f_lvlReconcile(array<float> snap) =>
    int cnt = int((snap.size() - HDR) / LS)
    int m = lvStore.size()
    if m > 0
        for i = 0 to m - 1
            Lvl q0 = lvStore.get(i)
            q0.seen := false
    if cnt > 0
        for k = 0 to cnt - 1
            int b = HDR + k * LS
            float pr = snap.get(b)
            int dr = snap.get(b + 1) > 0 ? 1 : -1
            int pt = int(snap.get(b + 2))
            int ct = int(snap.get(b + 3))
            bool found = false
            int n = lvStore.size()
            if n > 0
                for i = 0 to n - 1
                    Lvl q = lvStore.get(i)
                    if q.pivotT == pt and q.dir == dr
                        q.seen := true
                        found := true
            if not found
                lvStore.push(Lvl.new(price = pr, dir = dr, pivotT = pt, confT = ct, seen = true))
    int n2 = lvStore.size()
    if n2 > 0
        for i = n2 - 1 to 0
            if not lvStore.get(i).seen
                lvStore.remove(i)
    true

f_lvlSync(array<float> snap, int asOf) =>
    if not na(snap) and not na(asOf)
        srcSeen.set(IX_LVL, true)
        if asOf > lastAsOf.get(IX_LVL) and not srcBad.get(IX_LVL)
            lastAsOf.set(IX_LVL, asOf)
            if firstTime <= asOf
                if not na(prevCloseT) and prevCloseT > asOf
                    srcBad.set(IX_LVL, true)
                    warnArr.push("3m structure source disabled: chart candles do not align with 3m boundaries")
                else
                    srcInit.set(IX_LVL, true)
                    srcTrunc.set(IX_LVL, snap.get(0) == 1.0)
                    srcReady.set(IX_LVL, snap.get(1) > 0.0)
                    f_lvlReconcile(snap)
    true

f_lvlConsume() =>
    int n = lvStore.size()
    if n > 0
        for i = 0 to n - 1
            Lvl q = lvStore.get(i)
            if not q.consumed and time >= q.confT
                bool hit = q.dir > 0 ? f_tk(high) >= f_tk(q.price) : f_tk(low) <= f_tk(q.price)
                if hit
                    q.consumed := true
    true

// Nearest remaining (unconsumed, available before this candle began) level in the target direction.
// Blocks unless the target ends at least one tick before it. Returns [blocked, nearest level or na].
f_structCheck(bool bull, int tT) =>
    float near = na
    int n = lvStore.size()
    if n > 0
        for i = 0 to n - 1
            Lvl q = lvStore.get(i)
            if not q.consumed and q.confT <= time and q.dir == (bull ? 1 : -1)
                if na(near)
                    near := q.price
                else
                    near := bull ? math.min(near, q.price) : math.max(near, q.price)
    bool blocked = false
    if not na(near)
        blocked := bull ? tT > f_tk(near) - 1 : tT < f_tk(near) + 1
    [blocked, near]


f_ctxClear(Ctx c) =>
    if not na(c.bx)
        box.delete(c.bx)
        c.bx := na
    c.state := 0
    c.retestBar := -1
    true

f_ctxClearAll() =>
    for k = 0 to NCTX - 1
        f_ctxClear(cxs.get(k))
    true

f_fn(int k, int col) =>
    fnl.set(k * FN + col, fnl.get(k * FN + col) + 1)
    true

f_fb(int k, int col) =>
    fnb.set(k * FB + col, fnb.get(k * FB + col) + 1)
    true

f_setupExists(string trgId, string ctxId) =>
    bool r = false
    int n = setups.size()
    if n > 0
        for i = 0 to n - 1
            Setup q = setups.get(i)
            if q.trgId == trgId or q.ctxId == ctxId
                r := true
    r

f_openSetup() =>
    bool o = false
    int n = setups.size()
    if n > 0
        for i = 0 to n - 1
            if setups.get(i).state == 0
                o := true
    o

f_winCount(string id) =>
    int c = 0
    int n = wKeys.size()
    if n > 0
        for i = 0 to n - 1
            if wKeys.get(i) == id
                c := wCnt.get(i)
    c

f_winInc(string id) =>
    bool found = false
    int n = wKeys.size()
    if n > 0
        for i = 0 to n - 1
            if wKeys.get(i) == id
                wCnt.set(i, wCnt.get(i) + 1)
                found := true
    if not found
        wKeys.push(id)
        wCnt.push(1)
    while wKeys.size() > 60
        wKeys.shift()
        wCnt.shift()
    true

// ───────────── reporting calendar: New York entry dates ─────────────
f_dateKey(int t) =>
    year(t, TZ_NY) * 10000 + month(t, TZ_NY) * 100 + dayofmonth(t, TZ_NY)

f_dateIdx(int k) =>
    int r = -1
    int n = dKey.size()
    if n > 0
        for i = n - 1 to 0
            if r < 0 and dKey.get(i) == k
                r := i
    r

// The reported dates: the latest REP_DATES Mon-Fri NY dates that have chart data (plus any weekend date that holds setups,
// so no setup is ever silently left out). Oldest first.
f_reportDates() =>
    array<int> r = array.new_int(0)
    int n = dKey.size()
    if n > 0
        for i = n - 1 to 0
            if r.size() < REP_DATES
                bool wk = dDow.get(i) >= dayofweek.monday and dDow.get(i) <= dayofweek.friday
                if wk or dSetN.get(i) > 0
                    r.unshift(dKey.get(i))
    r

// Retention: an UNRESOLVED setup is never pruned. A RESOLVED setup is pruned only when its entry date is older than the
// oldest reported date. Statistics are computed from these records and never from drawings.
f_pruneSetups() =>
    array<int> rd = f_reportDates()
    int cut = rd.size() > 0 ? rd.first() : 0
    int n = setups.size()
    if n > 0
        for i = n - 1 to 0
            Setup s = setups.get(i)
            if s.state != 0 and s.dateKey < cut
                f_delSetupDraw(s)
                setups.remove(i)
    true

f_dateCount(int k, int st) =>
    int c = 0
    int n = setups.size()
    if n > 0
        for i = 0 to n - 1
            Setup s = setups.get(i)
            if s.dateKey == k and (st < 0 or s.state == st)
                c += 1
    c

// 0 fully evaluated, 1 partial, 2 unavailable (qualification coverage never complete on that date)
f_dateStatus(int idx) =>
    int st = 0
    int wn = dWinN.get(idx)
    int bad = dWinBad.get(idx)
    if wn > 0 and bad == wn
        st := 2
    else if bad > 0 or dKey.get(idx) == firstDateKey
        st := 1
    st

f_dateTxt(int k) =>
    string t = str.tostring(k)
    str.substring(t, 4, 6) + "-" + str.substring(t, 6, 8)

// Mandatory expiry at the originating window's end (end exclusive); optional maximum age. Never transferred.
// Mandatory expiry at the originating window's end (end exclusive). Never transferred to another window.
f_ctxExpire() =>
    for k = 0 to NCTX - 1
        Ctx c = cxs.get(k)
        if c.state != 0 and time_close >= c.winEnd
            c.lastReason := "context expired at window end"
            f_fb(k, 1)
            f_ctxClear(c)
    true

// One new confirmed source update for context timeframe k: (1) a later close of its OWN timeframe through the zone cancels its
// pending context; (2) inversions flagged by THIS source candle may create / replace that timeframe's context (bias direction,
// narrowest then newest, one-active rule, same window instance). Other timeframes are never touched.
f_ctxUpdate(int k, array<float> snap, int asOf, float cCl) =>
    Ctx c = cxs.get(k)
    if c.state != 0 and asOf > c.confAsOf
        bool inval = c.dir > 0 ? f_tk(cCl) < f_tk(c.bottom) : f_tk(cCl) > f_tk(c.top)
        if inval
            c.lastReason := c.tfTxt + " context cancelled by a confirmed " + c.tfTxt + " close through the zone"
            f_fb(k, 2)
            f_ctxClear(c)
    int cnt = int((snap.size() - HDR) / ZS)
    int bestK = -1
    float bestW = 0.0
    int bestFt = 0
    int nFlag = 0
    if cnt > 0
        for kk = 0 to cnt - 1
            int base = HDR + kk * ZS
            if math.abs(snap.get(base + 1)) == 2.0
                nFlag += 1
                bool dirOk = (snap.get(base + 1) > 0 ? -1 : 1) == biasDir
                if dirOk and f_tk(snap.get(base + 2)) - f_tk(snap.get(base + 3)) >= inCtxMinTicks
                    float w = snap.get(base + 2) - snap.get(base + 3)
                    int ft = int(snap.get(base))
                    if bestK < 0 or w < bestW or (w == bestW and ft >= bestFt)
                        bestK := kk
                        bestW := w
                        bestFt := ft
    if nFlag > 0
        fnl.set(k * FN, fnl.get(k * FN) + nFlag)
        if bestK < 0
            f_fb(k, 5)
    if bestK >= 0
        bool blocked = inOneActive and (f_openSetup() or asOf < lastResolveAt)
        [wn, ws, we] = f_selectWindow(asOf)
        if blocked
            f_fb(k, 6)
        else if na(ws)
            f_fb(k, 4)
        else
            int b2 = HDR + bestK * ZS
            float cd = snap.get(b2 + 1)
            bool replacing = c.state != 0
            f_ctxClear(c)
            c.state := 1
            c.dir := cd > 0 ? -1 : 1
            c.top := snap.get(b2 + 2)
            c.bottom := snap.get(b2 + 3)
            c.formTime := int(snap.get(b2))
            c.confAsOf := asOf
            c.procTime := time_close
            c.invPx := cCl
            c.zid := c.tfTxt + "|" + str.tostring(c.formTime) + "|" + str.tostring(cd > 0 ? 1 : -1)
            c.winId := wn + "|" + str.tostring(ws)
            c.winName := wn
            c.winStart := ws
            c.winEnd := we
            c.retestBar := -1
            c.away := 0
            c.legExt := na
            c.retestPx := na
            c.lastReason := ""
            f_fn(k, 1)
            if replacing
                f_fb(k, 0)
            f_log("ctx created " + c.tfTxt + " " + (c.dir > 0 ? "long" : "short") + " " + c.winId)
    true

f_ctxSync(int k, array<float> snap, int asOf, float cCl) =>
    int ix = IX_CTX + k
    if not na(snap) and not na(asOf) and not na(cCl)
        srcSeen.set(ix, true)
        if asOf > lastAsOf.get(ix) and not srcBad.get(ix)
            lastAsOf.set(ix, asOf)
            if firstTime <= asOf
                if not na(prevCloseT) and prevCloseT > asOf
                    srcBad.set(ix, true)
                    warnArr.push(cxs.get(k).tfTxt + " context source disabled: chart candles do not align with its boundaries")
                    f_ctxClear(cxs.get(k))
                else
                    srcInit.set(ix, true)
                    srcTrunc.set(ix, snap.get(0) == 1.0)
                    srcReady.set(ix, snap.get(1) > 0.0)
                    if srcReady.get(ix)
                        f_ctxUpdate(k, snap, asOf, cCl)
    true

// Trigger candidates = 30s gaps inverted on THIS bar in this context's direction whose formation candle opened at/after the
// context's inversion confirmation and that intersect THIS context gap (closed interval). Newest formation first; then larger
// width; then later array order (ids are timestamp-derived and unique per bar, so that final tie-break cannot occur).
f_pickTrigger(Ctx c) =>
    Zone best = na
    int n = pend.size()
    if n > 0
        int need = c.dir > 0 ? ST_BULL_IFVG : ST_BEAR_IFVG
        for i = 0 to n - 1
            Zone z = pend.get(i)
            if z.state == need and z.formTime >= c.confAsOf and f_overlap(z.top, z.bottom, c.bottom, c.top)
                bool take = false
                if na(best)
                    take := true
                else
                    take := z.formTime > best.formTime or (z.formTime == best.formTime and z.width >= best.width)
                if take
                    best := z
    best

f_decisive(Zone t, bool bull, float atrP) =>
    bool ok = true
    string why = ""
    float bodyAtr = na
    bool strong = inPreset == "Strong"
    float mB = strong ? 1.0 : 0.8
    float mR = strong ? 0.70 : 0.65
    float fr = strong ? 0.15 : 0.20
    float rng = high - low
    float body = close - open
    if na(atrP) or atrP <= 0
        ok := false
        why := "Decisive candle: previous ATR unavailable"
    else if rng <= 0
        ok := false
        why := "Decisive candle: zero-range candle"
    else
        float ab = math.abs(body)
        bodyAtr := ab / atrP
        bool dirOk = bull ? body > 0 : body < 0
        if not dirOk
            ok := false
            why := f_addWhy(why, "Weak/wrong inversion: body points against the setup")
        if ab < mB * atrP - 0.000000001
            ok := false
            why := f_addWhy(why, "Weak inversion: body " + str.tostring(bodyAtr, "#.00") + " x ATR < " + str.tostring(mB, "#.0"))
        if ab / rng < mR - 0.000000001
            ok := false
            why := f_addWhy(why, "Weak inversion: body/range " + str.tostring(ab / rng, "#.00") + " < " + str.tostring(mR, "#.00"))
        bool posOk = bull ? close >= high - fr * rng - 0.000000001 : close <= low + fr * rng + 0.000000001
        if not posOk
            ok := false
            why := f_addWhy(why, "Weak inversion: close not in the outer " + str.tostring(fr * 100, "#") + "% of the range")
        float ext = math.max(syminfo.mintick, 0.10 * atrP)
        float got = bull ? close - t.top : t.bottom - close
        if got < ext - 0.000000001
            ok := false
            why := f_addWhy(why, "Weak inversion: close extends only " + str.tostring(got / syminfo.mintick, "#.0") + " ticks beyond the trigger gap")
    [ok, why, bodyAtr]

f_dbg(string txt) =>
    if inDebug
        dbgLbls.push(label.new(bar_index, high, "x " + txt, style = label.style_label_down, size = size.tiny, textcolor = color.gray, color = color.new(color.gray, 90)))
        while dbgLbls.size() > 30
            label.delete(dbgLbls.shift())
    true

// Entry decision, taken ONCE for this trigger. Rejection keeps the context pending and is never revisited.
// Evaluate ONE pending context (with its own trigger and its own retest-leg stop) through every gate, in order:
// 1 impulse, 2 structural stop / risk, 3 clear path (HTF gaps + coverage + 3m swing room), 4 admission (window instance,
// session limit, unresolved setup, bias). The FIRST failed gate is recorded once. Pure: touches no global state.
f_evalCand(Ctx c, Zone t) =>
    Cand r = Cand.new(k = c.k, trg = t)
    bool bull = c.dir > 0
    float atrP = chartAtr[1]
    [decOk, decWhy, bodyAtr] = f_decisive(t, bull, atrP)
    r.bodyAtr := bodyAtr
    if not decOk
        r.fail := 7
        r.why := decWhy
    else
        r.stage := 1
        float legX = c.legExt
        int bufT = na(atrP) ? 1 : math.max(1, int(math.ceil(0.10 * atrP / syminfo.mintick - 0.000001)))
        int eT = f_tk(close)
        int sT = 0
        int rT = 0
        float entry = eT * syminfo.mintick
        float stop = na
        float target = na
        string stopWhy = ""
        if na(legX)
            stopWhy := "No retest-leg extreme recorded"
        else
            sT := bull ? int(math.floor(legX / syminfo.mintick + 0.000001)) - bufT : int(math.ceil(legX / syminfo.mintick - 0.000001)) + bufT
            rT := bull ? eT - sT : sT - eT
            stop := sT * syminfo.mintick
            if rT >= 1
                int tT = bull ? eT + rT : eT - rT
                target := tT * syminfo.mintick
            else
                stopWhy := "Invalid risk (stop not beyond entry)"
        if stopWhy != ""
            r.fail := 8
            r.why := stopWhy
        else
            r.stage := 2
            r.entry := entry
            r.stop := stop
            r.target := target
            r.legX := legX
            r.legT := c.legExtT
            r.riskT := rT
            r.bufT := bufT
            [cov, srcTxt, covWhy] = f_coverage()
            r.srcTxt := srcTxt
            int pathFail = -1
            string pathWhy = ""
            if cov != 0
                pathFail := 9
                pathWhy := cov == 2 ? "No applicable HTF source" : "HTF coverage unknown (" + covWhy + ")"
            else
                float lo = bull ? entry : target
                float hi = bull ? target : entry
                [obs, obsName] = f_scanAll(bull, lo, hi)
                if obs > 0
                    pathFail := 10
                    pathWhy := "Blocked: " + obsName + "."
                else if not f_lvlReady()
                    pathFail := 9
                    pathWhy := "3m structure coverage unknown (" + f_lvlWhy() + ")"
                else
                    [stBlk, stNear] = f_structCheck(bull, f_tk(target))
                    if not na(stNear)
                        r.nearTxt := str.tostring(stNear, format.mintick) + (bull ? " (3m swing high)" : " (3m swing low)")
                    if stBlk
                        pathFail := 10
                        pathWhy := "Blocked: 3m swing " + (bull ? "high " : "low ") + str.tostring(stNear, format.mintick) + " leaves less than one tick beyond the 1R target."
            if pathFail >= 0
                r.fail := pathFail
                r.why := pathWhy
            else
                r.stage := 3
                [wn, ws, we] = f_selectWindow(time_close)
                if na(ws) or wn + "|" + str.tostring(ws) != c.winId
                    r.fail := 11
                    r.why := "Entry outside the originating window instance"
                else if f_winCount(c.winId) >= inMaxEntries
                    r.fail := 12
                    r.why := "Window entry limit reached"
                else if inOneActive and f_openSetup()
                    r.fail := 13
                    r.why := "Another setup is unresolved"
                else if biasDir != c.dir
                    r.fail := 14
                    r.why := "15m bias does not agree"
                else
                    r.stage := 4
                    r.ok := true
    r

// Create the ONE entry from the chosen candidate. All levels are frozen on the record; both gaps are copied into it.
f_enter(Cand r, Ctx c) =>
    bool bull = c.dir > 0
    Zone t = r.trg
    string sid = str.format_time(time_close, "yyyyMMdd-HHmmss", TZ_NY) + (bull ? "-L" : "-S")
    int dk = f_dateKey(time_close)
    string dirW = bull ? "LONG" : "SHORT"
    string tip = "Setup " + sid + " " + dirW + " · " + c.winName + " · context " + c.tfTxt + "\n" + "15m bias: " + (bull ? "bullish (close above swing high " : "bearish (close below swing low ") + str.tostring(blR, format.mintick) + ", pivot " + f_nyT(int(btR)) + " NY, break confirmed " + f_nyT(int(baR)) + " NY)\n" + c.tfTxt + " inversion confirmed: " + f_nyT(c.confAsOf) + " NY\n" + "Chart first processed it: " + f_nyT(c.procTime) + " NY\n" + "Retest candle: " + f_nyT(c.retestTime) + " NY\n" + "30s trigger confirmed: " + f_nyT(time_close) + " NY\n" + "Impulse " + inPreset + ": body " + str.tostring(r.bodyAtr, "#.00") + " x prev ATR\n" + "Stop anchor (" + c.tfTxt + " retest leg): " + str.tostring(r.legX, format.mintick) + " @ " + f_nyT(r.legT) + " NY (+" + str.tostring(r.bufT) + " tick buffer)\n" + "Risk: " + str.tostring(r.riskT) + " ticks (1:1)\n" + "HTF sources checked: " + r.srcTxt + "\n" + "Nearest 3m structural obstacle: " + r.nearTxt
    Setup s = Setup.new(id = sid, dateKey = dk, dir = c.dir, entry = r.entry, stop = r.stop, target = r.target, riskT = r.riskT, entryTime = time_close, entryBar = bar_index, winId = c.winId, winName = c.winName, ctxZid = c.zid, srcs = r.srcTxt, ctxTop = c.top, ctxBot = c.bottom, ctxFormT = c.formTime - 2 * c.tfSecs * 1000, trgTop = t.top, trgBot = t.bottom, trgFormT = t.formTime - 2 * chartMs, legExt = r.legX, stopAnchorT = r.legT, retestT = c.retestTime, retestPx = c.retestPx, ctxTf = c.tfTxt, ctxId = c.zid, ctxConfT = c.confAsOf, ctxInvT = c.confAsOf - c.tfSecs * 1000, ctxInvPx = c.invPx, trgId = t.id, trgInvT = time, trgInvPx = close, tip = tip)
    setups.push(s)
    f_winInc(c.winId)
    int dxi = f_dateIdx(dk)
    if dxi >= 0
        dSetN.set(dxi, dSetN.get(dxi) + 1)
    f_evInc(bull ? 9 : 10, "")
    if alEntry
        aMsgs.push("H Ticks ENTRY " + dirW + " " + syminfo.ticker + " " + timeframe.period + " | ID " + sid + " | Context " + c.tfTxt + " | Entry " + str.tostring(r.entry, format.mintick) + " | Stop " + str.tostring(r.stop, format.mintick) + " | Target 1R " + str.tostring(r.target, format.mintick) + " | Risk " + str.tostring(r.riskT) + " ticks | Session " + c.winName + " | HTF obstacles checked: " + r.srcTxt)
    f_log("ENTRY " + dirW + " " + c.tfTxt + " E=" + str.tostring(r.entry) + " S=" + str.tostring(r.stop) + " T=" + str.tostring(r.target) + " rT=" + str.tostring(r.riskT))
    true

f_trackSetups() =>
    int rt = 0
    int n = setups.size()
    if n > 0
        int oTk = f_tk(open)
        int hTk = f_tk(high)
        int lTk = f_tk(low)
        for i = 0 to n - 1
            Setup s = setups.get(i)
            if s.state == 0 and bar_index > s.entryBar
                int sTk = f_tk(s.stop)
                int tTk = f_tk(s.target)
                int res = 0
                if s.dir > 0
                    if oTk >= tTk
                        res := 1
                    else if oTk <= sTk
                        res := 2
                    else
                        bool th = hTk >= tTk
                        bool sh = lTk <= sTk
                        res := th and sh ? 3 : (th ? 1 : (sh ? 2 : 0))
                else
                    if oTk <= tTk
                        res := 1
                    else if oTk >= sTk
                        res := 2
                    else
                        bool th = lTk <= tTk
                        bool sh = hTk >= sTk
                        res := th and sh ? 3 : (th ? 1 : (sh ? 2 : 0))
                if res != 0
                    s.state := res
                    s.resolveTime := time_close
                    rt := time_close
                    f_evInc(res == 1 ? 7 : (res == 2 ? 8 : 11), "")
                    bool want = res == 1 ? alTarget : (res == 2 ? alStop : alAmb)
                    if want
                        string what = res == 1 ? "TARGET HIT" : (res == 2 ? "STOP HIT" : "AMBIGUOUS (target and stop both reachable within one candle)")
                        aMsgs.push("H Ticks " + what + " | ID " + s.id + " | " + (s.dir > 0 ? "LONG" : "SHORT") + " " + syminfo.ticker + " | Session " + s.winName + " | Entry " + str.tostring(s.entry, format.mintick) + " Stop " + str.tostring(s.stop, format.mintick) + " Target " + str.tostring(s.target, format.mintick))
                    f_log("resolved " + s.id + " state=" + str.tostring(res))
    rt

// ═════════════════════════════ MAIN: confirmed-bar processing ═════════════════════════════════
if supported and barstate.isfirst
    if en1 and sec1 > chartSecs and not al1
        warnArr.push(f_tfText(sec1) + " obstacle source disabled: not an integer multiple of the chart timeframe")
    if en2 and sec2 > chartSecs and not al2
        warnArr.push(f_tfText(sec2) + " obstacle source disabled: not an integer multiple of the chart timeframe")
    if en3 and sec3 > chartSecs and not al3
        warnArr.push(f_tfText(sec3) + " obstacle source disabled: not an integer multiple of the chart timeframe")
    if en4 and sec4 > chartSecs and not al4
        warnArr.push(f_tfText(sec4) + " obstacle source disabled: not an integer multiple of the chart timeframe")
    if inWinAsia and not okWinAs
        warnArr.push("Entry window A disabled: start equals end")
    if inWinAm and not okWinAm
        warnArr.push("Entry window B disabled: start equals end")
    if inWinPm and not okWinPm
        warnArr.push("Entry window C disabled: start equals end")

bool drawNow = supported and barstate.isconfirmed and (barstate.islast or barstate.islastconfirmedhistory or barstate.isrealtime)

if supported and barstate.isconfirmed
    f_resetEv()
    aMsgs.clear()
    pend.clear()
    lastConfClose := time_close
    refPrice := close
    needPrune := false
    // reporting calendar: NY date of this confirmed bar's close (entry dates use the same basis)
    int dkNow = f_dateKey(time_close)
    if dKey.size() == 0 or dKey.last() != dkNow
        dKey.push(dkNow)
        dDow.push(dayofweek(time_close, TZ_NY))
        dWinN.push(0)
        dWinBad.push(0)
        dSetN.push(0)
        if na(firstDateKey)
            firstDateKey := dkNow
        while dKey.size() > 14
            dKey.shift()
            dDow.shift()
            dWinN.shift()
            dWinBad.shift()
            dSetN.shift()
        needPrune := true

    // 1) mechanical 30s gap lifecycle (unchanged rules). Inversions this bar become trigger candidates.
    int nc = chartZ.size()
    if nc > 0
        for i = nc - 1 to 0
            Zone z = chartZ.get(i)
            int r = f_stepChart(z, high, low, close, bar_index, time, time_close)
            if r == 1
                pend.push(z)
            else if r >= 2
                f_destroy(z)
                chartZ.remove(i)
            else if bar_index - z.formBar >= inChWin
                f_destroy(z)
                chartZ.remove(i)

    // 2) new 30s gap confirmed by THIS closed bar (candle 3)
    if bar_index >= 2 and not na(h2c) and not na(l2c)
        int bullGap = f_tk(low) - f_tk(h2c)
        int bearGap = f_tk(l2c) - f_tk(high)
        int dirN = bullGap >= inMinTick ? 1 : (bearGap >= inMinTick ? -1 : 0)
        if dirN != 0
            float zt = dirN > 0 ? low : l2c
            float zb = dirN > 0 ? h2c : high
            Zone nz = Zone.new(id = syminfo.tickerid + "|" + timeframe.period + "|" + str.tostring(time) + "|" + str.tostring(dirN), dir = dirN, state = dirN > 0 ? ST_BULL_FVG : ST_BEAR_FVG, top = zt, bottom = zb, formTime = time, confTime = time_close, availTime = time_close, width = zt - zb, fatr = chartAtr, formBar = bar_index)
            chartZ.push(nz)
    while chartZ.size() > inChCap
        Zone old = chartZ.shift()
        f_destroy(old)

    // 3) obstacle sources: confirmed source inversions / taps are applied BEFORE any entry decision
    if act1
        f_sync(hz1, 0, f_tfText(sec1), snap1, asOf1)
    if act2
        f_sync(hz2, 1, f_tfText(sec2), snap2, asOf2)
    if act3
        f_sync(hz3, 2, f_tfText(sec3), snap3, asOf3)
    if act4
        f_sync(hz4, 3, f_tfText(sec4), snap4, asOf4)
    f_tapStore(hz1)
    f_tapStore(hz2)
    f_tapStore(hz3)
    f_tapStore(hz4)

    // 4) outcome tracking of entered setups (resolution must precede context ingestion)
    int rt = f_trackSetups()
    if rt > 0
        lastResolveAt := rt
        needPrune := true

    // 5) contexts: expiry, 15m-bias cancellation, then each timeframe's newly available confirmed source data (own cancel / create)
    f_ctxExpire()
    if biasDir != 0
        for k = 0 to NCTX - 1
            Ctx cb = cxs.get(k)
            if cb.state != 0 and biasDir != cb.dir
                cb.lastReason := "15m bias reversed against the pending " + cb.tfTxt + " context"
                f_fb(k, 3)
                f_ctxClear(cb)
    if actC0
        f_ctxSync(0, snapC0, asOfC0, clsC0)
    if actC1
        f_ctxSync(1, snapC1, asOfC1, clsC1)
    if actC2
        f_ctxSync(2, snapC2, asOfC2, clsC2)
    if actC3
        f_ctxSync(3, snapC3, asOfC3, clsC3)
    if actL
        f_lvlSync(snapL, asOfL)
    f_lvlConsume()
    // qualification coverage of THIS bar: every active context source ready, 3m structure ready AND every applicable obstacle
    // source complete. Counted per NY date, only for bars inside an enabled entry window.
    [cvQ, txQ, whQ] = f_coverage()
    bool qualOk = f_ctxReadyAll() and f_lvlReady() and cvQ == 0
    if qualOk and na(covStart)
        covStart := time_close
    [wnQ, wsQ, weQ] = f_selectWindow(time_close)
    if not na(wsQ)
        int dq = dKey.size() - 1
        dWinN.set(dq, dWinN.get(dq) + 1)
        if not qualOk
            dWinBad.set(dq, dWinBad.get(dq) + 1)
    // every pending context that already retested is evaluated INDEPENDENTLY on this bar (own trigger, own retest leg)
    array<Cand> cands = array.new<Cand>()
    for k = 0 to NCTX - 1
        Ctx cc = cxs.get(k)
        if cc.state == 2 and cc.retestBar < bar_index
            // retest-leg extreme of THIS context runs from its first retest candle THROUGH this (possible entry) candle
            if cc.dir > 0 and low < cc.legExt
                cc.legExt := low
                cc.legExtT := time
            if cc.dir < 0 and high > cc.legExt
                cc.legExt := high
                cc.legExtT := time
            Zone trg = f_pickTrigger(cc)
            if not na(trg)
                Cand rc = f_evalCand(cc, trg)
                f_fn(k, 3)
                if rc.stage >= 1
                    f_fn(k, 4)
                if rc.stage >= 2
                    f_fn(k, 5)
                if rc.stage >= 3
                    f_fn(k, 6)
                if rc.fail >= 7
                    f_fb(k, rc.fail)
                if not rc.ok
                    cc.lastReason := rc.why
                    f_dbg(cc.tfTxt + ": " + rc.why)
                    f_log("trigger rejected " + cc.tfTxt + ": " + rc.why)
                cands.push(rc)
    // choose among PASSING candidates only: 5m > 3m > 2m > 1m (tie-break, not a confirmation requirement)
    Cand pick = na
    if cands.size() > 0
        for pk = 0 to NCTX - 1
            int want = NCTX - 1 - pk
            for ci = 0 to cands.size() - 1
                Cand qc = cands.get(ci)
                if na(pick) and qc.ok and qc.k == want
                    pick := qc
    if not na(pick)
        Ctx cp = cxs.get(pick.k)
        if not f_setupExists(pick.trg.id, cp.zid)
            f_enter(pick, cp)
            f_fn(pick.k, 7)
            for ci = 0 to cands.size() - 1
                Cand qo = cands.get(ci)
                if qo.ok and qo.k != pick.k
                    f_fb(qo.k, 15)
            f_ctxClearAll()
            needPrune := true
    // retests are evaluated AFTER the trigger step so a candle that both first retests and inverts a gap can never trigger
    for k = 0 to NCTX - 1
        Ctx cr = cxs.get(k)
        if cr.state == 1 and time >= cr.confAsOf
            bool touch = f_overlap(high, low, cr.bottom, cr.top)
            if touch and cr.away >= inDeparture
                cr.state := 2
                cr.retestBar := bar_index
                cr.retestTime := time
                cr.legExt := cr.dir > 0 ? low : high
                cr.legExtT := time
                cr.retestPx := cr.legExt
                f_fn(k, 2)
                f_log("retest " + cr.tfTxt + " bar " + str.tostring(bar_index))
            else
                int aw = cr.dir > 0 ? f_tk(high) - f_tk(cr.top) : f_tk(cr.bottom) - f_tk(low)
                if aw > cr.away
                    cr.away := aw

    if needPrune
        f_pruneSetups()

    // 6) drawings follow the committed state
    if drawNow
        f_drawAll()

var table warnTbl = table.new(position.top_right, 1, 1, border_width = 1, border_color = color.gray)
var table stTbl = table.new(position.bottom_right, 6, 9, border_width = 1, border_color = color.gray)
var table staTbl = table.new(position.top_left, 1, 4, border_width = 1, border_color = color.gray)
var table fnTbl = table.new(position.bottom_left, 9, 11, border_width = 1, border_color = color.gray)
f_cell(table t, int c, int r, string txt, color bg, color tc, string al) =>
    table.cell(t, c, r, txt, text_color = tc, text_size = size.normal, text_halign = al == "l" ? text.align_left : text.align_center, bgcolor = bg)
    true

f_blockTxt(int k) =>
    string[] nm = array.from("replaced", "expired", "closed through", "bias flip", "inv: no window", "inv: bias/narrow", "inv: unresolved block", "impulse fail", "stop/risk fail", "coverage unknown", "obstacle", "window instance", "session limit", "unresolved setup", "bias at entry", "outranked")
    string r = ""
    for j = 0 to FB - 1
        int v = fnb.get(k * FB + j)
        if v > 0
            r += (r == "" ? "" : " | ") + nm.get(j) + " " + str.tostring(v)
    cxs.get(k).tfTxt + ": " + (r == "" ? "none" : r)

if barstate.islast
    string w = supported ? array.join(warnArr, "\n") : "Switch to a standard 30-second chart"
    if supported
        string wx = ""
        wx := f_addWhy(wx, f_ctxWhy())
        wx := f_addWhy(wx, f_lvlWhy())
        wx := f_addWhy(wx, f_slotWhy(en1, ok1, act1, 0, f_tfText(sec1)))
        wx := f_addWhy(wx, f_slotWhy(en2, ok2, act2, 1, f_tfText(sec2)))
        wx := f_addWhy(wx, f_slotWhy(en3, ok3, act3, 2, f_tfText(sec3)))
        wx := f_addWhy(wx, f_slotWhy(en4, ok4, act4, 3, f_tfText(sec4)))
        if setups.size() > DRAW_MAX
            wx := f_addWhy(wx, "Drawings limited to " + str.tostring(DRAW_MAX) + " setups (unresolved first, then newest); records and statistics are unaffected")
        w += wx == "" ? "" : (w == "" ? "" : "\n") + str.replace_all(wx, "; ", "\n")
    if w == ""
        table.cell(warnTbl, 0, 0, "", bgcolor = na)
    else
        f_cell(warnTbl, 0, 0, w, cWarnBg, color.white, "l")
    if supported and inStatus
        string a1 = "Contexts: "
        for k = 0 to NCTX - 1
            Ctx cs = cxs.get(k)
            string st1 = not actCtxA.get(k) ? "off" : (cs.state == 0 ? "none" : (cs.dir > 0 ? "LONG " : "SHORT ") + (cs.state == 1 ? "awaiting retest" : "awaiting trigger"))
            a1 += cs.tfTxt + " " + st1 + (k < NCTX - 1 ? " | " : "")
        string a2 = (f_openSetup() ? "Setup OPEN" : "No open setup") + " | entries are counted per window instance (max " + str.tostring(inMaxEntries) + ")"
        [cvS, txS, whS] = f_coverage()
        bool qS = f_ctxReadyAll() and f_lvlReady() and cvS == 0
        string a3 = qS ? "Qualification coverage: complete (" + txS + ")" + (na(covStart) ? "" : " since " + str.format_time(covStart, "MM-dd HH:mm", TZ_NY) + " NY") : "Qualification coverage: INCOMPLETE - entries blocked" + (na(covStart) ? " (not yet established)" : " (complete earlier since " + str.format_time(covStart, "MM-dd HH:mm", TZ_NY) + " NY)")
        string a4 = biasDir == 0 ? "15m bias: UNKNOWN (no qualifying break yet) - no contexts" : "15m bias: " + (biasDir > 0 ? "BULLISH" : "BEARISH") + " - " + (biasDir > 0 ? "close above swing high " : "close below swing low ") + str.tostring(blR, format.mintick) + " (pivot " + f_nyT(int(btR)) + " NY)"
        f_cell(staTbl, 0, 0, a1, cRowBg, cRowTx, "l")
        f_cell(staTbl, 0, 1, a2, cRowBg, cRowTx, "l")
        f_cell(staTbl, 0, 2, a3, qS ? cRowBg : cWarnBg, qS ? cRowTx : color.white, "l")
        f_cell(staTbl, 0, 3, a4, biasDir == 0 ? cWarnBg : cRowBg, biasDir == 0 ? color.white : cRowTx, "l")
    if supported and inStats
        array<int> rd = f_reportDates()
        int nr = rd.size()
        string[] hd = array.from("Date (NY)", "Setups", "Wins", "Losses", "Open", "Ambiguous")
        for c = 0 to 5
            f_cell(stTbl, c, 0, hd.get(c), cHdrBg, cHdrTx, c == 0 ? "l" : "c")
        int tW = 0
        int tL = 0
        int tO = 0
        int tA = 0
        bool anyP = false
        bool anyU = false
        for r = 0 to REP_DATES - 1
            if r < nr
                int k = rd.get(r)
                int di = f_dateIdx(k)
                int stx = di >= 0 ? f_dateStatus(di) : 1
                int cW = f_dateCount(k, 1)
                int cL = f_dateCount(k, 2)
                int cO = f_dateCount(k, 0)
                int cA = f_dateCount(k, 3)
                if stx == 1
                    anyP := true
                if stx == 2
                    anyU := true
                tW += cW
                tL += cL
                tO += cO
                tA += cA
                string dt = f_dateTxt(k) + (stx == 1 ? " †" : (stx == 2 ? " ‡" : ""))
                f_cell(stTbl, 0, r + 1, dt, cRowBg, cRowTx, "l")
                f_cell(stTbl, 1, r + 1, stx == 2 ? "n/a" : str.tostring(cW + cL + cO + cA), cRowBg, cRowTx, "c")
                f_cell(stTbl, 2, r + 1, stx == 2 ? "n/a" : str.tostring(cW), cRowBg, cRowTx, "c")
                f_cell(stTbl, 3, r + 1, stx == 2 ? "n/a" : str.tostring(cL), cRowBg, cRowTx, "c")
                f_cell(stTbl, 4, r + 1, stx == 2 ? "n/a" : str.tostring(cO), cRowBg, cRowTx, "c")
                f_cell(stTbl, 5, r + 1, stx == 2 ? "n/a" : str.tostring(cA), cRowBg, cRowTx, "c")
            else
                for c = 0 to 5
                    f_cell(stTbl, c, r + 1, c == 0 ? "-" : "", cRowBg, cRowTx, c == 0 ? "l" : "c")
        f_cell(stTbl, 0, 6, "Total", cTotBg, cRowTx, "l")
        f_cell(stTbl, 1, 6, str.tostring(tW + tL + tO + tA), cTotBg, cRowTx, "c")
        f_cell(stTbl, 2, 6, str.tostring(tW), cTotBg, cRowTx, "c")
        f_cell(stTbl, 3, 6, str.tostring(tL), cTotBg, cRowTx, "c")
        f_cell(stTbl, 4, 6, str.tostring(tO), cTotBg, cRowTx, "c")
        f_cell(stTbl, 5, 6, str.tostring(tA), cTotBg, cRowTx, "c")
        int oldOpen = 0
        if nr > 0 and setups.size() > 0
            for i = 0 to setups.size() - 1
                Setup so = setups.get(i)
                if so.state == 0 and so.dateKey < rd.first()
                    oldOpen += 1
        string wr = (tW + tL) > 0 ? "Resolved win rate = Wins / (Wins + Losses) = " + str.tostring(100.0 * tW / (tW + tL), "#") + "% (" + str.tostring(tW) + "/" + str.tostring(tW + tL) + "); Open and Ambiguous excluded" : "Resolved win rate: - (no resolved setups)"
        string notes = ""
        if anyP
            notes += "† partial history: some qualification bars lacked coverage or the chart history begins that date. "
        if anyU
            notes += "‡ unavailable: no qualification coverage on that date. "
        if oldOpen > 0
            notes += str.tostring(oldOpen) + " older unresolved setup(s) retained, not in table. "
        f_cell(stTbl, 0, 7, wr, cRowBg, cRowTx, "l")
        table.merge_cells(stTbl, 0, 7, 5, 7)
        f_cell(stTbl, 0, 8, notes == "" ? "Entry date = New York date of the entry candle close. Outcomes follow the entry date." : notes, cRowBg, cRowTx, "l")
        table.merge_cells(stTbl, 0, 8, 5, 8)
    if supported and inDebug
        string[] fh = array.from("Context", "Inversions", "Admitted", "Retests", "30s inv", "Impulse", "Stop/risk", "Clear path", "Entries")
        for c = 0 to 8
            f_cell(fnTbl, c, 0, fh.get(c), cHdrBg, cHdrTx, c == 0 ? "l" : "c")
        int[] tot = array.new_int(FN, 0)
        for k = 0 to NCTX - 1
            f_cell(fnTbl, 0, k + 1, cxs.get(k).tfTxt + (actCtxA.get(k) ? "" : " (off)"), cRowBg, cRowTx, "l")
            for j = 0 to FN - 1
                int v = fnl.get(k * FN + j)
                tot.set(j, tot.get(j) + v)
                f_cell(fnTbl, j + 1, k + 1, str.tostring(v), cRowBg, cRowTx, "c")
        f_cell(fnTbl, 0, 5, "All", cTotBg, cRowTx, "l")
        for j = 0 to FN - 1
            f_cell(fnTbl, j + 1, 5, str.tostring(tot.get(j)), cTotBg, cRowTx, "c")
        f_cell(fnTbl, 0, 6, "First failed gate / blocks (each candidate counted once)", cHdrBg, cHdrTx, "l")
        table.merge_cells(fnTbl, 0, 6, 8, 6)
        for k = 0 to NCTX - 1
            f_cell(fnTbl, 0, 7 + k, f_blockTxt(k), cRowBg, cRowTx, "l")
            table.merge_cells(fnTbl, 0, 7 + k, 8, 7 + k)
    else
        table.clear(fnTbl, 0, 0, 8, 10)

// ═════════════════════════════════════════ ALERTS ═════════════════════════════════════════════
// Only genuine events on a confirmed REALTIME bar; never from history / bootstrap. Every event of the bar is collected in
// aMsgs while the state machine runs (each event is created once, at its single state transition) and sent as ONE alert().
// Drawing happens independently and can never produce an alert.
bool evNow = supported and barstate.isrealtime and barstate.isconfirmed
if evNow and aMsgs.size() > 0
    alert(array.join(aMsgs, "\n"), alert.freq_once_per_bar_close)
alertcondition(evNow and ev.get(9) > 0, "Long entry (3m ctx -> 30s trigger, 1R)", "H Ticks: LONG entry on {{ticker}} {{interval}}")
alertcondition(evNow and ev.get(10) > 0, "Short entry (3m ctx -> 30s trigger, 1R)", "H Ticks: SHORT entry on {{ticker}} {{interval}}")
alertcondition(evNow and ev.get(7) > 0, "Target hit", "H Ticks: setup TARGET HIT on {{ticker}} {{interval}}")
alertcondition(evNow and ev.get(8) > 0, "Stop hit", "H Ticks: setup STOP HIT on {{ticker}} {{interval}}")
alertcondition(evNow and ev.get(11) > 0, "Ambiguous outcome", "H Ticks: setup AMBIGUOUS on {{ticker}} {{interval}}")
