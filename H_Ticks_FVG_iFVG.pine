type Zone
    string id
    int    src = -1
    string tfTxt = ""
    int    dir
    int    state
    float  top
    float  bottom
    int    formTime
    int    confTime
    int    availTime
    int    formBar = -1
    int    invBar = -1
    int    invTime
    int    invAvail
    bool   tapped = false
    int    tapTime
    int    tapAvail
    int    lastEvt
    float  width
    float  fatr
    bool   seen = false
    bool   endNow = false
    int    cat = -1
    float  dist = 0.0
    bool   vis = false
    box    bx

// The single pending 3-minute context. state: 0 NONE, 1 PENDING_RETEST, 2 WAITING_FOR_30S_TRIGGER.
type Ctx
    int    state = 0
    int    dir
    float  top
    float  bottom
    int    formTime
    int    confAsOf
    int    procTime
    string zid = ""
    string winId = ""
    string winName = ""
    int    winStart
    int    winEnd
    int    retestBar = -1
    int    retestTime
    int    away = 0
    float  legExt = na
    int    legExtT
    float  retestPx = na
    int    cbDir = 0
    float  cbLvl = na
    int    cbLvlT
    string lastReason = ""
    box    bx

// An actual signalled entry. state: 0 OPEN, 1 TARGET_HIT, 2 STOP_HIT, 3 AMBIGUOUS (terminal states never change again).
type Setup
