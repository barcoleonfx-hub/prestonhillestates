var array<int> cxN = array.new_int(6, 0)          // 0 level id, 1 setup id, 2 fvg id, 3 last trading-day key, 4 area id
var array<int> prbS = array.new_int(7, 0)         // prior-range breakout state per aggregated timeframe: 1 up, -1 down, 0 none yet (NOT a CISD)
var array<int> prbT = array.new_int(7, na)        // availability timestamp (completed candle close); na = unavailable
var array<float> pvPx = array.new_float(2, na)    // last confirmed source-timeframe swing: 0 high, 1 low
var array<int> pvOp = array.new_int(2, na)
