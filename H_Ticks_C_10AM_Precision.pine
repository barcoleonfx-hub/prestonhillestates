bool inBias15 = input.bool(false, "Filter: 15m prior-range breakout state must agree", group = G12)
bool inFPo3 = input.bool(false, "Filter: the swept level must be the PO3 range (enable the PO3 level too)", group = G12)
bool inFConf = input.bool(false, "Filter: parent area must overlap another eligible area of a different type", group = G12)
bool inFIfvg = input.bool(false, "Filter: require a confirmed iFVG among the eligible areas", group = G12)
bool inFChop = input.bool(false, "Filter: reject choppy markets (efficiency ratio of recent source candles)", group = G12)
