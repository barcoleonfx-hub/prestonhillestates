// ─────────────────────────────────────────── HELPERS ───────────────────────────────────────────
f_ts(int key, int mins) =>
    timestamp(TZ, int(math.floor(key / 10000.0)), int(math.floor((key % 10000) / 100.0)), key % 100, int(math.floor(mins / 60.0)), mins % 60, 0)

f_hm(int t) =>
    str.format_time(t, "HH:mm", TZ)

f_hms(int t) =>
    str.format_time(t, "HH:mm:ss", TZ)

f_dt(int key) =>
    str.tostring(int(math.floor(key / 10000.0))) + "-" + str.format_time(f_ts(key, 720), "MM-dd", TZ)

f_fn(int slot, int col) =>
    fnl.set(slot * NF + col, fnl.get(slot * NF + col) + 1)
    true

// An event that applies to every simulated model (day-level funnel steps).
f_fnA(int col) =>
    for k = 0 to NS - 1
        if slotOn.get(k)
            f_fn(k, col)
    true

// kind: 0 setup ready, 1 order armed, 2 simulated fill, 3 invalidation / cancellation. Only the selected model alerts.
f_msgK(int kind, int slot, string txt) =>
    if slot == selSlot
        evK.set(kind, evK.get(kind) + 1)
        bool want = (kind == 0 and inAlSetup) or (kind == 1 and inAlArm) or (kind == 2 and inAlFill) or (kind == 3 and inAlInv) or (kind == 4 and inAlExit)
        if want
            aMsgs.push("H Ticks C | " + slotNm.get(slot) + " | " + txt + " | " + syminfo.ticker + " (research model; simulation)")
    true

f_exceeded(Day dy) =>
    dy.dir > 0 ? low < dy.mExt : high > dy.mExt

f_fibLvl(Day dy, float r) =>
    dy.dir < 0 ? dy.oppX + r * (dy.mExt - dy.oppX) : dy.oppX - r * (dy.oppX - dy.mExt)

// ───────────────────────────────────── TRADE BOOKKEEPING ─────────────────────────────────────
// outcome: 1 target, 2 stop, 3 time exit, 4 ambiguous (counted at the stop = conservative).
f_finish(Mdl md, int outcome, float exitPx, int exitTime, string note) =>
    Trade t = md.tr
    float sgn = t.dir > 0 ? 1.0 : -1.0
    float pv = syminfo.pointvalue
    float grossUsd = sgn * (exitPx - t.entryPx) * pv * t.qty
    float slipPer = inSlip * syminfo.mintick * pv * t.qty
    float slipUsd = slipPer * (outcome == 1 ? 1.0 : 2.0)
    float commUsd = inComm * t.qty * 2.0
    float riskUsd = t.riskPts * pv * t.qty
    t.isOpen := false
    t.outcome := outcome
    t.exitPx := exitPx
    t.exitT := exitTime
    t.costUsd := slipUsd + commUsd
    t.netUsd := grossUsd - slipUsd - commUsd
    t.grossR := riskUsd > 0 ? grossUsd / riskUsd : na
    t.netR := riskUsd > 0 ? t.netUsd / riskUsd : na
    t.note := t.note == "" ? note : t.note + " | " + note
    md.st := 4
    md.why := note
    if outcome == 4
        f_fn(md.slot, 10)
    true

// Plan the limit order for one model: stop, risk cap, target, then ARM (eligible from the NEXT candle).
f_plan(Day dy, Mdl md, float entryRaw, float wickX) =>
    bool bull = dy.dir > 0
    float entry = math.round_to_mintick(entryRaw)
    float anchor = (md.slot == 3 and not na(wickX)) ? wickX : dy.mExt
    float stop = bull ? math.round_to_mintick(anchor - inBuf * tk) : math.round_to_mintick(anchor + inBuf * tk)
    int riskT = int(math.round((bull ? entry - stop : stop - entry) / tk))
    int qty = inQty
    if inSizeMode == "Fixed cash risk" and riskT >= 1
        qty := int(math.floor(inCashRisk / (riskT * tk * syminfo.pointvalue)))
    bool armed = false
    if riskT < 1
        md.st := 4
        md.why := "rejected: stop is not beyond the entry"
        f_fn(md.slot, 8)
        f_msgK(3, md.slot, "REJECTED - " + md.why)
    else if riskT > inMaxStop
        md.st := 4
        md.why := "stop-cap rejection: " + str.tostring(riskT) + " ticks > " + str.tostring(inMaxStop)
        f_fn(md.slot, 8)
        f_msgK(3, md.slot, "REJECTED - " + md.why)
    else if qty < 1
        md.st := 4
        md.why := "sizing rejection: one contract risks more than the cash budget"
        f_fn(md.slot, 14)
        f_msgK(3, md.slot, "REJECTED - " + md.why)
    else
        float tgt = na
        if inTgt == "1R"
            tgt := bull ? entry + riskT * tk : entry - riskT * tk
        else if inTgt == "2R"
            tgt := bull ? entry + 2 * riskT * tk : entry - 2 * riskT * tk
        else
            // frozen opposing liquidity: the nearest level strictly beyond the entry on the profit side
            if bull
                float c1 = not na(dy.orH) and dy.orH > entry + tk ? dy.orH : na
                float c2 = not na(dy.pdH) and dy.pdH > entry + tk ? dy.pdH : na
                tgt := na(c1) ? c2 : (na(c2) ? c1 : math.min(c1, c2))
            else
                float c1 = not na(dy.orL) and dy.orL < entry - tk ? dy.orL : na
                float c2 = not na(dy.pdL) and dy.pdL < entry - tk ? dy.pdL : na
                tgt := na(c1) ? c2 : (na(c2) ? c1 : math.max(c1, c2))
        if na(tgt)
            md.st := 4
            md.why := "rejected: no eligible opposing-liquidity target"
            f_fn(md.slot, 11)
            f_msgK(3, md.slot, "REJECTED - " + md.why)
        else
            md.lim := entry
            md.stp := stop
            md.tgt := math.round_to_mintick(tgt)
            md.qty := qty
            md.tgtType := inTgt == "Opposing liquidity" ? "liquidity" : inTgt
            md.plannedR := math.abs(md.tgt - entry) / math.abs(entry - stop)
            md.st := 2
            md.armBar := bar_index
            md.armT := time_close
            f_fn(md.slot, 5)
            armed := true
            f_msgK(1, md.slot, "ORDER ARMED (simulated limit, NOT a fill) " + (bull ? "LONG" : "SHORT") + " limit " + str.tostring(md.lim, format.mintick) + " stop " + str.tostring(md.stp, format.mintick) + " target " + str.tostring(md.tgt, format.mintick) + " risk " + str.tostring(riskT) + " ticks")
    armed

// The model's entry conditions are satisfied on THIS candle's close -> plan and arm.
f_cond(Day dy, Mdl md, float entryRaw, float wickX) =>
    f_fn(md.slot, 4)
    f_plan(dy, md, entryRaw, wickX)

// ───────────────────────────────────── ORDER FILL AND POSITION ─────────────────────────────────────
// Called only on candles strictly AFTER the arming candle and before the entry cutoff.
// Touch / fill / same-candle resolution shared by both variants (candles after the arming candle only).
f_fillTry(Day dy, Mdl md) =>
    bool bull = dy.dir > 0
    float lim = md.lim
    float thrP = inStrict ? tk : 0.0
    bool touch = bull ? low <= lim - thrP : high >= lim + thrP
    if touch
        bool known = bull ? open <= lim - thrP : open >= lim + thrP
        float stp = md.stp
        float tgt = md.tgt
        Trade t = Trade.new(slot = md.slot, dir = dy.dir, dayKey = dy.key, lvl = dy.O, entryPx = lim, stopPx = stp, tgtPx = tgt, riskPts = math.abs(lim - stp), armT = md.armT, fillT = time, qty = md.qty, plannedR = md.plannedR, tgtType = md.tgtType, riskUsd = math.abs(lim - stp) * syminfo.pointvalue * md.qty, note = md.slot == 4 ? md.trigNm + " | plan " + str.tostring(md.plannedR, "#.0") + "R " + md.tgtType : "")
        md.tr := t
        md.st := 3
        trades.push(t)
        f_fn(md.slot, 6)
        f_msgK(2, md.slot, "SIMULATED FILL (limit touch assumed) " + (bull ? "LONG" : "SHORT") + " at " + str.tostring(lim, format.mintick) + " stop " + str.tostring(stp, format.mintick) + " target " + str.tostring(tgt, format.mintick))
        bool stopHit = bull ? low <= stp : high >= stp
        bool tgtTouch = bull ? high >= tgt : low <= tgt
        float adv = bull ? lim - low : high - lim
        float fav = bull ? high - lim : lim - low
        t.maeP := math.max(0.0, adv)
        if known
            t.mfeP := math.max(0.0, fav)
        else
            t.mfeP := 0.0
            t.excUnc := fav > 0
            t.entryAmb := tgtTouch or fav > 0
        bool gapStop = bull ? open <= stp : open >= stp
        if gapStop
            // EXECUTION POLICY (gap through entry AND stop): the resting limit was active, so it is NOT assumed cancelled. It is assumed filled at the
            // limit price (no price improvement) and stopped at the open (adverse gap). The real fill/exit prices cannot be known from OHLC, so the trade
            // is flagged ambiguous (counted as a loss at the worse of the two bounds) and counted separately as a gap event.
            t.gap := true
            t.maeP := math.max(t.maeP, bull ? lim - open : open - lim)
            t.excUnc := true
            f_finish(md, 4, open, time, "gap through entry AND stop: resting limit assumed filled at the limit, stopped at the open (conservative, ambiguous)")
        else if stopHit and tgtTouch
            t.maeP := math.max(t.maeP, t.riskPts)
            t.excUnc := true
            f_finish(md, 4, stp, time, "ambiguous: stop and target both reachable on the fill candle")
        else if stopHit
            t.maeP := math.max(t.maeP, t.riskPts)
            f_finish(md, 2, stp, time, "stop hit on the fill candle")
        else if known and tgtTouch
            t.mfeP := math.max(t.mfeP, math.abs(tgt - lim))
            f_finish(md, 1, tgt, time, "target hit on the fill candle (fill at the open)")
    true

f_fillStep(Day dy, Mdl md) =>
    // A resting limit is never assumed cancelled before a gap: a candle that opens beyond the manipulation extreme goes through the shared fill logic
    // (touch -> fill; open beyond the stop -> flagged gap event). Earlier versions silently invalidated such orders (optimistic).
    f_fillTry(dy, md)
    true

// Called on candles after the fill candle while the position is open.
f_posStep(Day dy, Mdl md) =>
    Trade t = md.tr
    bool bull = t.dir > 0
    float stp = md.stp
    float tgt = md.tgt
    float ent = t.entryPx
    bool gStop = bull ? open <= stp : open >= stp
    bool gTgt = bull ? open >= tgt : open <= tgt
    bool stopHit = bull ? low <= stp : high >= stp
    bool tgtHit = bull ? high >= tgt : low <= tgt
    float adv = bull ? ent - low : high - ent
    float fav = bull ? high - ent : ent - low
    float pMae = t.maeP
    float pMfe = t.mfeP
    float tgtD = math.abs(tgt - ent)
    if gStop
        t.maeP := math.max(pMae, bull ? ent - open : open - ent)
        f_finish(md, 2, open, time, "gap through the stop: exit at the open")
    else if gTgt
        t.mfeP := math.max(pMfe, tgtD)
        f_finish(md, 1, tgt, time, "gap through the target: filled at the target (no improvement)")
    else if stopHit and tgtHit
        t.maeP := math.max(pMae, t.riskPts)
        t.mfeP := math.max(pMfe, fav)
        t.excUnc := true
        f_finish(md, 4, stp, time, "ambiguous: stop and target both reachable on one candle")
    else if stopHit
        t.maeP := math.max(pMae, t.riskPts)
        t.excUnc := t.excUnc or fav > pMfe
        f_finish(md, 2, stp, time, "stop hit")
    else if tgtHit
        t.mfeP := math.max(pMfe, tgtD)
        t.maeP := math.max(pMae, adv)
        t.excUnc := t.excUnc or adv > pMae
        f_finish(md, 1, tgt, time, "target hit")
    else
        t.maeP := math.max(pMae, adv)
        t.mfeP := math.max(pMfe, fav)
    true

// ───────────────────────────────────── PER-MODEL WAITING RULES ─────────────────────────────────────
f_invalidate(Mdl md, string why) =>
    md.st := 4
    md.why := why
    f_fn(md.slot, 9)
    f_msgK(3, md.slot, "INVALIDATED - " + why)
    true

// Model B: the frozen gap must be inverted by a confirmed close (a wick through is not an inversion).
f_waitB(Day dy, Mdl md) =>
    bool bull = dy.dir > 0
    if f_exceeded(dy)
        f_invalidate(md, "price exceeded the frozen manipulation extreme before the iFVG confirmation")
    else if (bull ? close > md.fT : close < md.fB)
        md.fInv := true
        f_cond(dy, md, dy.O, na)
    true

// Model C: arms from the (shared) first rejection candle.
f_waitC(Day dy, Mdl md) =>
    if f_exceeded(dy)
        f_invalidate(md, "price exceeded the frozen manipulation extreme before a rejection candle")
    else if dy.rejOk
        f_cond(dy, md, dy.rejEntry, md.slot == 3 ? (dy.dir > 0 ? dy.rejLo : dy.rejHi) : na)
    true

// The first qualifying rejection candle after the reversal confirmation (shared by both C columns); frozen once found.
f_cReject(Day dy) =>
    if dy.fibOk and not dy.rejOk and bar_index > dy.confBar and mOpen < cutT and not na(dy.O)
        bool bull = dy.dir > 0
        bool inFrame = bull ? low >= dy.mExt : high <= dy.mExt
        bool zone = low <= dy.fibHi and high >= dy.fibLo
        if bull
            bool wick = low < math.min(open, close)
            if inFrame and zone and wick and low <= dy.O and close > dy.O
                dy.rejOk := true
                dy.rejT := time
                dy.rejHi := high
                dy.rejLo := low
                dy.rejBase := math.min(open, close)
                dy.rejEntry := (low + math.min(open, close)) / 2.0
        else
            bool wick = high > math.max(open, close)
            if inFrame and zone and wick and high >= dy.O and close < dy.O
                dy.rejOk := true
                dy.rejT := time
                dy.rejHi := high
                dy.rejLo := low
                dy.rejBase := math.max(open, close)
                dy.rejEntry := (high + math.max(open, close)) / 2.0
    true

// ─────────────────────────────────── PRECISION VARIANT ───────────────────────────────────
// Local pivots formed AFTER the reversal confirmation. A pivot HIGH is strictly higher than the L candles to its left and the R candles to its
// right (a pivot LOW is the mirror); equal values are not pivots. It becomes known only when its last right-side candle has CLOSED (never backdated),
// replaces any older pivot, and is consumed (cannot be swept again) once any candle exceeds it by the minimum.
f_pivotUpdate(Day dy) =>
    int n = bufH.size()
    int c = n - 1 - inPvR
    if c - inPvL >= 0
        bool bull = dy.dir > 0
        float pv = bull ? bufL.get(c) : bufH.get(c)
        bool ok = bufI.get(c) > dy.confBar
        if ok
            for j = 1 to inPvL
                ok := ok and (bull ? bufL.get(c - j) > pv : bufH.get(c - j) < pv)
            for j = 1 to inPvR
                ok := ok and (bull ? bufL.get(c + j) > pv : bufH.get(c + j) < pv)
        if ok
            dy.pvP := pv
            dy.pvBar := bufI.get(c)
            dy.pvT := bufT.get(c)
            dy.pvKn := bar_index
            dy.pvDead := false
    true

// Judge the candle that just closed. Returns true when a precision trigger fires (and freezes the trigger candle on the model).
// Rejection: trades into the precision area, closes beyond the 10am open AND beyond its own open, wick share >= minimum, close in the correct half.
// Secondary sweep: a KNOWN pivot (known on an earlier candle) is exceeded by >= 1 tick, the candle closes back through it, plus the rejection conditions.
f_precTrig(Day dy, Mdl md, bool gate) =>
    bool bull = dy.dir > 0
    float rng = high - low
    bool inArea = high >= dy.parLo and low <= dy.parHi
    bool intact = bull ? low >= dy.mExt : high <= dy.mExt
    bool shape = false
    if rng > 0
        float wick = bull ? math.min(open, close) - low : high - math.max(open, close)
        bool dirOk = bull ? (close > dy.O and close > open) : (close < dy.O and close < open)
        bool posOk = bull ? close >= low + 0.5 * rng : close <= low + 0.5 * rng
        shape := dirOk and posOk and wick >= inWick * rng - 0.000000001
    bool rej = inArea and intact and shape
    bool swp = false
    if not na(dy.pvP) and not dy.pvDead and bar_index > dy.pvKn
        bool exc = bull ? low <= dy.pvP - tk : high >= dy.pvP + tk
        swp := exc and inArea and intact and shape and (bull ? close > dy.pvP : close < dy.pvP)
        if exc
            dy.pvDead := true
    bool useR = inPTrig == "Rejection" or inPTrig == "Either"
    bool useS = inPTrig == "Secondary sweep" or inPTrig == "Either"
    bool fire = gate and ((useR and rej) or (useS and swp))
    if fire
        bool both = useR and useS and rej and swp
        md.trigNm := both ? "Sweep + Rejection" : ((useS and swp) ? "Secondary sweep" : "Rejection")
        md.tT := time
        md.tHi := high
        md.tLo := low
        md.tBase := bull ? math.min(open, close) : math.max(open, close)
        md.sLvl := (useS and swp) ? dy.pvP : na
        md.sT := dy.pvT
    fire

f_rejectP(Mdl md, int col, string why) =>
    md.st := 4
    md.why := why
    f_fn(4, col)
    f_msgK(3, 4, "REJECTED - " + why)
    true

// Precision order: entry = midpoint of the frozen trigger wick; stop = the trigger candle's extreme +/- buffer (a local invalidation level, never
// compressed); the nearest UNSWEPT opposing liquidity level known now (or a fixed R) is frozen as the target; planned R is checked on rounded prices.
f_planP(Day dy, Mdl md) =>
    bool bull = dy.dir > 0
    float entry = math.round_to_mintick(bull ? (md.tLo + md.tBase) / 2.0 : (md.tHi + md.tBase) / 2.0)
    float stop = bull ? math.round_to_mintick(md.tLo - inPBuf * tk) : math.round_to_mintick(md.tHi + inPBuf * tk)
    float dist = bull ? entry - stop : stop - entry
    int riskT = int(math.round(dist / tk))
    int qty = inQty
    if inSizeMode == "Fixed cash risk" and riskT >= 1
        qty := int(math.floor(inCashRisk / (riskT * tk * syminfo.pointvalue)))
    bool armed = false
    if dist <= 0 or riskT < 1
        f_rejectP(md, 8, "stop distance is zero or invalid after rounding")
    else if riskT > inPStopCap
        f_rejectP(md, 8, "stop-cap rejection: " + str.tostring(riskT) + " ticks > " + str.tostring(inPStopCap) + " (stop not compressed)")
    else if qty < 1
        f_rejectP(md, 14, "sizing rejection: one contract risks more than the cash budget")
    else
        float tgt = na
        if inPTgt == "Fixed R"
            tgt := bull ? entry + inPFixR * dist : entry - inPFixR * dist
        else if bull
            float c1 = not na(dy.orH) and dy.orH > entry + tk and not (dy.poHi > dy.orH) ? dy.orH : na
            float c2 = not na(dy.pdH) and dy.pdH > entry + tk and not (sHi > dy.pdH) ? dy.pdH : na
            tgt := na(c1) ? c2 : (na(c2) ? c1 : math.min(c1, c2))
        else
            float c1 = not na(dy.orL) and dy.orL < entry - tk and not (dy.poLo < dy.orL) ? dy.orL : na
            float c2 = not na(dy.pdL) and dy.pdL < entry - tk and not (sLo < dy.pdL) ? dy.pdL : na
            tgt := na(c1) ? c2 : (na(c2) ? c1 : math.max(c1, c2))
        if na(tgt)
            f_rejectP(md, 11, "No eligible liquidity target")
        else
            float tgtR = math.round_to_mintick(tgt)
            float pR = math.abs(tgtR - entry) / dist
            if pR < inMinR - 0.000000001
                f_rejectP(md, 13, "minimum-R rejection: planned " + str.tostring(pR, "#.00") + "R < " + str.tostring(inMinR, "#.0") + "R")
            else
                md.lim := entry
                md.stp := stop
                md.tgt := tgtR
                md.qty := qty
                md.tgtType := inPTgt == "Fixed R" ? "fixed-R" : "liquidity"
                md.plannedR := pR
                md.st := 2
                md.armBar := bar_index
                md.armT := time_close
                f_fn(4, 5)
                armed := true
                f_msgK(1, 4, "PRECISION ORDER ARMED (simulated limit, NOT a fill) " + md.trigNm + " " + (bull ? "LONG" : "SHORT") + " limit " + str.tostring(entry, format.mintick) + " stop " + str.tostring(stop, format.mintick) + " (" + str.tostring(riskT) + " ticks) target " + str.tostring(tgtR, format.mintick) + " (" + md.tgtType + ", planned " + str.tostring(pR, "#.0") + "R)")
    armed

f_waitP(Day dy, Mdl md) =>
    bool bull = dy.dir > 0
    if f_exceeded(dy)
        f_invalidate(md, "price exceeded the frozen manipulation extreme before a precision trigger")
    else
        bool gate = true
        if inPIfvg and not md.fInv
            gate := false
            if bull ? close > md.fT : close < md.fB
                md.fInv := true
        if f_precTrig(dy, md, gate)
            f_fn(4, 4)
            f_planP(dy, md)
        // pivots become known only AFTER this candle has been judged
        f_pivotUpdate(dy)
    true

// A pending precision order. Cancelled on: expiry, a candle opening beyond the local stop, the shared setup being invalidated, or the target being
// reached before the entry. Touching both the entry and the target on one candle is handled by the shared fill logic (flagged, conservative).
f_fillStepP(Day dy, Mdl md) =>
    bool bull = dy.dir > 0
    float thrP = inStrict ? tk : 0.0
    if bar_index > md.armBar + inPExp
        md.st := 4
        md.why := "expired: not filled within " + str.tostring(inPExp) + " subsequent candles"
        f_fn(4, 7)
        f_msgK(3, 4, "CANCELLED - " + md.why)
    else
        // gap candles are NOT cancelled here (see f_fillTry: resting limit assumed filled, flagged gap event)
        bool touchE = bull ? low <= md.lim - thrP : high >= md.lim + thrP
        bool tgtFirst = not touchE and (bull ? high >= md.tgt : low <= md.tgt)
        if tgtFirst
            md.st := 4
            md.why := "cancelled: the target was reached before the entry"
            f_fn(4, 7)
            f_msgK(3, 4, "CANCELLED - " + md.why)
        else
            f_fillTry(dy, md)
    true

f_modelStep(Day dy, Mdl md) =>
    int m = mOpen
    if md.st == 3
        if m >= exitT
            f_finish(md, 3, open, time, "time exit at the " + f_hm(time) + " candle open")
        else
            f_posStep(dy, md)
    else if md.st == 1 or md.st == 2
        if m >= cutT
            if md.st == 2
                f_fn(md.slot, 7)
                md.why := "unfilled: cancelled at the entry cutoff"
                f_msgK(3, md.slot, "CANCELLED - " + md.why)
            else
                f_fn(md.slot, 12)
                md.why := "entry conditions not met by the cutoff"
            md.st := 4
        else if md.st == 2
            if bar_index > md.armBar
                if md.slot == 4
                    f_fillStepP(dy, md)
                else
                    f_fillStep(dy, md)
        else
            if md.slot == 1
                f_waitB(dy, md)
            else if md.slot == 4
                f_waitP(dy, md)
            else
                f_waitC(dy, md)
    true

// ─────────────────────────────────────── REVERSAL CONFIRMED ───────────────────────────────────────
f_confirm(Day dy) =>
    bool bull = dy.dir > 0
    dy.confT := time_close
    dy.confBar := bar_index
    dy.mPts := math.abs(dy.mExt - dy.O)
    dy.mAtr := na(dy.atrPre) ? na : dy.mPts / dy.atrPre
    bool tooBig = inMaxOn and (inThr == "ATR" ? (not na(dy.mAtr) and dy.mAtr > inMaxAtr) : dy.mPts > inMaxPts)
    bool swOk = true
    if inSweep
        int i0 = bull ? 2 : 0
        int bestI = -1
        float bestP = na
        for i = i0 to i0 + 1
            float lv = dy.lvlP.get(i)
            if not na(lv) and not na(dy.lvlT.get(i)) and (bull ? close > lv : close < lv)
                if bestI < 0 or (bull ? lv < bestP : lv > bestP)
                    bestI := i
                    bestP := lv
        if bestI < 0
            swOk := false
        else
            dy.swpLvl := bestP
            dy.swpT := dy.lvlT.get(bestI)
            dy.swpNm := bestI == 0 ? "opening-range high" : (bestI == 1 ? "previous-session high" : (bestI == 2 ? "opening-range low" : "previous-session low"))
    if tooBig
        dy.st := 8
        dy.why := "manipulation larger than the maximum-size filter (" + str.tostring(dy.mPts, "#.00") + " pts)"
        f_fnA(9)
    else if not swOk
        dy.st := 8
        dy.why := "no qualifying post-10am liquidity sweep with a close back through the level"
        f_fnA(9)
    else
        dy.st := 3
        f_fnA(3)
        if inSweep
            f_fnA(2)
        f_msgK(0, selSlot, "SETUP READY: reversal confirmed " + (bull ? "LONG" : "SHORT") + " - 10am open " + str.tostring(dy.O, format.mintick) + ", frozen manipulation extreme " + str.tostring(dy.mExt, format.mintick))
        // model A: the reversal itself is the condition
        if slotOn.get(0)
            f_cond(dy, dy.ms.get(0), dy.O, na)
        // model B: freeze the latest eligible FVG (bullish for shorts, bearish for longs)
        if slotOn.get(1)
            Mdl mb = dy.ms.get(1)
            float gT = bull ? dy.fbeT : dy.fbuT
            float gB = bull ? dy.fbeB : dy.fbuB
            if na(gT)
                mb.st := 4
                mb.why := "no eligible FVG formed between the 10am open and the reversal confirmation"
                f_fn(1, 12)
            else
                mb.fT := gT
                mb.fB := gB
                mb.fCT := bull ? dy.fbeC : dy.fbuC
                bool inv = bull ? (not na(dy.fbeMax) and dy.fbeMax > gT) : (not na(dy.fbuMin) and dy.fbuMin < gB)
                mb.fInv := inv
                mb.st := 1
                if inv
                    f_cond(dy, mb, dy.O, na)
        // model C (both stop policies): the 10am open must sit inside the 61.8-79% retracement of the frozen leg
        float l618 = f_fibLvl(dy, 0.618)
        float l79 = f_fibLvl(dy, 0.79)
        dy.fibLo := math.min(l618, l79)
        dy.fibHi := math.max(l618, l79)
        if slotOn.get(2) or slotOn.get(3)
            dy.fibOk := dy.O >= dy.fibLo and dy.O <= dy.fibHi
            for k = 2 to 3
                if slotOn.get(k)
                    Mdl mc = dy.ms.get(k)
                    if dy.fibOk
                        mc.st := 1
                    else
                        mc.st := 4
                        mc.why := "skipped: the 10am open is outside the 61.8-79% retracement zone"
                        f_fn(k, 12)
        // Precision: it waits for its OWN local trigger on a later candle. The band, the optional Fib overlap and the optional frozen iFVG are fixed now.
        if slotOn.get(4)
            Mdl mp = dy.ms.get(4)
            dy.bdLo := dy.O - inBand * tk
            dy.bdHi := dy.O + inBand * tk
            float aLo = dy.bdLo
            float aHi = dy.bdHi
            bool pOk = true
            string pWhy = ""
            if inPFib
                aLo := math.max(dy.bdLo, dy.fibLo)
                aHi := math.min(dy.bdHi, dy.fibHi)
                if aLo > aHi
                    pOk := false
                    pWhy := "skipped: the precision band does not overlap the 61.8-79% Fib zone"
            dy.parLo := aLo
            dy.parHi := aHi
            if pOk and inPIfvg
                float gT2 = bull ? dy.fbeT : dy.fbuT
                float gB2 = bull ? dy.fbeB : dy.fbuB
                if na(gT2)
                    pOk := false
                    pWhy := "skipped: no eligible FVG for the iFVG filter"
                else
                    mp.fT := gT2
                    mp.fB := gB2
                    mp.fInv := bull ? (not na(dy.fbeMax) and dy.fbeMax > gT2) : (not na(dy.fbuMin) and dy.fbuMin < gB2)
            if pOk
                mp.st := 1
            else
                mp.st := 4
                mp.why := pWhy
                f_fn(4, 12)
    true

// ───────────────────────────────────────── DAY ENGINE ─────────────────────────────────────────
f_dayStep(Day dy) =>
    int m = mOpen
    if m >= 570 and m < 960
        dy.rthH := na(dy.rthH) ? high : math.max(dy.rthH, high)
        dy.rthL := na(dy.rthL) ? low : math.min(dy.rthL, low)
        dy.rthN += 1
    if m >= orS and m < orE
        dy.orH := na(dy.orH) ? high : math.max(dy.orH, high)
        dy.orL := na(dy.orL) ? low : math.min(dy.orL, low)
        dy.orN += 1
    if m < openT
        dy.atrPre := atrV
        if m >= orS
            if not na(dy.pdH) and high >= dy.pdH + inSweepTk * tk
                dy.preSweep := true
            if not na(dy.pdL) and low <= dy.pdL - inSweepTk * tk
                dy.preSweep := true
    if m >= openT and m < exitT
        dy.bars10 += 1
    // 1) the 10:00 candle's open is usable when that candle has closed
    if dy.st == 0 and m >= openT
        if m != openT
            dy.st := 9
            dy.status := 2
            dy.why := "missing 10am candle (first candle at/after the open is " + f_hm(time) + ")"
        else if inThr == "ATR" and na(dy.atrPre)
            dy.st := 9
            dy.status := 3
            dy.why := "ATR history unavailable before the open"
        else
            dy.O := open
            dy.oT := time
            if dy.orN < orE - orS
                dy.orH := na
                dy.orL := na
            dy.thr := inThr == "ATR" ? inAtrM * dy.atrPre : inFixed
            dy.lvlP.set(0, inLvOR ? dy.orH : na)
            dy.lvlP.set(1, inLvPD ? dy.pdH : na)
            dy.lvlP.set(2, inLvOR ? dy.orL : na)
            dy.lvlP.set(3, inLvPD ? dy.pdL : na)
            bool anyLvl = false
            for i = 0 to 3
                if not na(dy.lvlP.get(i))
                    anyLvl := true
            if inSweep and not anyLvl
                dy.st := 9
                dy.status := 4
                dy.why := "no eligible sweep level was available (opening range / previous session incomplete)"
            else
                dy.st := 1
                f_fnA(0)
    if not na(dy.O) and m >= openT
        dy.poHi := na(dy.poHi) ? high : math.max(dy.poHi, high)
        dy.poLo := na(dy.poLo) ? low : math.min(dy.poLo, low)
    // 2) trackers that only look at candles from the open onward
    if (dy.st == 1 or dy.st == 2) and m >= openT
        for i = 0 to 3
            float lv = dy.lvlP.get(i)
            if not na(lv) and na(dy.lvlT.get(i))
                if (i < 2 ? high >= lv + inSweepTk * tk : low <= lv - inSweepTk * tk)
                    dy.lvlT.set(i, time_close)
        if not na(dy.fbuB)
            dy.fbuMin := na(dy.fbuMin) ? close : math.min(dy.fbuMin, close)
        if not na(dy.fbeT)
            dy.fbeMax := na(dy.fbeMax) ? close : math.max(dy.fbeMax, close)
        if not na(h2) and not na(l2) and t2 >= dy.oT and time - t2 == 2 * chartMs
            if low > h2
                dy.fbuT := low
                dy.fbuB := h2
                dy.fbuC := time_close
                dy.fbuMin := na
            if high < l2
                dy.fbeT := l2
                dy.fbeB := high
                dy.fbeC := time_close
                dy.fbeMax := na
    // 3) first qualifying manipulation (the candle that defines the open may itself qualify; its state change happens at its close)
    if dy.st == 1
        if m >= manE
            dy.st := 7
            dy.why := "no qualifying manipulation before " + f_hm(f_ts(dy.key, manE))
        else
            float up = high - dy.O
            float dn = dy.O - low
            bool qu = up >= dy.thr
            bool qd = dn >= dy.thr
            if qu or qd
                if qu and qd and inAmbInit == "Skip day"
                    dy.st := 7
                    dy.why := "ambiguous first candle: crossed both thresholds, skipped"
                    cv.set(6, cv.get(6) + 1)
                else
                    dy.dir := qu and qd ? (up >= dn ? -1 : 1) : (qu ? -1 : 1)
                    dy.qBar := bar_index
                    dy.qT := time_close
                    dy.mExt := dy.dir < 0 ? high : low
                    dy.mExtT := time
                    dy.oppX := dy.dir < 0 ? low : high
                    dy.cnt := 0
                    dy.st := 2
                    f_fnA(1)
    // 4) reversal counting only on candles AFTER the manipulation candle
    if dy.st == 2 and bar_index > dy.qBar
        if m >= cutT
            dy.st := 7
            dy.why := "no reversal confirmation before the entry cutoff"
        else
            if dy.dir < 0
                if high >= dy.mExt
                    dy.mExt := high
                    dy.mExtT := time
                    dy.oppX := low
                else
                    dy.oppX := math.min(dy.oppX, low)
                dy.cnt := close < dy.O ? dy.cnt + 1 : 0
            else
                if low <= dy.mExt
                    dy.mExt := low
                    dy.mExtT := time
                    dy.oppX := high
                else
                    dy.oppX := math.max(dy.oppX, high)
                dy.cnt := close > dy.O ? dy.cnt + 1 : 0
            if dy.cnt >= inRevN
                f_confirm(dy)
    // 5) models run only on candles after the confirmation candle
    if dy.st == 3
        if bar_index > dy.confBar
            f_cReject(dy)
            for k = 0 to NS - 1
                if slotOn.get(k)
                    f_modelStep(dy, dy.ms.get(k))
        bool allDone = true
        for k = 0 to NS - 1
            if slotOn.get(k) and dy.ms.get(k).st != 4
                allDone := false
        if allDone
            dy.st := 6
    true

f_newDay(int key, int dow, Day prev) =>
    Day d = Day.new(key = key, active = dow >= dayofweek.monday and dow <= dayofweek.friday, lvlP = array.new_float(4, na), lvlT = array.new_int(4, na), ms = array.from(Mdl.new(slot = 0), Mdl.new(slot = 1), Mdl.new(slot = 2), Mdl.new(slot = 3), Mdl.new(slot = 4), Mdl.new(slot = 5), Mdl.new(slot = 6), Mdl.new(slot = 7), Mdl.new(slot = 8)))
    if not na(prev)
        if prev.rthN >= 390
            d.pdH := prev.rthH
            d.pdL := prev.rthL
    d

f_finalize(Day dy, float lastC, int lastT) =>
    if dy.active
        for k = 0 to NS - 1
            Mdl md = dy.ms.get(k)
            if md.st == 3
                f_finish(md, 3, lastC, lastT, "forced close at the last candle: no candle at/after the time exit (data missing)")
        if dy.st == 0
            dy.status := 2
            dy.why := "no candle at/after the 10am open"
        if dy.status == 0 and dy.bars10 < exitT - openT
            dy.status := 1
        cv.set(0, cv.get(0) + 1)
        cv.set(dy.status + 1, cv.get(dy.status + 1) + 1)
        if inDebug
            log.info("H Ticks C | " + f_dt(dy.key) + " coverage " + str.tostring(dy.status) + " | state " + str.tostring(dy.st) + " | " + dy.why + (na(dy.dir) or dy.dir == 0 ? "" : " | " + (dy.dir > 0 ? "LONG" : "SHORT") + " manip " + str.tostring(dy.mPts, "#.00") + " pts"))
    true


// ═════════════════════════════════════ CONTEXTUAL ENGINE ═════════════════════════════════════
// Provenance legend used in comments below:  [GUIDE] concept described in the Powell guide,  [OURS] our mechanical interpretation,
// [OPT] optional experimental filter,  [ENG] engineering approximation.  Nothing here is Powell's official rule set.
const int SC_STD = 5
const int SC_PRE = 6

f_inWin(int m, int a, int b) =>
    a < b ? (m >= a and m < b) : (m >= a or m < b)

f_ag(array<float> a, int k) =>
    a.get(a.size() - 1 - k)

f_agI(array<int> a, int k) =>
    a.get(a.size() - 1 - k)

f_cxCur() =>
    sets.size() > 0 ? sets.get(sets.size() - 1) : na

f_cxSetupBy(int sid) =>
    Setup out = na
    if sets.size() > 0
        for i = sets.size() - 1 to 0
            Setup q = sets.get(i)
            if q.id == sid
                out := q
                break
    out

// ---- why-no-trade bookkeeping: a short category is counted forever, the detailed text is kept for the latest day only
f_why(string cat, string detail) =>
    int ix = rjK.indexof(cat)
    if ix < 0
        rjK.push(cat)
        rjC.push(1)
    else
        rjC.set(ix, rjC.get(ix) + 1)
    dayWhy.push(f_hm(time_close) + " " + detail)
    while dayWhy.size() > 10
        dayWhy.shift()
    true

// funnel counter for a contextual plan: its own variant column and, for Precision, its entry-method column (7 Fib, 8 Rejection)
f_cxFn(Mdl md, int col) =>
    f_fn(md.slot, col)
    if md.slot == SC_PRE
        f_fn(md.meth == "Fib 0.705" ? 7 : 8, col)
    true

// ---- aggregation ----
f_aggPush(Agg a) =>
    a.O.push(a.o)
    a.H.push(a.h)
    a.L.push(a.l)
    a.C.push(a.c)
    a.T0.push(a.t0)
    a.TC.push(a.tc)
    while a.H.size() > 60
        a.O.shift()
        a.H.shift()
        a.L.shift()
        a.C.shift()
        a.T0.shift()
        a.TC.shift()
    true

// Bucket = minutes since 18:00 NY on the trading day (the 18:00 candle belongs to the FOLLOWING calendar date).
// A candle completes on the last 1m bar of its bucket; if that bar is missing it completes (late, conservatively) when the next bucket starts.
f_aggClear(Agg a) =>
    a.O.clear()
    a.H.clear()
    a.L.clear()
    a.C.clear()
    a.T0.clear()
    a.TC.clear()
    true

// Publish (ok) or DROP (incomplete) the bucket. A dropped bucket clears the history so no pattern (FVG, swing, run, bias) can span the hole.
f_aggClose(Agg a, bool ok) =>
    if ok
        f_aggPush(a)
        a.doneN += 1
        a.nw := true
    else
        f_aggClear(a)
        a.dropN += 1
        a.bad := true
    a.has := false
    true

// Completeness bookkeeping per synthetic timeframe. Bucket = minutes since 18:00 NY on the trading day. The scheduled 17:00-18:00 break is EXPLICIT:
// a bucket that reaches it ends at 17:00 (minute 1380), so the 4H candle 14:00-17:00 and the Daily candle 18:00-17:00 expect 180 / 1380 one-minute candles.
// A candle is published only if its first/last candle are on the expected boundaries (within the tolerance) and no more than the tolerance is missing.
// A gap between consecutive 1m candles is "explained" only when it follows the 16:59 candle (break, weekend, holiday); any other hole clears history.
f_aggStep(Agg a) =>
    a.nw := false
    a.bad := false
    int ms18 = (mOpen - 1080 + 1440) % 1440
    int span = a.n >= 1440 ? 1440 : a.n
    int idx = a.n >= 1440 ? 0 : int(math.floor(ms18 / a.n))
    int bid = tdk * 10000 + idx
    int startMs = idx * span
    int endMs = math.min((idx + 1) * span, 1380)
    int prevM = na(pCloseT) ? -1 : hour(pCloseT - chartMs, TZ) * 60 + minute(pCloseT - chartMs, TZ)
    int missed = na(pCloseT) ? 0 : int(math.round((time - pCloseT) / chartMs))
    bool hole = missed > inCxMiss and prevM != 1019
    if a.has and bid != a.id
        // the previous bucket never saw its last candle
        bool okp = a.firstMs - a.idx * span <= inCxMiss and (math.min((a.idx + 1) * span, 1380) - 1) - a.lastMs <= inCxMiss and a.cnt >= (math.min((a.idx + 1) * span, 1380) - a.idx * span) - inCxMiss and not a.gap
        f_aggClose(a, okp)
    if hole
        a.gap := true
        if a.H.size() > 0
            f_aggClear(a)
            a.dropN += 1
            a.bad := true
    if not a.has
        a.o := open
        a.h := high
        a.l := low
        a.c := close
        a.t0 := time
        a.tc := time_close
        a.id := bid
        a.idx := idx
        a.cnt := 1
        a.firstMs := ms18
        a.lastMs := ms18
        a.gap := hole
        a.has := true
    else
        a.h := math.max(a.h, high)
        a.l := math.min(a.l, low)
        a.c := close
        a.tc := time_close
        a.cnt += 1
        a.lastMs := ms18
    if ms18 + 1 == endMs
        bool ok = a.firstMs - startMs <= inCxMiss and endMs - 1 - a.lastMs <= inCxMiss and a.cnt >= (endMs - startMs) - inCxMiss and not a.gap
        f_aggClose(a, ok)
    a.nw or a.bad

// ---- levels ----
f_newLevel(string ty, int side, float px, int origin, int known, bool sup) =>
    bool dup = false
    for lv in lvls
        if lv.ty == ty
            if sup and lv.st < 2
                lv.st := 3
            else if not sup and lv.px == px
                dup := true
    Lvl out = na
    if not dup
        cxN.set(0, cxN.get(0) + 1)
        out := Lvl.new(id = cxN.get(0), ty = ty, side = side, px = px, origin = origin, known = known)
        lvls.push(out)
        int i = lvls.size() - 1
        while i >= 0
            Lvl q = lvls.get(i)
            if q.st == 3 or time - q.known > 345600000
                lvls.remove(i)
            i -= 1
        while lvls.size() > 60
            lvls.shift()
    out

// Level statuses use only levels that ALREADY exist: a level created at this candle's close is first tested on the next candle,
// so the candle that defines a level can never sweep it. A level also cannot be swept by a candle that opened before the level was known.
f_cxLvlStatus() =>
    float sw = inCxSwTk * tk
    for lv in lvls
        if lv.side == 0
            if lv.st == 0 and time >= lv.known and low <= lv.px and high >= lv.px
                lv.st := 1
        else if lv.st < 2 and time >= lv.known
            if lv.side > 0
                if high >= lv.px + sw
                    lv.st := 2
                    lv.swT := time_close
                    lv.swOpen := time
                else if high >= lv.px
                    lv.st := 1
            else
                if low <= lv.px - sw
                    lv.st := 2
                    lv.swT := time_close
                    lv.swOpen := time
                else if low <= lv.px
                    lv.st := 1
    true

// A predefined session range becomes a level only once COMPLETED (at least 80% of its minutes present).
f_cxRange(Rg r, string rs, string tyH, string tyL, bool enable) =>
    if enable
        int a = f_mins(rs, 0)
        int b = f_mins(rs, 5)
        int e = b % 1440
        bool inW = a != e and f_inWin(mOpen, a, e == 0 ? 1440 : e)
        if inW and not r.active
            r.active := true
            r.h := na
            r.l := na
            r.n := 0
            r.origin := time
        if inW
            r.h := na(r.h) ? high : math.max(r.h, high)
            r.l := na(r.l) ? low : math.min(r.l, low)
            r.n += 1
        bool fin = false
        int kn = 0
        if inW and (mOpen + 1) % 1440 == e
            fin := true
            kn := time_close
        else if r.active and not inW
            fin := true
            kn := nz(pCloseT)
        if fin and r.active
            int dur = (b - a + 1440) % 1440
            if dur == 0
                dur := 1440
            if r.n >= 0.8 * dur and not na(r.h)
                f_newLevel(tyH, 1, r.h, r.origin, kn, true)
                f_newLevel(tyL, -1, r.l, r.origin, kn, true)
            r.active := false
    true

f_cxLevelsBar() =>
    int m = mOpen
    if m == 570
        rgRTH.h := na
        rgRTH.l := na
        rgRTH.n := 0
        csT.hi := na
        csT.lo := na
        csT.hiReg := false
        csT.loReg := false
    if m >= 570 and m < 960
        rgRTH.h := na(rgRTH.h) ? high : math.max(rgRTH.h, high)
        rgRTH.l := na(rgRTH.l) ? low : math.min(rgRTH.l, low)
        rgRTH.n += 1
        if m == 959 and inCxLvPS and rgRTH.n >= 390
            f_newLevel("PSH", 1, rgRTH.h, time, time_close, true)
            f_newLevel("PSL", -1, rgRTH.l, time, time_close, true)
        // [OURS] current-session extreme that has stood for N minutes becomes a level (it existed BEFORE any later sweep of it)
        if inCxLvCS
            if na(csT.hi) or high > csT.hi
                csT.hi := high
                csT.hiT := time_close
                csT.hiReg := false
            if na(csT.lo) or low < csT.lo
                csT.lo := low
                csT.loT := time_close
                csT.loReg := false
            if not csT.hiReg and time_close - csT.hiT >= inCsAge * chartMs
                f_newLevel("CSH", 1, csT.hi, csT.hiT, time_close, false)
                csT.hiReg := true
            if not csT.loReg and time_close - csT.loT >= inCsAge * chartMs
                f_newLevel("CSL", -1, csT.lo, csT.loT, time_close, false)
                csT.loReg := true
    if inCxLvOR
        if m == orS
            rgOR.h := na
            rgOR.l := na
            rgOR.n := 0
        if m >= orS and m < orE
            rgOR.h := na(rgOR.h) ? high : math.max(rgOR.h, high)
            rgOR.l := na(rgOR.l) ? low : math.min(rgOR.l, low)
            rgOR.n += 1
            if m == orE - 1 and rgOR.n >= orE - orS
                f_newLevel("ORH", 1, rgOR.h, time, time_close, true)
                f_newLevel("ORL", -1, rgOR.l, time, time_close, true)
    f_cxRange(rgAS, inCxAs, "ASH", "ASL", inCxLvAS)
    f_cxRange(rgLD, inCxLd, "LDH", "LDL", inCxLvLD)
    f_cxRange(rgPO, inCxPo, "PO3H", "PO3L", inCxLvPO)
    // [GUIDE] key opens are reference context only; they are never sweep levels and never an entry by themselves
    if m == 1080 or m == 0 or m == 600
        f_newLevel(m == 1080 ? "O1800" : (m == 0 ? "O0000" : "O1000"), 0, open, time, time_close, true)
    true

// ---- higher-timeframe bias (completed candles only) and optional HTF points of interest ----
// PRIOR-RANGE BREAKOUT STATE (not a CISD): +1 after a completed candle closes above the previous completed candle's high, -1 after a close below its low,
// otherwise the last state PERSISTS (0 until the first breakout). It is unavailable until two consecutive complete candles exist and is RESET to unavailable
// whenever that timeframe drops an incomplete candle. The CISD used for setups is a different, per-setup construct (opposing delivery leg, see f_cxRef).
f_cxPrb(int ix, Agg a) =>
    if a.bad
        prbS.set(ix, 0)
        prbT.set(ix, na)
        if ix == 2
            poi15.clear()
        if ix == 4
            poi60.clear()
    if a.nw and a.H.size() >= 2
        float c0 = f_ag(a.C, 0)
        if c0 > f_ag(a.H, 1)
            prbS.set(ix, 1)
        else if c0 < f_ag(a.L, 1)
            prbS.set(ix, -1)
        prbT.set(ix, a.TC.last())
    if a.nw and (ix == 2 or ix == 4) and a.H.size() >= 3
        array<Fvg> pl = ix == 2 ? poi15 : poi60
        float h1 = f_ag(a.H, 2)
        float l1 = f_ag(a.L, 2)
        float h3 = f_ag(a.H, 0)
        float l3 = f_ag(a.L, 0)
        if l3 > h1
            pl.push(Fvg.new(id = 0, dir = 1, lo = h1, hi = l3, c1open = f_agI(a.T0, 2), known = time_close))
        if h3 < l1
            pl.push(Fvg.new(id = 0, dir = -1, lo = h3, hi = l1, c1open = f_agI(a.T0, 2), known = time_close))
        while pl.size() > 10
            pl.shift()
    if a.nw and (ix == 2 or ix == 4) and a.H.size() >= 1
        array<Fvg> pl2 = ix == 2 ? poi15 : poi60
        float cc = f_ag(a.C, 0)
        for f in pl2
            if not f.dead and (f.dir > 0 ? cc < f.lo : cc > f.hi)
                f.dead := true
    true

// priority of a level family when several are swept by one candle or compete for an active setup (0 = strongest)
f_cxPri(string ty) =>
    ty == "PDH" or ty == "PDL" ? 0 : (ty == "PSH" or ty == "PSL" ? 1 : (ty == "PO3H" or ty == "PO3L" ? 2 : (ty == "ASH" or ty == "ASL" ? 3 : (ty == "LDH" or ty == "LDL" ? 4 : (ty == "ORH" or ty == "ORL" ? 5 : (ty == "EQH" or ty == "EQL" ? 6 : 7))))))

// Day-level funnel counts for the contextual slots (setup-level events are shared by Standard and Precision)
f_fnA2(int col) =>
    for k = 5 to 8
        if slotOn.get(k)
            f_fn(k, col)
    true

// ---- source-timeframe events ----
f_cxSrc() =>
    aggs.get(inCxTf == "1m" ? 0 : (inCxTf == "5m" ? 1 : 2))

f_cxTfMs() =>
    (inCxTf == "1m" ? 1 : (inCxTf == "5m" ? 5 : 15)) * chartMs

// A confirmed swing (strength P each side) plus the block associated with it: for a swing LOW the last bearish candle at/before it (the order block of the
// up-leg that starts there); for a swing HIGH the last bullish candle at/before it. Known only when the swing was confirmed (never back-dated).
f_cxSwing(Agg A, int i, int side) =>
    float px = side > 0 ? A.H.get(i) : A.L.get(i)
    float bLo = na
    float bHi = na
    for k = 0 to 3
        int j = i - k
        if j >= 0 and na(bLo)
            bool cand = side > 0 ? A.C.get(j) > A.O.get(j) : A.C.get(j) < A.O.get(j)
            if cand
                bLo := A.L.get(j)
                bHi := A.H.get(j)
    swgs.push(Sw.new(side = side, px = px, open = A.T0.get(i), kn = time_close, bLo = bLo, bHi = bHi))
    while swgs.size() > 30
        swgs.shift()
    true

// FVG store (3 candles; usable once the third closed), confirmed swings (strength P each side), and equal highs/lows.
f_cxPivFvg(Agg A) =>
    int n = A.H.size()
    int P = inCxPv
    if n >= 3
        float h1 = f_ag(A.H, 2)
        float l1 = f_ag(A.L, 2)
        float h3 = f_ag(A.H, 0)
        float l3 = f_ag(A.L, 0)
        if l3 > h1
            cxN.set(2, cxN.get(2) + 1)
            fvgs.push(Fvg.new(id = cxN.get(2), dir = 1, lo = h1, hi = l3, c1open = f_agI(A.T0, 2), known = time_close))
        if h3 < l1
            cxN.set(2, cxN.get(2) + 1)
            fvgs.push(Fvg.new(id = cxN.get(2), dir = -1, lo = h3, hi = l1, c1open = f_agI(A.T0, 2), known = time_close))
    if n >= 1
        float cc = f_ag(A.C, 0)
        int ct0 = f_agI(A.T0, 0)
        for f in fvgs
            if not f.dead
                if not f.inv
                    if f.dir > 0 ? cc < f.lo : cc > f.hi
                        f.inv := true
                        f.invOpen := ct0
                        f.invKnown := time_close
                else if ct0 > f.invOpen
                    if f.dir > 0 ? cc > f.hi : cc < f.lo
                        f.dead := true
        while fvgs.size() > 40
            fvgs.shift()
    if n >= 2 * P + 1
        int i = n - 1 - P
        float ph = A.H.get(i)
        float pl = A.L.get(i)
        bool okH = true
        bool okL = true
        for j = 1 to P
            okH := okH and A.H.get(i - j) < ph and A.H.get(i + j) < ph
            okL := okL and A.L.get(i - j) > pl and A.L.get(i + j) > pl
        if okH
            f_cxSwing(A, i, 1)
            pvPx.set(0, ph)
            pvOp.set(0, A.T0.get(i))
            pvKn.set(0, time_close)
        if okL
            f_cxSwing(A, i, -1)
            pvPx.set(1, pl)
            pvOp.set(1, A.T0.get(i))
            pvKn.set(1, time_close)
        if inCxLvEQ
            float tol = inEqTol * tk
            for q = 0 to 1
                bool ok = q == 0 ? okH : okL
                float px = q == 0 ? ph : pl
                if ok
                    bool hit = false
                    for pv in eqP
                        if not hit and not pv.dead and pv.side == (q == 0 ? 1 : -1) and math.abs(pv.px - px) <= tol
                            f_newLevel(q == 0 ? "EQH" : "EQL", q == 0 ? 1 : -1, q == 0 ? math.max(px, pv.px) : math.min(px, pv.px), A.T0.get(i), time_close, false)
                            pv.dead := true
                            hit := true
                    eqP.push(Pv.new(side = q == 0 ? 1 : -1, px = px))
            while eqP.size() > 12
                eqP.shift()
            float chh = A.H.get(n - 1)
            float cll = A.L.get(n - 1)
            for pv in eqP
                if not pv.dead and (pv.side > 0 ? chh > pv.px + inEqTol * tk : cll < pv.px - inEqTol * tk)
                    pv.dead := true
    true

// [OURS] CISD reference = first open of the most recent contiguous opposite-colour run leading into the sweep candle (dojis end a run).
f_cxRef(Agg A, int d) =>
    int n = A.H.size()
    int j = n - 1
    float ref = na
    int refOpen = na
    bool opp0 = d > 0 ? A.C.get(j) < A.O.get(j) : A.C.get(j) > A.O.get(j)
    if not opp0
        j -= 1
    if j >= 0
        bool oppJ = d > 0 ? A.C.get(j) < A.O.get(j) : A.C.get(j) > A.O.get(j)
        if oppJ
            while j - 1 >= 0 and (d > 0 ? A.C.get(j - 1) < A.O.get(j - 1) : A.C.get(j - 1) > A.O.get(j - 1))
                j -= 1
            ref := A.O.get(j)
            refOpen := A.T0.get(j)
    [ref, refOpen]

// [OURS] rejection block: a candle at/after the sweep with a long wick and a small body; the zone is the wick.
f_cxMkArea(string kind, float lo, float hi, int known, int src) =>
    cxN.set(4, cxN.get(4) + 1)
    Area.new(id = cxN.get(4), kind = kind, lo = lo, hi = hi, ce = (lo + hi) / 2.0, known = known, src = src)

f_cxRb(Setup st, Agg A) =>
    if inARb
        float h0 = f_ag(A.H, 0)
        float l0 = f_ag(A.L, 0)
        float o0 = f_ag(A.O, 0)
        float c0 = f_ag(A.C, 0)
        float rng = h0 - l0
        if rng > 0 and f_agI(A.T0, 0) >= st.swOpen
            float body = math.abs(c0 - o0)
            float wick = st.dir > 0 ? math.min(o0, c0) - l0 : h0 - math.max(o0, c0)
            float lo = st.dir > 0 ? l0 : math.max(o0, c0)
            float hi = st.dir > 0 ? math.min(o0, c0) : h0
            if wick / rng >= inRbWick - 0.000000001 and body / rng <= inRbBody + 0.000000001 and hi > lo
                st.rbs.push(f_cxMkArea("RB", lo, hi, time_close, f_agI(A.T0, 0)))
    true

// FVG areas (formed after the sweep began) and iFVG areas (opposite gaps inverted by a close after the sweep began), once each per setup.
f_cxCollect(Setup st) =>
    while st.rbs.size() > 0
        st.areas.push(st.rbs.shift())
    for f in fvgs
        if not f.dead and not st.fvgUsed.includes(f.id)
            if inAFvg and f.dir == st.dir and not f.inv and f.c1open >= st.swOpen
                st.areas.push(f_cxMkArea("FVG", f.lo, f.hi, f.known, f.c1open))
                st.fvgUsed.push(f.id)
            else if inAIf and f.dir == -st.dir and f.inv and f.invOpen >= st.swOpen and f.c1open >= st.swOpen - inIfLook * f_cxTfMs()
                st.areas.push(f_cxMkArea("iFVG", f.lo, f.hi, f.invKnown, f.c1open))
                st.fvgUsed.push(f.id)
    true

// [GUIDE] BREAKER, causal confirmed-swing sequence. Bearish (short setup): swing HIGH A -> intervening swing LOW B -> HIGHER swing high C (the sweep extreme)
// -> a completed candle CLOSES below B (a wick is not enough). Bullish mirrors. The broken block is the order block associated with B (the last opposite-colour
// candle at/before B: bearish candle for a swing low, bullish for a swing high); its full high-low is the area. All three swings must be CONFIRMED and the
// closing candle completed before the area exists, and the area is stamped known at that moment. If any part of the structure is missing there is no breaker.
f_cxBrk(Setup st, Agg A) =>
    if inABrk and not st.brkDone and A.H.size() >= 3
        bool bull = st.dir > 0
        Sw c = na
        for s in swgs
            if s.side == (bull ? -1 : 1) and s.px == st.ext and s.open >= st.swOpen and s.kn <= time_close
                c := s
        if not na(c)
            Sw b = na
            Sw a0 = na
            for i = swgs.size() - 1 to 0
                Sw s2 = swgs.get(i)
                if na(b)
                    if s2.side == (bull ? 1 : -1) and s2.open < c.open
                        b := s2
                else if na(a0)
                    if s2.side == c.side and s2.open < b.open and (bull ? s2.px > c.px : s2.px < c.px)
                        a0 := s2
            if not na(b) and not na(a0) and not na(b.bLo)
                bool broke = false
                for k = 0 to A.H.size() - 1
                    if A.T0.get(k) > c.open
                        broke := broke or (bull ? A.C.get(k) > b.px : A.C.get(k) < b.px)
                if broke
                    st.areas.push(f_cxMkArea("BRK", b.bLo, b.bHi, time_close, b.open))
                    st.brkDone := true
    true

// [OPT] SMT, reversal role: the peer index failed to take its own comparable extreme while this index swept.
f_cxSmt(Setup st) =>
    int res = -1
    int n = sBt.size()
    float wP = na
    float wN = na
    float pP = na
    float pN = na
    int cntP = 0
    if n > 0 and not na(sEsL.last())
        for i = n - 1 to 0
            if sBt.get(i) >= st.firstExc
                wP := na(wP) ? (st.dir > 0 ? sEsL.get(i) : sEsH.get(i)) : (st.dir > 0 ? math.min(wP, sEsL.get(i)) : math.max(wP, sEsH.get(i)))
                wN := na(wN) ? (st.dir > 0 ? sNqL.get(i) : sNqH.get(i)) : (st.dir > 0 ? math.min(wN, sNqL.get(i)) : math.max(wN, sNqH.get(i)))
            else if cntP < inSmtLook
                pP := na(pP) ? (st.dir > 0 ? sEsL.get(i) : sEsH.get(i)) : (st.dir > 0 ? math.min(pP, sEsL.get(i)) : math.max(pP, sEsH.get(i)))
                pN := na(pN) ? (st.dir > 0 ? sNqL.get(i) : sNqH.get(i)) : (st.dir > 0 ? math.min(pN, sNqL.get(i)) : math.max(pN, sNqH.get(i)))
                cntP += 1
        if not na(wP) and not na(pP) and not na(wN) and not na(pN)
            bool peerFailed = st.dir > 0 ? wP > pP : wP < pP
            bool meTook = st.dir > 0 ? wN < pN : wN > pN
            res := peerFailed and meTook ? 1 : 0
    res

f_cxCisd(Setup st, Agg A) =>
    st.st := 2
    st.cisdT := time_close
    st.cisdOpen := f_agI(A.T0, 0)
    f_fnA2(2)
    bool bull = st.dir > 0
    int n = A.H.size()
    // [GUIDE] order block = the last opposite-colour candle before the displacement that confirmed the CISD (full high-low, CE = midpoint);
    // [OURS] it must sit at/after the sweep candle.
    int j = n - 1
    while j - 1 >= 0 and (bull ? A.C.get(j - 1) > A.O.get(j - 1) : A.C.get(j - 1) < A.O.get(j - 1))
        j -= 1
    if inAOb and j - 1 >= 0
        float oo = A.O.get(j - 1)
        float oc = A.C.get(j - 1)
        bool opp = bull ? oc < oo : oc > oo
        if opp and A.T0.get(j - 1) >= st.swOpen
            st.areas.push(f_cxMkArea("OB", A.L.get(j - 1), A.H.get(j - 1), time_close, A.T0.get(j - 1)))
    f_cxCollect(st)
    f_cxBrk(st, A)
    if inSmt != "Off"
        st.smt := f_cxSmt(st)
    f_msgK(0, selSlot, "SETUP #" + str.tostring(st.id) + " CONFIRMED " + (bull ? "LONG" : "SHORT") + " - swept " + st.lvl.ty + " " + str.tostring(st.lvl.px, format.mintick) + ", CISD ref " + str.tostring(st.cisdRef, format.mintick) + " closed through, sweep extreme " + str.tostring(st.ext, format.mintick))
    true

// sweep recognition, CISD tracking, expiry and area collection - runs when a SOURCE-timeframe candle completes
f_cxSource(Agg A) =>
    f_cxPivFvg(A)
    int c0t = f_agI(A.T0, 0)
    Setup st = f_cxCur()
    bool act = not na(st) and (st.st == 1 or st.st == 2)
    // [GUIDE] sweep of a PRE-EXISTING level (the level was known before the sweeping candle began)
    Lvl best = na
    for lv in lvls
        if lv.side != 0 and lv.st == 2 and not lv.proc
            lv.proc := true
            bool elig = lv.swOpen >= c0t and lv.known <= lv.swOpen
            if elig
                if na(best)
                    best := lv
                else if f_cxPri(lv.ty) < f_cxPri(best.ty) or (f_cxPri(lv.ty) == f_cxPri(best.ty) and (lv.side > 0 ? lv.px > best.px : lv.px < best.px))
                    best := lv
    if not na(best)
        int d = -best.side
        // an active setup is replaced only by a sweep of a strictly higher-priority level while it still waits for its CISD (a displacement
        // naturally takes minor highs/lows, so those must never replace it)
        bool replace = act and st.st == 1 and f_cxPri(best.ty) < f_cxPri(st.lvl.ty)
        if act and not replace
            f_why("sweep ignored", "sweep of " + best.ty + " ignored: setup #" + str.tostring(st.id) + " is still active")
        else
            [ref, refOpen] = f_cxRef(A, d)
            f_fnA2(1)
            int fe = best.swOpen
            for lv in lvls
                if lv.side == best.side and lv.st == 2 and lv.swOpen >= c0t and lv.swOpen < fe
                    fe := lv.swOpen
            cxN.set(1, cxN.get(1) + 1)
            Setup ns = Setup.new(id = cxN.get(1), dir = d, lvl = best, swOpen = c0t, swT = time_close, ext = d > 0 ? f_ag(A.L, 0) : f_ag(A.H, 0), firstExc = fe, dayKey = dkey, areas = array.new<Area>(), rbs = array.new<Area>(), fvgUsed = array.new_int())
            if replace
                st.st := 8
                st.why := "superseded by a sweep of a higher-priority level"
            if na(ref)
                ns.st := 8
                ns.why := "no opposing candle run before the sweep (CISD reference unavailable)"
                f_why("CISD reference unavailable", "sweep of " + best.ty + " rejected: " + ns.why)
            else
                ns.st := 1
                ns.cisdRef := ref
                ns.refOpen := refOpen
                f_cxRb(ns, A)
            sets.push(ns)
            while sets.size() > 60
                sets.shift()
            st := ns
    // [GUIDE] CISD: a LATER candle must CLOSE through the frozen reference (the sweep candle itself cannot confirm it)
    if not na(st) and st.st == 1 and st.swOpen != c0t
        st.cnt += 1
        st.ext := st.dir > 0 ? math.min(st.ext, f_ag(A.L, 0)) : math.max(st.ext, f_ag(A.H, 0))
        f_cxRb(st, A)
        float cc = f_ag(A.C, 0)
        if st.dir > 0 ? cc > st.cisdRef : cc < st.cisdRef
            f_cxCisd(st, A)
        else if st.cnt >= inCxSwAge
            st.st := 8
            st.why := "reversal (CISD) not confirmed within " + str.tostring(inCxSwAge) + " candles"
            f_why("no CISD", "setup #" + str.tostring(st.id) + ": " + st.why)
    else if not na(st) and st.st == 2
        bool busy = (not na(st.mdlS) and (st.mdlS.st == 2 or st.mdlS.st == 3)) or (not na(st.mdlP) and (st.mdlP.st == 2 or st.mdlP.st == 3))
        if time_close - st.cisdT > inCxAgeMin * 60000 and not busy
            st.st := 8
            st.why := "setup expired: no order within " + str.tostring(inCxAgeMin) + " minutes of the CISD"
            f_why("setup expired", "setup #" + str.tostring(st.id) + ": " + st.why)
        else
            f_cxRb(st, A)
            f_cxCollect(st)
            f_cxBrk(st, A)
    true


// ---- price areas: staleness, selection ----
// An area dies when a 1m candle CLOSES through its far side. It is stale once price has traded to its CE after it became known
// (a limit at the CE would then already have been touched), so it can never be armed retroactively.
f_cxAreaUpdate(Setup st) =>
    bool bull = st.dir > 0
    for a in st.areas
        if not a.dead
            if a.known <= time and not a.stale
                if bull ? low <= a.ce : high >= a.ce
                    a.stale := true
            if bull ? close < a.lo : close > a.hi
                a.dead := true
    true

f_cxOverlap(Area a, float lo, float hi) =>
    a.hi > lo and a.lo < hi

// [OURS] selected HTF POI: the latest live FVG of the setup direction on the chosen timeframe (known before now)
f_cxPoi(int d) =>
    float lo = na
    float hi = na
    if inPoi != "None"
        array<Fvg> pl = inPoi == "15m FVG" ? poi15 : poi60
        if pl.size() > 0
            for i = pl.size() - 1 to 0
                Fvg f = pl.get(i)
                if f.dir == d and not f.dead and f.known <= time_close
                    lo := f.lo
                    hi := f.hi
                    break
    [lo, hi]

f_cxKindRank(string k) =>
    k == "OB" ? 0 : (k == "BRK" ? 1 : (k == "FVG" ? 2 : (k == "iFVG" ? 3 : 4)))

// Deterministic selection: (1) prefer areas overlapping the selected HTF POI, (2) otherwise the nearest CE to the last close on the retracement path,
// (3) tie -> most recently confirmed, then area type (OB, breaker, FVG, iFVG, rejection block). execSide=true also requires a not-stale CE on the
// executable side of the close (a buy limit below / sell limit above market). Only areas known at or before beforeT are candidates (an area that is
// created by the candle being judged can never be its own parent).
f_cxPick(Setup st, bool execSide, int beforeT) =>
    bool bull = st.dir > 0
    [plo, phi] = f_cxPoi(st.dir)
    Area best = na
    bool bestOv = false
    for a in st.areas
        bool okA = not a.dead and a.known <= beforeT
        if okA and execSide
            okA := not a.stale and (bull ? a.ce < close : a.ce > close)
        if okA
            bool ov = not na(plo) and f_cxOverlap(a, plo, phi)
            bool take = false
            if na(best)
                take := true
            else if ov != bestOv
                take := ov
            else
                float da = math.abs(a.ce - close)
                float db = math.abs(best.ce - close)
                if da != db
                    take := da < db
                else if a.known != best.known
                    take := a.known > best.known
                else
                    take := f_cxKindRank(a.kind) < f_cxKindRank(best.kind)
            if take
                best := a
                bestOv := ov
    best

// Nearest UNSWEPT opposing level that already existed when the order is armed (never a farther one, never a swept one)
f_cxTarget(int d, float entry) =>
    Lvl best = na
    for lv in lvls
        if lv.side == d and lv.st < 2 and lv.known <= time_close
            if d > 0 ? lv.px > entry + tk : lv.px < entry - tk
                if na(best) or (d > 0 ? lv.px < best.px : lv.px > best.px)
                    best := lv
    best

// [OPT] engineered-liquidity proximity: unswept same-side (stop side) liquidity within N points beyond the entry
f_cxCeProx(Setup st, float ce) =>
    bool hit = false
    for lv in lvls
        if lv.side == -st.dir and lv.st < 2 and lv.known <= time_close
            if st.dir > 0 ? (lv.px >= ce - inCeDist and lv.px <= ce) : (lv.px >= ce and lv.px <= ce + inCeDist)
                hit := true
    hit

// optional filters; returns the reason text ("" = passed)
f_cxFilters(Setup st, Area area) =>
    string r = ""
    bool bull = st.dir > 0
    for q = 0 to 4
        bool on = q == 0 ? inBiasD : (q == 1 ? inBias4 : (q == 2 ? inBias1 : (q == 3 ? inBias30 : inBias15)))
        int ix = q == 0 ? 6 : (q == 1 ? 5 : (q == 2 ? 4 : (q == 3 ? 3 : 2)))
        string nm = q == 0 ? "Daily" : (q == 1 ? "4H" : (q == 2 ? "1H" : (q == 3 ? "30m" : "15m")))
        if on and r == ""
            if na(prbT.get(ix)) or prbS.get(ix) == 0
                r := "prior-range state " + nm + " unavailable or none yet"
            else if (prbS.get(ix) > 0) != bull
                r := "prior-range state " + nm + " against the setup"
    if r == "" and inFPo3 and st.lvl.ty != "PO3H" and st.lvl.ty != "PO3L"
        r := "PO3 filter: the swept level is not the PO3 range"
    if r == "" and inFConf and not na(area)
        bool ov = false
        for a in st.areas
            if not a.dead and a.kind != area.kind and f_cxOverlap(a, area.lo, area.hi)
                ov := true
        if not ov
            r := "no FVG/breaker confluence with the parent area"
    if r == "" and inFIfvg
        bool has = false
        for a in st.areas
            if a.kind == "iFVG" and not a.dead
                has := true
        if not has
            r := "no iFVG confirmation"
    if r == "" and inFChop
        Agg A = f_cxSrc()
        if A.H.size() >= inChopN
            float net = math.abs(f_ag(A.C, 0) - f_ag(A.O, inChopN - 1))
            float path = 0.0
            for k = 0 to inChopN - 1
                path += f_ag(A.H, k) - f_ag(A.L, k)
            if path <= 0 or net / path < inChopMin
                r := "chop filter: efficiency ratio too low"
    if r == "" and inSmt != "Off" and st.smt != 1
        r := st.smt == 0 ? "SMT (reversal) not present" : "SMT data unavailable"
    r

// ---- sequence gating (per variant, per NY day) ----
// returns [multiplier, first trade's actual cash risk, reason]; multiplier 0 = not allowed now
f_cxSeq(int slot) =>
    float mult = 0.0
    float firstRisk = na
    string why = ""
    int doneN = 0
    float lastNet = na
    for t in trades
        if t.slot == slot and t.dayKey == dkey
            doneN += 1
            if doneN == 1
                firstRisk := t.riskUsd
                lastNet := t.netR
    bool pend = false
    for md in plans
        if md.slot == slot and md.dayKey == dkey and (md.st == 2 or md.st == 3)
            pend := true
    if pend
        why := "busy"
    else if doneN == 0
        mult := 1.0
    else if inSeq != "One trade per day" and doneN == 1 and not (not na(lastNet) and lastNet > 0)
        mult := 0.5
    else
        why := "daily sequence complete"
    [mult, firstRisk, why]

f_cxDrop(Mdl md, string why, string cat, int col) =>
    md.st := 4
    md.why := why
    f_cxFn(md, col)
    f_why(cat, md.meth + ": " + why)
    f_msgK(3, md.slot, "REJECTED - " + md.meth + ": " + why)
    false

f_cxNewMdl(int slot, Setup st, string meth) =>
    Mdl md = Mdl.new(slot = slot, dir = st.dir, dayKey = dkey, sid = st.id, xExt = st.ext, meth = meth)
    plans.push(md)
    while plans.size() > 150
        plans.shift()
    f_cxFn(md, 4)
    md

// entry/stop/target planning on ROUNDED prices; arms a limit order that is eligible from the NEXT candle
f_cxPlan(Setup st, Mdl md, float entryRaw, float stopRaw, int cap, float minR, float mult, float firstRisk) =>
    bool bull = st.dir > 0
    float entry = math.round_to_mintick(entryRaw)
    float stop = math.round_to_mintick(stopRaw)
    float dist = bull ? entry - stop : stop - entry
    int riskT = int(math.round(dist / tk))
    bool armed = false
    if riskT < 1
        f_cxDrop(md, "stop is not beyond the entry after rounding", "stop invalid", 8)
    else if riskT > cap
        f_cxDrop(md, "stop-cap rejection: " + str.tostring(riskT) + " ticks > " + str.tostring(cap) + " (never squeezed)", "stop cap", 8)
    else
        int qty = inQty
        float perC = riskT * tk * syminfo.pointvalue
        if inSizeMode == "Fixed cash risk"
            qty := int(math.floor(inCashRisk / perC))
        if mult != 1.0 and not na(firstRisk)
            qty := int(math.floor(mult * firstRisk / perC))
        if qty < 1
            f_cxDrop(md, "sizing rejection: one contract risks more than the budget", "sizing", 14)
        else
            float tgt = na
            Lvl tl = na
            string tt = "liquidity"
            if inCxTgt == "Fixed R"
                tgt := bull ? entry + inCxFixR * dist : entry - inCxFixR * dist
                tt := "fixed-R"
            else
                tl := f_cxTarget(st.dir, entry)
                tgt := na(tl) ? na : tl.px
            if na(tgt)
                f_cxDrop(md, "no eligible unswept opposing liquidity target", "no target", 11)
            else
                float tgtR = math.round_to_mintick(tgt)
                float pR = math.abs(tgtR - entry) / dist
                if pR < minR - 0.000000001
                    f_cxDrop(md, "minimum-R rejection: planned " + str.tostring(pR, "#.00") + "R < " + str.tostring(minR, "#.0") + "R", "min R", 13)
                else
                    md.lim := entry
                    md.stp := stop
                    md.tgt := tgtR
                    md.qty := qty
                    md.plannedR := pR
                    md.tgtType := tt
                    md.tgtId := na(tl) ? 0 : tl.id
                    md.tgtTy := na(tl) ? "fixed-R" : tl.ty
                    md.mult := mult
                    md.st := 2
                    md.armBar := bar_index
                    md.armT := time_close
                    f_cxFn(md, 5)
                    armed := true
                    f_msgK(1, md.slot, "ORDER ARMED (simulated limit, NOT a fill) setup #" + str.tostring(st.id) + " " + md.meth + " " + (bull ? "LONG" : "SHORT") + " limit " + str.tostring(entry, format.mintick) + " stop " + str.tostring(stop, format.mintick) + " (" + str.tostring(riskT) + " ticks) target " + str.tostring(tgtR, format.mintick) + " (" + tt + ", planned " + str.tostring(pR, "#.0") + "R)")
    armed

// Entry eligibility is separate from context ingestion: orders may be armed only inside the window on Monday-Friday (NY calendar day of the candle).
// Sunday-evening and overnight data still feed levels, ranges and aggregation.
f_cxArmWin() =>
    dowN >= dayofweek.monday and dowN <= dayofweek.friday and mOpen >= winS and mOpen < cutM

// ---- Standard: limit at the CE of the selected area; stop beyond the FULL setup sweep extreme ----
f_cxTryStd(Setup st) =>
    if slotOn.get(SC_STD) and st.stdSt == 0 and f_cxArmWin()
        [mult, firstRisk, why] = f_cxSeq(SC_STD)
        if mult == 0.0
            if why != "busy"
                st.stdSt := 2
                f_why("daily sequence", "Standard: " + why)
        else
            Area area = f_cxPick(st, true, time_close)
            if not na(area)
                st.stdSt := 2
                Mdl md = f_cxNewMdl(SC_STD, st, "Area CE")
                st.mdlS := md
                md.areaK := area.kind
                md.aLo := area.lo
                md.aHi := area.hi
                md.aCe := area.ce
                string fl = f_cxFilters(st, area)
                if fl != ""
                    f_cxDrop(md, fl, "filter", 12)
                else if inFCe and f_cxCeProx(st, area.ce)
                    f_cxDrop(md, "engineered-liquidity proximity: same-side liquidity within " + str.tostring(inCeDist, "#.0") + " pts beyond the CE", "filter", 12)
                else
                    float stopRaw = st.dir > 0 ? st.ext - inCxBuf * tk : st.ext + inCxBuf * tk
                    if f_cxPlan(st, md, area.ce, stopRaw, inCxCap, inCxMinR, mult, firstRisk)
                        st.stdSt := 1
    true

// ---- Precision A: Fib. Anchors = sweep extreme + the FIRST confirmed swing after the CISD (known only when its right side closed) ----
// Endpoint DETECTION, stale TRACKING and order ARMING are separate: the first eligible endpoint is stored with its original confirmation time whether or not
// the entry window is open, it is never replaced by a later swing, it becomes stale the moment price trades to the entry level, and it is armed only inside the
// entry window and only if it is still eligible then.
f_cxFibEntry(Setup st) =>
    bool bull = st.dir > 0
    float hx = bull ? st.fibPx : st.ext
    float lx = bull ? st.ext : st.fibPx
    float rg = hx - lx
    float e = bull ? hx - inFibE * rg : lx + inFibE * rg
    float ref = bull ? hx - inFibS * rg : lx + inFibS * rg
    [rg, e, ref]

f_cxFibDetect(Setup st, Agg A) =>
    if slotOn.get(SC_PRE) and inPFibOn and st.fibSt == 0
        bool bull = st.dir > 0
        int q = bull ? 0 : 1
        if not na(pvKn.get(q)) and pvKn.get(q) == time_close and pvOp.get(q) >= st.cisdOpen
            st.fibSt := 1
            st.fibPx := pvPx.get(q)
            st.fibOp := pvOp.get(q)
            st.fibKn := pvKn.get(q)
            [rg, e, ref] = f_cxFibEntry(st)
            float eR = math.round_to_mintick(e)
            // stale: the candles AFTER the swing candle are all known now; if any already reached the entry it was traversed before the anchor existed
            bool trav = false
            int n = A.H.size()
            for i = 0 to n - 1
                if A.T0.get(i) > st.fibOp
                    trav := trav or (bull ? A.L.get(i) <= eR : A.H.get(i) >= eR)
            if rg <= 0
                st.fibSt := 3
                f_why("fib invalid", "Fib: the leg has no size")
                f_fn(SC_PRE, 8)
                f_fn(7, 8)
            else if trav or not (bull ? eR < close : eR > close)
                st.fibSt := 3
                f_why("stale fib", "Fib: " + str.tostring(inFibE, "#.000") + " (" + str.tostring(eR, format.mintick) + ") was already traversed before the swing anchor (confirmed " + f_hm(st.fibKn) + ") existed; no back-dated entry")
                f_fn(SC_PRE, 12)
                f_fn(7, 12)
    true

// every 1m candle: a stored candidate dies as soon as price trades to its entry level (a limit placed later would be retroactive)
f_cxFibTrack(Setup st) =>
    if st.fibSt == 1 and time >= st.fibKn
        [rg, e, ref] = f_cxFibEntry(st)
        float eR = math.round_to_mintick(e)
        if st.dir > 0 ? low <= eR : high >= eR
            st.fibSt := 3
            f_why("stale fib", "Fib: price traded to " + str.tostring(eR, format.mintick) + " after the anchor was confirmed (" + f_hm(st.fibKn) + ") and before an order could be armed")
            f_fn(SC_PRE, 12)
            f_fn(7, 12)
    true

f_cxFibArm(Setup st) =>
    if slotOn.get(SC_PRE) and st.fibSt == 1 and f_cxArmWin()
        [mult, firstRisk, why] = f_cxSeq(SC_PRE)
        if mult == 0.0
            if why != "busy"
                st.fibSt := 3
                f_why("daily sequence", "Precision Fib: " + why)
        else
            bool bull = st.dir > 0
            Mdl md = f_cxNewMdl(SC_PRE, st, "Fib 0.705")
            st.mdlP := md
            st.fibSt := 3
            md.fH := bull ? st.fibPx : st.ext
            md.fL := bull ? st.ext : st.fibPx
            // a VALID parent area is required for Precision (independent of the optional overlap filter below)
            Area par = f_cxPick(st, false, time_close)
            if na(par)
                f_cxDrop(md, "no valid parent area for Precision (none known, alive and eligible)", "no parent", 12)
            else
                md.areaK := par.kind
                md.aLo := par.lo
                md.aHi := par.hi
                md.aCe := par.ce
                md.parId := par.id
                [rg, e, ref] = f_cxFibEntry(st)
                float eR = math.round_to_mintick(e)
                if not (bull ? eR < close : eR > close)
                    f_cxDrop(md, "stale: the entry is no longer on the executable side of the market", "stale fib", 12)
                else if inFibArea and (eR < par.lo or eR > par.hi)
                    f_cxDrop(md, "Fib entry does not overlap the selected parent area (optional condition)", "filter", 12)
                else
                    string fl = f_cxFilters(st, par)
                    if fl != ""
                        f_cxDrop(md, fl, "filter", 12)
                    else if inFCe and f_cxCeProx(st, eR)
                        f_cxDrop(md, "engineered-liquidity proximity beyond the entry", "filter", 12)
                    else
                        float stopRaw = bull ? ref - inCxPBuf * tk : ref + inCxPBuf * tk
                        if f_cxPlan(st, md, e, stopRaw, inCxPCap, inCxPMinR, mult, firstRisk)
                            st.precSt := 1
    true

// ---- Precision B: a completed local rejection candle interacting with the parent area; entry = midpoint of the confirmed wick ----
f_cxTryRej(Setup st, Agg R) =>
    // SEQUENCE: CISD confirmed -> parent area known -> THEN a rejection candle that OPENED after both. The candle cannot create its own parent.
    int rOpen = f_agI(R.T0, 0)
    if slotOn.get(SC_PRE) and inPRejOn and st.precSt != 1 and f_cxArmWin() and rOpen >= st.cisdT
        bool bull = st.dir > 0
        Area par = f_cxPick(st, false, rOpen)
        if not na(par)
            float h0 = f_ag(R.H, 0)
            float l0 = f_ag(R.L, 0)
            float o0 = f_ag(R.O, 0)
            float c0 = f_ag(R.C, 0)
            float rng = h0 - l0
            bool inter = h0 > par.lo and l0 < par.hi
            float bLo = math.min(o0, c0)
            float bHi = math.max(o0, c0)
            float wick = bull ? bLo - l0 : h0 - bHi
            bool dirOk = bull ? c0 > o0 : c0 < o0
            bool intact = bull ? l0 > st.ext : h0 < st.ext
            bool sw = true
            if inRejSweep
                sw := R.H.size() >= 2 and (bull ? l0 < f_ag(R.L, 1) : h0 > f_ag(R.H, 1))
            if rng > 0 and inter and dirOk and intact and sw and wick >= inRejWick * rng - 0.000000001
                [mult, firstRisk, why] = f_cxSeq(SC_PRE)
                if mult == 0.0
                    if why != "busy"
                        f_why("daily sequence", "Precision: " + why)
                else
                    Mdl md = f_cxNewMdl(SC_PRE, st, "Rejection CE")
                    st.mdlP := md
                    md.areaK := par.kind
                    md.aLo := par.lo
                    md.aHi := par.hi
                    md.aCe := par.ce
                    md.parId := par.id
                    md.rLo := l0
                    md.rHi := h0
                    md.rT := f_agI(R.T0, 0)
                    float e = bull ? (l0 + bLo) / 2.0 : (h0 + bHi) / 2.0
                    string fl = f_cxFilters(st, par)
                    if fl != ""
                        f_cxDrop(md, fl, "filter", 12)
                    else if inFCe and f_cxCeProx(st, math.round_to_mintick(e))
                        f_cxDrop(md, "engineered-liquidity proximity beyond the entry", "filter", 12)
                    else
                        float stopRaw = bull ? l0 - inCxPBuf * tk : h0 + inCxPBuf * tk
                        if f_cxPlan(st, md, e, stopRaw, inCxPCap, inCxPMinR, mult, firstRisk)
                            st.precSt := 1
    true

// ---- plan lifecycle: pending -> filled -> closed (shared simulation rules of the legacy engine, direction taken from the plan) ----
f_cxFinish(Mdl md, int outcome, float exitPx, int exitTime, string note) =>
    f_finish(md, outcome, exitPx, exitTime, note)
    Setup st = f_cxSetupBy(md.sid)
    if not na(st)
        if md.slot == SC_STD
            st.stdSt := 2
        else
            st.precSt := outcome == 1 ? 2 : 0
    if outcome == 4 and md.slot == SC_PRE
        f_fn(md.meth == "Fib 0.705" ? 7 : 8, 10)
    f_msgK(4, md.slot, (outcome == 1 ? "TARGET" : (outcome == 2 ? "STOP" : (outcome == 3 ? "TIME EXIT" : "AMBIGUOUS (counted as loss)"))) + " setup #" + str.tostring(md.sid) + " " + md.meth + " " + (md.dir > 0 ? "LONG" : "SHORT") + " exit " + str.tostring(exitPx, format.mintick) + " (" + str.tostring(md.tr.netR, "#.00") + "R net, simulated)")
    true

f_cxAfterCancel(Mdl md, bool setupDead) =>
    Setup st = f_cxSetupBy(md.sid)
    if not na(st)
        if md.slot == SC_STD
            st.stdSt := 2
        else
            st.precSt := 0
        if setupDead
            st.st := 8
            st.why := md.why
    true

f_cxFillTry(Mdl md) =>
    bool bull = md.dir > 0
    float lim = md.lim
    float thrP = inStrict ? tk : 0.0
    bool touch = bull ? low <= lim - thrP : high >= lim + thrP
    if touch
        bool known = bull ? open <= lim - thrP : open >= lim + thrP
        float stp = md.stp
        float tgt = md.tgt
        Setup st = f_cxSetupBy(md.sid)
        float lvlPx = na(st) ? na : st.lvl.px
        Trade t = Trade.new(slot = md.slot, dir = md.dir, dayKey = md.dayKey, lvl = lvlPx, entryPx = lim, stopPx = stp, tgtPx = tgt, riskPts = math.abs(lim - stp), armT = md.armT, fillT = time, qty = md.qty, plannedR = md.plannedR, tgtType = md.tgtType, riskUsd = math.abs(lim - stp) * syminfo.pointvalue * md.qty, note = md.meth + " | setup #" + str.tostring(md.sid) + " | plan " + str.tostring(md.plannedR, "#.0") + "R " + md.tgtType + (md.plannedR >= 4.0 ? " (4R+)" : ""), meth = md.meth, sid = md.sid)
        md.tr := t
        md.st := 3
        trades.push(t)
        f_cxFn(md, 6)
        f_msgK(2, md.slot, "SIMULATED FILL (limit touch assumed) setup #" + str.tostring(md.sid) + " " + md.meth + " " + (bull ? "LONG" : "SHORT") + " at " + str.tostring(lim, format.mintick) + " stop " + str.tostring(stp, format.mintick) + " target " + str.tostring(tgt, format.mintick))
        bool stopHit = bull ? low <= stp : high >= stp
        bool tgtTouch = bull ? high >= tgt : low <= tgt
        float adv = bull ? lim - low : high - lim
        float fav = bull ? high - lim : lim - low
        t.maeP := math.max(0.0, adv)
        if known
            t.mfeP := math.max(0.0, fav)
        else
            t.mfeP := 0.0
            t.excUnc := fav > 0
            t.entryAmb := tgtTouch or fav > 0
        bool gapStop = bull ? open <= stp : open >= stp
        if gapStop
            // EXECUTION POLICY (gap through entry AND stop): the active resting limit is assumed filled at the limit price (no improvement) and stopped at
            // the open. Real prices cannot be known from OHLC, so the trade is flagged ambiguous, counted as a loss at the worse bound and counted as a gap event.
            t.gap := true
            t.maeP := math.max(t.maeP, bull ? lim - open : open - lim)
            t.excUnc := true
            f_cxFinish(md, 4, open, time, "gap through entry AND stop: resting limit assumed filled at the limit, stopped at the open (conservative, ambiguous)")
        else if stopHit and tgtTouch
            t.maeP := math.max(t.maeP, t.riskPts)
            t.excUnc := true
            f_cxFinish(md, 4, stp, time, "ambiguous: stop and target both reachable on the fill candle")
        else if stopHit
            t.maeP := math.max(t.maeP, t.riskPts)
            f_cxFinish(md, 2, stp, time, "stop hit on the fill candle")
        else if known and tgtTouch
            t.mfeP := math.max(t.mfeP, math.abs(tgt - lim))
            f_cxFinish(md, 1, tgt, time, "target hit on the fill candle (fill at the open)")
    true

f_cxPosStep(Mdl md) =>
    Trade t = md.tr
    bool bull = t.dir > 0
    float stp = md.stp
    float tgt = md.tgt
    float ent = t.entryPx
    bool gStop = bull ? open <= stp : open >= stp
    bool gTgt = bull ? open >= tgt : open <= tgt
    bool stopHit = bull ? low <= stp : high >= stp
    bool tgtHit = bull ? high >= tgt : low <= tgt
    float adv = bull ? ent - low : high - ent
    float fav = bull ? high - ent : ent - low
    float pMae = t.maeP
    float pMfe = t.mfeP
    float tgtD = math.abs(tgt - ent)
    if gStop
        t.maeP := math.max(pMae, bull ? ent - open : open - ent)
        f_cxFinish(md, 2, open, time, "gap through the stop: exit at the open")
    else if gTgt
        t.mfeP := math.max(pMfe, tgtD)
        f_cxFinish(md, 1, tgt, time, "gap through the target: filled at the target (no improvement)")
    else if stopHit and tgtHit
        t.maeP := math.max(pMae, t.riskPts)
        t.mfeP := math.max(pMfe, fav)
        t.excUnc := true
        f_cxFinish(md, 4, stp, time, "ambiguous: stop and target both reachable on one candle")
    else if stopHit
        t.maeP := math.max(pMae, t.riskPts)
        t.excUnc := t.excUnc or fav > pMfe
        f_cxFinish(md, 2, stp, time, "stop hit")
    else if tgtHit
        t.mfeP := math.max(pMfe, tgtD)
        t.maeP := math.max(pMae, adv)
        t.excUnc := t.excUnc or adv > pMae
        f_cxFinish(md, 1, tgt, time, "target hit")
    else
        t.maeP := math.max(pMae, adv)
        t.mfeP := math.max(pMfe, fav)
    true

f_cxCancel(Mdl md, string why, int col, bool setupDead) =>
    md.st := 4
    md.why := why
    f_cxFn(md, col)
    f_msgK(3, md.slot, "CANCELLED/INVALIDATED setup #" + str.tostring(md.sid) + " " + md.meth + " - " + why)
    f_why(col == 9 ? "invalidated" : "unfilled / cancelled", md.meth + ": " + why)
    f_cxAfterCancel(md, setupDead)
    true

f_cxPlanStep(Mdl md) =>
    bool bull = md.dir > 0
    if md.st == 3
        if mOpen >= exitM
            f_cxFinish(md, 3, open, time, "time exit at the hard-exit candle open")
        else
            f_cxPosStep(md)
    else if md.st == 2 and bar_index > md.armBar
        float thrP = inStrict ? tk : 0.0
        if mOpen >= cutM
            f_cxCancel(md, "unfilled: cancelled at the entry cutoff", 7, false)
        else if bar_index > md.armBar + inCxExp
            f_cxCancel(md, "expired: not filled within " + str.tostring(inCxExp) + " candles", 7, false)
        else
            // No cancellation on a gap: an active resting limit is never assumed cancelled before the market gaps through it. A candle that opens beyond
            // the entry fills (touch), and one that opens beyond the STOP is a flagged gap event (see f_cxFillTry), never a silent non-trade.
            bool touchE = bull ? low <= md.lim - thrP : high >= md.lim + thrP
            bool tgtFirst = not touchE and (bull ? high >= md.tgt : low <= md.tgt)
            if tgtFirst
                f_cxCancel(md, "cancelled: the target liquidity was taken before the entry", 7, false)
            else
                f_cxFillTry(md)
    true

// ---- one 1m candle of the contextual engine (called only on confirmed candles) ----
// the source timeframe lost a candle: nothing may span the hole, and a setup that still waits for its CISD cannot be tracked
f_cxSrcBad() =>
    fvgs.clear()
    eqP.clear()
    swgs.clear()
    for q = 0 to 1
        pvPx.set(q, na)
        pvOp.set(q, na)
        pvKn.set(q, na)
    Setup st = f_cxCur()
    if not na(st) and st.st == 1
        st.st := 8
        st.why := "source candle incomplete (missing 1m data): CISD tracking cannot continue"
        f_why("incomplete data", "setup #" + str.tostring(st.id) + ": " + st.why)
    true

f_cxBar(Day dy) =>
    // coverage (entry-day bookkeeping only: context ingestion below runs on EVERY candle, including Sunday evening)
    if dy.active and mOpen >= winS and mOpen < exitM
        dy.bars10 += 1
    if dy.active and dy.st == 0 and mOpen >= winS
        if mOpen != winS
            dy.st := 9
            dy.status := 2
            dy.why := "window start candle missing (first candle at/after the window is " + f_hm(time) + ")"
        else
            dy.st := 1
            bool anyLv = false
            for lv in lvls
                if lv.side != 0 and lv.st < 2
                    anyLv := true
            if not anyLv
                dy.status := 4
                dy.why := "no eligible liquidity level was known at the window start (warm-up / missing session data)"
            else
                f_fnA(0)
    // a new trading day (18:00 NY) ends yesterday's un-armed setups: the sweep horizon is the current trading day
    if cxN.get(3) != tdk
        cxN.set(3, tdk)
        for q in sets
            if (q.st == 1 or q.st == 2) and not ((not na(q.mdlS) and (q.mdlS.st == 2 or q.mdlS.st == 3)) or (not na(q.mdlP) and (q.mdlP.st == 2 or q.mdlP.st == 3)))
                q.st := 8
                q.why := "new trading day"
        dayWhy.clear()
    // SMT buffers (1m)
    if inSmt != "Off"
        sBt.push(time)
        sEsL.push(esL)
        sEsH.push(esH)
        sNqL.push(low)
        sNqH.push(high)
        if sBt.size() > 300
            sBt.shift()
            sEsL.shift()
            sEsH.shift()
            sNqL.shift()
            sNqH.shift()
    // 1) level statuses (existing levels only), area staleness
    f_cxLvlStatus()
    Setup st = f_cxCur()
    if not na(st) and st.st == 2
        f_cxAreaUpdate(st)
        f_cxFibTrack(st)
    // 2) pending / open plans first: they only react to candles AFTER their arming candle
    for md in plans
        if md.st == 2 or md.st == 3
            f_cxPlanStep(md)
    // 3) a setup that has no order yet dies when any candle exceeds its frozen sweep extreme
    if not na(st) and st.st == 2 and (st.dir > 0 ? low < st.ext : high > st.ext)
        bool busy = (not na(st.mdlS) and (st.mdlS.st == 2 or st.mdlS.st == 3)) or (not na(st.mdlP) and (st.mdlP.st == 2 or st.mdlP.st == 3))
        if not busy
            st.st := 8
            st.why := "setup invalidated: price exceeded the frozen sweep extreme " + str.tostring(st.ext, format.mintick)
            f_why("invalidated", "setup #" + str.tostring(st.id) + ": " + st.why)
            f_fnA2(9)
    // 3b) aggregation
    for i = 0 to 6
        f_aggStep(aggs.get(i))
    Agg dA = aggs.get(6)
    if dA.nw and inCxLvPD
        f_newLevel("PDH", 1, f_ag(dA.H, 0), f_agI(dA.T0, 0), time_close, true)
        f_newLevel("PDL", -1, f_ag(dA.L, 0), f_agI(dA.T0, 0), time_close, true)
    for i = 2 to 6
        f_cxPrb(i, aggs.get(i))
    // 4) levels created at THIS candle's close
    f_cxLevelsBar()
    // 5) source candle / local rejection candle events
    Agg A = f_cxSrc()
    Agg R = aggs.get(inRejTf == "1m" ? 0 : 1)
    if A.bad
        f_cxSrcBad()
    if A.nw
        f_cxSource(A)
        st := f_cxCur()
        if not na(st) and st.st == 2
            if not st.hadArea and st.areas.size() > 0
                st.hadArea := true
                f_fnA2(3)
            f_cxFibDetect(st, A)
    st := f_cxCur()
    if not na(st) and st.st == 2
        f_cxFibArm(st)
    st := f_cxCur()
    if R.nw and not na(st) and st.st == 2
        f_cxTryRej(st, R)
    // 6) Standard arming is evaluated on every 1m candle
    st := f_cxCur()
    if not na(st) and st.st == 2
        f_cxTryStd(st)
    true

f_cxFinalize(Day dy, float lastC, int lastT) =>
    if dy.active
        for md in plans
            if md.dayKey == dy.key
                if md.st == 3
                    f_cxFinish(md, 3, lastC, lastT, "forced close at the last candle: no candle at/after the hard exit (data missing)")
                else if md.st == 2
                    md.st := 4
                    md.why := "cancelled: the day ended with the order still pending"
                    f_cxFn(md, 7)
        if dy.st == 0
            dy.status := 2
            dy.why := "no candle at/after the window start"
        if dy.status == 0 and dy.bars10 < exitM - winS
            dy.status := 1
        cv.set(0, cv.get(0) + 1)
        cv.set(dy.status + 1, cv.get(dy.status + 1) + 1)
        if inDebug
            log.info("H Ticks C ctx | " + f_dt(dy.key) + " coverage " + str.tostring(dy.status) + " | " + dy.why)
    true

// ───────────────────────────────────────── MAIN LOOP ─────────────────────────────────────────
if supported and cfgAll and barstate.isconfirmed
    aMsgs.clear()
    for q = 0 to 4
        evK.set(q, 0)
    bufH.push(high)
    bufL.push(low)
    bufI.push(bar_index)
    bufT.push(time)
    while bufH.size() > 12
        bufH.shift()
        bufL.shift()
        bufI.shift()
        bufT.shift()
    if mOpen >= 960 and (na(pM) or pM < 960)
        sHi := high
        sLo := low
    else
        sHi := na(sHi) ? high : math.max(sHi, high)
        sLo := na(sLo) ? low : math.min(sLo, low)
    pM := mOpen
    if na(cur) or cur.key != dkey
        if not na(cur)
            if isCx
                f_cxFinalize(cur, pClose, pCloseT)
            else
                f_finalize(cur, pClose, pCloseT)
            if cur.active
                lastAct := cur
        cur := f_newDay(dkey, dowN, lastAct)
        days.push(cur)
        while days.size() > 80
            days.shift()
        if cur.active
            if na(firstKey)
                firstKey := dkey
            lastKey := dkey
    if isCx
        f_cxBar(cur)
    else if cur.active
        f_dayStep(cur)
    pClose := close
    pCloseT := time_close
    if barstate.isrealtime and aMsgs.size() > 0
        alert(array.join(aMsgs, "\n"), alert.freq_once_per_bar_close)

bool evNow = supported and cfgAll and barstate.isrealtime and barstate.isconfirmed
alertcondition(evNow and evK.get(0) > 0, "Setup ready", "H Ticks C: setup ready (reversal confirmed) on {{ticker}}")
alertcondition(evNow and evK.get(1) > 0, "Order armed", "H Ticks C: order ARMED (simulated limit, not a fill) on {{ticker}}")
alertcondition(evNow and evK.get(2) > 0, "Simulated fill", "H Ticks C: SIMULATED FILL on {{ticker}}")
alertcondition(evNow and evK.get(3) > 0, "Invalidation / cancellation", "H Ticks C: setup invalidated or order cancelled on {{ticker}}")
alertcondition(evNow and evK.get(4) > 0, "Simulated exit", "H Ticks C: simulated stop / target / time exit on {{ticker}}")

// ───────────────────────────────────────── STATISTICS ─────────────────────────────────────────
f_fmt(float v, string f) =>
    na(v) ? "-" : str.tostring(v, f)

// Statistics for one model from CLOSED trades (expired / cancelled / unfilled orders never create a trade, so they are excluded from every rate).
// Indices: 0 counted trades, 1 wins (target), 2 losses (stop + ambiguous at the stop), 3 time exits, 4 ambiguous, 5 net win rate %, 6 net expectancy R,
// 7 profit factor, 8 avg winner R, 9 avg loser R, 10 max consecutive losses, 11 max closed-equity drawdown R, 12 same in USD, 13 net R total,
// 14 avg MAE pts, 15 avg MAE R, 16 median MAE pts, 17 median MAE R, 18 median MAE of winners pts, 19 same in R, 20 % winners with MAE <= 0.25R,
// 21 avg MFE pts, 22 avg MFE R, 23 trades with uncertain excursions, 24 open trades, 25 net USD total, 26 excluded ambiguous,
// 27 gross expectancy R, 28 avg stop distance (ticks), 29 avg planned R, 30 avg actual risk USD (after whole-contract rounding).
f_perf(int slot, string meth) =>
    array<float> r = array.new_float(34, 0.0)
    array<float> maeP = array.new_float(0)
    array<float> maeR = array.new_float(0)
    array<float> maeWP = array.new_float(0)
    array<float> maeWR = array.new_float(0)
    int cntT = 0
    int wins = 0
    int losses = 0
    int tex = 0
    int amb = 0
    int pos = 0
    int neg = 0
    int unc = 0
    int openN = 0
    int exAmb = 0
    int nPlan = 0
    float gw = 0.0
    float gl = 0.0
    float sumNet = 0.0
    float sumGross = 0.0
    float sumUsd = 0.0
    float sumStopT = 0.0
    float sumPlan = 0.0
    float sumRisk = 0.0
    float eq = 0.0
    float pk = 0.0
    float dd = 0.0
    float eqU = 0.0
    float pkU = 0.0
    float ddU = 0.0
    int consec = 0
    int maxC = 0
    float sMae = 0.0
    float sMaeR = 0.0
    float sMfe = 0.0
    float sMfeR = 0.0
    int winLow = 0
    int nW = 0
    int n4 = 0
    int n5 = 0
    int nGap = 0
    int n = trades.size()
    if n > 0
        for i = 0 to n - 1
            Trade t = trades.get(i)
            if t.slot == slot and (meth == "" or t.meth == meth)
                if t.isOpen
                    openN += 1
                else if t.outcome == 4 and inAmbMode == "Exclude from stats" and not t.gap
                    exAmb += 1
                else
                    cntT += 1
                    float nr = na(t.netR) ? 0.0 : t.netR
                    float gr = na(t.grossR) ? 0.0 : t.grossR
                    float rk = t.riskPts > 0 ? t.riskPts : 1.0
                    if t.outcome == 1
                        wins += 1
                    else if t.outcome == 3
                        tex += 1
                    else
                        losses += 1
                    if t.outcome == 4
                        amb += 1
                    if t.gap
                        nGap += 1
                    if t.excUnc or t.entryAmb
                        unc += 1
                    sumNet += nr
                    sumGross += gr
                    sumUsd += t.netUsd
                    sumStopT += t.riskPts / tk
                    sumRisk += t.riskUsd
                    if not na(t.plannedR)
                        sumPlan += t.plannedR
                        nPlan += 1
                        if t.plannedR >= 4.0
                            n4 += 1
                        if t.plannedR >= 5.0
                            n5 += 1
                    if nr > 0
                        pos += 1
                        gw += nr
                        maeWP.push(t.maeP)
                        maeWR.push(t.maeP / rk)
                        nW += 1
                        if t.maeP / rk <= 0.25
                            winLow += 1
                    else if nr < 0
                        gl += -nr
                        neg += 1
                    if nr < 0
                        consec += 1
                        maxC := math.max(maxC, consec)
                    else
                        consec := 0
                    eq += nr
                    pk := math.max(pk, eq)
                    dd := math.max(dd, pk - eq)
                    eqU += t.netUsd
                    pkU := math.max(pkU, eqU)
                    ddU := math.max(ddU, pkU - eqU)
                    sMae += t.maeP
                    sMaeR += t.maeP / rk
                    sMfe += t.mfeP
                    sMfeR += t.mfeP / rk
                    maeP.push(t.maeP)
                    maeR.push(t.maeP / rk)
    r.set(0, cntT)
    r.set(1, wins)
    r.set(2, losses)
    r.set(3, tex)
    r.set(4, amb)
    r.set(5, cntT > 0 ? 100.0 * pos / cntT : na)
    r.set(6, cntT > 0 ? sumNet / cntT : na)
    r.set(7, gl > 0 ? gw / gl : na)
    r.set(8, pos > 0 ? gw / pos : na)
    r.set(9, neg > 0 ? -gl / neg : na)
    r.set(10, maxC)
    r.set(11, dd)
    r.set(12, ddU)
    r.set(13, sumNet)
    r.set(14, cntT > 0 ? sMae / cntT : na)
    r.set(15, cntT > 0 ? sMaeR / cntT : na)
    r.set(16, maeP.size() > 0 ? maeP.median() : na)
    r.set(17, maeR.size() > 0 ? maeR.median() : na)
    r.set(18, maeWP.size() > 0 ? maeWP.median() : na)
    r.set(19, maeWR.size() > 0 ? maeWR.median() : na)
    r.set(20, nW > 0 ? 100.0 * winLow / nW : na)
    r.set(21, cntT > 0 ? sMfe / cntT : na)
    r.set(22, cntT > 0 ? sMfeR / cntT : na)
    r.set(23, unc)
    r.set(24, openN)
    r.set(25, sumUsd)
    r.set(26, exAmb)
    r.set(27, cntT > 0 ? sumGross / cntT : na)
    r.set(28, cntT > 0 ? sumStopT / cntT : na)
    r.set(29, nPlan > 0 ? sumPlan / nPlan : na)
    r.set(30, cntT > 0 ? sumRisk / cntT : na)
    r.set(31, n4)
    r.set(32, n5)
    r.set(33, nGap)
    r

f_weekdays(int k1, int k2) =>
    int t0 = f_ts(k1, 720)
    int t1 = f_ts(k2, 720)
    int c = 0
    int t = t0
    while t <= t1
        int dw = dayofweek(t, TZ)
        if dw >= dayofweek.monday and dw <= dayofweek.friday
            c += 1
        t += 86400000
    c

// ───────────────────────────────────────── DRAWINGS ─────────────────────────────────────────
f_clearDraw() =>
    while dLines.size() > 0
        line.delete(dLines.pop())
    while dBoxes.size() > 0
        box.delete(dBoxes.pop())
    while dLabels.size() > 0
        label.delete(dLabels.pop())
    true

f_ln(int x1, float y1, int x2, float y2, color c, string sty, int w) =>
    dLines.push(line.new(x1 = x1, y1 = y1, x2 = x2, y2 = y2, xloc = xloc.bar_time, color = c, style = sty, width = w))
    true

f_bx(int x1, float top, int x2, float bot, color bg, color bc) =>
    dBoxes.push(box.new(left = x1, top = top, right = x2, bottom = bot, xloc = xloc.bar_time, border_color = bc, border_width = 1, bgcolor = bg))
    true

f_bxs(int x1, float top, int x2, float bot, color bg, color bc, string sty) =>
    dBoxes.push(box.new(left = x1, top = top, right = x2, bottom = bot, xloc = xloc.bar_time, border_color = bc, border_width = 1, border_style = sty, bgcolor = bg))
    true

f_lb(int x, float y, string txt, color tc, string sty, string tip) =>
    dLabels.push(label.new(x = x, y = y, text = txt, xloc = xloc.bar_time, style = sty, size = size.tiny, textcolor = tc, color = color.new(color.white, 15), tooltip = tip))
    true

// One planned order (entry / stop / target) of one model. Pending orders are dashed, filled positions solid, cancelled orders dotted grey,
// completed trades solid with an outcome label, so a pending level can never be mistaken for a confirmed fill.
f_drawPlan(Day dy, int slot) =>
    Mdl ms = dy.ms.get(slot)
    if not na(ms.lim)
        string pre = slot == 4 ? "PREC" : "STD"
        bool done = ms.st == 4 and not na(ms.tr)
        bool canc = ms.st == 4 and na(ms.tr)
        bool pend = ms.st == 2
        string stt = pend ? "PENDING" : (ms.st == 3 ? "FILLED" : (done ? "DONE" : "CANCELLED"))
        string sty = pend ? line.style_dashed : (canc ? line.style_dotted : line.style_solid)
        color cE = canc ? color.gray : color.blue
        color cS = canc ? color.gray : color.red
        color cT = canc ? color.gray : color.green
        int xEnd = f_ts(dy.key, exitT)
        int xCut = f_ts(dy.key, cutT)
        int xPre = ms.armT + inPExp * chartMs
        int xe = xCut
        if done
            xe := ms.tr.exitT
        else if ms.st == 3
            xe := xEnd
        else if slot == 4
            xe := xPre
        float distP = math.abs(ms.lim - ms.stp)
        int distT = int(math.round(distP / tk))
        // position boxes like a trade tool: red = entry to stop, green = entry to target (dashed while only PENDING, grey when CANCELLED)
        int xs = (done or ms.st == 3) and not na(ms.tr) ? ms.tr.fillT : ms.armT
        color fillR = canc ? color.new(color.gray, 88) : color.new(color.red, pend ? 90 : 80)
        color fillG = canc ? color.new(color.gray, 88) : color.new(color.green, pend ? 90 : 80)
        f_bxs(xs, math.max(ms.lim, ms.stp), xe, math.min(ms.lim, ms.stp), fillR, cS, sty)
        f_bxs(xs, math.max(ms.lim, ms.tgt), xe, math.min(ms.lim, ms.tgt), fillG, cT, sty)
        f_ln(xs, ms.lim, xe, ms.lim, cE, line.style_solid, 2)
        f_lb(xe, ms.lim, pre + " ENTRY " + str.tostring(ms.lim, format.mintick) + " [" + stt + "]", cE, label.style_label_left, ms.why == "" ? stt : stt + ": " + ms.why)
        f_lb(xe, ms.stp, pre + " SL " + str.tostring(ms.stp, format.mintick) + " | " + str.tostring(distT) + " ticks / " + str.tostring(distP, "#.00") + " pts", cS, label.style_label_left, "planned stop distance")
        f_lb(xe, ms.tgt, pre + " TP " + str.tostring(ms.tgt, format.mintick) + " | plan " + str.tostring(ms.plannedR, "#.0") + "R " + ms.tgtType, cT, label.style_label_left, "planned reward; target type: " + ms.tgtType)
        if done
            f_lb(ms.tr.exitT, ms.tr.exitPx, pre + " " + (ms.tr.outcome == 1 ? "target" : (ms.tr.outcome == 2 ? "stop" : (ms.tr.outcome == 3 ? "time exit" : "ambiguous"))) + " " + str.tostring(ms.tr.netR, "#.00") + "R", color.black, label.style_label_down, ms.tr.note)
    true

f_stName(int st) =>
    st == 0 ? "WAITING" : (st == 1 ? "no manipulation yet" : (st == 2 ? "manipulation, no reversal yet" : (st == 3 ? "reversal confirmed" : (st == 6 ? "COMPLETE" : (st == 7 ? "EXPIRED" : (st == 8 ? "INVALIDATED" : "INELIGIBLE"))))))

f_drawDay(Day dy) =>
    int xEnd = f_ts(dy.key, exitT)
    int xCut = f_ts(dy.key, cutT)
    if not na(dy.O)
        f_ln(dy.oT, dy.O, xEnd, dy.O, color.blue, line.style_dashed, 2)
        f_lb(dy.oT, dy.O, "10am open " + str.tostring(dy.O, format.mintick) + " | " + f_stName(dy.st) + (dy.why == "" ? "" : ": " + dy.why), color.blue, label.style_label_right, f_dt(dy.key) + ": exact open of the 10:00 candle, usable once that candle closed")
        if inVisOR and not na(dy.orH)
            f_bx(f_ts(dy.key, orS), dy.orH, dy.oT, dy.orL, color.new(color.gray, 88), color.new(color.gray, 40))
    if dy.st >= 2 and not na(dy.mExt) and dy.st != 7
        f_ln(dy.mExtT, dy.mExt, xCut, dy.mExt, color.orange, line.style_solid, 2)
        f_lb(dy.mExtT, dy.mExt, "manip " + (dy.dir > 0 ? "low " : "high ") + str.tostring(dy.mExt, format.mintick), color.orange, dy.dir > 0 ? label.style_label_up : label.style_label_down, "frozen at reversal confirmation; Standard stops sit beyond it")
    if not na(dy.swpLvl)
        f_ln(f_ts(dy.key, orS), dy.swpLvl, dy.confT, dy.swpLvl, color.purple, line.style_dotted, 2)
        f_lb(dy.swpT, dy.swpLvl, "swept " + dy.swpNm, color.purple, label.style_label_left, "first exceeded " + f_hms(dy.swpT) + " NY")
    if inVisFvg and slotOn.get(1)
        Mdl mb = dy.ms.get(1)
        if not na(mb.fT)
            f_bx(mb.fCT - 3 * chartMs, mb.fT, xCut, mb.fB, color.new(color.teal, 85), color.new(color.teal, 30))
            f_lb(mb.fCT, mb.fT, mb.fInv ? "FVG (inverted)" : "FVG (frozen)", color.teal, label.style_label_down, "model B frozen gap")
    bool fibShow = not na(dy.fibLo) and not na(dy.oppX) and ((dy.fibOk and (slotOn.get(2) or slotOn.get(3))) or (slotOn.get(4) and inPFib))
    if inVisFib and fibShow
        f_bx(dy.mExtT, dy.fibHi, xCut, dy.fibLo, color.new(color.fuchsia, 88), color.new(color.fuchsia, 40))
        array<float> rs = array.from(0.5, 0.618, 0.705, 0.79)
        for i = 0 to 3
            float lv = f_fibLvl(dy, rs.get(i))
            f_ln(dy.mExtT, lv, xCut, lv, color.new(color.fuchsia, 30), line.style_dotted, 1)
            f_lb(xCut, lv, str.tostring(rs.get(i), "#.000"), color.fuchsia, label.style_label_left, "frozen Fib level (our experimental anchoring)")
    if inVisFib and dy.rejOk
        f_bx(dy.rejT, dy.rejHi, dy.rejT + 3 * chartMs, dy.rejBase, color.new(color.red, 80), color.new(color.red, 20))
        f_lb(dy.rejT, dy.rejEntry, "rejection wick, limit " + str.tostring(math.round_to_mintick(dy.rejEntry), format.mintick), color.red, label.style_label_right, "frozen rejection candle (model C); precision entry = wick midpoint")
    if inVisBand and slotOn.get(4) and not na(dy.bdLo) and (selSlot == 4 or altDraw == 4)
        f_bx(dy.oT, dy.bdHi, xCut, dy.bdLo, color.new(color.aqua, 90), color.new(color.aqua, 40))
    if inVisPrec and slotOn.get(4) and (selSlot == 4 or altDraw == 4)
        Mdl mp = dy.ms.get(4)
        if not na(mp.tT)
            float wTop = dy.dir > 0 ? mp.tBase : mp.tHi
            float wBot = dy.dir > 0 ? mp.tLo : mp.tBase
            f_bx(mp.tT, wTop, mp.tT + 2 * chartMs, wBot, color.new(color.red, 75), color.new(color.red, 10))
            f_lb(mp.tT, dy.dir > 0 ? mp.tLo : mp.tHi, "PREC trigger: " + mp.trigNm, color.red, dy.dir > 0 ? label.style_label_up : label.style_label_down, "frozen only after this candle closed; the stop sits beyond its extreme")
            if not na(mp.sLvl)
                f_ln(mp.sT, mp.sLvl, mp.tT + 2 * chartMs, mp.sLvl, color.maroon, line.style_dotted, 2)
                f_lb(mp.sT, mp.sLvl, "swept local " + (dy.dir > 0 ? "low" : "high") + " " + str.tostring(mp.sLvl, format.mintick), color.maroon, label.style_label_right, "pivot known before the sweep candle began")
    if inVisPlan
        if slotOn.get(selSlot)
            f_drawPlan(dy, selSlot)
        if altDraw >= 0 and altDraw != selSlot
            if slotOn.get(altDraw)
                f_drawPlan(dy, altDraw)
    true


// ───────────────────────────────── CONTEXTUAL DRAWINGS ─────────────────────────────────
// One planned order: pending = dashed, filled = solid, cancelled = dotted grey, completed = solid with an outcome label (a pending level can never be mistaken for a fill).
f_cxDrawPlan(Mdl md) =>
    if not na(md.lim)
        string pre = md.slot == SC_PRE ? "PREC" : "STD"
        bool done = md.st == 4 and not na(md.tr)
        bool canc = md.st == 4 and na(md.tr)
        bool pend = md.st == 2
        string stt = pend ? "PENDING" : (md.st == 3 ? "FILLED" : (done ? "DONE" : "CANCELLED"))
        string sty = pend ? line.style_dashed : (canc ? line.style_dotted : line.style_solid)
        color cE = canc ? color.gray : color.blue
        color cS = canc ? color.gray : color.red
        color cT = canc ? color.gray : color.green
        int xEnd = f_ts(md.dayKey, exitM)
        int xCut = f_ts(md.dayKey, cutM)
        int xe = pend ? math.min(xCut, md.armT + inCxExp * chartMs) : xCut
        if done
            xe := md.tr.exitT
        else if md.st == 3
            xe := xEnd
        float distP = math.abs(md.lim - md.stp)
        int distT = int(math.round(distP / tk))
        int xs = (done or md.st == 3) and not na(md.tr) ? md.tr.fillT : md.armT
        color fillR = canc ? color.new(color.gray, 88) : color.new(color.red, pend ? 90 : 80)
        color fillG = canc ? color.new(color.gray, 88) : color.new(color.green, pend ? 90 : 80)
        f_bxs(xs, math.max(md.lim, md.stp), xe, math.min(md.lim, md.stp), fillR, cS, sty)
        f_bxs(xs, math.max(md.lim, md.tgt), xe, math.min(md.lim, md.tgt), fillG, cT, sty)
        f_ln(xs, md.lim, xe, md.lim, cE, line.style_solid, 2)
        string mtag = pre + " " + md.meth + " #" + str.tostring(md.sid)
        f_lb(xe, md.lim, mtag + " ENTRY " + str.tostring(md.lim, format.mintick) + " [" + stt + "]", cE, label.style_label_left, md.why == "" ? stt : stt + ": " + md.why)
        f_lb(xe, md.stp, mtag + " SL " + str.tostring(md.stp, format.mintick) + " | " + str.tostring(distT) + " ticks / " + str.tostring(distP, "#.00") + " pts", cS, label.style_label_left, "planned stop distance")
        f_lb(xe, md.tgt, mtag + " TP " + str.tostring(md.tgt, format.mintick) + " | plan " + str.tostring(md.plannedR, "#.0") + "R " + md.tgtTy + (md.tgtType == "liquidity" ? " (unswept at arming)" : ""), cT, label.style_label_left, "planned reward; target liquidity frozen when the order was armed")
        if done
            f_lb(md.tr.exitT, md.tr.exitPx, pre + " " + (md.tr.outcome == 1 ? "target" : (md.tr.outcome == 2 ? "stop" : (md.tr.outcome == 3 ? "time exit" : "ambiguous"))) + " " + str.tostring(md.tr.netR, "#.00") + "R", color.black, label.style_label_down, md.tr.note)
        // parent area (frozen snapshot), Fib anchors and local rejection wick of this plan
        if not na(md.aLo) and not na(md.aHi)
            f_bxs(md.armT - 2 * chartMs, md.aHi, xe, md.aLo, color.new(color.teal, 90), color.new(color.teal, 40), line.style_dotted)
            f_lb(md.armT, md.aCe, "parent " + md.areaK + " CE " + str.tostring(md.aCe, format.mintick), color.teal, label.style_label_right, "selected parent area (frozen when the order was armed)")
        if inCxVisFib and md.meth == "Fib 0.705" and not na(md.fH) and not na(md.fL)
            array<float> rs = array.from(0.5, inFibE, inFibS)
            for i = 0 to 2
                float lv = md.dir > 0 ? md.fH - rs.get(i) * (md.fH - md.fL) : md.fL + rs.get(i) * (md.fH - md.fL)
                f_ln(md.armT - 3 * chartMs, lv, xe, lv, color.new(color.fuchsia, 35), line.style_dotted, 1)
                f_lb(xe, lv, str.tostring(rs.get(i), "#.000"), color.fuchsia, label.style_label_left, "Fib level of the frozen leg")
            f_lb(md.armT, md.dir > 0 ? md.fH : md.fL, "Fib anchor " + str.tostring(md.dir > 0 ? md.fH : md.fL, format.mintick) + " (first confirmed swing after the CISD)", color.fuchsia, md.dir > 0 ? label.style_label_down : label.style_label_up, "known only when its right-side candles closed")
        if md.meth == "Rejection CE" and not na(md.rLo)
            f_bx(md.rT, md.rHi, md.rT + 2 * chartMs, md.rLo, color.new(color.red, 80), color.new(color.red, 20))
            f_lb(md.rT, md.dir > 0 ? md.rLo : md.rHi, "local rejection (entry = wick midpoint)", color.red, md.dir > 0 ? label.style_label_up : label.style_label_down, "completed local candle; the stop sits beyond its extreme")
    true

f_cxDrawSetup(Setup st) =>
    int xCut = f_ts(st.dayKey, cutM)
    f_ln(st.lvl.known, st.lvl.px, st.swT, st.lvl.px, color.purple, line.style_dotted, 2)
    f_lb(st.swT, st.lvl.px, "SWEEP #" + str.tostring(st.id) + " " + st.lvl.ty + " " + str.tostring(st.lvl.px, format.mintick) + " (L" + str.tostring(st.lvl.id) + ")", color.purple, st.dir > 0 ? label.style_label_up : label.style_label_down, "pre-existing level swept; known since " + f_hm(st.lvl.known))
    if st.st >= 1 and not na(st.cisdRef)
        int xr = st.cisdT > 0 ? st.cisdT : st.swT
        f_ln(st.refOpen, st.cisdRef, xr, st.cisdRef, color.aqua, line.style_dashed, 1)
        f_lb(xr, st.cisdRef, st.cisdT > 0 ? "CISD ref " + str.tostring(st.cisdRef, format.mintick) + " - closed through " + f_hm(st.cisdT) : "CISD ref " + str.tostring(st.cisdRef, format.mintick) + " (frozen at the sweep, awaiting a close through)", color.aqua, label.style_label_right, "first open of the opposing run into the sweep")
    if st.st >= 2
        f_ln(st.swOpen, st.ext, xCut, st.ext, color.orange, line.style_solid, 2)
        f_lb(st.swOpen, st.ext, "setup extreme " + str.tostring(st.ext, format.mintick) + (st.st == 8 ? " [ended: " + st.why + "]" : ""), color.orange, st.dir > 0 ? label.style_label_up : label.style_label_down, "frozen at the CISD; Standard stops sit beyond it")
        if inCxVisAreas
            for a in st.areas
                if not a.dead
                    f_bxs(a.known, a.hi, xCut, a.lo, color.new(color.teal, 92), color.new(color.teal, 55), a.stale ? line.style_dotted : line.style_solid)
                    f_lb(a.known, a.ce, a.kind + " CE " + str.tostring(a.ce, format.mintick) + (a.stale ? " (stale)" : ""), color.teal, label.style_label_right, "eligible area")
    else if st.st == 8
        f_lb(st.swT, st.ext, "setup #" + str.tostring(st.id) + " ended: " + st.why, color.gray, st.dir > 0 ? label.style_label_up : label.style_label_down, st.why)
    true

f_cxDrawLevels() =>
    int xe = time_close + 12 * chartMs
    for lv in lvls
        if (lv.side != 0 or inCxOpens) and lv.known > time_close - 172800000
            bool sw = lv.st == 2
            color c = lv.side == 0 ? color.new(color.gray, 20) : (lv.side > 0 ? color.new(color.maroon, sw ? 70 : 25) : color.new(color.green, sw ? 70 : 25))
            f_ln(lv.known, lv.px, sw ? lv.swT : xe, lv.px, c, lv.side == 0 ? line.style_dotted : (sw ? line.style_dashed : line.style_solid), 1)
            f_lb(sw ? lv.swT : xe, lv.px, lv.ty + " " + str.tostring(lv.px, format.mintick) + (sw ? " [swept]" : (lv.st == 1 ? " [touched]" : "")), c, label.style_label_left, "level L" + str.tostring(lv.id) + ", known " + f_hm(lv.known) + " NY, first knowable then")
    true

// ───────────────────────────────────────────── TABLES ─────────────────────────────────────────────
var table tbInfo = table.new(position.middle_left, 1, 16, bgcolor = color.new(color.white, 8), border_width = 1, border_color = color.gray)
var table tbFun = table.new(position.top_right, 6, 16, bgcolor = color.new(color.white, 8), border_width = 1, border_color = color.gray)
var table tbPerf = table.new(position.bottom_right, 6, 21, bgcolor = color.new(color.white, 8), border_width = 1, border_color = color.gray)
var table tbLed = table.new(position.bottom_left, 12, 12, bgcolor = color.new(color.white, 8), border_width = 1, border_color = color.gray)

f_cell(table t, int c, int r, string txt, color tcol, color bg) =>
    table.cell(t, c, r, txt, text_color = tcol, text_size = size.tiny, text_halign = text.align_left, bgcolor = bg)
    true

f_drawTables() =>
    color blk = color.black
    color bgH = color.new(color.silver, 30)
    color bgN = na
    int maxN = 0
    for k = 0 to NL - 1
        if slotOn.get(k)
            int cnt = 0
            if trades.size() > 0
                for i = 0 to trades.size() - 1
                    if trades.get(i).slot == k
                        cnt += 1
            maxN := math.max(maxN, cnt)
    int wk = not na(firstKey) and not na(lastKey) ? f_weekdays(firstKey, lastKey) : 0
    int evald = cv.get(0)
    string rngTxt = not na(firstKey) ? f_dt(firstKey) + " to " + f_dt(lastKey) : "no weekday evaluated yet"
    string dstate = ""
    string mWhy = ""
    if not na(cur)
        string[] nm = array.from("WAITING", "OPEN_CAPTURED", "MANIPULATION_QUALIFIED", "REVERSAL_CONFIRMED", "", "", "COMPLETE", "EXPIRED", "INVALIDATED", "INELIGIBLE")
        dstate := f_dt(cur.key) + ": " + (cur.active ? nm.get(cur.st) : "weekend") + (cur.why == "" ? "" : " - " + cur.why)
        for k = 0 to NL - 1
            if slotOn.get(k)
                Mdl mm = cur.ms.get(k)
                string tx = mm.st == 0 ? "no setup" : (mm.st == 1 ? "waiting" : (mm.st == 2 ? "order armed" : (mm.st == 3 ? "position open" : (mm.why == "" ? "done" : mm.why))))
                mWhy += slotNm.get(k) + ": " + tx + "  "
    bool nqOk = syminfo.root == "NQ" or syminfo.root == "MNQ"
    f_cell(tbInfo, 0, 0, "H Ticks C - 10AM Precision | RESEARCH MODEL, profitability UNPROVEN | " + syminfo.ticker, color.white, color.new(color.maroon, 10))
    f_cell(tbInfo, 0, 1, "Our own rules, not Powell's. Simulated on completed 1m candles; no tick data." + (nqOk ? "" : " NOTE: tuned for NQ/MNQ."), nqOk ? blk : color.red, bgN)
    f_cell(tbInfo, 0, 2, "Data (loaded history only): " + rngTxt, blk, bgN)
    f_cell(tbInfo, 0, 3, "Weekdays: " + str.tostring(evald) + " done | " + str.tostring(cv.get(1)) + " complete | " + str.tostring(cv.get(2)) + " partial | " + str.tostring(cv.get(3)) + " no 10am | " + str.tostring(cv.get(4)) + " ATR n/a | " + str.tostring(cv.get(5)) + " levels n/a", blk, bgN)
    f_cell(tbInfo, 0, 4, "No-bar weekdays: " + str.tostring(math.max(0, wk - evald)) + " (holiday/missing; never counted as 'no setup') | ambiguous 1st candles skipped: " + str.tostring(cv.get(6)), blk, bgN)
    f_cell(tbInfo, 0, 5, "Latest day: " + dstate, blk, bgN)
    f_cell(tbInfo, 0, 6, "Latest day per model: " + mWhy, blk, bgN)
    f_cell(tbInfo, 0, 7, "Variant: " + inVariant + (inCmpVar ? " (comparing both)" : "") + " | STD model " + inModel + " | tgt " + inTgt + " | stop cap " + str.tostring(inMaxStop) + "t buf " + str.tostring(inBuf), blk, bgN)
    f_cell(tbInfo, 0, 8, "PRECISION: " + inPTrig + (inPFib ? "+Fib" : "") + (inPIfvg ? "+iFVG" : "") + " | band +/-" + str.tostring(inBand, "#.#") + "t | wick " + str.tostring(inWick * 100, "#") + "% | cap " + str.tostring(inPStopCap) + "t buf " + str.tostring(inPBuf) + " | min " + str.tostring(inMinR, "#.0") + "R | expiry " + str.tostring(inPExp) + " | " + (inPTgt == "Fixed R" ? "fixed " + str.tostring(inPFixR, "#.0") + "R" : "unswept liquidity"), blk, bgN)
    f_cell(tbInfo, 0, 9, "Costs: " + (inComm == 0.0 and inSlip == 0 ? "ZERO (net = gross)" : str.tostring(inComm, "#.00") + " USD/side, " + str.tostring(inSlip) + "t slip") + " | size: " + (inSizeMode == "Fixed cash risk" ? str.tostring(inCashRisk, "#") + " USD risk, whole contracts" : str.tostring(inQty) + " contract(s)") + " | fills: " + (inStrict ? "trade-through" : "touch assumed"), blk, bgN)
    f_cell(tbInfo, 0, 10, maxN < 100 ? "SAMPLE TOO SMALL: " + str.tostring(maxN) + " trade(s) in the largest column. ~16 days cannot show an edge." : "Sample: " + str.tostring(maxN) + " trades in the largest column (still not proof).", maxN < 100 ? color.red : blk, bgN)
    f_cell(tbInfo, 0, 11, "Limits: OHLC order inside a candle is unknowable (ambiguous trades flagged); a touched limit is an assumption.", blk, bgN)
    f_cell(tbInfo, 0, 12, "Precision retries are NOT implemented (one candidate per day). Asia/London levels not implemented.", blk, bgN)
    f_cell(tbInfo, 0, 13, "A small stop with a big planned R is not an edge or low drawdown. Drawdown = closed trades only.", blk, bgN)
    f_cell(tbInfo, 0, 14, "Unfilled/expired orders create no trade and are excluded from every rate. Ledger times = candle opens (NY).", blk, bgN)
    f_cell(tbInfo, 0, 15, "Defaults are research starting points, not optimised. No guarantee of any outcome.", blk, bgN)
    // funnel (Standard columns and Precision side by side)
    if inFunnel
        string[] rows = array.from("Eligible days", "Qualified manipulations", "Sweep-qualified" + (inSweep ? "" : " (off)"), "Confirmed reversals", "Entry conds / triggers", "Orders armed", "Filled trades", "Unfilled/expired/cancel", "Stop-cap rejections", "Invalidated", "Ambiguous trades", "No-target rejections", "Skipped / unmet", "Min-R rejections", "Sizing rejections")
        f_cell(tbFun, 0, 0, "FUNNEL (shadow sims)", blk, bgH)
        for k = 0 to NL - 1
            f_cell(tbFun, k + 1, 0, slotNm.get(k), blk, bgH)
        for r = 0 to NF - 1
            f_cell(tbFun, 0, r + 1, rows.get(r), blk, bgN)
            for k = 0 to NL - 1
                f_cell(tbFun, k + 1, r + 1, slotOn.get(k) ? str.tostring(fnl.get(k * NF + r)) : "off", blk, bgN)
    else
        table.clear(tbFun, 0, 0, 5, 15)
    // performance (closed trades only)
    if inPerf
        matrix<float> pf = matrix.new<float>(NL, 32, 0.0)
        for k = 0 to NL - 1
            array<float> pa = f_perf(k, "")
            for j = 0 to 31
                pf.set(k, j, pa.get(j))
        string[] pr = array.from("Closed trades", "W / L / time / ambig", "Net win rate % (filled)", "Expectancy gross / net R", "Profit factor (net)", "Avg win / avg loss R", "Max losing streak", "Closed DD  R / USD", "Net total  R / USD", "Avg MAE pts / R", "Median MAE all  pts / R", "Median MAE wins  pts / R", "Wins with MAE <= 0.25R %", "Avg MFE pts / R", "Uncertain / open trades", "Avg stop (ticks)", "Avg plan R / real net R", "Avg actual risk USD")
        f_cell(tbPerf, 0, 0, "PERFORMANCE (MAE/MFE = bounds)", blk, bgH)
        for k = 0 to NL - 1
            f_cell(tbPerf, k + 1, 0, slotNm.get(k), blk, bgH)
        for r = 0 to 17
            f_cell(tbPerf, 0, r + 1, pr.get(r), blk, bgN)
            for k = 0 to NL - 1
                string v = "off"
                if slotOn.get(k)
                    if r == 0
                        v := str.tostring(pf.get(k, 0), "#") + (pf.get(k, 26) > 0 ? " (+" + str.tostring(pf.get(k, 26), "#") + " excl.)" : "")
                    else if r == 1
                        v := str.tostring(pf.get(k, 1), "#") + " / " + str.tostring(pf.get(k, 2), "#") + " / " + str.tostring(pf.get(k, 3), "#") + " / " + str.tostring(pf.get(k, 4), "#")
                    else if r == 2
                        v := f_fmt(pf.get(k, 5), "#.0")
                    else if r == 3
                        v := f_fmt(pf.get(k, 27), "#.00") + " / " + f_fmt(pf.get(k, 6), "#.00")
                    else if r == 4
                        v := f_fmt(pf.get(k, 7), "#.00")
                    else if r == 5
                        v := f_fmt(pf.get(k, 8), "#.00") + " / " + f_fmt(pf.get(k, 9), "#.00")
                    else if r == 6
                        v := str.tostring(pf.get(k, 10), "#")
                    else if r == 7
                        v := f_fmt(pf.get(k, 11), "#.00") + " / " + f_fmt(pf.get(k, 12), "#")
                    else if r == 8
                        v := f_fmt(pf.get(k, 13), "#.00") + " / " + f_fmt(pf.get(k, 25), "#")
                    else if r == 9
                        v := f_fmt(pf.get(k, 14), "#.0") + " / " + f_fmt(pf.get(k, 15), "#.00")
                    else if r == 10
                        v := f_fmt(pf.get(k, 16), "#.0") + " / " + f_fmt(pf.get(k, 17), "#.00")
                    else if r == 11
                        v := f_fmt(pf.get(k, 18), "#.0") + " / " + f_fmt(pf.get(k, 19), "#.00")
                    else if r == 12
                        v := f_fmt(pf.get(k, 20), "#")
                    else if r == 13
                        v := f_fmt(pf.get(k, 21), "#.0") + " / " + f_fmt(pf.get(k, 22), "#.00")
                    else if r == 14
                        v := str.tostring(pf.get(k, 23), "#") + " / " + str.tostring(pf.get(k, 24), "#")
                    else if r == 15
                        v := f_fmt(pf.get(k, 28), "#.0")
                    else if r == 16
                        v := f_fmt(pf.get(k, 29), "#.0") + " / " + f_fmt(pf.get(k, 6), "#.00")
                    else
                        v := f_fmt(pf.get(k, 30), "#")
                f_cell(tbPerf, k + 1, r + 1, v, blk, bgN)
    else
        table.clear(tbPerf, 0, 0, 5, 18)
    // ledger (newest first), paginated
    if inLedger
        int perPage = 10
        int sel = inLedModel == "All" ? -1 : (inLedModel == "A" ? 0 : (inLedModel == "B" ? 1 : (inLedModel == "C" ? 2 : (inLedModel == "C-wick" ? 3 : 4))))
        array<int> idx = array.new_int(0)
        if trades.size() > 0
            for i = trades.size() - 1 to 0
                if sel < 0 or trades.get(i).slot == sel
                    idx.push(i)
        int pages = math.max(1, int(math.ceil(idx.size() / 10.0)))
        int pg = math.min(inLedPage, pages)
        string[] hd = array.from("Date", "Dir", "Model", "Open", "Entry", "Stop", "Target", "Fill", "Exit", "Outcome", "Net R", "Reason")
        for c = 0 to 11
            f_cell(tbLed, c, 0, (c == 0 ? "LEDGER " + str.tostring(pg) + "/" + str.tostring(pages) + " " : "") + hd.get(c), blk, bgH)
        for r = 0 to perPage - 1
            int pos = (pg - 1) * perPage + r
            if pos < idx.size()
                Trade t = trades.get(idx.get(pos))
                string oc = t.isOpen ? "OPEN" : (t.outcome == 1 ? "TARGET" : (t.outcome == 2 ? "STOP" : (t.outcome == 3 ? "TIME EXIT" : "AMBIGUOUS")))
                string why = t.note + (t.entryAmb ? " [entry-candle ambiguity]" : "")
                string[] cells = array.from(f_dt(t.dayKey), t.dir > 0 ? "LONG" : "SHORT", slotNm.get(t.slot), str.tostring(t.lvl, format.mintick), str.tostring(t.entryPx, format.mintick), str.tostring(t.stopPx, format.mintick), str.tostring(t.tgtPx, format.mintick), f_hms(t.fillT), t.isOpen ? "-" : f_hms(t.exitT), oc, f_fmt(t.netR, "#.00"), str.length(why) > 44 ? str.substring(why, 0, 44) : why)
                for c = 0 to 11
                    f_cell(tbLed, c, r + 1, cells.get(c), blk, bgN)
            else
                for c = 0 to 11
                    f_cell(tbLed, c, r + 1, "", blk, bgN)
    else
        table.clear(tbLed, 0, 0, 11, 11)
    if not inInfo
        table.clear(tbInfo, 0, 0, 0, 15)
    true


// ───────────────────────────────── CONTEXTUAL TABLES ─────────────────────────────────
var table tbWhy = table.new(position.top_left, 1, 20, bgcolor = color.new(color.white, 8), border_width = 1, border_color = color.gray)

f_cxPrbTxt(int ix, string nm) =>
    string s = nm + " n/a"
    if not na(prbT.get(ix))
        s := nm + " " + (prbS.get(ix) > 0 ? "up" : (prbS.get(ix) < 0 ? "down" : "none yet")) + " (" + f_hm(prbT.get(ix)) + ")"
    s

f_perfStr(array<float> a, int r) =>
    array<string> v = array.from(str.tostring(a.get(0), "#") + (a.get(26) > 0 ? " (+" + str.tostring(a.get(26), "#") + " excl.)" : ""), str.tostring(a.get(1), "#") + " / " + str.tostring(a.get(2), "#") + " / " + str.tostring(a.get(3), "#") + " / " + str.tostring(a.get(4), "#"), f_fmt(a.get(5), "#.0"), f_fmt(a.get(27), "#.00") + " / " + f_fmt(a.get(6), "#.00"), f_fmt(a.get(7), "#.00"), f_fmt(a.get(8), "#.00") + " / " + f_fmt(a.get(9), "#.00"), str.tostring(a.get(10), "#"), f_fmt(a.get(11), "#.00") + " / " + f_fmt(a.get(12), "#"), f_fmt(a.get(13), "#.00") + " / " + f_fmt(a.get(25), "#"), f_fmt(a.get(14), "#.0") + " / " + f_fmt(a.get(15), "#.00"), f_fmt(a.get(16), "#.0") + " / " + f_fmt(a.get(17), "#.00"), f_fmt(a.get(18), "#.0") + " / " + f_fmt(a.get(19), "#.00"), f_fmt(a.get(20), "#"), f_fmt(a.get(21), "#.0") + " / " + f_fmt(a.get(22), "#.00"), str.tostring(a.get(23), "#") + " / " + str.tostring(a.get(24), "#"), f_fmt(a.get(28), "#.0"), f_fmt(a.get(29), "#.0") + " / " + f_fmt(a.get(6), "#.00"), f_fmt(a.get(30), "#"), str.tostring(a.get(31), "#") + " / " + str.tostring(a.get(32), "#"), str.tostring(a.get(33), "#"))
    v.get(r)

f_cxTables() =>
    color blk = color.black
    color bgH = color.new(color.silver, 30)
    color bgN = na
    int wk = not na(firstKey) and not na(lastKey) ? f_weekdays(firstKey, lastKey) : 0
    int evald = cv.get(0)
    string rngTxt = not na(firstKey) ? f_dt(firstKey) + " to " + f_dt(lastKey) : "no weekday evaluated yet"
    int maxN = 0
    for k = 5 to 6
        int cnt = 0
        for t in trades
            if t.slot == k
                cnt += 1
        maxN := math.max(maxN, cnt)
    Setup st = f_cxCur()
    string stTxt = "no setup yet"
    if not na(st)
        stTxt := "#" + str.tostring(st.id) + " " + (st.dir > 0 ? "LONG" : "SHORT") + " swept " + st.lvl.ty + " " + str.tostring(st.lvl.px, format.mintick) + " | " + (st.st == 1 ? "waiting for a close through CISD ref " + str.tostring(st.cisdRef, format.mintick) : (st.st == 2 ? "CISD confirmed " + f_hm(st.cisdT) + ", " + str.tostring(st.areas.size()) + " area(s)" : "ended: " + st.why))
    string vTxt = ""
    if not na(st)
        vTxt := "STD: " + (na(st.mdlS) ? (st.stdSt == 0 ? "waiting for an area" : "none") : (st.mdlS.st == 2 ? "order armed" : (st.mdlS.st == 3 ? "position open" : (st.mdlS.why == "" ? "done" : st.mdlS.why)))) + " | PREC: " + (na(st.mdlP) ? "waiting for a trigger" : (st.mdlP.st == 2 ? "order armed (" + st.mdlP.meth + ")" : (st.mdlP.st == 3 ? "position open" : (st.mdlP.why == "" ? "done" : st.mdlP.why))))
    bool nqOk = syminfo.root == "NQ" or syminfo.root == "MNQ"
    if not inCxCompact
        f_cell(tbInfo, 0, 0, "H Ticks - Powell Model C (Contextual) | RESEARCH MODEL, profitability UNPROVEN | " + syminfo.ticker, color.white, color.new(color.maroon, 10))
        f_cell(tbInfo, 0, 1, "Our mechanical reading of the guide, not Powell's rules. Simulated on completed 1m candles; HTF candles built from 1m and used once complete." + (nqOk ? "" : " NOTE: tuned for NQ/MNQ."), nqOk ? blk : color.red, bgN)
        f_cell(tbInfo, 0, 2, "Data (loaded history only): " + rngTxt + " | window " + inCxWin + " NY, hard exit " + inCxHard, blk, bgN)
        f_cell(tbInfo, 0, 3, "Weekdays: " + str.tostring(evald) + " done | context-ready " + str.tostring(cv.get(1) + cv.get(2)) + " (" + str.tostring(cv.get(1)) + " complete, " + str.tostring(cv.get(2)) + " partial) | no window candle " + str.tostring(cv.get(3)) + " | levels n/a " + str.tostring(cv.get(5)), blk, bgN)
        f_cell(tbInfo, 0, 4, "No-bar weekdays: " + str.tostring(math.max(0, wk - evald)) + " (never 'no setup'). Candles built / DROPPED as incomplete: 5m " + str.tostring(aggs.get(1).doneN) + "/" + str.tostring(aggs.get(1).dropN) + " 15m " + str.tostring(aggs.get(2).doneN) + "/" + str.tostring(aggs.get(2).dropN) + " 1H " + str.tostring(aggs.get(4).doneN) + "/" + str.tostring(aggs.get(4).dropN) + " 4H " + str.tostring(aggs.get(5).doneN) + "/" + str.tostring(aggs.get(5).dropN) + " D " + str.tostring(aggs.get(6).doneN) + "/" + str.tostring(aggs.get(6).dropN) + " (tolerance " + str.tostring(inCxMiss) + ")", blk, bgN)
        f_cell(tbInfo, 0, 5, "Prior-range breakout state, NOT CISD (completed candles): " + f_cxPrbTxt(6, "D") + " | " + f_cxPrbTxt(5, "4H") + " | " + f_cxPrbTxt(4, "1H") + " | " + f_cxPrbTxt(3, "30m") + " | " + f_cxPrbTxt(2, "15m"), blk, bgN)
        f_cell(tbInfo, 0, 6, "Current setup: " + stTxt, blk, bgN)
        f_cell(tbInfo, 0, 7, "Latest setup per variant: " + vTxt, blk, bgN)
        f_cell(tbInfo, 0, 8, "Variant: " + inVariant + (inCmpVar ? " (comparing both)" : "") + " | source TF " + inCxTf + " | areas " + (inAFvg ? "FVG " : "") + (inAOb ? "OB " : "") + (inABrk ? "BRK " : "") + (inARb ? "RB " : "") + (inAIf ? "iFVG" : "") + " | HTF POI " + inPoi, blk, bgN)
        f_cell(tbInfo, 0, 9, "STANDARD: limit at area CE, stop beyond the full sweep extreme +" + str.tostring(inCxBuf) + "t (cap " + str.tostring(inCxCap) + "t), min " + str.tostring(inCxMinR, "#.0") + "R, target " + (inCxTgt == "Fixed R" ? "fixed " + str.tostring(inCxFixR, "#.0") + "R" : "nearest unswept liquidity"), blk, bgN)
        f_cell(tbInfo, 0, 10, "PRECISION: " + (inPFibOn ? "Fib " + str.tostring(inFibE, "#.000") + " (stop beyond " + str.tostring(inFibS, "#.00") + ") " : "") + (inPRejOn ? "| rejection CE on " + inRejTf : "") + " | cap " + str.tostring(inCxPCap) + "t buf " + str.tostring(inCxPBuf) + " | min " + str.tostring(inCxPMinR, "#.0") + "R", blk, bgN)
        f_cell(tbInfo, 0, 11, "Costs: " + (inComm == 0.0 and inSlip == 0 ? "ZERO (net = gross)" : str.tostring(inComm, "#.00") + " USD/side, " + str.tostring(inSlip) + "t slip") + " | size: " + (inSizeMode == "Fixed cash risk" ? str.tostring(inCashRisk, "#") + " USD risk, whole contracts" : str.tostring(inQty) + " contract(s)") + " | fills: " + (inStrict ? "trade-through" : "touch assumed") + " | " + inSeq, blk, bgN)
        f_cell(tbInfo, 0, 12, maxN < 100 ? "SAMPLE TOO SMALL: " + str.tostring(maxN) + " trade(s) in the largest column. A few days cannot show an edge." : "Sample: " + str.tostring(maxN) + " trades in the largest column (still not proof).", maxN < 100 ? color.red : blk, bgN)
        f_cell(tbInfo, 0, 13, "Limits: OHLC order inside a candle is unknowable (ambiguous trades are counted as losses); a touched limit is an assumption; MAE/MFE are bounds.", blk, bgN)
        f_cell(tbInfo, 0, 14, "Not implemented: NWOG/NDOG, trailing/breakeven, SMT target role, local FVG/breaker overlap for rejections. Unfilled orders create no trade.", blk, bgN)
        f_cell(tbInfo, 0, 15, "Defaults are research starting points, not optimised. No guarantee of any outcome. Drawdown = closed trades only.", blk, bgN)
    else
        table.clear(tbInfo, 0, 0, 0, 15)
    // why-no-trade panel
    f_cell(tbWhy, 0, 0, "WHY NO TRADE? (latest day, newest last)", blk, bgH)
    int nr = dayWhy.size()
    int w0 = math.max(0, nr - 9)
    for r = 0 to 8
        f_cell(tbWhy, 0, r + 1, w0 + r < nr ? dayWhy.get(w0 + r) : "", blk, bgN)
    f_cell(tbWhy, 0, 10, "Cumulative reasons (all loaded days):", blk, bgH)
    for r = 0 to 8
        f_cell(tbWhy, 0, r + 11, r < rjK.size() ? rjK.get(r) + ": " + str.tostring(rjC.get(r)) : "", blk, bgN)
    // funnel (4 columns: Standard, Precision, Precision-Fib, Precision-Rejection)
    if inFunnel and not inCxCompact
        string[] rows = array.from("Eligible days", "Sweeps recognised", "CISD confirmed", "Setups with an eligible area", "Candidates evaluated", "Orders armed", "Filled trades", "Unfilled/expired/cancel", "Stop rejections", "Invalidated", "Ambiguous trades", "No-target rejections", "Filter rejections / stale", "Min-R rejections", "Sizing rejections")
        string[] cn = array.from("STD", "PREC", "PREC-Fib", "PREC-Rej")
        f_cell(tbFun, 0, 0, "FUNNEL (shadow sims; setup-level rows are shared)", blk, bgH)
        for c = 0 to 3
            f_cell(tbFun, c + 1, 0, cn.get(c), blk, bgH)
        for r = 0 to NF - 1
            f_cell(tbFun, 0, r + 1, rows.get(r), blk, bgN)
            for c = 0 to 3
                f_cell(tbFun, c + 1, r + 1, slotOn.get(5 + c) ? str.tostring(fnl.get((5 + c) * NF + r)) : "off", blk, bgN)
        table.clear(tbFun, 5, 0, 5, 15)
    else
        table.clear(tbFun, 0, 0, 5, 15)
    // performance (closed trades only; Precision also split by entry method)
    if inPerf
        string[] pr = array.from("Closed trades", "W / L / time / ambig", "Net win rate % (filled)", "Expectancy gross / net R", "Profit factor (net)", "Avg win / avg loss R", "Max losing streak", "Closed DD  R / USD", "Net total  R / USD", "Avg MAE pts / R", "Median MAE all  pts / R", "Median MAE wins  pts / R", "Wins with MAE <= 0.25R %", "Avg MFE pts / R", "Uncertain / open trades", "Avg stop (ticks)", "Avg plan R / real net R", "Avg actual risk USD", "Planned >=4R / >=5R trades", "Gap-through-entry events")
        string[] cn = array.from("STD", "PREC", "PREC-Fib", "PREC-Rej")
        f_cell(tbPerf, 0, 0, "PERFORMANCE (MAE/MFE = bounds)", blk, bgH)
        for c = 0 to 3
            f_cell(tbPerf, c + 1, 0, cn.get(c), blk, bgH)
            array<float> pa = f_perf(c == 0 ? 5 : 6, c == 2 ? "Fib 0.705" : (c == 3 ? "Rejection CE" : ""))
            for r = 0 to 19
                f_cell(tbPerf, 0, r + 1, pr.get(r), blk, bgN)
                f_cell(tbPerf, c + 1, r + 1, slotOn.get(5 + (c == 0 ? 0 : 1)) ? f_perfStr(pa, r) : "off", blk, bgN)
        table.clear(tbPerf, 5, 0, 5, 20)
    else
        table.clear(tbPerf, 0, 0, 5, 20)
    // ledger (newest first)
    if inLedger and not inCxCompact
        int perPage = 10
        int sel = inLedModel == "Ctx Standard" ? 5 : (inLedModel == "Ctx Precision" ? 6 : -1)
        array<int> idx = array.new_int(0)
        if trades.size() > 0
            for i = trades.size() - 1 to 0
                Trade tt = trades.get(i)
                if tt.slot >= 5 and (sel < 0 or tt.slot == sel)
                    idx.push(i)
        int pages = math.max(1, int(math.ceil(idx.size() / 10.0)))
        int pg = math.min(inLedPage, pages)
        string[] hd = array.from("Date", "Dir", "Method", "Swept", "Entry", "Stop", "Target", "Fill", "Exit", "Outcome", "Net R", "Reason")
        for c = 0 to 11
            f_cell(tbLed, c, 0, (c == 0 ? "LEDGER " + str.tostring(pg) + "/" + str.tostring(pages) + " " : "") + hd.get(c), blk, bgH)
        for r = 0 to perPage - 1
            int pos = (pg - 1) * perPage + r
            if pos < idx.size()
                Trade t = trades.get(idx.get(pos))
                string oc = t.isOpen ? "OPEN" : (t.outcome == 1 ? "TARGET" : (t.outcome == 2 ? "STOP" : (t.outcome == 3 ? "TIME EXIT" : "AMBIGUOUS")))
                string why = t.note + (t.entryAmb ? " [entry-candle ambiguity]" : "")
                string[] cells = array.from(f_dt(t.dayKey), t.dir > 0 ? "LONG" : "SHORT", (t.slot == SC_STD ? "STD " : "PREC ") + t.meth, str.tostring(t.lvl, format.mintick), str.tostring(t.entryPx, format.mintick), str.tostring(t.stopPx, format.mintick), str.tostring(t.tgtPx, format.mintick), f_hms(t.fillT), t.isOpen ? "-" : f_hms(t.exitT), oc, f_fmt(t.netR, "#.00"), str.length(why) > 44 ? str.substring(why, 0, 44) : why)
                for c = 0 to 11
                    f_cell(tbLed, c, r + 1, cells.get(c), blk, bgN)
            else
                for c = 0 to 11
                    f_cell(tbLed, c, r + 1, "", blk, bgN)
    else
        table.clear(tbLed, 0, 0, 11, 11)
    if not inInfo
        table.clear(tbInfo, 0, 0, 0, 15)
    true

bool drawNow = barstate.islastconfirmedhistory or (barstate.isrealtime and barstate.isconfirmed)
if not supported
    if barstate.islast
        table.cell(tbInfo, 0, 0, "H Ticks C needs STANDARD 1-MINUTE candles (not Heikin Ashi, Renko, tick or other types)", text_color = color.white, text_size = size.small, text_halign = text.align_left, bgcolor = color.new(color.red, 10))
else if not cfgAll
    if barstate.islast
        table.cell(tbInfo, 0, 0, "H Ticks C: invalid time settings (check: opening range ends by the open, open < manipulation end <= cutoff < exit)", text_color = color.white, text_size = size.small, text_halign = text.align_left, bgcolor = color.new(color.red, 10))
else if drawNow
    f_clearDraw()
    int nd = days.size()
    int shown = 0
    array<int> shownKeys = array.new_int(0)
    if nd > 0
        for i = nd - 1 to 0
            Day dd = days.get(i)
            if dd.active and shown < inDraw
                if not isCx
                    f_drawDay(dd)
                shownKeys.push(dd.key)
                shown += 1
    if isCx
        if inCxVisCtx
            f_cxDrawLevels()
            for q in sets
                if shownKeys.includes(q.dayKey) and (inCxHist or q.dayKey == cur.key)
                    f_cxDrawSetup(q)
        for md in plans
            if shownKeys.includes(md.dayKey) and (inCxHist or md.dayKey == cur.key) and slotOn.get(md.slot) and inVisPlan and (inShowBoth or md.slot == selSlot)
                f_cxDrawPlan(md)
        f_cxTables()
    else
        f_drawTables()
