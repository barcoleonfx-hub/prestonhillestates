bool inFCe = input.bool(false, "Filter: reject if same-side liquidity sits within N points beyond the entry (engineered-liquidity proximity)", group = G12, tooltip = "Our reading of the guide's roughly 2-point idea. Optional research filter.")
float inCeDist = input.float(2.0, "Engineered-liquidity proximity (points)", minval = 0.25, step = 0.25, group = G12)
string inSmt = input.string("Off", "SMT divergence (reversal role only)", options = ["Off", "Reversal"], group = G12, tooltip = "Reversal role: at the sweep the peer index must have FAILED to take its own comparable extreme. The target role is NOT implemented.")
string inSmtSym = input.string("CME_MINI:ES1!", "SMT peer symbol", group = G12)
int inSmtLook = input.int(60, "SMT comparison look-back (1m candles before the sweep)", minval = 10, maxval = 200, group = G12)
bool inAFvg = input.bool(true, "Area: FVG (3 candles, usable once the third closed)", group = G13)
bool inAOb = input.bool(true, "Area: order block (last opposite candle before the displacement that confirmed the CISD)", group = G13)
bool inABrk = input.bool(true, "Area: breaker (the broken block, confirmed by a CLOSE through it)", group = G13)
bool inARb = input.bool(true, "Area: rejection block (our thresholds; not attributed to Powell)", group = G13)
bool inAIf = input.bool(true, "Area: iFVG (a gap inverted by a close beyond its opposite side)", group = G13)
float inRbWick = input.float(0.50, "Rejection block: minimum wick share of the range", minval = 0.1, maxval = 0.95, step = 0.05, group = G13)
float inRbBody = input.float(0.40, "Rejection block: maximum body share of the range", minval = 0.05, maxval = 0.9, step = 0.05, group = G13)
int inIfLook = input.int(12, "iFVG: the gap may have formed up to this many source candles before the sweep", minval = 1, group = G13)
string inPoi = input.string("None", "Selected higher-timeframe POI (areas overlapping it are preferred)", options = ["None", "15m FVG", "1H FVG"], group = G13)
int inCxBuf = input.int(2, "Standard stop buffer beyond the sweep extreme (ticks)", minval = 0, group = G14)
int inCxCap = input.int(200, "Standard maximum stop (ticks); wider setups are REJECTED", minval = 1, group = G14)
float inCxMinR = input.float(3.0, "Standard minimum planned reward:risk (checked on rounded prices)", minval = 0.5, step = 0.5, group = G14)
string inCxTgt = input.string("Opposing liquidity", "Target", options = ["Opposing liquidity", "Fixed R"], group = G14, tooltip = "Opposing liquidity = nearest UNSWEPT level known when the order is armed, frozen with the stop. No target = the setup is rejected and counted; no farther target is substituted. Fixed R is a separate testing mode.")
float inCxFixR = input.float(3.0, "Fixed R multiple (Fixed R mode)", minval = 0.5, step = 0.5, group = G14)
bool inPFibOn = input.bool(true, "Precision method: Fib 0.705 entry", group = G15)
bool inPRejOn = input.bool(true, "Precision method: local rejection CE entry", group = G15)
float inFibE = input.float(0.705, "Fib entry ratio", minval = 0.3, maxval = 0.95, step = 0.005, group = G15)
float inFibS = input.float(0.79, "Fib stop-reference ratio (stop sits beyond this + buffer)", minval = 0.4, maxval = 0.99, step = 0.005, group = G15)
int inCxPv = input.int(2, "Swing strength for the Fib anchor (candles each side)", minval = 1, maxval = 5, group = G15, tooltip = "The anchor is the FIRST confirmed swing after the CISD. It is known only when its last right-side candle closes, and is never back-dated.")
bool inFibArea = input.bool(false, "Fib filter: the 0.705 entry must lie inside the selected parent area", group = G15)
int inCxPCap = input.int(80, "Precision maximum stop (ticks)", minval = 1, group = G15)
int inCxPBuf = input.int(2, "Precision stop buffer (ticks)", minval = 0, group = G15)
float inCxPMinR = input.float(3.0, "Precision minimum planned reward:risk (set 5 for the 5R research filter)", minval = 0.5, step = 0.5, group = G15)
string inRejTf = input.string("5m", "Local rejection timeframe", options = ["5m", "1m"], group = G15)
float inRejWick = input.float(0.40, "Local rejection: minimum wick share of the range", minval = 0.1, maxval = 0.95, step = 0.05, group = G15)
bool inRejSweep = input.bool(false, "Local rejection: must also sweep the previous local candle's extreme", group = G15)
string inSeq = input.string("One trade per day", "Daily sequence (each variant independently)", options = ["One trade per day", "Win ends day; one 50% retry after a non-win"], group = G16, tooltip = "A win (net R > 0) ends the day. Anything else (loss, ambiguous, flat or time exit) counts as an attempt and allows ONE more trade with 50% of the first trade's actual cash risk (whole contracts, rounded down).")
bool inCxVisCtx = input.bool(true, "Draw the CURRENT setup context (sweep, CISD reference, setup extreme)", group = G16)
bool inCxVisAreas = input.bool(false, "Draw every eligible area (otherwise only the selected parent area)", group = G16)
bool inCxVisFib = input.bool(false, "Draw Fib anchors and levels on Fib plans", group = G16)
bool inDbgMode = input.bool(false, "DEBUG MODE: show the full funnel, reconciliation, ledger, coverage and diagnostic tables", group = G16, tooltip = "OFF (default) = one small summary panel only.")
int inCxNDone = input.int(10, "Completed trade boxes kept on the chart (per variant)", minval = 0, maxval = 40, group = G16)
bool inCxVisLevels = input.bool(false, "Draw live liquidity levels (clutter)", group = G16)
bool inCxHistCtx = input.bool(false, "Historical context: also draw ended / superseded setups, truncated at their end", group = G16)
bool inAlExit = input.bool(true, "Alert: simulated stop / target / time exit", group = G8)
int inCxMiss = input.int(0, "Aggregation: missing 1m candles tolerated per higher-timeframe candle (0 = strict)", minval = 0, maxval = 30, group = G10, tooltip = "A synthetic 5m/15m/30m/1H/4H/Daily candle is published only when all its expected 1m candles are present (scheduled 17:00-18:00 break excluded). TradingView has no bar for a minute without trades, so thin sessions can lose candles; this tolerance trades strictness for availability. Dropped candles are counted in the info panel.")

// ───────────────────────────────────────── TIME AND CHART ─────────────────────────────────────────
f_hhmm(string s) =>
    string t = str.trim(s)
    int p = str.pos(t, ":")
    p >= 0 ? int(str.tonumber(str.substring(t, 0, p))) * 60 + int(str.tonumber(str.substring(t, p + 1, str.length(t)))) : 660

f_mins(string s, int off) =>
    int(str.tonumber(str.substring(s, off, off + 2))) * 60 + int(str.tonumber(str.substring(s, off + 2, off + 4)))

int orS = f_mins(inORs, 0)
int orE = f_mins(inORs, 5)
int winS = f_mins(inCxWin, 0)
int cutM = f_mins(inCxWin, 5)
int exitM = f_hhmm(inCxHard)
bool cxCfgOk = winS < cutM and cutM <= exitM and orS < orE
bool cfgAll = cxCfgOk

bool supported = chart.is_standard and not timeframe.isticks and timeframe.isminutes and timeframe.multiplier == 1
int chartMs = 60000
float tk = syminfo.mintick
int mOpen = hour(time, TZ) * 60 + minute(time, TZ)
int dkey = year(time, TZ) * 10000 + month(time, TZ) * 100 + dayofmonth(time, TZ)
int dowN = dayofweek(time, TZ)
int tdk = year(time + 21600000, TZ) * 10000 + month(time + 21600000, TZ) * 100 + dayofmonth(time + 21600000, TZ)
[esH, esL] = request.security(inSmt != "Off" ? inSmtSym : syminfo.tickerid, "1", [high, low])

int selVar = inVariant == "Precision" ? 1 : 0
int selSlot = selVar == 1 ? 6 : 5
bool stdOn = selVar == 0 or inCmpVar
bool precOn = selVar == 1 or inCmpVar
var array<bool> slotOn = array.from(false, false, false, false, false, stdOn, precOn, precOn, precOn)
var array<string> slotNm = array.from("STD-A", "STD-B", "STD-C", "STD-C wick", "PREC", "CTX-STD", "CTX-PREC", "PREC-Fib", "PREC-Rej")

// ───────────────────────────────────────────── TYPES ─────────────────────────────────────────────
type Trade
    int slot
    int dir
    int dayKey
    float lvl
    float entryPx
    float stopPx
    float tgtPx
    float riskPts
    int armT
    int fillT
    int exitT
    float exitPx
    bool isOpen = true
    int outcome = 0
    float grossR = na
    float netR = na
    float netUsd = 0.0
    float costUsd = 0.0
    float maeP = 0.0
    float mfeP = 0.0
    bool excUnc = false
    bool entryAmb = false
    string note = ""
    int qty = 1
    float plannedR = na
    string tgtType = ""
    float riskUsd = 0.0
    string meth = ""
    int sid = 0
    bool gap = false

// One entry model's state for one day. st: 0 idle, 1 waiting for its entry conditions, 2 ARMED limit, 3 POSITION OPEN, 4 done.
type Mdl
    int slot
    int st = 0
    string why = ""
    int armBar = -1
    int armT
    float lim = na
    float stp = na
    float tgt = na
    Trade tr
    int qty = 1
    float plannedR = na
    string tgtType = ""
    int dir
    int dayKey
    int sid
    float xExt = na
    string meth = ""
    int tgtId = 0
    string tgtTy = ""
    float mult = 1.0
    string areaK = ""
    float aLo = na
    float aHi = na
    float aCe = na
    float fH = na
    float fL = na
    float rLo = na
    float rHi = na
    int rT
    int parId = 0
    string tgtAud = ""

// Per NY calendar day bookkeeping (coverage only). st: 0 waiting, 1 window seen, 9 ineligible. status: 0 complete, 1 partial, 2 no window start candle, 4 no levels.
type Day
    int key
    bool active = true
    int status = 0
    int st = 0
    string why = ""
    int bars10 = 0

// ──────────────────────────────── CONTEXTUAL ENGINE TYPES ────────────────────────────────
// Aggregated candles are built from the 1m chart and used only after they COMPLETE (history arrays hold completed candles only).
type Agg
    int n
    int id = 0
    bool has = false
    float o = na
    float h = na
    float l = na
    float c = na
    int t0 = 0
    int tc = 0
    bool nw = false
    int cnt = 0
    int idx = 0
    int firstMs = 0
    int lastMs = 0
    bool gap = false
    bool bad = false
    int dropN = 0
    int doneN = 0
    array<float> O
    array<float> H
    array<float> L
    array<float> C
    array<int> T0
    array<int> TC

// A liquidity / reference level. st: 0 untouched, 1 touched, 2 swept (exceeded by the minimum), 3 superseded. side: +1 high, -1 low, 0 reference only.
type Lvl
    int id
    string ty
    int side
    float px
    int origin
    int known
    int st = 0
    int swT = 0
    int swOpen = 0
    bool proc = false

type Area
    int id
    string kind
    float lo
    float hi
    float ce
    int known
    int src
    bool dead = false
    bool stale = false

type Fvg
    int id
    int dir
    float lo
    float hi
    int c1open
    int known
    bool inv = false
    int invOpen = 0
    int invKnown = 0
    bool dead = false

type Pv
    int side
    float px
    bool dead = false

// A confirmed source-timeframe swing (known only when its right-side candles closed) and the order block associated with it
type Sw
    int side
    float px
    int open
    int kn
    float bLo = na
    float bHi = na

type Rg
    bool active = false
    float h = na
    float l = na
    int n = 0
    int origin = 0

type Cs
    float hi = na
    float lo = na
    int hiT = 0
    int loT = 0
    bool hiReg = false
    bool loReg = false

// One contextual setup: sweep of a pre-existing level -> CISD -> eligible areas. st: 1 swept (waiting for the CISD close), 2 CISD confirmed (waiting for / using execution), 8 ended.
type Setup
    int id
    int dir
    int st = 0
    string why = ""
    Lvl lvl
    int swOpen
    int swT
    float ext
    int cnt = 0
    int firstExc
    int dayKey
    float cisdRef = na
    int refOpen = 0
    int cisdT = 0
    int cisdOpen = 0
    array<Area> areas
    array<Area> rbs
    array<int> fvgUsed
    int smt = -1
    bool hadArea = false
    int endT = 0
    string endCat = ""
    bool winSeen = false
    bool execSeen = false
    bool counted = false
    bool parWait = false
    int candN = 0
    string candCat = ""
    bool candArmed = false
    bool seqBlock = false
    bool busyBlock = false
    int fibSt = 0
    float fibPx = na
    int fibOp = 0
    int fibKn = 0
    bool brkDone = false
    int stdSt = 0
    int precSt = 0
    Mdl mdlS
    Mdl mdlP

// ───────────────────────────────────────────── STATE ─────────────────────────────────────────────
var array<int> fnl = array.new_int(NS * NF, 0)
var array<int> cv = array.new_int(8, 0)           // 0 evaluated weekdays, 1 complete, 2 partial, 3 missing 10am candle, 4 ATR unavailable, 5 levels unavailable, 6 ambiguous first candle skipped
var array<Trade> trades = array.new<Trade>()
var array<Day> days = array.new<Day>()
var array<string> aMsgs = array.new_string(0)
var array<int> evK = array.new_int(5, 0)
var array<line> dLines = array.new<line>()
var array<box> dBoxes = array.new<box>()
var array<label> dLabels = array.new<label>()
var Day cur = na
var Day lastAct = na
var int firstKey = na
var int lastKey = na
var float pClose = na
var int pCloseT = na

// ──────────────────────────────── CONTEXTUAL ENGINE STATE ────────────────────────────────
var array<Agg> aggs = array.from(Agg.new(n = 1, O = array.new_float(), H = array.new_float(), L = array.new_float(), C = array.new_float(), T0 = array.new_int(), TC = array.new_int()), Agg.new(n = 5, O = array.new_float(), H = array.new_float(), L = array.new_float(), C = array.new_float(), T0 = array.new_int(), TC = array.new_int()), Agg.new(n = 15, O = array.new_float(), H = array.new_float(), L = array.new_float(), C = array.new_float(), T0 = array.new_int(), TC = array.new_int()), Agg.new(n = 30, O = array.new_float(), H = array.new_float(), L = array.new_float(), C = array.new_float(), T0 = array.new_int(), TC = array.new_int()), Agg.new(n = 60, O = array.new_float(), H = array.new_float(), L = array.new_float(), C = array.new_float(), T0 = array.new_int(), TC = array.new_int()), Agg.new(n = 240, O = array.new_float(), H = array.new_float(), L = array.new_float(), C = array.new_float(), T0 = array.new_int(), TC = array.new_int()), Agg.new(n = 1440, O = array.new_float(), H = array.new_float(), L = array.new_float(), C = array.new_float(), T0 = array.new_int(), TC = array.new_int()))
var array<Lvl> lvls = array.new<Lvl>()
var array<Setup> sets = array.new<Setup>()
var array<Mdl> plans = array.new<Mdl>()
var array<Fvg> fvgs = array.new<Fvg>()
var array<Fvg> poi15 = array.new<Fvg>()
var array<Fvg> poi60 = array.new<Fvg>()
var array<Pv> eqP = array.new<Pv>()
var array<Sw> swgs = array.new<Sw>()
var array<int> cxN = array.new_int(6, 0)          // 0 level id, 1 setup id, 2 fvg id, 3 last trading-day key, 4 area id
var array<int> prbS = array.new_int(7, 0)         // prior-range breakout state per aggregated timeframe: 1 up, -1 down, 0 none yet (NOT a CISD)
var array<int> prbT = array.new_int(7, na)        // availability timestamp (completed candle close); na = unavailable
var array<float> pvPx = array.new_float(2, na)    // last confirmed source-timeframe swing: 0 high, 1 low
var array<int> pvOp = array.new_int(2, na)
var array<int> pvKn = array.new_int(2, na)
var array<int> sBt = array.new_int(0)
var array<float> sEsL = array.new_float(0)
var array<float> sEsH = array.new_float(0)
var array<float> sNqL = array.new_float(0)
var array<float> sNqH = array.new_float(0)
var array<string> rjK = array.new_string(0)       // "why no trade" categories (cumulative)
var array<int> rjC = array.new_int(0)
var array<string> dayWhy = array.new_string(0)    // detailed reasons for the latest day
var array<string> lastRsn = array.from("")        // newest rejection / cancellation reason
var array<int> rcN = array.new_int(16, 0)         // setup-level reconciliation: 0-13 exclusive categories, 15 = area-qualified setups
var array<int> blkC = array.new_int(4, 0)         // sweeps ignored, by the state of the blocking setup
var Rg rgAS = Rg.new()
var Rg rgLD = Rg.new()
var Rg rgPO = Rg.new()
var Rg rgRTH = Rg.new()
var Rg rgOR = Rg.new()
var Cs csT = Cs.new()

// ─────────────────────────────────────────── HELPERS ───────────────────────────────────────────
f_ts(int key, int mins) =>
    timestamp(TZ, int(math.floor(key / 10000.0)), int(math.floor((key % 10000) / 100.0)), key % 100, int(math.floor(mins / 60.0)), mins % 60, 0)

f_hm(int t) =>
    str.format_time(t, "HH:mm", TZ)

f_hms(int t) =>
    str.format_time(t, "HH:mm:ss", TZ)

f_dt(int key) =>
    str.tostring(int(math.floor(key / 10000.0))) + "-" + str.format_time(f_ts(key, 720), "MM-dd", TZ)

f_fn(int slot, int col) =>
    fnl.set(slot * NF + col, fnl.get(slot * NF + col) + 1)
    true

// An event that applies to every simulated model (day-level funnel steps).
f_fnA(int col) =>
    for k = 0 to NS - 1
        if slotOn.get(k)
            f_fn(k, col)
    true

// kind: 0 setup ready, 1 order armed, 2 simulated fill, 3 invalidation / cancellation. Only the selected model alerts.
f_msgK(int kind, int slot, string txt) =>
    if slot == selSlot
        evK.set(kind, evK.get(kind) + 1)
        bool want = (kind == 0 and inAlSetup) or (kind == 1 and inAlArm) or (kind == 2 and inAlFill) or (kind == 3 and inAlInv) or (kind == 4 and inAlExit)
        if want
            aMsgs.push("H Ticks C | " + slotNm.get(slot) + " | " + txt + " | " + syminfo.ticker + " (research model; simulation)")
    true

// ───────────────────────────────────── TRADE BOOKKEEPING ─────────────────────────────────────
// outcome: 1 target, 2 stop, 3 time exit, 4 ambiguous (counted at the stop = conservative).
f_finish(Mdl md, int outcome, float exitPx, int exitTime, string note) =>
    Trade t = md.tr
    float sgn = t.dir > 0 ? 1.0 : -1.0
    float pv = syminfo.pointvalue
    float grossUsd = sgn * (exitPx - t.entryPx) * pv * t.qty
    float slipPer = inSlip * syminfo.mintick * pv * t.qty
    float slipUsd = slipPer * (outcome == 1 ? 1.0 : 2.0)
    float commUsd = inComm * t.qty * 2.0
    float riskUsd = t.riskPts * pv * t.qty
    t.isOpen := false
    t.outcome := outcome
    t.exitPx := exitPx
    t.exitT := exitTime
    t.costUsd := slipUsd + commUsd
    t.netUsd := grossUsd - slipUsd - commUsd
    t.grossR := riskUsd > 0 ? grossUsd / riskUsd : na
    t.netR := riskUsd > 0 ? t.netUsd / riskUsd : na
    t.note := t.note == "" ? note : t.note + " | " + note
    md.st := 4
    md.why := note
    if outcome == 4
        f_fn(md.slot, 10)
    true

f_newDay(int key, int dow, Day prev) =>
    Day d = Day.new(key = key, active = dow >= dayofweek.monday and dow <= dayofweek.friday)
    d

// ═════════════════════════════════════ CONTEXTUAL ENGINE ═════════════════════════════════════
// Provenance legend used in comments below:  [GUIDE] concept described in the Powell guide,  [OURS] our mechanical interpretation,
// [OPT] optional experimental filter,  [ENG] engineering approximation.  Nothing here is Powell's official rule set.
const int SC_STD = 5
const int SC_PRE = 6

f_inWin(int m, int a, int b) =>
    a < b ? (m >= a and m < b) : (m >= a or m < b)

f_ag(array<float> a, int k) =>
    a.get(a.size() - 1 - k)

f_agI(array<int> a, int k) =>
    a.get(a.size() - 1 - k)

f_cxCur() =>
    sets.size() > 0 ? sets.get(sets.size() - 1) : na

f_cxSetupBy(int sid) =>
    Setup out = na
    if sets.size() > 0
        for i = sets.size() - 1 to 0
            Setup q = sets.get(i)
            if q.id == sid
                out := q
                break
    out

// ---- why-no-trade bookkeeping: a short category is counted forever, the detailed text is kept for the latest day only
f_why(string cat, string detail) =>
    int ix = rjK.indexof(cat)
    if ix < 0
        rjK.push(cat)
        rjC.push(1)
    else
        rjC.set(ix, rjC.get(ix) + 1)
    dayWhy.push(f_hm(time_close) + " " + detail)
    if cat != "sweep ignored"
        lastRsn.set(0, detail)
    while dayWhy.size() > 10
        dayWhy.shift()
    true

// Setup lifecycle end. Every end goes through here: the end time is recorded (drawings stop there) and each AREA-QUALIFIED setup is classified into ONE
// exclusive reconciliation category (precedence: a candidate was evaluated > daily trade limit > an existing active order > window seen but nothing executable
// > how the setup ended). Candidate/order counters elsewhere are per variant and NOT exclusive with these.
f_cxRecLabel(int c) =>
    array<string> L = array.from("candidate armed", "candidate rejected: stop cap", "candidate rejected: no target / min-R", "candidate rejected: filter / stale / parent", "candidate rejected: sizing / invalid", "no candidate: daily trade limit", "no candidate: an existing order was active", "no candidate: in window but no executable fresh area", "no candidate: invalidated (price beyond the sweep extreme)", "no candidate: expired (age limit)", "no candidate: rolled to the next trading day (never inside an entry window / nothing executable)", "no candidate: superseded / exhausted / other", "no candidate: missing data", "still active (data ended)")
    L.get(c)

f_cxEnd(Setup st, string why, string kind) =>
    if st.st != 8
        st.st := 8
        st.why := why
        st.endT := time_close
        int c = 11
        if st.candN > 0
            c := st.candArmed ? 0 : (st.candCat == "stop" ? 1 : (st.candCat == "target" ? 2 : (st.candCat == "filter" ? 3 : 4)))
        else if st.seqBlock
            c := 5
        else if st.busyBlock
            c := 6
        else if kind == "data"
            c := 12
        else if st.winSeen and not st.execSeen
            c := 7
        else if kind == "inval"
            c := 8
        else if kind == "exp"
            c := 9
        else if kind == "day"
            c := 10
        st.endCat := f_cxRecLabel(c)
        if st.hadArea and not st.counted
            st.counted := true
            rcN.set(c, rcN.get(c) + 1)
    true

// funnel counter for a contextual plan: its own variant column and, for Precision, its entry-method column (7 Fib, 8 Rejection)
f_cxFn(Mdl md, int col) =>
    f_fn(md.slot, col)
    if md.slot == SC_PRE
        f_fn(md.meth == "Fib 0.705" ? 7 : 8, col)
    true

// ---- aggregation ----
f_aggPush(Agg a) =>
    a.O.push(a.o)
    a.H.push(a.h)
    a.L.push(a.l)
    a.C.push(a.c)
    a.T0.push(a.t0)
    a.TC.push(a.tc)
    while a.H.size() > 60
        a.O.shift()
        a.H.shift()
        a.L.shift()
        a.C.shift()
        a.T0.shift()
        a.TC.shift()
    true

// Bucket = minutes since 18:00 NY on the trading day (the 18:00 candle belongs to the FOLLOWING calendar date).
// A candle completes on the last 1m bar of its bucket; if that bar is missing it completes (late, conservatively) when the next bucket starts.
f_aggClear(Agg a) =>
    a.O.clear()
    a.H.clear()
    a.L.clear()
    a.C.clear()
    a.T0.clear()
    a.TC.clear()
    true

// Publish (ok) or DROP (incomplete) the bucket. A dropped bucket clears the history so no pattern (FVG, swing, run, bias) can span the hole.
f_aggClose(Agg a, bool ok) =>
    if ok
        f_aggPush(a)
        a.doneN += 1
        a.nw := true
    else
        f_aggClear(a)
        a.dropN += 1
        a.bad := true
    a.has := false
    true

// Completeness bookkeeping per synthetic timeframe. Bucket = minutes since 18:00 NY on the trading day. The scheduled 17:00-18:00 break is EXPLICIT:
// a bucket that reaches it ends at 17:00 (minute 1380), so the 4H candle 14:00-17:00 and the Daily candle 18:00-17:00 expect 180 / 1380 one-minute candles.
// A candle is published only if its first/last candle are on the expected boundaries (within the tolerance) and no more than the tolerance is missing.
// A gap between consecutive 1m candles is "explained" only when it follows the 16:59 candle (break, weekend, holiday); any other hole clears history.
f_aggStep(Agg a) =>
    a.nw := false
    a.bad := false
    int ms18 = (mOpen - 1080 + 1440) % 1440
    int span = a.n >= 1440 ? 1440 : a.n
    int idx = a.n >= 1440 ? 0 : int(math.floor(ms18 / a.n))
    int bkt = tdk * 10000 + idx
    int startMs = idx * span
    int endMs = math.min((idx + 1) * span, 1380)
    int prevM = na(pCloseT) ? -1 : hour(pCloseT - chartMs, TZ) * 60 + minute(pCloseT - chartMs, TZ)
    int missed = na(pCloseT) ? 0 : int(math.round((time - pCloseT) / chartMs))
    bool hole = missed > inCxMiss and prevM != 1019
    if a.has and bkt != a.id
        // the previous bucket never saw its last candle
        bool okp = a.firstMs - a.idx * span <= inCxMiss and (math.min((a.idx + 1) * span, 1380) - 1) - a.lastMs <= inCxMiss and a.cnt >= (math.min((a.idx + 1) * span, 1380) - a.idx * span) - inCxMiss and not a.gap
        f_aggClose(a, okp)
    if hole
        a.gap := true
        if a.H.size() > 0
            f_aggClear(a)
            a.bad := true
    if not a.has
        a.o := open
        a.h := high
        a.l := low
        a.c := close
        a.t0 := time
        a.tc := time_close
        a.id := bkt
        a.idx := idx
        a.cnt := 1
        a.firstMs := ms18
        a.lastMs := ms18
        a.gap := hole
        a.has := true
    else
        a.h := math.max(a.h, high)
        a.l := math.min(a.l, low)
        a.c := close
        a.tc := time_close
        a.cnt += 1
        a.lastMs := ms18
    if ms18 + 1 == endMs
        bool ok = a.firstMs - startMs <= inCxMiss and endMs - 1 - a.lastMs <= inCxMiss and a.cnt >= (endMs - startMs) - inCxMiss and not a.gap
        f_aggClose(a, ok)
    a.nw or a.bad

// ---- levels ----
f_newLevel(string ty, int side, float px, int origin, int known, bool sup) =>
    bool dup = false
    for lv in lvls
        if lv.ty == ty
            if sup and lv.st < 2
                lv.st := 3
                if lv.side != 0
                    cxN.set(5, cxN.get(5) + 1)
            else if not sup and lv.px == px
                dup := true
    Lvl out = na
    if not dup
        cxN.set(0, cxN.get(0) + 1)
        out := Lvl.new(id = cxN.get(0), ty = ty, side = side, px = px, origin = origin, known = known)
        lvls.push(out)
        int i = lvls.size() - 1
        while i >= 0
            Lvl q = lvls.get(i)
            if q.st == 3 or time - q.known > 345600000
                lvls.remove(i)
            i -= 1
        while lvls.size() > 60
            lvls.shift()
    out

// Level statuses use only levels that ALREADY exist: a level created at this candle's close is first tested on the next candle,
// so the candle that defines a level can never sweep it. A level also cannot be swept by a candle that opened before the level was known.
f_cxLvlStatus() =>
    float sw = inCxSwTk * tk
    for lv in lvls
        if lv.side == 0
            if lv.st == 0 and time >= lv.known and low <= lv.px and high >= lv.px
                lv.st := 1
        else if lv.st < 2 and time >= lv.known
            if lv.side > 0
                if high >= lv.px + sw
                    lv.st := 2
                    lv.swT := time_close
                    lv.swOpen := time
                else if high >= lv.px
                    lv.st := 1
            else
                if low <= lv.px - sw
                    lv.st := 2
                    lv.swT := time_close
                    lv.swOpen := time
                else if low <= lv.px
                    lv.st := 1
    true

// A predefined session range becomes a level only once COMPLETED (at least 80% of its minutes present).
f_cxRange(Rg r, string rs, string tyH, string tyL, bool enable) =>
    if enable
        int a = f_mins(rs, 0)
        int b = f_mins(rs, 5)
        int e = b % 1440
        bool inW = a != e and f_inWin(mOpen, a, e == 0 ? 1440 : e)
        if inW and not r.active
            r.active := true
            r.h := na
            r.l := na
            r.n := 0
            r.origin := time
        if inW
            r.h := na(r.h) ? high : math.max(r.h, high)
            r.l := na(r.l) ? low : math.min(r.l, low)
            r.n += 1
        bool fin = false
        int kn = 0
        if inW and (mOpen + 1) % 1440 == e
            fin := true
            kn := time_close
        else if r.active and not inW
            fin := true
            kn := nz(pCloseT)
        if fin and r.active
            int dur = (b - a + 1440) % 1440
            if dur == 0
                dur := 1440
            if r.n >= 0.8 * dur and not na(r.h)
                f_newLevel(tyH, 1, r.h, r.origin, kn, true)
                f_newLevel(tyL, -1, r.l, r.origin, kn, true)
            r.active := false
    true

f_cxLevelsBar() =>
    int m = mOpen
    if m == 570
        rgRTH.h := na
        rgRTH.l := na
        rgRTH.n := 0
        csT.hi := na
        csT.lo := na
        csT.hiReg := false
        csT.loReg := false
    if m >= 570 and m < 960
        rgRTH.h := na(rgRTH.h) ? high : math.max(rgRTH.h, high)
        rgRTH.l := na(rgRTH.l) ? low : math.min(rgRTH.l, low)
        rgRTH.n += 1
        if m == 959 and inCxLvPS and rgRTH.n >= 390
            f_newLevel("PSH", 1, rgRTH.h, time, time_close, true)
            f_newLevel("PSL", -1, rgRTH.l, time, time_close, true)
        // [OURS] current-session extreme that has stood for N minutes becomes a level (it existed BEFORE any later sweep of it)
        if inCxLvCS
            if na(csT.hi) or high > csT.hi
                csT.hi := high
                csT.hiT := time_close
                csT.hiReg := false
            if na(csT.lo) or low < csT.lo
                csT.lo := low
                csT.loT := time_close
                csT.loReg := false
            if not csT.hiReg and time_close - csT.hiT >= inCsAge * chartMs
                f_newLevel("CSH", 1, csT.hi, csT.hiT, time_close, false)
                csT.hiReg := true
            if not csT.loReg and time_close - csT.loT >= inCsAge * chartMs
                f_newLevel("CSL", -1, csT.lo, csT.loT, time_close, false)
                csT.loReg := true
    if inCxLvOR
        if m == orS
            rgOR.h := na
            rgOR.l := na
            rgOR.n := 0
        if m >= orS and m < orE
            rgOR.h := na(rgOR.h) ? high : math.max(rgOR.h, high)
            rgOR.l := na(rgOR.l) ? low : math.min(rgOR.l, low)
            rgOR.n += 1
            if m == orE - 1 and rgOR.n >= orE - orS
                f_newLevel("ORH", 1, rgOR.h, time, time_close, true)
                f_newLevel("ORL", -1, rgOR.l, time, time_close, true)
    f_cxRange(rgAS, inCxAs, "ASH", "ASL", inCxLvAS)
    f_cxRange(rgLD, inCxLd, "LDH", "LDL", inCxLvLD)
    f_cxRange(rgPO, inCxPo, "PO3H", "PO3L", inCxLvPO)
    // [GUIDE] key opens are reference context only; they are never sweep levels and never an entry by themselves
    if m == 1080 or m == 0 or m == 600
        f_newLevel(m == 1080 ? "O1800" : (m == 0 ? "O0000" : "O1000"), 0, open, time, time_close, true)
    true

// ---- higher-timeframe bias (completed candles only) and optional HTF points of interest ----
// PRIOR-RANGE BREAKOUT STATE (not a CISD): +1 after a completed candle closes above the previous completed candle's high, -1 after a close below its low,
// otherwise the last state PERSISTS (0 until the first breakout). It is unavailable until two consecutive complete candles exist and is RESET to unavailable
// whenever that timeframe drops an incomplete candle. The CISD used for setups is a different, per-setup construct (opposing delivery leg, see f_cxRef).
f_cxPrb(int ix, Agg a) =>
    if a.bad
        prbS.set(ix, 0)
        prbT.set(ix, na)
        if ix == 2
            poi15.clear()
        if ix == 4
            poi60.clear()
    if a.nw and a.H.size() >= 2
        float c0 = f_ag(a.C, 0)
        if c0 > f_ag(a.H, 1)
            prbS.set(ix, 1)
        else if c0 < f_ag(a.L, 1)
            prbS.set(ix, -1)
        prbT.set(ix, a.TC.last())
    if a.nw and (ix == 2 or ix == 4) and a.H.size() >= 3
        array<Fvg> pl = ix == 2 ? poi15 : poi60
        float h1 = f_ag(a.H, 2)
        float l1 = f_ag(a.L, 2)
        float h3 = f_ag(a.H, 0)
        float l3 = f_ag(a.L, 0)
        if l3 > h1
            pl.push(Fvg.new(id = 0, dir = 1, lo = h1, hi = l3, c1open = f_agI(a.T0, 2), known = time_close))
        if h3 < l1
            pl.push(Fvg.new(id = 0, dir = -1, lo = h3, hi = l1, c1open = f_agI(a.T0, 2), known = time_close))
        while pl.size() > 10
            pl.shift()
    if a.nw and (ix == 2 or ix == 4) and a.H.size() >= 1
        array<Fvg> pl2 = ix == 2 ? poi15 : poi60
        float cc = f_ag(a.C, 0)
        for f in pl2
            if not f.dead and (f.dir > 0 ? cc < f.lo : cc > f.hi)
                f.dead := true
    true

// priority of a level family when several are swept by one candle or compete for an active setup (0 = strongest)
f_cxPri(string ty) =>
    ty == "PDH" or ty == "PDL" ? 0 : (ty == "PSH" or ty == "PSL" ? 1 : (ty == "PO3H" or ty == "PO3L" ? 2 : (ty == "ASH" or ty == "ASL" ? 3 : (ty == "LDH" or ty == "LDL" ? 4 : (ty == "ORH" or ty == "ORL" ? 5 : (ty == "EQH" or ty == "EQL" ? 6 : 7))))))

// Day-level funnel counts for the contextual slots (setup-level events are shared by Standard and Precision)
f_fnA2(int col) =>
    for k = 5 to 8
        if slotOn.get(k)
            f_fn(k, col)
    true

// ---- source-timeframe events ----
f_cxSrc() =>
    aggs.get(inCxTf == "1m" ? 0 : (inCxTf == "5m" ? 1 : 2))

f_cxTfMs() =>
    (inCxTf == "1m" ? 1 : (inCxTf == "5m" ? 5 : 15)) * chartMs

// A confirmed swing (strength P each side) plus the block associated with it: for a swing LOW the last bearish candle at/before it (the order block of the
// up-leg that starts there); for a swing HIGH the last bullish candle at/before it. Known only when the swing was confirmed (never back-dated).
f_cxSwing(Agg A, int i, int side) =>
    float px = side > 0 ? A.H.get(i) : A.L.get(i)
    float bLo = na
    float bHi = na
    for k = 0 to 3
        int j = i - k
        if j >= 0 and na(bLo)
            bool cand = side > 0 ? A.C.get(j) > A.O.get(j) : A.C.get(j) < A.O.get(j)
            if cand
                bLo := A.L.get(j)
                bHi := A.H.get(j)
    swgs.push(Sw.new(side = side, px = px, open = A.T0.get(i), kn = time_close, bLo = bLo, bHi = bHi))
    while swgs.size() > 30
        swgs.shift()
    true

// FVG store (3 candles; usable once the third closed), confirmed swings (strength P each side), and equal highs/lows.
f_cxPivFvg(Agg A) =>
    int n = A.H.size()
    int P = inCxPv
    if n >= 3
        float h1 = f_ag(A.H, 2)
        float l1 = f_ag(A.L, 2)
        float h3 = f_ag(A.H, 0)
        float l3 = f_ag(A.L, 0)
        if l3 > h1
            cxN.set(2, cxN.get(2) + 1)
            fvgs.push(Fvg.new(id = cxN.get(2), dir = 1, lo = h1, hi = l3, c1open = f_agI(A.T0, 2), known = time_close))
        if h3 < l1
            cxN.set(2, cxN.get(2) + 1)
            fvgs.push(Fvg.new(id = cxN.get(2), dir = -1, lo = h3, hi = l1, c1open = f_agI(A.T0, 2), known = time_close))
    if n >= 1
        float cc = f_ag(A.C, 0)
        int ct0 = f_agI(A.T0, 0)
        for f in fvgs
            if not f.dead
                if not f.inv
                    if f.dir > 0 ? cc < f.lo : cc > f.hi
                        f.inv := true
                        f.invOpen := ct0
                        f.invKnown := time_close
                else if ct0 > f.invOpen
                    if f.dir > 0 ? cc > f.hi : cc < f.lo
                        f.dead := true
        while fvgs.size() > 40
            fvgs.shift()
    if n >= 2 * P + 1
        int i = n - 1 - P
        float ph = A.H.get(i)
        float pl = A.L.get(i)
        bool okH = true
        bool okL = true
        for j = 1 to P
            okH := okH and A.H.get(i - j) < ph and A.H.get(i + j) < ph
            okL := okL and A.L.get(i - j) > pl and A.L.get(i + j) > pl
        if okH
            f_cxSwing(A, i, 1)
            pvPx.set(0, ph)
            pvOp.set(0, A.T0.get(i))
            pvKn.set(0, time_close)
        if okL
            f_cxSwing(A, i, -1)
            pvPx.set(1, pl)
            pvOp.set(1, A.T0.get(i))
            pvKn.set(1, time_close)
        if inCxLvEQ
            float tol = inEqTol * tk
            for q = 0 to 1
                bool ok = q == 0 ? okH : okL
                float px = q == 0 ? ph : pl
                if ok
                    bool hit = false
                    for pv in eqP
                        if not hit and not pv.dead and pv.side == (q == 0 ? 1 : -1) and math.abs(pv.px - px) <= tol
                            f_newLevel(q == 0 ? "EQH" : "EQL", q == 0 ? 1 : -1, q == 0 ? math.max(px, pv.px) : math.min(px, pv.px), A.T0.get(i), time_close, false)
                            pv.dead := true
                            hit := true
                    eqP.push(Pv.new(side = q == 0 ? 1 : -1, px = px))
            while eqP.size() > 12
                eqP.shift()
            float chh = A.H.get(n - 1)
            float cll = A.L.get(n - 1)
            for pv in eqP
                if not pv.dead and (pv.side > 0 ? chh > pv.px + inEqTol * tk : cll < pv.px - inEqTol * tk)
                    pv.dead := true
    true

// [OURS] CISD reference = first open of the most recent contiguous opposite-colour run leading into the sweep candle (dojis end a run).
f_cxRef(Agg A, int d) =>
    int n = A.H.size()
    int j = n - 1
    float ref = na
    int refOpen = na
    bool opp0 = d > 0 ? A.C.get(j) < A.O.get(j) : A.C.get(j) > A.O.get(j)
    if not opp0
        j -= 1
    if j >= 0
        bool oppJ = d > 0 ? A.C.get(j) < A.O.get(j) : A.C.get(j) > A.O.get(j)
        if oppJ
            while j - 1 >= 0 and (d > 0 ? A.C.get(j - 1) < A.O.get(j - 1) : A.C.get(j - 1) > A.O.get(j - 1))
                j -= 1
            ref := A.O.get(j)
            refOpen := A.T0.get(j)
    [ref, refOpen]

// [OURS] rejection block: a candle at/after the sweep with a long wick and a small body; the zone is the wick.
f_cxMkArea(string kind, float lo, float hi, int known, int src) =>
    cxN.set(4, cxN.get(4) + 1)
    Area.new(id = cxN.get(4), kind = kind, lo = lo, hi = hi, ce = (lo + hi) / 2.0, known = known, src = src)

f_cxRb(Setup st, Agg A) =>
    if inARb
        float h0 = f_ag(A.H, 0)
        float l0 = f_ag(A.L, 0)
        float o0 = f_ag(A.O, 0)
        float c0 = f_ag(A.C, 0)
        float rng = h0 - l0
        if rng > 0 and f_agI(A.T0, 0) >= st.swOpen
            float body = math.abs(c0 - o0)
            float wick = st.dir > 0 ? math.min(o0, c0) - l0 : h0 - math.max(o0, c0)
            float lo = st.dir > 0 ? l0 : math.max(o0, c0)
            float hi = st.dir > 0 ? math.min(o0, c0) : h0
            if wick / rng >= inRbWick - 0.000000001 and body / rng <= inRbBody + 0.000000001 and hi > lo
                st.rbs.push(f_cxMkArea("RB", lo, hi, time_close, f_agI(A.T0, 0)))
    true

// FVG areas (formed after the sweep began) and iFVG areas (opposite gaps inverted by a close after the sweep began), once each per setup.
f_cxCollect(Setup st) =>
    while st.rbs.size() > 0
        st.areas.push(st.rbs.shift())
    for f in fvgs
        if not f.dead and not st.fvgUsed.includes(f.id)
            if inAFvg and f.dir == st.dir and not f.inv and f.c1open >= st.swOpen
                st.areas.push(f_cxMkArea("FVG", f.lo, f.hi, f.known, f.c1open))
                st.fvgUsed.push(f.id)
            else if inAIf and f.dir == -st.dir and f.inv and f.invOpen >= st.swOpen and f.c1open >= st.swOpen - inIfLook * f_cxTfMs()
                st.areas.push(f_cxMkArea("iFVG", f.lo, f.hi, f.invKnown, f.c1open))
                st.fvgUsed.push(f.id)
    true

// [GUIDE] BREAKER, causal confirmed-swing sequence. Bearish (short setup): swing HIGH A -> intervening swing LOW B -> HIGHER swing high C (the sweep extreme)
// -> a completed candle CLOSES below B (a wick is not enough). Bullish mirrors. The broken block is the order block associated with B (the last opposite-colour
// candle at/before B: bearish candle for a swing low, bullish for a swing high); its full high-low is the area. All three swings must be CONFIRMED and the
// closing candle completed before the area exists, and the area is stamped known at that moment. If any part of the structure is missing there is no breaker.
f_cxBrk(Setup st, Agg A) =>
    if inABrk and not st.brkDone and A.H.size() >= 3
        bool bull = st.dir > 0
        Sw c = na
        for s in swgs
            if s.side == (bull ? -1 : 1) and s.px == st.ext and s.open >= st.swOpen and s.kn <= time_close
                c := s
        if not na(c)
            Sw b = na
            Sw a0 = na
            for i = swgs.size() - 1 to 0
                Sw s2 = swgs.get(i)
                if na(b)
                    if s2.side == (bull ? 1 : -1) and s2.open < c.open
                        b := s2
                else if na(a0)
                    if s2.side == c.side and s2.open < b.open and (bull ? s2.px > c.px : s2.px < c.px)
                        a0 := s2
            if not na(b) and not na(a0) and not na(b.bLo)
                bool broke = false
                for k = 0 to A.H.size() - 1
                    if A.T0.get(k) > c.open
                        broke := broke or (bull ? A.C.get(k) > b.px : A.C.get(k) < b.px)
                if broke
                    st.areas.push(f_cxMkArea("BRK", b.bLo, b.bHi, time_close, b.open))
                    st.brkDone := true
    true

// [OPT] SMT, reversal role: the peer index failed to take its own comparable extreme while this index swept.
f_cxSmt(Setup st) =>
    int res = -1
    int n = sBt.size()
    float wP = na
    float wN = na
    float pP = na
    float pN = na
    int cntP = 0
    if n > 0 and not na(sEsL.last())
        for i = n - 1 to 0
            if sBt.get(i) >= st.firstExc
                wP := na(wP) ? (st.dir > 0 ? sEsL.get(i) : sEsH.get(i)) : (st.dir > 0 ? math.min(wP, sEsL.get(i)) : math.max(wP, sEsH.get(i)))
                wN := na(wN) ? (st.dir > 0 ? sNqL.get(i) : sNqH.get(i)) : (st.dir > 0 ? math.min(wN, sNqL.get(i)) : math.max(wN, sNqH.get(i)))
            else if cntP < inSmtLook
                pP := na(pP) ? (st.dir > 0 ? sEsL.get(i) : sEsH.get(i)) : (st.dir > 0 ? math.min(pP, sEsL.get(i)) : math.max(pP, sEsH.get(i)))
                pN := na(pN) ? (st.dir > 0 ? sNqL.get(i) : sNqH.get(i)) : (st.dir > 0 ? math.min(pN, sNqL.get(i)) : math.max(pN, sNqH.get(i)))
                cntP += 1
        if not na(wP) and not na(pP) and not na(wN) and not na(pN)
            bool peerFailed = st.dir > 0 ? wP > pP : wP < pP
            bool meTook = st.dir > 0 ? wN < pN : wN > pN
            res := peerFailed and meTook ? 1 : 0
    res

f_cxCisd(Setup st, Agg A) =>
    st.st := 2
    st.cisdT := time_close
    st.cisdOpen := f_agI(A.T0, 0)
    f_fnA2(2)
    bool bull = st.dir > 0
    int n = A.H.size()
    // [GUIDE] order block = the last opposite-colour candle before the displacement that confirmed the CISD (full high-low, CE = midpoint);
    // [OURS] it must sit at/after the sweep candle.
    int j = n - 1
    while j - 1 >= 0 and (bull ? A.C.get(j - 1) > A.O.get(j - 1) : A.C.get(j - 1) < A.O.get(j - 1))
        j -= 1
    if inAOb and j - 1 >= 0
        float oo = A.O.get(j - 1)
        float oc = A.C.get(j - 1)
        bool opp = bull ? oc < oo : oc > oo
        if opp and A.T0.get(j - 1) >= st.swOpen
            st.areas.push(f_cxMkArea("OB", A.L.get(j - 1), A.H.get(j - 1), time_close, A.T0.get(j - 1)))
    f_cxCollect(st)
    f_cxBrk(st, A)
    if inSmt != "Off"
        st.smt := f_cxSmt(st)
    f_msgK(0, selSlot, "SETUP #" + str.tostring(st.id) + " CONFIRMED " + (bull ? "LONG" : "SHORT") + " - swept " + st.lvl.ty + " " + str.tostring(st.lvl.px, format.mintick) + ", CISD ref " + str.tostring(st.cisdRef, format.mintick) + " closed through, sweep extreme " + str.tostring(st.ext, format.mintick))
    true

// sweep recognition, CISD tracking, expiry and area collection - runs when a SOURCE-timeframe candle completes
f_cxSource(Agg A) =>
    f_cxPivFvg(A)
    int c0t = f_agI(A.T0, 0)
    Setup st = f_cxCur()
    bool act = not na(st) and (st.st == 1 or st.st == 2)
    // [GUIDE] sweep of a PRE-EXISTING level (the level was known before the sweeping candle began)
    Lvl best = na
    for lv in lvls
        if lv.side != 0 and lv.st == 2 and not lv.proc
            lv.proc := true
            bool elig = lv.swOpen >= c0t and lv.known <= lv.swOpen
            if elig
                if na(best)
                    best := lv
                else if f_cxPri(lv.ty) < f_cxPri(best.ty) or (f_cxPri(lv.ty) == f_cxPri(best.ty) and (lv.side > 0 ? lv.px > best.px : lv.px < best.px))
                    best := lv
    if not na(best)
        int d = -best.side
        // an active setup is replaced only by a sweep of a strictly higher-priority level while it still waits for its CISD (a displacement
        // naturally takes minor highs/lows, so those must never replace it)
        bool replace = act and st.st == 1 and f_cxPri(best.ty) < f_cxPri(st.lvl.ty)
        if act and not replace
            // which kind of setup is blocking? 0 waiting for its CISD, 1 CISD done / no order yet, 2 idle (variants finished, nothing pending), 3 order pending or open
            bool pendB = (not na(st.mdlS) and (st.mdlS.st == 2 or st.mdlS.st == 3)) or (not na(st.mdlP) and (st.mdlP.st == 2 or st.mdlP.st == 3))
            int bk = st.st == 1 ? 0 : (pendB ? 3 : (st.stdSt == 2 and st.candN > 0 ? 2 : 1))
            blkC.set(bk, blkC.get(bk) + 1)
            f_why("sweep ignored", "sweep of " + best.ty + " ignored: setup #" + str.tostring(st.id) + " active (" + (bk == 0 ? "waiting for CISD" : (bk == 1 ? "CISD done, no order yet" : (bk == 2 ? "idle, attempts used" : "order pending/open"))) + ", age " + str.tostring(math.round((time_close - st.swT) / 60000.0)) + "m)")
        else
            [ref, refOpen] = f_cxRef(A, d)
            f_fnA2(1)
            int fe = best.swOpen
            for lv in lvls
                if lv.side == best.side and lv.st == 2 and lv.swOpen >= c0t and lv.swOpen < fe
                    fe := lv.swOpen
            cxN.set(1, cxN.get(1) + 1)
            Setup ns = Setup.new(id = cxN.get(1), dir = d, lvl = best, swOpen = c0t, swT = time_close, ext = d > 0 ? f_ag(A.L, 0) : f_ag(A.H, 0), firstExc = fe, dayKey = dkey, areas = array.new<Area>(), rbs = array.new<Area>(), fvgUsed = array.new_int())
            if replace
                f_cxEnd(st, "superseded by a sweep of a higher-priority level", "sup")
            if na(ref)
                f_cxEnd(ns, "no opposing candle run before the sweep (CISD reference unavailable)", "other")
                f_why("CISD reference unavailable", "sweep of " + best.ty + " rejected: " + ns.why)
            else
                ns.st := 1
                ns.cisdRef := ref
                ns.refOpen := refOpen
                f_cxRb(ns, A)
            sets.push(ns)
            while sets.size() > 60
                sets.shift()
            st := ns
    // [GUIDE] CISD: a LATER candle must CLOSE through the frozen reference (the sweep candle itself cannot confirm it)
    if not na(st) and st.st == 1 and st.swOpen != c0t
        st.cnt += 1
        st.ext := st.dir > 0 ? math.min(st.ext, f_ag(A.L, 0)) : math.max(st.ext, f_ag(A.H, 0))
        f_cxRb(st, A)
        float cc = f_ag(A.C, 0)
        if st.dir > 0 ? cc > st.cisdRef : cc < st.cisdRef
            f_cxCisd(st, A)
        else if st.cnt >= inCxSwAge
            f_cxEnd(st, "reversal (CISD) not confirmed within " + str.tostring(inCxSwAge) + " candles", "other")
            f_why("no CISD", "setup #" + str.tostring(st.id) + ": " + st.why)
    else if not na(st) and st.st == 2
        bool busy = (not na(st.mdlS) and (st.mdlS.st == 2 or st.mdlS.st == 3)) or (not na(st.mdlP) and (st.mdlP.st == 2 or st.mdlP.st == 3))
        if time_close - st.cisdT > inCxAgeMin * 60000 and not busy
            f_cxEnd(st, "setup expired: no order within " + str.tostring(inCxAgeMin) + " minutes of the CISD", "exp")
            f_why("setup expired", "setup #" + str.tostring(st.id) + ": " + st.why)
        else
            f_cxRb(st, A)
            f_cxCollect(st)
            f_cxBrk(st, A)
    true


// ---- price areas: staleness, selection ----
// An area dies when a 1m candle CLOSES through its far side. It is stale once price has traded to its CE after it became known
// (a limit at the CE would then already have been touched), so it can never be armed retroactively.
f_cxAreaUpdate(Setup st) =>
    bool bull = st.dir > 0
    for a in st.areas
        if not a.dead
            if a.known <= time and not a.stale
                if bull ? low <= a.ce : high >= a.ce
                    a.stale := true
            if bull ? close < a.lo : close > a.hi
                a.dead := true
    true

f_cxOverlap(Area a, float lo, float hi) =>
    a.hi > lo and a.lo < hi

// [OURS] selected HTF POI: the latest live FVG of the setup direction on the chosen timeframe (known before now)
f_cxPoi(int d) =>
    float lo = na
    float hi = na
    if inPoi != "None"
        array<Fvg> pl = inPoi == "15m FVG" ? poi15 : poi60
        if pl.size() > 0
            for i = pl.size() - 1 to 0
                Fvg f = pl.get(i)
                if f.dir == d and not f.dead and f.known <= time_close
                    lo := f.lo
                    hi := f.hi
                    break
    [lo, hi]

f_cxKindRank(string k) =>
    k == "OB" ? 0 : (k == "BRK" ? 1 : (k == "FVG" ? 2 : (k == "iFVG" ? 3 : 4)))

// Deterministic selection: (1) prefer areas overlapping the selected HTF POI, (2) otherwise the nearest CE to the last close on the retracement path,
// (3) tie -> most recently confirmed, then area type (OB, breaker, FVG, iFVG, rejection block). execSide=true also requires a not-stale CE on the
// executable side of the close (a buy limit below / sell limit above market). Only areas known at or before beforeT are candidates (an area that is
// created by the candle being judged can never be its own parent).
f_cxPick(Setup st, bool execSide, int beforeT) =>
    bool bull = st.dir > 0
    [plo, phi] = f_cxPoi(st.dir)
    Area best = na
    bool bestOv = false
    for a in st.areas
        bool okA = not a.dead and a.known <= beforeT
        if okA and execSide
            okA := not a.stale and (bull ? a.ce < close : a.ce > close)
        if okA
            bool ov = not na(plo) and f_cxOverlap(a, plo, phi)
            bool take = false
            if na(best)
                take := true
            else if ov != bestOv
                take := ov
            else
                float da = math.abs(a.ce - close)
                float db = math.abs(best.ce - close)
                if da != db
                    take := da < db
                else if a.known != best.known
                    take := a.known > best.known
                else
                    take := f_cxKindRank(a.kind) < f_cxKindRank(best.kind)
            if take
                best := a
                bestOv := ov
    best

// Nearest UNSWEPT opposing level that already existed when the order is armed (never a farther one, never a swept one)
f_cxTarget(int d, float entry) =>
    Lvl best = na
    float rejPx = na
    string rej = ""
    for lv in lvls
        if lv.side == d and (d > 0 ? lv.px > entry + tk : lv.px < entry - tk)
            if lv.st < 2 and lv.known <= time_close
                if na(best) or (d > 0 ? lv.px < best.px : lv.px > best.px)
                    best := lv
            else if na(rejPx) or (d > 0 ? lv.px < rejPx : lv.px > rejPx)
                rejPx := lv.px
                rej := lv.ty + " " + str.tostring(lv.px, format.mintick) + (lv.st == 2 ? " swept " + f_hm(lv.swT) : " not yet known")
    string aud = "no eligible level"
    if not na(best)
        aud := best.ty + " L" + str.tostring(best.id) + " " + str.tostring(best.px, format.mintick) + " origin " + str.format_time(best.origin, "MM-dd HH:mm", TZ) + " known " + str.format_time(best.known, "MM-dd HH:mm", TZ) + " " + (best.st == 1 ? "touched, unswept" : "untouched")
        if not na(rejPx) and (d > 0 ? rejPx < best.px : rejPx > best.px)
            aud += " | nearer but ineligible: " + rej
    [best, aud]

// [OPT] engineered-liquidity proximity: unswept same-side (stop side) liquidity within N points beyond the entry
f_cxCeProx(Setup st, float ce) =>
    bool hit = false
    for lv in lvls
        if lv.side == -st.dir and lv.st < 2 and lv.known <= time_close
            if st.dir > 0 ? (lv.px >= ce - inCeDist and lv.px <= ce) : (lv.px >= ce and lv.px <= ce + inCeDist)
                hit := true
    hit

// optional filters; returns the reason text ("" = passed)
f_cxFilters(Setup st, Area area) =>
    string r = ""
    bool bull = st.dir > 0
    for q = 0 to 4
        bool on = q == 0 ? inBiasD : (q == 1 ? inBias4 : (q == 2 ? inBias1 : (q == 3 ? inBias30 : inBias15)))
        int ix = q == 0 ? 6 : (q == 1 ? 5 : (q == 2 ? 4 : (q == 3 ? 3 : 2)))
        string nm = q == 0 ? "Daily" : (q == 1 ? "4H" : (q == 2 ? "1H" : (q == 3 ? "30m" : "15m")))
        if on and r == ""
            if na(prbT.get(ix)) or prbS.get(ix) == 0
                r := "prior-range state " + nm + " unavailable or none yet"
            else if (prbS.get(ix) > 0) != bull
                r := "prior-range state " + nm + " against the setup"
    if r == "" and inFPo3 and st.lvl.ty != "PO3H" and st.lvl.ty != "PO3L"
        r := "PO3 filter: the swept level is not the PO3 range"
    if r == "" and inFConf and not na(area)
        bool ov = false
        for a in st.areas
            if not a.dead and a.kind != area.kind and f_cxOverlap(a, area.lo, area.hi)
                ov := true
        if not ov
            r := "no FVG/breaker confluence with the parent area"
    if r == "" and inFIfvg
        bool has = false
        for a in st.areas
            if a.kind == "iFVG" and not a.dead
                has := true
        if not has
            r := "no iFVG confirmation"
    if r == "" and inFChop
        Agg A = f_cxSrc()
        if A.H.size() >= inChopN
            float net = math.abs(f_ag(A.C, 0) - f_ag(A.O, inChopN - 1))
            float path = 0.0
            for k = 0 to inChopN - 1
                path += f_ag(A.H, k) - f_ag(A.L, k)
            if path <= 0 or net / path < inChopMin
                r := "chop filter: efficiency ratio too low"
    if r == "" and inSmt != "Off" and st.smt != 1
        r := st.smt == 0 ? "SMT (reversal) not present" : "SMT data unavailable"
    r

// ---- sequence gating (per variant, per NY day) ----
// returns [multiplier, first trade's actual cash risk, reason]; multiplier 0 = not allowed now
f_cxSeq(int slot) =>
    float mult = 0.0
    float firstRisk = na
    string why = ""
    int doneN = 0
    float lastNet = na
    for t in trades
        if t.slot == slot and t.dayKey == dkey
            doneN += 1
            if doneN == 1
                firstRisk := t.riskUsd
                lastNet := t.netR
    bool pend = false
    for md in plans
        if md.slot == slot and md.dayKey == dkey and (md.st == 2 or md.st == 3)
            pend := true
    if pend
        why := "busy"
    else if doneN == 0
        mult := 1.0
    else if inSeq != "One trade per day" and doneN == 1 and not (not na(lastNet) and lastNet > 0)
        mult := 0.5
    else
        why := "daily sequence complete"
    [mult, firstRisk, why]

f_cxDrop(Mdl md, string why, string cat, int col) =>
    md.st := 4
    md.why := why
    f_cxFn(md, col)
    f_why(cat, md.meth + ": " + why)
    f_msgK(3, md.slot, "REJECTED - " + md.meth + ": " + why)
    Setup s = f_cxSetupBy(md.sid)
    if not na(s) and s.candCat == ""
        s.candCat := cat == "stop cap" ? "stop" : (cat == "no target" or cat == "min R" ? "target" : (cat == "filter" or cat == "stale fib" or cat == "no parent" ? "filter" : "other"))
    false

f_cxNewMdl(int slot, Setup st, string meth) =>
    Mdl md = Mdl.new(slot = slot, dir = st.dir, dayKey = dkey, sid = st.id, xExt = st.ext, meth = meth)
    plans.push(md)
    while plans.size() > 150
        plans.shift()
    st.candN += 1
    f_cxFn(md, 4)
    md

// entry/stop/target planning on ROUNDED prices; arms a limit order that is eligible from the NEXT candle
f_cxPlan(Setup st, Mdl md, float entryRaw, float stopRaw, int cap, float minR, float mult, float firstRisk) =>
    bool bull = st.dir > 0
    float entry = math.round_to_mintick(entryRaw)
    float stop = math.round_to_mintick(stopRaw)
    float dist = bull ? entry - stop : stop - entry
    int riskT = int(math.round(dist / tk))
    bool armed = false
    if riskT < 1
        f_cxDrop(md, "stop is not beyond the entry after rounding", "stop invalid", 8)
    else if riskT > cap
        f_cxDrop(md, "stop-cap rejection: " + str.tostring(riskT) + " ticks > " + str.tostring(cap) + " (never squeezed)", "stop cap", 8)
    else
        int qty = inQty
        float perC = riskT * tk * syminfo.pointvalue
        if inSizeMode == "Fixed cash risk"
            qty := int(math.floor(inCashRisk / perC))
        if mult != 1.0 and not na(firstRisk)
            qty := int(math.floor(mult * firstRisk / perC))
        if qty < 1
            f_cxDrop(md, "sizing rejection: one contract risks more than the budget", "sizing", 14)
        else
            float tgt = na
            Lvl tl = na
            string tt = "liquidity"
            string aud = "fixed R"
            if inCxTgt == "Fixed R"
                tgt := bull ? entry + inCxFixR * dist : entry - inCxFixR * dist
                tt := "fixed-R"
            else
                [tl0, aud0] = f_cxTarget(st.dir, entry)
                tl := tl0
                aud := aud0
                tgt := na(tl) ? na : tl.px
            if na(tgt)
                f_cxDrop(md, "no eligible unswept opposing liquidity target", "no target", 11)
            else
                float tgtR = math.round_to_mintick(tgt)
                float pR = math.abs(tgtR - entry) / dist
                if pR < minR - 0.000000001
                    f_cxDrop(md, "minimum-R rejection: planned " + str.tostring(pR, "#.00") + "R < " + str.tostring(minR, "#.0") + "R", "min R", 13)
                else
                    md.lim := entry
                    md.stp := stop
                    md.tgt := tgtR
                    md.qty := qty
                    md.plannedR := pR
                    md.tgtType := tt
                    md.tgtId := na(tl) ? 0 : tl.id
                    md.tgtTy := na(tl) ? "fixed-R" : tl.ty
                    md.tgtAud := aud
                    st.candArmed := true
                    md.mult := mult
                    md.st := 2
                    md.armBar := bar_index
                    md.armT := time_close
                    f_cxFn(md, 5)
                    armed := true
                    f_msgK(1, md.slot, "ORDER ARMED (simulated limit, NOT a fill) setup #" + str.tostring(st.id) + " " + md.meth + " " + (bull ? "LONG" : "SHORT") + " limit " + str.tostring(entry, format.mintick) + " stop " + str.tostring(stop, format.mintick) + " (" + str.tostring(riskT) + " ticks) target " + str.tostring(tgtR, format.mintick) + " (" + tt + ", planned " + str.tostring(pR, "#.0") + "R)")
    armed

// Entry eligibility is separate from context ingestion: orders may be armed only inside the window on Monday-Friday (NY calendar day of the candle).
// Sunday-evening and overnight data still feed levels, ranges and aggregation.
f_cxArmWin() =>
    dowN >= dayofweek.monday and dowN <= dayofweek.friday and mOpen >= winS and mOpen < cutM

// ---- Standard: limit at the CE of the selected area; stop beyond the FULL setup sweep extreme ----
f_cxTryStd(Setup st) =>
    if slotOn.get(SC_STD) and st.stdSt == 0 and f_cxArmWin()
        [mult, firstRisk, why] = f_cxSeq(SC_STD)
        if mult == 0.0
            if why != "busy"
                st.stdSt := 2
                st.seqBlock := st.candN == 0
                f_why("daily sequence", "Standard: " + why)
            else
                st.busyBlock := st.candN == 0
        else
            Area area = f_cxPick(st, true, time_close)
            if not na(area)
                st.stdSt := 2
                Mdl md = f_cxNewMdl(SC_STD, st, "Area CE")
                st.mdlS := md
                md.areaK := area.kind
                md.aLo := area.lo
                md.aHi := area.hi
                md.aCe := area.ce
                string fl = f_cxFilters(st, area)
                if fl != ""
                    f_cxDrop(md, fl, "filter", 12)
                else if inFCe and f_cxCeProx(st, area.ce)
                    f_cxDrop(md, "engineered-liquidity proximity: same-side liquidity within " + str.tostring(inCeDist, "#.0") + " pts beyond the CE", "filter", 12)
                else
                    float stopRaw = st.dir > 0 ? st.ext - inCxBuf * tk : st.ext + inCxBuf * tk
                    if f_cxPlan(st, md, area.ce, stopRaw, inCxCap, inCxMinR, mult, firstRisk)
                        st.stdSt := 1
    true

// ---- Precision A: Fib. Anchors = sweep extreme + the FIRST confirmed swing after the CISD (known only when its right side closed) ----
// Endpoint DETECTION, stale TRACKING and order ARMING are separate: the first eligible endpoint is stored with its original confirmation time whether or not
// the entry window is open, it is never replaced by a later swing, it becomes stale the moment price trades to the entry level, and it is armed only inside the
// entry window and only if it is still eligible then.
f_cxFibEntry(Setup st) =>
    bool bull = st.dir > 0
    float hx = bull ? st.fibPx : st.ext
    float lx = bull ? st.ext : st.fibPx
    float rg = hx - lx
    float e = bull ? hx - inFibE * rg : lx + inFibE * rg
    float ref = bull ? hx - inFibS * rg : lx + inFibS * rg
    [rg, e, ref]

f_cxFibDetect(Setup st, Agg A) =>
    if slotOn.get(SC_PRE) and inPFibOn and st.fibSt == 0
        bool bull = st.dir > 0
        int q = bull ? 0 : 1
        if not na(pvKn.get(q)) and pvKn.get(q) == time_close and pvOp.get(q) >= st.cisdOpen
            st.fibSt := 1
            st.fibPx := pvPx.get(q)
            st.fibOp := pvOp.get(q)
            st.fibKn := pvKn.get(q)
            [rg, e, ref] = f_cxFibEntry(st)
            float eR = math.round_to_mintick(e)
            // stale: the candles AFTER the swing candle are all known now; if any already reached the entry it was traversed before the anchor existed
            bool trav = false
            int n = A.H.size()
            for i = 0 to n - 1
                if A.T0.get(i) > st.fibOp
                    trav := trav or (bull ? A.L.get(i) <= eR : A.H.get(i) >= eR)
            if rg <= 0
                st.fibSt := 3
                f_why("fib invalid", "Fib: the leg has no size")
                f_fn(SC_PRE, 8)
                f_fn(7, 8)
            else if trav or not (bull ? eR < close : eR > close)
                st.fibSt := 3
                if st.winSeen
                    st.candN += 1
                    st.candCat := st.candCat == "" ? "filter" : st.candCat
                f_why("stale fib", "Fib: " + str.tostring(inFibE, "#.000") + " (" + str.tostring(eR, format.mintick) + ") was already traversed before the swing anchor (confirmed " + f_hm(st.fibKn) + ") existed; no back-dated entry")
                f_fn(SC_PRE, 12)
                f_fn(7, 12)
    true

// every 1m candle: a stored candidate dies as soon as price trades to its entry level (a limit placed later would be retroactive)
f_cxFibTrack(Setup st) =>
    if st.fibSt == 1 and time >= st.fibKn
        [rg, e, ref] = f_cxFibEntry(st)
        float eR = math.round_to_mintick(e)
        if st.dir > 0 ? low <= eR : high >= eR
            st.fibSt := 3
            if st.winSeen
                st.candN += 1
                st.candCat := st.candCat == "" ? "filter" : st.candCat
            f_why("stale fib", "Fib: price traded to " + str.tostring(eR, format.mintick) + " after the anchor was confirmed (" + f_hm(st.fibKn) + ") and before an order could be armed")
            f_fn(SC_PRE, 12)
            f_fn(7, 12)
    true

f_cxFibArm(Setup st) =>
    if slotOn.get(SC_PRE) and st.fibSt == 1 and f_cxArmWin()
        [mult, firstRisk, why] = f_cxSeq(SC_PRE)
        // a VALID parent area is required for Precision (independent of the optional overlap filter below). If none is alive/known YET the stored
        // candidate WAITS (it is not consumed): parents can still form while the window is open.
        Area par = f_cxPick(st, false, time_close)
        if mult == 0.0
            if why != "busy"
                st.fibSt := 3
                st.seqBlock := st.candN == 0
                f_why("daily sequence", "Precision Fib: " + why)
            else
                st.busyBlock := st.candN == 0
        else if na(par)
            if not st.parWait
                st.parWait := true
                f_why("no parent yet", "Fib candidate waits: no valid parent area is known and alive yet")
        else
            bool bull = st.dir > 0
            Mdl md = f_cxNewMdl(SC_PRE, st, "Fib 0.705")
            st.mdlP := md
            st.fibSt := 3
            md.fH := bull ? st.fibPx : st.ext
            md.fL := bull ? st.ext : st.fibPx
            md.areaK := par.kind
            md.aLo := par.lo
            md.aHi := par.hi
            md.aCe := par.ce
            md.parId := par.id
            [rg, e, ref] = f_cxFibEntry(st)
            float eR = math.round_to_mintick(e)
            if not (bull ? eR < close : eR > close)
                f_cxDrop(md, "stale: the entry is no longer on the executable side of the market", "stale fib", 12)
            else if inFibArea and (eR < par.lo or eR > par.hi)
                f_cxDrop(md, "Fib entry does not overlap the selected parent area (optional condition)", "filter", 12)
            else
                string fl = f_cxFilters(st, par)
                if fl != ""
                    f_cxDrop(md, fl, "filter", 12)
                else if inFCe and f_cxCeProx(st, eR)
                    f_cxDrop(md, "engineered-liquidity proximity beyond the entry", "filter", 12)
                else
                    float stopRaw = bull ? ref - inCxPBuf * tk : ref + inCxPBuf * tk
                    if f_cxPlan(st, md, e, stopRaw, inCxPCap, inCxPMinR, mult, firstRisk)
                        st.precSt := 1
    true

// ---- Precision B: a completed local rejection candle interacting with the parent area; entry = midpoint of the confirmed wick ----
f_cxTryRej(Setup st, Agg R) =>
    // SEQUENCE: CISD confirmed -> parent area known -> THEN a rejection candle that OPENED after both. The candle cannot create its own parent.
    int rOpen = f_agI(R.T0, 0)
    if slotOn.get(SC_PRE) and inPRejOn and st.precSt != 1 and f_cxArmWin() and rOpen >= st.cisdT
        bool bull = st.dir > 0
        Area par = f_cxPick(st, false, rOpen)
        if not na(par)
            float h0 = f_ag(R.H, 0)
            float l0 = f_ag(R.L, 0)
            float o0 = f_ag(R.O, 0)
            float c0 = f_ag(R.C, 0)
            float rng = h0 - l0
            bool inter = h0 > par.lo and l0 < par.hi
            float bLo = math.min(o0, c0)
            float bHi = math.max(o0, c0)
            float wick = bull ? bLo - l0 : h0 - bHi
            bool dirOk = bull ? c0 > o0 : c0 < o0
            bool intact = bull ? l0 > st.ext : h0 < st.ext
            bool sw = true
            if inRejSweep
                sw := R.H.size() >= 2 and (bull ? l0 < f_ag(R.L, 1) : h0 > f_ag(R.H, 1))
            if rng > 0 and inter and dirOk and intact and sw and wick >= inRejWick * rng - 0.000000001
                [mult, firstRisk, why] = f_cxSeq(SC_PRE)
                if mult == 0.0
                    if why != "busy"
                        st.seqBlock := st.candN == 0
                        f_why("daily sequence", "Precision: " + why)
                    else
                        st.busyBlock := st.candN == 0
                else
                    Mdl md = f_cxNewMdl(SC_PRE, st, "Rejection CE")
                    st.mdlP := md
                    md.areaK := par.kind
                    md.aLo := par.lo
                    md.aHi := par.hi
                    md.aCe := par.ce
                    md.parId := par.id
                    md.rLo := l0
                    md.rHi := h0
                    md.rT := f_agI(R.T0, 0)
                    float e = bull ? (l0 + bLo) / 2.0 : (h0 + bHi) / 2.0
                    string fl = f_cxFilters(st, par)
                    if fl != ""
                        f_cxDrop(md, fl, "filter", 12)
                    else if inFCe and f_cxCeProx(st, math.round_to_mintick(e))
                        f_cxDrop(md, "engineered-liquidity proximity beyond the entry", "filter", 12)
                    else
                        float stopRaw = bull ? l0 - inCxPBuf * tk : h0 + inCxPBuf * tk
                        if f_cxPlan(st, md, e, stopRaw, inCxPCap, inCxPMinR, mult, firstRisk)
                            st.precSt := 1
    true

// ---- plan lifecycle: pending -> filled -> closed (shared simulation rules of the legacy engine, direction taken from the plan) ----
f_cxFinish(Mdl md, int outcome, float exitPx, int exitTime, string note) =>
    f_finish(md, outcome, exitPx, exitTime, note)
    Setup st = f_cxSetupBy(md.sid)
    if not na(st)
        if md.slot == SC_STD
            st.stdSt := 2
        else
            st.precSt := outcome == 1 ? 2 : 0
    if outcome == 4 and md.slot == SC_PRE
        f_fn(md.meth == "Fib 0.705" ? 7 : 8, 10)
    f_msgK(4, md.slot, (outcome == 1 ? "TARGET" : (outcome == 2 ? "STOP" : (outcome == 3 ? "TIME EXIT" : "AMBIGUOUS (counted as loss)"))) + " setup #" + str.tostring(md.sid) + " " + md.meth + " " + (md.dir > 0 ? "LONG" : "SHORT") + " exit " + str.tostring(exitPx, format.mintick) + " (" + str.tostring(md.tr.netR, "#.00") + "R net, simulated)")
    true

f_cxAfterCancel(Mdl md, bool setupDead) =>
    Setup st = f_cxSetupBy(md.sid)
    if not na(st)
        if md.slot == SC_STD
            st.stdSt := 2
        else
            st.precSt := 0
        if setupDead
            f_cxEnd(st, md.why, "inval")
    true

f_cxFillTry(Mdl md) =>
    bool bull = md.dir > 0
    float lim = md.lim
    float thrP = inStrict ? tk : 0.0
    bool touch = bull ? low <= lim - thrP : high >= lim + thrP
    if touch
        bool known = bull ? open <= lim - thrP : open >= lim + thrP
        float stp = md.stp
        float tgt = md.tgt
        Setup st = f_cxSetupBy(md.sid)
        float lvlPx = na(st) ? na : st.lvl.px
        Trade t = Trade.new(slot = md.slot, dir = md.dir, dayKey = md.dayKey, lvl = lvlPx, entryPx = lim, stopPx = stp, tgtPx = tgt, riskPts = math.abs(lim - stp), armT = md.armT, fillT = time, qty = md.qty, plannedR = md.plannedR, tgtType = md.tgtType, riskUsd = math.abs(lim - stp) * syminfo.pointvalue * md.qty, note = md.meth + " | setup #" + str.tostring(md.sid) + " | plan " + str.tostring(md.plannedR, "#.0") + "R " + md.tgtType + (md.plannedR >= 4.0 ? " (4R+)" : "") + " | tgt " + md.tgtAud, meth = md.meth, sid = md.sid)
        md.tr := t
        md.st := 3
        trades.push(t)
        f_cxFn(md, 6)
        f_msgK(2, md.slot, "SIMULATED FILL (limit touch assumed) setup #" + str.tostring(md.sid) + " " + md.meth + " " + (bull ? "LONG" : "SHORT") + " at " + str.tostring(lim, format.mintick) + " stop " + str.tostring(stp, format.mintick) + " target " + str.tostring(tgt, format.mintick))
        bool stopHit = bull ? low <= stp : high >= stp
        bool tgtTouch = bull ? high >= tgt : low <= tgt
        float adv = bull ? lim - low : high - lim
        float fav = bull ? high - lim : lim - low
        t.maeP := math.max(0.0, adv)
        if known
            t.mfeP := math.max(0.0, fav)
        else
            t.mfeP := 0.0
            t.excUnc := fav > 0
            t.entryAmb := tgtTouch or fav > 0
        bool gapStop = bull ? open <= stp : open >= stp
        if gapStop
            // EXECUTION POLICY (gap through entry AND stop): the active resting limit is assumed filled at the limit price (no improvement) and stopped at
            // the open. Real prices cannot be known from OHLC, so the trade is flagged ambiguous, counted as a loss at the worse bound and counted as a gap event.
            t.gap := true
            t.maeP := math.max(t.maeP, bull ? lim - open : open - lim)
            t.excUnc := true
            f_cxFinish(md, 4, open, time, "gap through entry AND stop: resting limit assumed filled at the limit, stopped at the open (conservative, ambiguous)")
        else if stopHit and tgtTouch
            t.maeP := math.max(t.maeP, t.riskPts)
            t.excUnc := true
            f_cxFinish(md, 4, stp, time, "ambiguous: stop and target both reachable on the fill candle")
        else if stopHit
            t.maeP := math.max(t.maeP, t.riskPts)
            f_cxFinish(md, 2, stp, time, "stop hit on the fill candle")
        else if known and tgtTouch
            t.mfeP := math.max(t.mfeP, math.abs(tgt - lim))
            f_cxFinish(md, 1, tgt, time, "target hit on the fill candle (fill at the open)")
    true

f_cxPosStep(Mdl md) =>
    Trade t = md.tr
    bool bull = t.dir > 0
    float stp = md.stp
    float tgt = md.tgt
    float ent = t.entryPx
    bool gStop = bull ? open <= stp : open >= stp
    bool gTgt = bull ? open >= tgt : open <= tgt
    bool stopHit = bull ? low <= stp : high >= stp
    bool tgtHit = bull ? high >= tgt : low <= tgt
    float adv = bull ? ent - low : high - ent
    float fav = bull ? high - ent : ent - low
    float pMae = t.maeP
    float pMfe = t.mfeP
    float tgtD = math.abs(tgt - ent)
    if gStop
        t.maeP := math.max(pMae, bull ? ent - open : open - ent)
        f_cxFinish(md, 2, open, time, "gap through the stop: exit at the open")
    else if gTgt
        t.mfeP := math.max(pMfe, tgtD)
        f_cxFinish(md, 1, tgt, time, "gap through the target: filled at the target (no improvement)")
    else if stopHit and tgtHit
        t.maeP := math.max(pMae, t.riskPts)
        t.mfeP := math.max(pMfe, fav)
        t.excUnc := true
        f_cxFinish(md, 4, stp, time, "ambiguous: stop and target both reachable on one candle")
    else if stopHit
        t.maeP := math.max(pMae, t.riskPts)
        t.excUnc := t.excUnc or fav > pMfe
        f_cxFinish(md, 2, stp, time, "stop hit")
    else if tgtHit
        t.mfeP := math.max(pMfe, tgtD)
        t.maeP := math.max(pMae, adv)
        t.excUnc := t.excUnc or adv > pMae
        f_cxFinish(md, 1, tgt, time, "target hit")
    else
        t.maeP := math.max(pMae, adv)
        t.mfeP := math.max(pMfe, fav)
    true

f_cxCancel(Mdl md, string why, int col, bool setupDead) =>
    md.st := 4
    md.why := why
    f_cxFn(md, col)
    f_msgK(3, md.slot, "CANCELLED/INVALIDATED setup #" + str.tostring(md.sid) + " " + md.meth + " - " + why)
    f_why(col == 9 ? "invalidated" : "unfilled / cancelled", md.meth + ": " + why)
    f_cxAfterCancel(md, setupDead)
    true

f_cxPlanStep(Mdl md) =>
    bool bull = md.dir > 0
    if md.st == 3
        if mOpen >= exitM
            f_cxFinish(md, 3, open, time, "time exit at the hard-exit candle open")
        else
            f_cxPosStep(md)
    else if md.st == 2 and bar_index > md.armBar
        float thrP = inStrict ? tk : 0.0
        if mOpen >= cutM
            f_cxCancel(md, "unfilled: cancelled at the entry cutoff", 7, false)
        else if bar_index > md.armBar + inCxExp
            f_cxCancel(md, "expired: not filled within " + str.tostring(inCxExp) + " candles", 7, false)
        else
            // No cancellation on a gap: an active resting limit is never assumed cancelled before the market gaps through it. A candle that opens beyond
            // the entry fills (touch), and one that opens beyond the STOP is a flagged gap event (see f_cxFillTry), never a silent non-trade.
            bool touchE = bull ? low <= md.lim - thrP : high >= md.lim + thrP
            bool tgtFirst = not touchE and (bull ? high >= md.tgt : low <= md.tgt)
            if tgtFirst
                f_cxCancel(md, "cancelled: the target liquidity was taken before the entry", 7, false)
            else
                f_cxFillTry(md)
    true

// ---- one 1m candle of the contextual engine (called only on confirmed candles) ----
// the source timeframe lost a candle: nothing may span the hole, and a setup that still waits for its CISD cannot be tracked
f_cxSrcBad() =>
    fvgs.clear()
    eqP.clear()
    swgs.clear()
    for q = 0 to 1
        pvPx.set(q, na)
        pvOp.set(q, na)
        pvKn.set(q, na)
    Setup st = f_cxCur()
    if not na(st) and st.st == 1
        f_cxEnd(st, "source candle incomplete (missing 1m data): CISD tracking cannot continue", "data")
        f_why("incomplete data", "setup #" + str.tostring(st.id) + ": " + st.why)
    true

// A setup whose enabled variants have ALL used their attempts and has nothing pending is finished: it must not keep blocking later sweeps.
// (Precision keeps a setup alive while a Fib endpoint is still awaited/stored or the rejection method can still trigger.)
f_cxExhaust(Setup st) =>
    if st.st == 2
        bool pend = (not na(st.mdlS) and (st.mdlS.st == 2 or st.mdlS.st == 3)) or (not na(st.mdlP) and (st.mdlP.st == 2 or st.mdlP.st == 3))
        if not pend and (not slotOn.get(SC_STD) or st.stdSt == 2)
            bool precDone = not slotOn.get(SC_PRE) or st.precSt == 2
            if not precDone
                [m6, fr6, w6] = f_cxSeq(SC_PRE)
                precDone := (m6 == 0.0 and w6 != "busy") or (not inPRejOn and (not inPFibOn or st.fibSt == 3))
            if precDone
                f_cxEnd(st, "exhausted: every enabled variant used its attempt (nothing pending)", "exh")
    true

f_cxBar(Day dy) =>
    // coverage (entry-day bookkeeping only: context ingestion below runs on EVERY candle, including Sunday evening)
    if dy.active and mOpen >= winS and mOpen < exitM
        dy.bars10 += 1
    if dy.active and dy.st == 0 and mOpen >= winS
        if mOpen != winS
            dy.st := 9
            dy.status := 2
            dy.why := "window start candle missing (first candle at/after the window is " + f_hm(time) + ")"
        else
            dy.st := 1
            bool anyLv = false
            for lv in lvls
                if lv.side != 0 and lv.st < 2
                    anyLv := true
            if not anyLv
                dy.status := 4
                dy.why := "no eligible liquidity level was known at the window start (warm-up / missing session data)"
            else
                f_fnA(0)
    // a new trading day (18:00 NY) ends yesterday's un-armed setups: the sweep horizon is the current trading day
    if cxN.get(3) != tdk
        cxN.set(3, tdk)
        for q in sets
            if (q.st == 1 or q.st == 2) and not ((not na(q.mdlS) and (q.mdlS.st == 2 or q.mdlS.st == 3)) or (not na(q.mdlP) and (q.mdlP.st == 2 or q.mdlP.st == 3)))
                f_cxEnd(q, "new trading day", "day")
        dayWhy.clear()
    // SMT buffers (1m)
    if inSmt != "Off"
        sBt.push(time)
        sEsL.push(esL)
        sEsH.push(esH)
        sNqL.push(low)
        sNqH.push(high)
        if sBt.size() > 300
            sBt.shift()
            sEsL.shift()
            sEsH.shift()
            sNqL.shift()
            sNqH.shift()
    // 1) level statuses (existing levels only), area staleness
    f_cxLvlStatus()
    Setup st = f_cxCur()
    if not na(st) and st.st == 2
        f_cxAreaUpdate(st)
        f_cxFibTrack(st)
    // 2) pending / open plans first: they only react to candles AFTER their arming candle
    for md in plans
        if md.st == 2 or md.st == 3
            f_cxPlanStep(md)
    // 3) a setup that has no order yet dies when any candle exceeds its frozen sweep extreme
    if not na(st) and st.st == 2 and (st.dir > 0 ? low < st.ext : high > st.ext)
        bool busy = (not na(st.mdlS) and (st.mdlS.st == 2 or st.mdlS.st == 3)) or (not na(st.mdlP) and (st.mdlP.st == 2 or st.mdlP.st == 3))
        if not busy
            f_cxEnd(st, "setup invalidated: price exceeded the frozen sweep extreme " + str.tostring(st.ext, format.mintick), "inval")
            f_why("invalidated", "setup #" + str.tostring(st.id) + ": " + st.why)
            f_fnA2(9)
    // 3b) aggregation
    for i = 0 to 6
        f_aggStep(aggs.get(i))
    Agg dA = aggs.get(6)
    if dA.nw and inCxLvPD
        f_newLevel("PDH", 1, f_ag(dA.H, 0), f_agI(dA.T0, 0), time_close, true)
        f_newLevel("PDL", -1, f_ag(dA.L, 0), f_agI(dA.T0, 0), time_close, true)
    for i = 2 to 6
        f_cxPrb(i, aggs.get(i))
    // 4) levels created at THIS candle's close
    f_cxLevelsBar()
    // 5) source candle / local rejection candle events
    Agg A = f_cxSrc()
    Agg R = aggs.get(inRejTf == "1m" ? 0 : 1)
    if A.bad
        f_cxSrcBad()
    if A.nw
        f_cxSource(A)
        st := f_cxCur()
        if not na(st) and st.st == 2
            if not st.hadArea and st.areas.size() > 0
                st.hadArea := true
                rcN.set(15, rcN.get(15) + 1)
                f_fnA2(3)
            f_cxFibDetect(st, A)
    st := f_cxCur()
    if not na(st) and st.st == 2
        f_cxFibArm(st)
    st := f_cxCur()
    if R.nw and not na(st) and st.st == 2
        f_cxTryRej(st, R)
    // 6) Standard arming is evaluated on every 1m candle
    st := f_cxCur()
    if not na(st) and st.st == 2
        if f_cxArmWin()
            st.winSeen := true
            if not st.execSeen and not na(f_cxPick(st, true, time_close))
                st.execSeen := true
        f_cxTryStd(st)
        f_cxExhaust(st)
    true

f_cxFinalize(Day dy, float lastC, int lastT) =>
    if dy.active
        for md in plans
            if md.dayKey == dy.key
                if md.st == 3
                    f_cxFinish(md, 3, lastC, lastT, "forced close at the last candle: no candle at/after the hard exit (data missing)")
                else if md.st == 2
                    md.st := 4
                    md.why := "cancelled: the day ended with the order still pending"
                    f_cxFn(md, 7)
        if dy.st == 0
            dy.status := 2
            dy.why := "no candle at/after the window start"
        if dy.status == 0 and dy.bars10 < exitM - winS
            dy.status := 1
        cv.set(0, cv.get(0) + 1)
        cv.set(dy.status + 1, cv.get(dy.status + 1) + 1)
        if inDebug
            log.info("H Ticks C ctx | " + f_dt(dy.key) + " coverage " + str.tostring(dy.status) + " | " + dy.why)
    true

// ───────────────────────────────────────── MAIN LOOP ─────────────────────────────────────────
if supported and cfgAll and barstate.isconfirmed
    aMsgs.clear()
    for q = 0 to 4
        evK.set(q, 0)
    if na(cur) or cur.key != dkey
        if not na(cur)
            f_cxFinalize(cur, pClose, pCloseT)
            if cur.active
                lastAct := cur
        cur := f_newDay(dkey, dowN, lastAct)
        days.push(cur)
        while days.size() > 80
            days.shift()
        if cur.active
            if na(firstKey)
                firstKey := dkey
            lastKey := dkey
    f_cxBar(cur)
    pClose := close
    pCloseT := time_close
    if barstate.isrealtime and aMsgs.size() > 0
        alert(array.join(aMsgs, "\n"), alert.freq_once_per_bar_close)

bool evNow = supported and cfgAll and barstate.isrealtime and barstate.isconfirmed
alertcondition(evNow and evK.get(0) > 0, "Setup ready", "H Ticks C: setup ready (reversal confirmed) on {{ticker}}")
alertcondition(evNow and evK.get(1) > 0, "Order armed", "H Ticks C: order ARMED (simulated limit, not a fill) on {{ticker}}")
alertcondition(evNow and evK.get(2) > 0, "Simulated fill", "H Ticks C: SIMULATED FILL on {{ticker}}")
alertcondition(evNow and evK.get(3) > 0, "Invalidation / cancellation", "H Ticks C: setup invalidated or order cancelled on {{ticker}}")
alertcondition(evNow and evK.get(4) > 0, "Simulated exit", "H Ticks C: simulated stop / target / time exit on {{ticker}}")

// ───────────────────────────────────────── STATISTICS ─────────────────────────────────────────
f_fmt(float v, string f) =>
    na(v) ? "-" : str.tostring(v, f)

// Statistics for one model from CLOSED trades (expired / cancelled / unfilled orders never create a trade, so they are excluded from every rate).
// Indices: 0 counted trades, 1 wins (target), 2 losses (stop + ambiguous at the stop), 3 time exits, 4 ambiguous, 5 net win rate %, 6 net expectancy R,
// 7 profit factor, 8 avg winner R, 9 avg loser R, 10 max consecutive losses, 11 max closed-equity drawdown R, 12 same in USD, 13 net R total,
// 14 avg MAE pts, 15 avg MAE R, 16 median MAE pts, 17 median MAE R, 18 median MAE of winners pts, 19 same in R, 20 % winners with MAE <= 0.25R,
// 21 avg MFE pts, 22 avg MFE R, 23 trades with uncertain excursions, 24 open trades, 25 net USD total, 26 excluded ambiguous,
// 27 gross expectancy R, 28 avg stop distance (ticks), 29 avg planned R, 30 avg actual risk USD (after whole-contract rounding).
f_perf(int slot, string meth) =>
    array<float> r = array.new_float(34, 0.0)
    array<float> maeP = array.new_float(0)
    array<float> maeR = array.new_float(0)
    array<float> maeWP = array.new_float(0)
    array<float> maeWR = array.new_float(0)
    int cntT = 0
    int wins = 0
    int losses = 0
    int tex = 0
    int amb = 0
    int pos = 0
    int neg = 0
    int unc = 0
    int openN = 0
    int exAmb = 0
    int nPlan = 0
    float gw = 0.0
    float gl = 0.0
    float sumNet = 0.0
    float sumGross = 0.0
    float sumUsd = 0.0
    float sumStopT = 0.0
    float sumPlan = 0.0
    float sumRisk = 0.0
    float eq = 0.0
    float pk = 0.0
    float dd = 0.0
    float eqU = 0.0
    float pkU = 0.0
    float ddU = 0.0
    int consec = 0
    int maxC = 0
    float sMae = 0.0
    float sMaeR = 0.0
    float sMfe = 0.0
    float sMfeR = 0.0
    int winLow = 0
    int nW = 0
    int n4 = 0
    int n5 = 0
    int nGap = 0
    int n = trades.size()
    if n > 0
        for i = 0 to n - 1
            Trade t = trades.get(i)
            if t.slot == slot and (meth == "" or t.meth == meth)
                if t.isOpen
                    openN += 1
                else if t.outcome == 4 and inAmbMode == "Exclude from stats" and not t.gap
                    exAmb += 1
                else
                    cntT += 1
                    float nr = na(t.netR) ? 0.0 : t.netR
                    float gr = na(t.grossR) ? 0.0 : t.grossR
                    float rk = t.riskPts > 0 ? t.riskPts : 1.0
                    if t.outcome == 1
                        wins += 1
                    else if t.outcome == 3
                        tex += 1
                    else
                        losses += 1
                    if t.outcome == 4
                        amb += 1
                    if t.gap
                        nGap += 1
                    if t.excUnc or t.entryAmb
                        unc += 1
                    sumNet += nr
                    sumGross += gr
                    sumUsd += t.netUsd
                    sumStopT += t.riskPts / tk
                    sumRisk += t.riskUsd
                    if not na(t.plannedR)
                        sumPlan += t.plannedR
                        nPlan += 1
                        if t.plannedR >= 4.0
                            n4 += 1
                        if t.plannedR >= 5.0
                            n5 += 1
                    if nr > 0
                        pos += 1
                        gw += nr
                        maeWP.push(t.maeP)
                        maeWR.push(t.maeP / rk)
                        nW += 1
                        if t.maeP / rk <= 0.25
                            winLow += 1
                    else if nr < 0
                        gl += -nr
                        neg += 1
                    if nr < 0
                        consec += 1
                        maxC := math.max(maxC, consec)
                    else
                        consec := 0
                    eq += nr
                    pk := math.max(pk, eq)
                    dd := math.max(dd, pk - eq)
                    eqU += t.netUsd
                    pkU := math.max(pkU, eqU)
                    ddU := math.max(ddU, pkU - eqU)
                    sMae += t.maeP
                    sMaeR += t.maeP / rk
                    sMfe += t.mfeP
                    sMfeR += t.mfeP / rk
                    maeP.push(t.maeP)
                    maeR.push(t.maeP / rk)
    r.set(0, cntT)
    r.set(1, wins)
    r.set(2, losses)
    r.set(3, tex)
    r.set(4, amb)
    r.set(5, cntT > 0 ? 100.0 * pos / cntT : na)
    r.set(6, cntT > 0 ? sumNet / cntT : na)
    r.set(7, gl > 0 ? gw / gl : na)
    r.set(8, pos > 0 ? gw / pos : na)
    r.set(9, neg > 0 ? -gl / neg : na)
    r.set(10, maxC)
    r.set(11, dd)
    r.set(12, ddU)
    r.set(13, sumNet)
    r.set(14, cntT > 0 ? sMae / cntT : na)
    r.set(15, cntT > 0 ? sMaeR / cntT : na)
    r.set(16, maeP.size() > 0 ? maeP.median() : na)
    r.set(17, maeR.size() > 0 ? maeR.median() : na)
    r.set(18, maeWP.size() > 0 ? maeWP.median() : na)
    r.set(19, maeWR.size() > 0 ? maeWR.median() : na)
    r.set(20, nW > 0 ? 100.0 * winLow / nW : na)
    r.set(21, cntT > 0 ? sMfe / cntT : na)
    r.set(22, cntT > 0 ? sMfeR / cntT : na)
    r.set(23, unc)
    r.set(24, openN)
    r.set(25, sumUsd)
    r.set(26, exAmb)
    r.set(27, cntT > 0 ? sumGross / cntT : na)
    r.set(28, cntT > 0 ? sumStopT / cntT : na)
    r.set(29, nPlan > 0 ? sumPlan / nPlan : na)
    r.set(30, cntT > 0 ? sumRisk / cntT : na)
    r.set(31, n4)
    r.set(32, n5)
    r.set(33, nGap)
    r

f_weekdays(int k1, int k2) =>
    int t0 = f_ts(k1, 720)
    int t1 = f_ts(k2, 720)
    int c = 0
    int t = t0
    while t <= t1
        int dw = dayofweek(t, TZ)
        if dw >= dayofweek.monday and dw <= dayofweek.friday
            c += 1
        t += 86400000
    c

// ───────────────────────────────────────── DRAWINGS ─────────────────────────────────────────
f_clearDraw() =>
    while dLines.size() > 0
        line.delete(dLines.pop())
    while dBoxes.size() > 0
        box.delete(dBoxes.pop())
    while dLabels.size() > 0
        label.delete(dLabels.pop())
    true

f_ln(int x1, float y1, int x2, float y2, color c, string sty, int w) =>
    dLines.push(line.new(x1 = x1, y1 = y1, x2 = x2, y2 = y2, xloc = xloc.bar_time, color = c, style = sty, width = w))
    true

f_bx(int x1, float top, int x2, float bot, color bg, color bc) =>
    dBoxes.push(box.new(left = x1, top = top, right = x2, bottom = bot, xloc = xloc.bar_time, border_color = bc, border_width = 1, bgcolor = bg))
    true

f_bxs(int x1, float top, int x2, float bot, color bg, color bc, string sty) =>
    dBoxes.push(box.new(left = x1, top = top, right = x2, bottom = bot, xloc = xloc.bar_time, border_color = bc, border_width = 1, border_style = sty, bgcolor = bg))
    true

f_lb(int x, float y, string txt, color tc, string sty, string tip) =>
    dLabels.push(label.new(x = x, y = y, text = txt, xloc = xloc.bar_time, style = sty, size = size.tiny, textcolor = tc, color = color.new(color.white, 15), tooltip = tip))
    true

// ───────────────────────────────── CONTEXTUAL DRAWINGS ─────────────────────────────────
// Trade boxes use ONLY values frozen when the order was armed / filled / closed (never later information): black entry line, red risk box, green reward box.
// Pending = dashed, filled = solid, completed = solid plus an exit marker.
f_cxDrawPlan(Mdl md) =>
    if not na(md.lim)
        string pre = md.slot == SC_PRE ? "PREC" : "STD"
        bool done = md.st == 4 and not na(md.tr)
        bool pend = md.st == 2
        string sty = pend ? line.style_dashed : line.style_solid
        int xCut = f_ts(md.dayKey, cutM)
        int xEnd = f_ts(md.dayKey, exitM)
        int xe = xEnd
        if pend
            xe := math.min(xCut, md.armT + inCxExp * chartMs)
        else if done
            xe := md.tr.exitT
        int xs = pend ? md.armT : md.tr.fillT
        float distP = math.abs(md.lim - md.stp)
        int distT = int(math.round(distP / tk))
        f_bxs(xs, math.max(md.lim, md.stp), xe, math.min(md.lim, md.stp), color.new(color.red, pend ? 88 : 78), color.red, sty)
        f_bxs(xs, math.max(md.lim, md.tgt), xe, math.min(md.lim, md.tgt), color.new(color.green, pend ? 88 : 78), color.green, sty)
        f_ln(xs, md.lim, xe, md.lim, color.black, line.style_solid, 2)
        string head = pre + " " + md.meth + " #" + str.tostring(md.sid) + (pend ? " PENDING" : (done ? "" : " FILLED"))
        f_lb(xe, md.lim, head + " | E " + str.tostring(md.lim, format.mintick) + " | " + str.tostring(md.plannedR, "#.0") + "R", color.black, label.style_label_left, "entry; frozen when armed. " + md.why)
        f_lb(xe, md.stp, "SL " + str.tostring(md.stp, format.mintick) + " (" + str.tostring(distT) + "t)", color.red, label.style_label_left, "stop")
        f_lb(xe, md.tgt, "TP " + str.tostring(md.tgt, format.mintick) + " " + md.tgtTy, color.green, label.style_label_left, "target audit: " + md.tgtAud)
        if done
            string oc = md.tr.outcome == 1 ? "TP" : (md.tr.outcome == 2 ? "SL" : (md.tr.outcome == 3 ? "time" : "ambig"))
            f_lb(md.tr.exitT, md.tr.exitPx, "x " + oc + " " + str.tostring(md.tr.netR, "#.00") + "R", color.black, md.dir > 0 ? label.style_label_down : label.style_label_up, md.tr.note)
        if inCxVisFib and md.meth == "Fib 0.705" and not na(md.fH)
            f_lb(md.armT, md.fH, "Fib H", color.fuchsia, label.style_label_down, "anchor")
            f_lb(md.armT, md.fL, "Fib L", color.fuchsia, label.style_label_up, "anchor")
        if md.meth == "Rejection CE" and not na(md.rLo)
            f_bx(md.rT, md.rHi, md.rT + 2 * chartMs, md.rLo, color.new(color.red, 80), color.new(color.red, 20))
    true

// Setup context. Everything is anchored at the moment it became known and STOPS at the setup's actual end (endT), never beyond it.
f_cxDrawSetup(Setup st) =>
    int xe = st.endT > 0 ? st.endT : time_close
    f_ln(st.lvl.known, st.lvl.px, st.swT, st.lvl.px, color.purple, line.style_dotted, 2)
    f_lb(st.swT, st.lvl.px, "SWEEP #" + str.tostring(st.id) + " " + st.lvl.ty + " " + str.tostring(st.lvl.px, format.mintick), color.purple, st.dir > 0 ? label.style_label_up : label.style_label_down, "pre-existing level swept; known since " + f_hm(st.lvl.known))
    if st.st >= 1 and not na(st.cisdRef)
        int xr = st.cisdT > 0 ? st.cisdT : xe
        f_ln(st.swT, st.cisdRef, xr, st.cisdRef, color.aqua, line.style_dashed, 1)
        f_lb(xr, st.cisdRef, st.cisdT > 0 ? "CISD ref " + str.tostring(st.cisdRef, format.mintick) + " closed through" : "CISD ref " + str.tostring(st.cisdRef, format.mintick) + " (awaiting a close through)", color.aqua, label.style_label_right, "first open of the opposing run into the sweep, frozen at the sweep")
    if st.cisdT > 0
        f_ln(st.cisdT, st.ext, xe, st.ext, color.orange, line.style_solid, 2)
        f_lb(st.cisdT, st.ext, "setup extreme " + str.tostring(st.ext, format.mintick), color.orange, st.dir > 0 ? label.style_label_up : label.style_label_down, "frozen at the CISD; Standard stops sit beyond it")
        if inCxVisAreas and st.st == 2
            for a in st.areas
                if not a.dead
                    f_bxs(a.known, a.hi, xe, a.lo, color.new(color.teal, 92), color.new(color.teal, 55), a.stale ? line.style_dotted : line.style_solid)
                    f_lb(a.known, a.ce, a.kind + " CE " + str.tostring(a.ce, format.mintick) + (a.stale ? " (stale)" : ""), color.teal, label.style_label_right, "eligible area")
    if st.st == 8
        f_lb(xe, st.ext, "ended: " + st.why, color.gray, st.dir > 0 ? label.style_label_up : label.style_label_down, st.endCat)
    true

f_cxDrawLevels() =>
    int xe = time_close + 12 * chartMs
    for lv in lvls
        bool sw = lv.st == 2
        if (lv.side != 0 or inCxOpens) and lv.known > time_close - 172800000 and (not sw or inCxHistCtx)
            color c = lv.side == 0 ? color.new(color.gray, 20) : (lv.side > 0 ? color.new(color.maroon, sw ? 70 : 25) : color.new(color.green, sw ? 70 : 25))
            f_ln(lv.known, lv.px, sw ? lv.swT : xe, lv.px, c, lv.side == 0 ? line.style_dotted : (sw ? line.style_dashed : line.style_solid), 1)
            f_lb(sw ? lv.swT : xe, lv.px, lv.ty + " " + str.tostring(lv.px, format.mintick) + (sw ? " [swept]" : ""), c, label.style_label_left, "level L" + str.tostring(lv.id) + ", known " + f_hm(lv.known) + " NY")
    true

// ───────────────────────────────────────────── TABLES ─────────────────────────────────────────────
var table tbInfo = table.new(position.middle_left, 1, 11, bgcolor = color.new(color.white, 8), border_width = 1, border_color = color.gray)
var table tbFun = table.new(position.middle_right, 5, 16, bgcolor = color.new(color.white, 8), border_width = 1, border_color = color.gray)
var table tbPerf = table.new(position.bottom_right, 5, 21, bgcolor = color.new(color.white, 8), border_width = 1, border_color = color.gray)
var table tbLed = table.new(position.bottom_left, 12, 12, bgcolor = color.new(color.white, 8), border_width = 1, border_color = color.gray)

f_cell(table t, int c, int r, string txt, color tcol, color bg) =>
    table.cell(t, c, r, txt, text_color = tcol, text_size = size.tiny, text_halign = text.align_left, bgcolor = bg)
    true

// ───────────────────────────────── CONTEXTUAL TABLES ─────────────────────────────────
var table tbWhy = table.new(position.top_left, 1, 20, bgcolor = color.new(color.white, 8), border_width = 1, border_color = color.gray)

f_perfStr(array<float> a, int r) =>
    array<string> v = array.from(str.tostring(a.get(0), "#") + (a.get(26) > 0 ? " (+" + str.tostring(a.get(26), "#") + " excl.)" : ""), str.tostring(a.get(1), "#") + " / " + str.tostring(a.get(2), "#") + " / " + str.tostring(a.get(3), "#") + " / " + str.tostring(a.get(4), "#"), f_fmt(a.get(5), "#.0"), f_fmt(a.get(27), "#.00") + " / " + f_fmt(a.get(6), "#.00"), f_fmt(a.get(7), "#.00"), f_fmt(a.get(8), "#.00") + " / " + f_fmt(a.get(9), "#.00"), str.tostring(a.get(10), "#"), f_fmt(a.get(11), "#.00") + " / " + f_fmt(a.get(12), "#"), f_fmt(a.get(13), "#.00") + " / " + f_fmt(a.get(25), "#"), f_fmt(a.get(14), "#.0") + " / " + f_fmt(a.get(15), "#.00"), f_fmt(a.get(16), "#.0") + " / " + f_fmt(a.get(17), "#.00"), f_fmt(a.get(18), "#.0") + " / " + f_fmt(a.get(19), "#.00"), f_fmt(a.get(20), "#"), f_fmt(a.get(21), "#.0") + " / " + f_fmt(a.get(22), "#.00"), str.tostring(a.get(23), "#") + " / " + str.tostring(a.get(24), "#"), f_fmt(a.get(28), "#.0"), f_fmt(a.get(29), "#.0") + " / " + f_fmt(a.get(6), "#.00"), f_fmt(a.get(30), "#"), str.tostring(a.get(31), "#") + " / " + str.tostring(a.get(32), "#"), str.tostring(a.get(33), "#"))
    v.get(r)

var table tbSum = table.new(position.top_right, 1, 7, bgcolor = color.new(color.white, 8), border_width = 1, border_color = color.gray)
var table tbRec = table.new(position.top_center, 2, 24, bgcolor = color.new(color.white, 8), border_width = 1, border_color = color.gray)
var table tbSet = table.new(position.bottom_center, 7, 14, bgcolor = color.new(color.white, 8), border_width = 1, border_color = color.gray)

// ---- default view: ONE small summary panel ----
f_cxSumStat(int slot) =>
    array<float> a = f_perf(slot, "")
    string s = "0 trades"
    if a.get(0) + a.get(24) > 0
        s := str.tostring(a.get(0), "#") + " closed (" + str.tostring(a.get(1), "#") + "W/" + str.tostring(a.get(2), "#") + "L/" + str.tostring(a.get(3), "#") + "T)" + (a.get(24) > 0 ? " +" + str.tostring(a.get(24), "#") + " open" : "") + " | net win " + f_fmt(a.get(5), "#.0") + "% | net " + f_fmt(a.get(13), "#.00") + "R"
    s

f_cxSetupTxt() =>
    Setup st = f_cxCur()
    string s = "none yet"
    if not na(st)
        string base = "#" + str.tostring(st.id) + " " + (st.dir > 0 ? "LONG" : "SHORT") + " swept " + st.lvl.ty + " " + str.tostring(st.lvl.px, format.mintick)
        if st.st == 1
            s := base + " | waiting for a close through CISD ref " + str.tostring(st.cisdRef, format.mintick)
        else if st.st == 2
            s := base + " | CISD " + f_hm(st.cisdT) + ", " + str.tostring(st.areas.size()) + " area(s), " + (f_cxArmWin() ? "entry window OPEN" : "waiting for the entry window")
        else
            s := base + " | ended: " + st.why
    s

f_cxSummary() =>
    color blk = color.black
    int maxN = 0
    for t in trades
        maxN += 1
    string pTxt = "PREC: OFF - tick 'COMPARE Standard and Precision' or select Precision"
    if slotOn.get(SC_PRE)
        pTxt := "PREC: " + f_cxSumStat(SC_PRE)
    string sTxt = "STD: not simulated (variant = Precision only; tick COMPARE to run both)"
    if slotOn.get(SC_STD)
        sTxt := "STD: " + f_cxSumStat(SC_STD)
    string rs = lastRsn.get(0)
    if str.length(rs) > 78
        rs := str.substring(rs, 0, 78)
    int dropped = 0
    for i = 1 to 6
        dropped += aggs.get(i).dropN
    string warn = maxN < 30 ? "SAMPLE: " + str.tostring(maxN) + " trade(s) - too few to show an edge" : "Sample: " + str.tostring(maxN) + " trades (still not proof)"
    warn += " | days " + str.tostring(cv.get(0)) + " (" + str.tostring(cv.get(2)) + " partial, " + str.tostring(cv.get(3) + cv.get(5)) + " unusable)" + (dropped > 0 ? " | " + str.tostring(dropped) + " HTF candles dropped" : "")
    f_cell(tbSum, 0, 0, "H Ticks C | Contextual | " + inVariant + (inCmpVar ? " + comparison" : "") + " | research sim", color.white, color.new(color.maroon, 10))
    f_cell(tbSum, 0, 1, "Setup: " + f_cxSetupTxt(), blk, na)
    f_cell(tbSum, 0, 2, sTxt, blk, na)
    f_cell(tbSum, 0, 3, pTxt, slotOn.get(SC_PRE) ? blk : color.red, na)
    f_cell(tbSum, 0, 4, "Last reject: " + (rs == "" ? "-" : rs), blk, na)
    f_cell(tbSum, 0, 5, warn, maxN < 30 ? color.red : blk, na)
    f_cell(tbSum, 0, 6, inDbgMode ? "Debug mode ON" : "Full tables: Settings > Display > DEBUG MODE", color.gray, na)
    true

// ---- debug view ----
f_cxPrbTxt(int ix, string nm) =>
    string s = nm + " n/a"
    if not na(prbT.get(ix))
        s := nm + " " + (prbS.get(ix) > 0 ? "up" : (prbS.get(ix) < 0 ? "down" : "none yet")) + " (" + f_hm(prbT.get(ix)) + ")"
    s

f_cxCols() =>
    array<int> c = array.new_int(0)
    if slotOn.get(SC_STD)
        c.push(5)
    if slotOn.get(SC_PRE)
        c.push(6)
        if inPFibOn
            c.push(7)
        if inPRejOn
            c.push(8)
    c

f_cxDbgInfo() =>
    color blk = color.black
    int wk = not na(firstKey) and not na(lastKey) ? f_weekdays(firstKey, lastKey) : 0
    string rng = not na(firstKey) ? f_dt(firstKey) + " to " + f_dt(lastKey) : "none"
    string agTxt = "5m " + str.tostring(aggs.get(1).doneN) + "/" + str.tostring(aggs.get(1).dropN) + " 15m " + str.tostring(aggs.get(2).doneN) + "/" + str.tostring(aggs.get(2).dropN) + " 1H " + str.tostring(aggs.get(4).doneN) + "/" + str.tostring(aggs.get(4).dropN) + " 4H " + str.tostring(aggs.get(5).doneN) + "/" + str.tostring(aggs.get(5).dropN) + " D " + str.tostring(aggs.get(6).doneN) + "/" + str.tostring(aggs.get(6).dropN)
    string tAud = "-"
    if plans.size() > 0
        for i = plans.size() - 1 to 0
            if plans.get(i).tgtAud != ""
                tAud := "#" + str.tostring(plans.get(i).sid) + " " + plans.get(i).meth + " target: " + plans.get(i).tgtAud
                break
    f_cell(tbInfo, 0, 0, "DEBUG | Contextual | " + syminfo.ticker + " | research model, profitability UNPROVEN, our reading of the guide", color.white, color.new(color.maroon, 10))
    f_cell(tbInfo, 0, 1, "Data (loaded history): " + rng + " | window " + inCxWin + " NY, hard exit " + inCxHard + " | weekdays done " + str.tostring(cv.get(0)) + " of " + str.tostring(wk) + " (complete " + str.tostring(cv.get(1)) + ", partial " + str.tostring(cv.get(2)) + ", no window candle " + str.tostring(cv.get(3)) + ", levels n/a " + str.tostring(cv.get(5)) + ")", blk, na)
    f_cell(tbInfo, 0, 2, "HTF candles built/dropped: " + agTxt + " (tolerance " + str.tostring(inCxMiss) + ")", blk, na)
    f_cell(tbInfo, 0, 3, "Prior-range breakout state, NOT CISD: " + f_cxPrbTxt(6, "D") + " | " + f_cxPrbTxt(5, "4H") + " | " + f_cxPrbTxt(4, "1H") + " | " + f_cxPrbTxt(3, "30m") + " | " + f_cxPrbTxt(2, "15m"), blk, na)
    f_cell(tbInfo, 0, 4, "Current setup: " + f_cxSetupTxt(), blk, na)
    f_cell(tbInfo, 0, 5, "STANDARD: limit at area CE, stop beyond the sweep extreme +" + str.tostring(inCxBuf) + "t (cap " + str.tostring(inCxCap) + "t), min " + str.tostring(inCxMinR, "#.0") + "R, " + (inCxTgt == "Fixed R" ? "fixed " + str.tostring(inCxFixR, "#.0") + "R" : "nearest unswept liquidity"), blk, na)
    f_cell(tbInfo, 0, 6, "PRECISION: " + (inPFibOn ? "Fib " + str.tostring(inFibE, "#.000") + " " : "") + (inPRejOn ? "rejection CE on " + inRejTf : "") + " | cap " + str.tostring(inCxPCap) + "t buf " + str.tostring(inCxPBuf) + " | min " + str.tostring(inCxPMinR, "#.0") + "R | " + inSeq, blk, na)
    f_cell(tbInfo, 0, 7, "Costs " + (inComm == 0.0 and inSlip == 0 ? "ZERO (net = gross)" : str.tostring(inComm, "#.00") + "/side, " + str.tostring(inSlip) + "t slip") + " | size " + (inSizeMode == "Fixed cash risk" ? str.tostring(inCashRisk, "#") + " USD risk" : str.tostring(inQty) + " contract(s)") + " | fills " + (inStrict ? "trade-through" : "touch assumed"), blk, na)
    f_cell(tbInfo, 0, 8, "Latest " + tAud, blk, na)
    f_cell(tbInfo, 0, 9, "Unswept levels superseded by a newer same-type level (no longer targets): " + str.tostring(cxN.get(5)) + " | not implemented: NWOG/NDOG, trailing, SMT target role", blk, na)
    f_cell(tbInfo, 0, 10, "Limits: OHLC order inside a candle is unknowable (ambiguous = loss); a touched limit is an assumption; drawdown = closed trades only.", blk, na)
    true

f_cxDbgFun() =>
    color blk = color.black
    color bgH = color.new(color.silver, 30)
    string[] rows = array.from("Eligible days", "Setups created (sweeps)", "CISD confirmed", "Setups with an eligible area", "Candidates evaluated", "Orders armed", "Filled trades", "Unfilled/expired/cancel", "Stop rejections", "Invalidated", "Ambiguous trades", "No-target rejections", "Filter rejections / stale", "Min-R rejections", "Sizing rejections")
    string[] cn = array.from("", "", "", "", "", "STD", "PREC", "PREC-Fib", "PREC-Rej")
    array<int> cs = f_cxCols()
    f_cell(tbFun, 0, 0, "FUNNEL - candidate/order rows are per variant and NOT exclusive; setup rows are shared", blk, bgH)
    for c = 0 to 3
        if c < cs.size()
            f_cell(tbFun, c + 1, 0, cn.get(cs.get(c)), blk, bgH)
    for r = 0 to NF - 1
        f_cell(tbFun, 0, r + 1, rows.get(r), blk, na)
        for c = 0 to 3
            if c < cs.size()
                f_cell(tbFun, c + 1, r + 1, str.tostring(fnl.get(cs.get(c) * NF + r)), blk, na)
    true

f_cxDbgPerf() =>
    color blk = color.black
    color bgH = color.new(color.silver, 30)
    string[] pr = array.from("Closed trades", "W / L / time / ambig", "Net win rate % (filled)", "Expectancy gross / net R", "Profit factor (net)", "Avg win / avg loss R", "Max losing streak", "Closed DD  R / USD", "Net total  R / USD", "Avg MAE pts / R", "Median MAE all  pts / R", "Median MAE wins  pts / R", "Wins with MAE <= 0.25R %", "Avg MFE pts / R", "Uncertain / open trades", "Avg stop (ticks)", "Avg plan R / real net R", "Avg actual risk USD", "Planned >=4R / >=5R trades", "Gap-through-entry events")
    string[] cn = array.from("", "", "", "", "", "STD", "PREC", "PREC-Fib", "PREC-Rej")
    array<int> cs = f_cxCols()
    f_cell(tbPerf, 0, 0, "PERFORMANCE (MAE/MFE = bounds)", blk, bgH)
    for r = 0 to 19
        f_cell(tbPerf, 0, r + 1, pr.get(r), blk, na)
    for c = 0 to 3
        if c < cs.size()
            int k = cs.get(c)
            f_cell(tbPerf, c + 1, 0, cn.get(k), blk, bgH)
            array<float> pa = f_perf(k == 5 ? 5 : 6, k == 7 ? "Fib 0.705" : (k == 8 ? "Rejection CE" : ""))
            for r = 0 to 19
                f_cell(tbPerf, c + 1, r + 1, f_perfStr(pa, r), blk, na)
    true

f_cxDbgLed() =>
    color blk = color.black
    color bgH = color.new(color.silver, 30)
    int perPage = 10
    int sel = inLedModel == "Ctx Standard" ? 5 : (inLedModel == "Ctx Precision" ? 6 : -1)
    array<int> idx = array.new_int(0)
    if trades.size() > 0
        for i = trades.size() - 1 to 0
            Trade tt = trades.get(i)
            if tt.slot >= 5 and (sel < 0 or tt.slot == sel)
                idx.push(i)
    int pages = math.max(1, int(math.ceil(idx.size() / 10.0)))
    int pg = math.min(inLedPage, pages)
    string[] hd = array.from("Date", "Dir", "Method", "Swept", "Entry", "Stop", "Target", "Fill", "Exit", "Outcome", "Net R", "Reason (incl. target audit)")
    for c = 0 to 11
        f_cell(tbLed, c, 0, (c == 0 ? "LEDGER " + str.tostring(pg) + "/" + str.tostring(pages) + " " : "") + hd.get(c), blk, bgH)
    for r = 0 to perPage - 1
        int pos = (pg - 1) * perPage + r
        if pos < idx.size()
            Trade t = trades.get(idx.get(pos))
            string oc = t.isOpen ? "OPEN" : (t.outcome == 1 ? "TARGET" : (t.outcome == 2 ? "STOP" : (t.outcome == 3 ? "TIME EXIT" : "AMBIGUOUS")))
            string why = t.note + (t.entryAmb ? " [entry-candle ambiguity]" : "")
            string mth = (t.slot == SC_STD ? "STD " : "PREC ") + t.meth
            string[] cells = array.from(f_dt(t.dayKey), t.dir > 0 ? "LONG" : "SHORT", mth, str.tostring(t.lvl, format.mintick), str.tostring(t.entryPx, format.mintick), str.tostring(t.stopPx, format.mintick), str.tostring(t.tgtPx, format.mintick), f_hms(t.fillT), t.isOpen ? "-" : f_hms(t.exitT), oc, f_fmt(t.netR, "#.00"), str.length(why) > 120 ? str.substring(why, 0, 120) : why)
            for c = 0 to 11
                f_cell(tbLed, c, r + 1, cells.get(c), blk, na)
        else
            for c = 0 to 11
                f_cell(tbLed, c, r + 1, "", blk, na)
    true

f_cxDbgWhy() =>
    color blk = color.black
    color bgH = color.new(color.silver, 30)
    f_cell(tbWhy, 0, 0, "WHY NO TRADE? latest day (newest last)", blk, bgH)
    int nr = dayWhy.size()
    int w0 = math.max(0, nr - 9)
    for r = 0 to 8
        f_cell(tbWhy, 0, r + 1, w0 + r < nr ? dayWhy.get(w0 + r) : "", blk, na)
    f_cell(tbWhy, 0, 10, "Cumulative reasons (all loaded days):", blk, bgH)
    for r = 0 to 8
        f_cell(tbWhy, 0, r + 11, r < rjK.size() ? rjK.get(r) + ": " + str.tostring(rjC.get(r)) : "", blk, na)
    true

f_cxDbgRec() =>
    color blk = color.black
    color bgH = color.new(color.silver, 30)
    int tot = rcN.get(15)
    int sumC = 0
    f_cell(tbRec, 0, 0, "SETUP-LEVEL RECONCILIATION: each area-qualified setup is counted ONCE", blk, bgH)
    f_cell(tbRec, 1, 0, "setups", blk, bgH)
    for c = 0 to 13
        int v = c < 13 ? rcN.get(c) : math.max(0, tot - sumC)
        sumC += c < 13 ? v : 0
        f_cell(tbRec, 0, c + 1, f_cxRecLabel(c), blk, na)
        f_cell(tbRec, 1, c + 1, str.tostring(v), blk, na)
    f_cell(tbRec, 0, 15, "Area-qualified setups (total)", blk, bgH)
    f_cell(tbRec, 1, 15, str.tostring(tot), blk, bgH)
    f_cell(tbRec, 0, 16, "SWEEPS IGNORED while a setup was active (by blocker):", blk, bgH)
    f_cell(tbRec, 1, 16, "", blk, bgH)
    string[] bl = array.from("blocker waiting for its CISD", "blocker CISD done, no order yet", "blocker IDLE (attempts used, nothing pending)", "blocker has an order pending/open")
    for b = 0 to 3
        f_cell(tbRec, 0, b + 17, bl.get(b), blk, na)
        f_cell(tbRec, 1, b + 17, str.tostring(blkC.get(b)), blk, na)
    f_cell(tbRec, 0, 21, "Setup counters are exclusive; funnel candidate/order counters are per variant.", blk, na)
    f_cell(tbRec, 1, 21, "", blk, na)
    true

f_cxDbgSet() =>
    color blk = color.black
    color bgH = color.new(color.silver, 30)
    string[] hd = array.from("Setup", "Dir", "Swept level", "CISD", "Areas", "Cands", "Outcome")
    for c = 0 to 6
        f_cell(tbSet, c, 0, hd.get(c), blk, bgH)
    int row = 1
    if sets.size() > 0
        for i = sets.size() - 1 to 0
            Setup q = sets.get(i)
            if q.hadArea and row <= 13
                string oc = q.st == 8 ? q.endCat : "active: " + (q.st == 1 ? "waiting CISD" : "CISD done")
                string[] cells = array.from("#" + str.tostring(q.id) + " " + str.format_time(q.swT, "MM-dd HH:mm", TZ), q.dir > 0 ? "LONG" : "SHORT", q.lvl.ty + " " + str.tostring(q.lvl.px, format.mintick), f_hm(q.cisdT), str.tostring(q.areas.size()), str.tostring(q.candN), oc)
                for c = 0 to 6
                    f_cell(tbSet, c, row, cells.get(c), blk, na)
                row += 1
    while row <= 13
        for c = 0 to 6
            f_cell(tbSet, c, row, "", blk, na)
        row += 1
    true

f_cxDebugAll() =>
    f_cxDbgInfo()
    f_cxDbgWhy()
    f_cxDbgRec()
    f_cxDbgSet()
    if inFunnel
        f_cxDbgFun()
    if inPerf
        f_cxDbgPerf()
    if inLedger
        f_cxDbgLed()
    true

f_cxClearDebug() =>
    table.clear(tbInfo, 0, 0, 0, 10)
    table.clear(tbFun, 0, 0, 4, 15)
    table.clear(tbPerf, 0, 0, 4, 20)
    table.clear(tbLed, 0, 0, 11, 11)
    table.clear(tbWhy, 0, 0, 0, 19)
    table.clear(tbRec, 0, 0, 1, 23)
    table.clear(tbSet, 0, 0, 6, 13)
    true

bool drawNow = barstate.islastconfirmedhistory or (barstate.isrealtime and barstate.isconfirmed)
if not supported
    if barstate.islast
        table.cell(tbInfo, 0, 0, "H Ticks C needs STANDARD 1-MINUTE candles (not Heikin Ashi, Renko, tick or other types)", text_color = color.white, text_size = size.small, text_halign = text.align_left, bgcolor = color.new(color.red, 10))
else if not cfgAll
    if barstate.islast
        table.cell(tbInfo, 0, 0, "H Ticks C: invalid time settings (check: opening range ends by the open, open < manipulation end <= cutoff < exit)", text_color = color.white, text_size = size.small, text_halign = text.align_left, bgcolor = color.new(color.red, 10))
else if drawNow
    f_clearDraw()
    int nd = days.size()
    int shown = 0
    array<int> shownKeys = array.new_int(0)
    if nd > 0
        for i = nd - 1 to 0
            Day dd = days.get(i)
            if dd.active and shown < inDraw
                shownKeys.push(dd.key)
                shown += 1
    Setup cs = f_cxCur()
    if inCxVisCtx
        if not na(cs) and (cs.st == 1 or cs.st == 2)
            f_cxDrawSetup(cs)
        if inCxHistCtx
            for q in sets
                if shownKeys.includes(q.dayKey) and q.st == 8
                    f_cxDrawSetup(q)
    if inCxVisLevels
        f_cxDrawLevels()
    // trade boxes: latest PENDING plan per variant, every open position, and the last N completed trades per variant
    array<int> pendShown = array.new_int(9, 0)
    array<int> doneShown = array.new_int(9, 0)
    if plans.size() > 0 and inVisPlan
        for i = plans.size() - 1 to 0
            Mdl md = plans.get(i)
            if slotOn.get(md.slot)
                bool draw = false
                if md.st == 3
                    draw := true
                else if md.st == 2 and pendShown.get(md.slot) == 0
                    draw := true
                    pendShown.set(md.slot, 1)
                else if md.st == 4 and not na(md.tr) and doneShown.get(md.slot) < inCxNDone
                    draw := true
                    doneShown.set(md.slot, doneShown.get(md.slot) + 1)
                if draw
                    f_cxDrawPlan(md)
    f_cxSummary()
    if inDbgMode
        f_cxDebugAll()
    else
        f_cxClearDebug()
