// ──────────────────────────────── CONTEXTUAL ENGINE TYPES ────────────────────────────────
// Aggregated candles are built from the 1m chart and used only after they COMPLETE (history arrays hold completed candles only).
type Agg
    int n
    int id = 0
    bool has = false
    float o = na
    float h = na
    float l = na
    float c = na
    int t0 = 0
    int tc = 0
    bool nw = false
    int cnt = 0
    int idx = 0
    int firstMs = 0
    int lastMs = 0
    bool gap = false
    bool bad = false
    int dropN = 0
    int doneN = 0
    array<float> O
    array<float> H
    array<float> L
    array<float> C
    array<int> T0
    array<int> TC

// A liquidity / reference level. st: 0 untouched, 1 touched, 2 swept (exceeded by the minimum), 3 superseded. side: +1 high, -1 low, 0 reference only.
type Lvl
    int id
    string ty
    int side
    float px
    int origin
    int known
    int st = 0
    int swT = 0
    int swOpen = 0
    bool proc = false

type Area
    int id
    string kind
    float lo
    float hi
    float ce
    int known
    int src
    bool dead = false
    bool stale = false

type Fvg
    int id
    int dir
    float lo
    float hi
    int c1open
    int known
    bool inv = false
    int invOpen = 0
    int invKnown = 0
    bool dead = false

type Pv
    int side
    float px
    bool dead = false

// A confirmed source-timeframe swing (known only when its right-side candles closed) and the order block associated with it
type Sw
    int side
    float px
    int open
    int kn
    float bLo = na
    float bHi = na

type Rg
    bool active = false
    float h = na
    float l = na
    int n = 0
    int origin = 0

type Cs
    float hi = na
    float lo = na
    int hiT = 0
    int loT = 0
    bool hiReg = false
    bool loReg = false

// One contextual setup: sweep of a pre-existing level -> CISD -> eligible areas. st: 1 swept (waiting for the CISD close), 2 CISD confirmed (waiting for / using execution), 8 ended.
type Setup
    int id
    int dir
    int st = 0
    string why = ""
    Lvl lvl
    int swOpen
    int swT
    float ext
    int cnt = 0
    int firstExc
    int dayKey
    float cisdRef = na
    int refOpen = 0
    int cisdT = 0
    int cisdOpen = 0
    array<Area> areas
    array<Area> rbs
    array<int> fvgUsed
    int smt = -1
    bool hadArea = false
    int fibSt = 0
    float fibPx = na
    int fibOp = 0
    int fibKn = 0
    bool brkDone = false
    int stdSt = 0
    int precSt = 0
    Mdl mdlS
    Mdl mdlP

