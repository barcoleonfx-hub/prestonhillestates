    float plannedR = na
    string tgtType = ""
    float riskUsd = 0.0
    string meth = ""
    int sid = 0
    bool gap = false

// One entry model's state for one day. st: 0 idle, 1 waiting for its entry conditions, 2 ARMED limit, 3 POSITION OPEN, 4 done.
type Mdl
