    float aHi = na
    float aCe = na
    float fH = na
    float fL = na
    float rLo = na
    float rHi = na
    int rT
    int parId = 0

// Day state. st: 0 WAITING, 1 OPEN_CAPTURED, 2 MANIPULATION_QUALIFIED, 3 REVERSAL_CONFIRMED, 6 COMPLETE, 7 EXPIRED, 8 INVALIDATED, 9 INELIGIBLE.
