string inCxLd = input.session("0200-0500", "London range (NY)", group = G11)
bool inCxLvPO = input.bool(false, "Level: predefined PO3 accumulation range", group = G11, tooltip = "The range is fixed in advance (below) and becomes a level only when it has COMPLETED. It is never inferred retrospectively.")
string inCxPo = input.session("0000-0600", "PO3 accumulation range (NY)", group = G11)
bool inCxOpens = input.bool(true, "Show the 18:00 / 00:00 / 10:00 opens (reference only, never an entry)", group = G11)
bool inBiasD = input.bool(false, "Filter: Daily prior-range breakout state must agree (NOT a CISD)", group = G12, tooltip = "Prior-range breakout state per timeframe, from COMPLETED candles only: +1 after a close above the previous candle's high, -1 after a close below its low, otherwise it PERSISTS unchanged (0 until the first breakout). It resets to unavailable when that timeframe loses a candle (incomplete data). It is NOT the opposing-delivery-leg CISD used for the setup.")
bool inBias4 = input.bool(false, "Filter: 4H prior-range breakout state must agree", group = G12)
bool inBias1 = input.bool(false, "Filter: 1H prior-range breakout state must agree", group = G12)
